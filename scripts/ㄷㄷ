    // ========================================================================
    // 기존 유틸리티 메서드 (변경 없음)
    // ========================================================================
    private String findIidByTitle(String responseJson, String targetTitle) {
        Pattern blockPattern = Pattern.compile("\\{[^}]*\\}");
        Matcher blockMatcher = blockPattern.matcher(responseJson);
        Pattern titlePattern = Pattern.compile("\"title\":\"([^\"]*)\"");
        Pattern iidPattern   = Pattern.compile("\"iid\":\\s*(\\d+)");
        while (blockMatcher.find()) {
            String block = blockMatcher.group();
            Matcher titleMatcher = titlePattern.matcher(block);
            Matcher iidMatcher   = iidPattern.matcher(block);
            if (titleMatcher.find() && iidMatcher.find()) {
                if (titleMatcher.group(1).trim().equals(targetTitle.trim())) return iidMatcher.group(1).trim();
            }
        }
        return null;
    }

    private boolean isDuplicateIssue(String encodedPath, String targetTitle) throws IOException {
        String urlPath = "api/v4/projects/" + encodedPath + "/issues?state=opened&per_page=100";
        String responseJson = get(urlPath, gitLabAccessToken);
        if (responseJson == null || responseJson.trim().equals("[]") || responseJson.trim().isEmpty()) return false;
        Pattern pattern = Pattern.compile("\"title\":\"([^\"]*)\"");
        Matcher matcher = pattern.matcher(responseJson);
        while (matcher.find()) {
            if (matcher.group(1).trim().equalsIgnoreCase(targetTitle.trim())) return true;
        }
        return false;
    }

    private Long findGitLabUserIdByUsername(String username) throws IOException {
        String responseJson = get("api/v4/users?username=" + username, gitLabAccessToken);
        if (responseJson == null || responseJson.trim().equals("[]") || responseJson.trim().isEmpty()) return null;
        try {
            String idKey = "\"id\":";
            int idIdx = responseJson.indexOf(idKey);
            if (idIdx != -1) {
                int start = idIdx + idKey.length();
                int end = responseJson.indexOf(",", start);
                if (end == -1) end = responseJson.indexOf("}", start);
                return Long.parseLong(responseJson.substring(start, end).trim());
            }
        } catch (Exception e) { return null; }
        return null;
    }

    private String encodeProjectId(String systemName) throws IOException {
        if (systemName == null || systemName.trim().isEmpty()) return null;
        return URLEncoder.encode(systemName, StandardCharsets.UTF_8.toString());
    }

    private String formatLabelsToJsonArray(String labels) {
        if (labels == null || labels.trim().isEmpty()) return "[]";
        StringBuilder sb = new StringBuilder().append("[");
        String[] labelArray = labels.split(",");
        for (int i = 0; i < labelArray.length; i++) {
            String clean = labelArray[i].trim().replaceAll("[\\(\\[\\]\"]", "").trim();
            if (!clean.isEmpty()) {
                sb.append("\"").append(clean).append("\"");
                if (i < labelArray.length - 1) sb.append(",");
            }
        }
        sb.append("]");
        return sb.toString();
    }

    private String complete(List<ChatMessage> messages, double temp, int maxTokens) throws IOException {
        return parseChoiceContent(postLlm(llmBaseUrl, buildChatBody(defaultModel, messages, temp, maxTokens, false, null)));
    }

    private String postLlm(String baseUrl, String body) throws IOException {
        URL url = new URL(baseUrl);
        HttpURLConnection conn = (HttpURLConnection) url.openConnection();
        conn.setRequestMethod("POST");
        conn.setRequestProperty("Content-Type", "application/json; charset=UTF-8");
        conn.setDoOutput(true);
        try (OutputStream os = conn.getOutputStream()) { os.write(body.getBytes(StandardCharsets.UTF_8)); }
        return readAll(conn.getInputStream());
    }

    private String post(String path, String body, String token) throws IOException {
        URL url = new URL(gitLabBaseUrl + path);
        HttpURLConnection conn = (HttpURLConnection) url.openConnection();
        conn.setRequestMethod("POST");
        conn.setRequestProperty("Content-Type", "application/json; charset=UTF-8");
        conn.setRequestProperty("PRIVATE-TOKEN", token);
        conn.setDoOutput(true);
        try (OutputStream os = conn.getOutputStream()) { os.write(body.getBytes(StandardCharsets.UTF_8)); }
        int code = conn.getResponseCode();
        return (code >= 200 && code < 300) ? readAll(conn.getInputStream()) : "Error: " + code;
    }

    private String put(String path, String body, String token) throws IOException {
        String cleanBase = gitLabBaseUrl.endsWith("/") ? gitLabBaseUrl.substring(0, gitLabBaseUrl.length() - 1) : gitLabBaseUrl;
        String cleanPath = path.startsWith("/") ? path.substring(1) : path;
        URL url = new URL(cleanBase + "/" + cleanPath);
        HttpURLConnection conn = (HttpURLConnection) url.openConnection();
        conn.setRequestMethod("PUT");
        conn.setRequestProperty("Content-Type", "application/json; charset=UTF-8");
        conn.setRequestProperty("PRIVATE-TOKEN", token);
        conn.setDoOutput(true);
        try (OutputStream os = conn.getOutputStream()) { os.write(body.getBytes(StandardCharsets.UTF_8)); }
        int code = conn.getResponseCode();
        if (code >= 200 && code < 300) return readAll(conn.getInputStream());
        try (InputStream is = conn.getErrorStream()) {
            return "Error: " + code + " | " + (is != null ? readAll(is) : "No body");
        }
    }

    private String get(String path, String token) throws IOException {
        URL url = new URL(gitLabBaseUrl + path);
        HttpURLConnection conn = (HttpURLConnection) url.openConnection();
        conn.setRequestMethod("GET");
        conn.setRequestProperty("PRIVATE-TOKEN", token);
        if (conn.getResponseCode() == 200) return readAll(conn.getInputStream());
        return "";
    }

    private String buildChatBody(String model, List<ChatMessage> messages, double temperature, int maxTokens, boolean stream, String[] stop) {
        StringBuilder sb = new StringBuilder();
        sb.append("{");
        sb.append("\"model\":").append(jsonStr(model)).append(',');
        sb.append("\"temperature\":").append(temperature).append(',');
        sb.append("\"max_tokens\":").append(maxTokens).append(',');
        sb.append("\"messages\":[");
        for (int i = 0; i < messages.size(); i++) {
            ChatMessage m = messages.get(i);
            sb.append("{\"role\":").append(jsonStr(m.getRoleString())).append(",\"content\":").append(jsonStr(m.getContent())).append('}');
            if (i < messages.size() - 1) sb.append(',');
        }
        sb.append("]}");
        return sb.toString();
    }

    private String readAll(InputStream is) throws IOException {
        if (is == null) return "";
        try (BufferedReader r = new BufferedReader(new InputStreamReader(is, StandardCharsets.UTF_8))) {
            StringBuilder sb = new StringBuilder();
            String line;
            while ((line = r.readLine()) != null) sb.append(line).append('\n');
            return sb.toString().trim();
        }
    }

    private String jsonStr(String str) {
        if (str == null) return "null";
        StringBuilder sb = new StringBuilder().append('"');
        for (int i = 0; i < str.length(); i++) {
            char c = str.charAt(i);
            switch (c) {
                case '"':  sb.append("\\\""); break;
                case '\\': sb.append("\\\\"); break;
                case '\n': sb.append("\\n");  break;
                case '\r': sb.append("\\r");  break;
                case '\t': sb.append("\\t");  break;
                default:   sb.append(c);
            }
        }
        return sb.append('"').toString();
    }

    private String parseChoiceContent(String responseJson) {
        try {
            String searchKey = "\"content\":\"";
            int contentIdx = responseJson.indexOf(searchKey);
            if (contentIdx == -1) return "Parse Error";
            int start = contentIdx + searchKey.length();
            int end = findClosingQuote(responseJson, start);
            return responseJson.substring(start, end).replace("\\n", "\n").replace("\\\"", "\"");
        } catch (Exception e) { return "Parse Error"; }
    }

    private int findClosingQuote(String str, int start) {
        boolean escaped = false;
        for (int i = start; i < str.length(); i++) {
            char c = str.charAt(i);
            if (c == '\\' && !escaped) { escaped = true; continue; }
            if (c == '"' && !escaped) return i;
            escaped = false;
        }
        return str.length();
    }

    private String getJsonValue(String json, String key) {
        Pattern pattern = Pattern.compile("\"" + key + "\":\\s*\"?([^,\"}]+)\"?");
        Matcher matcher = pattern.matcher(json);
        return matcher.find() ? matcher.group(1).trim() : null;
    }

    public static class ChatMessage {
        private final String role;
        private final String content;
        public ChatMessage(String role, String content) { this.role = role; this.content = content; }
        public String getRoleString() { return role; }
        public String getContent()    { return content; }
    }

    private static class ParsedLlmData {
        String labels          = "";
        String fullDescription = "";
        String dueDate         = "";
    }
}
// 기존
String milestoneId = getJsonValue(milestoneResponse, "id");

// 수정 - "id": 숫자 패턴만 정확히 추출
private String getMilestoneId(String json) {
    Pattern pattern = Pattern.compile("\"id\":\\s*(\\d+)");
    Matcher matcher = pattern.matcher(json);
    return matcher.find() ? matcher.group(1).trim() : null;
}
