package jef.application.resource.imdg.nearcache;

import java.util.Map;
import java.util.concurrent.ConcurrentHashMap;
import java.util.concurrent.locks.ReentrantReadWriteLock;

import org.slf4j.Logger;
import org.slf4j.LoggerFactory;

import com.github.benmanes.caffeine.cache.Cache;
import com.github.benmanes.caffeine.cache.Caffeine;

import jef.application.resource.imdg.ImdgCache;
import jef.application.resource.imdg.ImdgClient;
import jef.foundation.logging.ConsoleLogger;

/**
 * 단일 프로세스에서 한번만 생성되며, 각각의 스레드는
 * ThreadLocal 으로 별도의 Caffeine 캐시를 만든다.
 */
public class BatchJefNearCache<K, V> implements ImdgCache<K, V>{

    private static final Logger logger = LoggerFactory.getLogger(BatchJefNearCache.class);

    private final ImdgClient imdgClient;
    private final ImdgCache<K, V> internalCache;

    private final Map<Long, Cache<K, V>> cacheMap = new ConcurrentHashMap<>();
    private final ReentrantReadWriteLock mainLock = new ReentrantReadWriteLock();
    private ThreadLocal<Cache<K, V>> threadLocalCache = null;

	private JefNearCacheConfiguration config;

    public BatchJefNearCache(ImdgCache<K, V> internalCache,
                             ImdgClient imdgClient,
                             JefNearCacheConfiguration config) {
        this.internalCache = internalCache;
        this.imdgClient = imdgClient;
		this.config = config;
        
        this.threadLocalCache = new ThreadLocal<Cache<K, V>>() {
        	
            @Override
            protected Cache<K, V> initialValue() {
            	// 현재 스레드 ID와 캐시를 맵에 등록
            	long threadId = Thread.currentThread().getId();
                Cache<K, V> cache = getInitialCache(threadId);
                cacheMap.put(threadId, cache);
				return cache;
            }

        };

        ConsoleLogger.info("[IMDG] BatchJefNearCache({"+internalCache.getName()+"}) created.");
    }
    
    private Cache<K, V> getInitialCache(long threadId) {
    	Cache<K, V> cache = Caffeine.newBuilder()
    			.maximumSize(config.getMaxCapacity())
    			.recordStats()
    			.build();
    	
    	ConsoleLogger.info("[IMDG]BatchJefNearCacheByThreadId(" + threadId + ") created. "
    			+ "[maxCapacity: "+ config.getMaxCapacity() + "][recordStat: " + config.isRecordStat() + "]");
    	return cache;
    }

    private Cache<K, V> getCacheForCurrentThread() {
        long threadId = Thread.currentThread().getId();
        Cache<K, V> cache = cacheMap.get(threadId);

        if (cache == null) {
        	cache = getInitialCache(threadId);
            cacheMap.put(threadId, cache);
        }
        return cache;
    }

    @Override
    public V get(K key) {
    	V value = null;
    	Cache<K, V> cache = getCacheForCurrentThread();
    	try {
    		value = cache.getIfPresent(key);

    		if (logger.isDebugEnabled()) {
    			logger.debug("NearCache GET : threadid={"+Thread.currentThread().getId()+"} key={"+key+"} → {"+(value != null ? value:"")+"}" );
    		}

    	} catch (Exception e) {
    		logger.error("NearCache GET ERROR. : threadid={"+Thread.currentThread().getId()+"} key={"+key+"} error::"+e.getMessage());
    	}
    	
    	if (value == null && imdgClient.isActive() && !internalCache.isClosed()) {
    		try {
    			value = internalCache.get(key);
    			
    			if (value != null && cache != null ) {
    				cache.put(key, value);

    				if (logger.isDebugEnabled())
    					logger.debug("NearCache PUT (after miss): key={"+key+"} → {"+(value != null ? value:"")+"}" );
    			} 
    		} catch (Exception e) {
    			logger.error("InternalCache GET ERROR. : threadid={"+Thread.currentThread().getId()+"} key={"+key+"} , error::"+e.getMessage());
    		}
    	}

    	return value;
    }

    @Override
    public void put(K key, V value) {
        Cache<K, V> cache = getCacheForCurrentThread();

        if (imdgClient.isActive() && !internalCache.isClosed()) {
            try {
                internalCache.put(key, value);
                if (logger.isDebugEnabled())
                    logger.debug("InternalCache PUT: key={} → {}", key, value);
                
            } catch (Exception e) {
            	logger.error("InternalCache PUT ERROR. : threadid={"+Thread.currentThread().getId()+"} key={"+key+"} , error::"+e.getMessage());
            }
        }

        try {
        	if(cache != null)
        		cache.put(key, value);
        	
            if (logger.isDebugEnabled())
            	logger.debug("NearCache PUT : threadid={"+Thread.currentThread().getId()+"} key={"+key+"} → {"+(value != null ? value:"")+"}" );
            
        } catch (Exception e) {
        	logger.error("NearCache PUT ERROR. : threadid={"+Thread.currentThread().getId()+"} key={"+key+"} , error::"+e.getMessage());
        }
    }

    @Override
    public boolean remove(K key) {
        Cache<K, V> cache = getCacheForCurrentThread();
        cache.invalidate(key);   

        try {
            boolean removed = internalCache.remove(key);
            if (logger.isDebugEnabled())
                logger.debug("InternalCache remove(key={}) → {}", key, removed);
            return removed;
        } catch (Exception e) {
            logger.error("InternalCache.remove. "+ e.getMessage(), e);
            return false;
        }
    }

    @Override
    public boolean remove(K key, V value) {
        Cache<K, V> cache = getCacheForCurrentThread();
        cache.invalidate(key);

        try {
            boolean removed = internalCache.remove(key, value);
            if (logger.isDebugEnabled())
                logger.debug("InternalCache remove(key={}, value={}) ", key, value);
            return removed;
        } catch (Exception e) {
        	logger.error("InternalCache.remove. "+ e.getMessage(), e);
            return false;
        }
    }

    @Override
    public boolean removeAll() {
        cleanupThreadMapAll();  // Near Cache 모두 정리

        try {
            boolean removed = internalCache.removeAll();
            if (logger.isDebugEnabled())
                logger.debug("InternalCache.removeAll() → {}", removed);
            return removed;
        } catch (Exception e) {
        	logger.error("InternalCache.removeAll. "+ e.getMessage(), e);
            return false;
        }
    }

    @Override
    public void putAsync(K key, V value) {
        put(key, value);
    }

    @Override
    public void putAsyncExt(K key, V value) throws Exception {
    	  put(key, value);
    }

    @Override
    public V getExt(K key) throws Exception {
        return get(key);
    }

    @Override
    public void putExt(K key, V value) throws Exception {
        put(key, value);
    }

    @Override
    public String getName() {
        return "BatchJefNearCache(" + internalCache.getName() + ")";
    }

    @Override
    public boolean isNearCache() { return true; }

    @Override
    public boolean clearNearCache() {
        cleanupThreadMapAll();
        return true;
    }

    @Override
    public void close() {
        cleanupThreadMapAll();
    }

    @Override
    public boolean isClosed() {
        return cacheMap.isEmpty();
    }

    public void clearNearRuleCache(String stepName, long threadId) {
//    	CacheStats stats = getStats( stepName, threadId);
//    	if (stats == null)
//    		logger.info("RuleCacheClearEvent → stepId:{"+stepName+"}, threadId:{"+threadId+"}, stat:{null..}");
//    	else
//    		logger.info("RuleCacheClearEvent → stepId:{"+stepName+"}, threadId:{"+threadId+"}, stat:{"+stats.toString()+"}");
//    	cleanupThread(threadId);
    }
	
    public CacheStats getStats(String stepName, long threadId) {
    	Cache<K, V> cache = cacheMap.get(threadId);
    	if (cache == null) return null;

    	if (logger.isInfoEnabled())
    		logger.info("close.getStats → stepId:{"+stepName+"}, threadId:{"+threadId+"}, cache:{"+cache.toString()+"}");
    	com.github.benmanes.caffeine.cache.stats.CacheStats stats = cache.stats();
    	if (stats != null)
    		logger.info("close.getStats → hitCount:{"+stats.hitCount()+"}, missCount:{"+stats.missCount()+"}, estimatedSize:{"+cache.estimatedSize()+"}");

    	return new CacheStats(stats.hitCount(),
    			stats.missCount(),
    			cache.estimatedSize());

    }
    
    public void cleanupThread(long threadId) {
        mainLock.writeLock().lock();
        try {
            cacheMap.remove(threadId);
        } finally {
            mainLock.writeLock().unlock();
        }
    }
    
    public void cleanupThreadMapAll() {
        mainLock.writeLock().lock();
        try {
            cacheMap.clear();
            threadLocalCache.remove();   // 남은 ThreadLocal 가 있으면 정리
        } finally {
            mainLock.writeLock().unlock();
        }
    }

	public static class CacheStats {
		private final long hitCount;
		private final long missCount;
		private final long estimatedSize;
		
		public CacheStats(long h, long m, long s) {
			this.hitCount = h;
			this.missCount = m;
			this.estimatedSize = s;
		}
		
		public long getHitCount() { return hitCount; }
		public long getMissCount() { return missCount; }
		public long getEstimatedSize() { return estimatedSize; }
		
		public double getHitRate() {
			long total = hitCount + missCount;
			return total > 0 ? (double) hitCount / total : 0.0;
		}
		
		@Override
		public String toString() {
			return String.format("CacheStats{hit=%d, miss=%d, hitRate=%.2f, size=%d}",
					hitCount, missCount, getHitRate(), estimatedSize);
		}
	}
}