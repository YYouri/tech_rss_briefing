
package hi.bxm.assist.test;

import java.io.BufferedReader;
import java.io.IOException;
import java.io.InputStream;
import java.io.InputStreamReader;
import java.io.OutputStream;
import java.net.HttpURLConnection;
import java.net.URL;
import java.net.URLEncoder;
import java.nio.charset.StandardCharsets;
import java.util.ArrayList;
import java.util.List;
import java.util.regex.Matcher;
import java.util.regex.Pattern;

/**
 * PMS -> LLM -> GitLab 통합 서비스 클래스
 * - 마일스톤 + 이슈 1:1 생성 (자원 DESC 기반 체크리스트/영향도/개발방향성)
 */
public class PmsGitLabIntegrationService {

    private final String llmBaseUrl        = "http://dev-fms.hi-portal.co.kr/fms/api/llm/gemma/chat.do";
    private final String gitLabBaseUrl     = "http://10.2.12.77:48000/";
    private final String gitLabAccessToken = "Snp4WHJox4JYUf4byNZ4";
    private final String defaultModel      = "/app/models/gemma4-31b-it-awq-4bit";

    // ========================================================================
    // 자원 정보 VO
    // ========================================================================
    public static class ResourceInfo {
        public final String name;
        public final String desc;
        public ResourceInfo(String name, String desc) {
            this.name = name;
            this.desc = (desc == null ? "" : desc);
        }
    }

    // ========================================================================
    // 마일스톤 + 이슈 생성 (메인 진입점)
    // ========================================================================
    public String createMilestoneAndIssue(
            String projectId,           // P20260610-0001
            String pmsTaskTitle,        // 작업의뢰 제목
            String pmsTaskContent,      // 작업의뢰 내용
            String pmsEmployeeId,       // 담당자 ID
            String gitLabSystemPath,    // GitLab 프로젝트 경로
            List<ResourceInfo> resources // 체크아웃 자원 목록
    ) {
        try {
            // 1. 경로 인코딩
            String encodedPath = encodeProjectId(gitLabSystemPath);
            if (encodedPath == null) return "Fail: 경로 오류";

            // 2. 담당자 조회
            Long gitLabUserId = findGitLabUserIdByUsername(pmsEmployeeId);
            if (gitLabUserId == null || gitLabUserId == -1) return "Fail: 계정 오류";

            // 3. 마일스톤/이슈 제목 (코드명 기준)
            String title = projectId + " " + pmsTaskTitle;

            // 4. 중복 체크 (이슈 기준)
            if (isDuplicateIssue(encodedPath, title)) {
                return "Skip: 이미 [" + title + "] 명칭의 이슈가 존재합니다.";
            }

            // 5. LLM 분석 (자원 DESC 포함)
            String llmRawResponse = analyzeWithLLM(pmsTaskTitle, pmsTaskContent, resources);
            ParsedLlmData parsedData = parseLlmResponse(llmRawResponse, pmsEmployeeId, resources);

            // 6. 마일스톤 생성
            String milestoneResponse = createGitLabMilestone(encodedPath, title, projectId, pmsTaskContent, parsedData.dueDate);
            if (milestoneResponse.contains("Error")) return "Fail: 마일스톤 생성 오류 - " + milestoneResponse;
            String milestoneId = getJsonValue(milestoneResponse, "id");
            if (milestoneId == null) return "Fail: 마일스톤 ID 추출 실패";

            // 7. 이슈 생성 (마일스톤 연결)
            String issueResponse = createGitLabIssue(
                    encodedPath, title, parsedData.labels,
                    parsedData.fullDescription, gitLabUserId,
                    Long.parseLong(milestoneId)
            );
            if (issueResponse.contains("Error")) return "Fail: 이슈 생성 오류 - " + issueResponse;

            String iid = getJsonValue(issueResponse, "iid");
            return "Success: 마일스톤 및 이슈 생성 완료 (이슈 번호: #" + iid + ", 마일스톤 ID: " + milestoneId + ")";

        } catch (Exception e) {
            return "Error: " + e.getMessage();
        }
    }

    // ========================================================================
    // 마일스톤 생성
    // ========================================================================
    private String createGitLabMilestone(
            String encodedPath, String title,
            String projectId, String pmsTaskContent, String dueDate
    ) throws IOException {
        String urlPath = "api/v4/projects/" + encodedPath + "/milestones";

        StringBuilder desc = new StringBuilder();
        desc.append("## 요청 정보\n");
        desc.append("- **요청번호**: ").append(projectId).append("\n");
        desc.append("- **요청내용**: ").append(pmsTaskContent).append("\n");

        StringBuilder sb = new StringBuilder();
        sb.append("{");
        sb.append("\"title\":").append(jsonStr(title)).append(",");
        sb.append("\"description\":").append(jsonStr(desc.toString()));
        if (dueDate != null && !dueDate.isEmpty()) {
            sb.append(",\"due_date\":").append(jsonStr(dueDate));
        }
        sb.append("}");

        return post(urlPath, sb.toString(), gitLabAccessToken);
    }

    // ========================================================================
    // LLM 분석 (자원 DESC 포함)
    // ========================================================================
    private String analyzeWithLLM(
            String taskTitle, String taskContent,
            List<ResourceInfo> resources
    ) throws IOException {
        List<ChatMessage> messages = new ArrayList<ChatMessage>();

        String systemPrompt =
            "당신은 Java/Spring 시니어 개발자입니다.\n"
            + "입력받은 작업의뢰와 자원 목록을 분석하여 아래 형식으로 출력하십시오.\n\n"
            + "출력 형식(반드시 엄격히 지킬 것):\n"
            + "[METADATA]\n"
            + "Label: (라벨1, 라벨2 - 선택: Bug/Feature/Refactoring/Task/UI/API/DB/Security/Infrastructure)\n"
            + "DueDate: (YYYY-MM-DD 형식, 자원 수와 복잡도 기반 추정)\n"
            + "[DESCRIPTION]\n"
            + "### 📌 개발 방향성\n(요청 내용과 자원 분석 기반의 작업 방향 서술)\n\n"
            + "### ⚠️ 영향도\n"
            + "- 연관 가능 모듈: (자원 DESC 기반 추정)\n"
            + "- 공통 모듈 여부: (예/아니오 및 설명)\n"
            + "- 주의 필요 항목: (변경 시 주의사항)\n\n"
            + "### ✅ 작업 체크리스트\n"
            + "#### 수정 자원\n"
            + "(자원별 체크리스트 - 아래 [자원목록]을 그대로 활용)\n\n"
            + "#### 신규 자원\n"
            + "(개발자 직접 추가)\n\n"
            + "### 🔗 관련 이슈\n"
            + "(추후 연결 예정)";

        // 자원 목록 문자열 생성
        StringBuilder resourceStr = new StringBuilder();
        if (resources != null && !resources.isEmpty()) {
            resourceStr.append("\n\n[자원목록]\n");
            for (ResourceInfo r : resources) {
                resourceStr.append("- ").append(r.name).append(": ").append(r.desc).append("\n");
            }
        }

        messages.add(new ChatMessage("system", systemPrompt));
        messages.add(new ChatMessage("user",
            "작업의뢰 제목: " + taskTitle + "\n"
            + "작업의뢰 내용: " + taskContent
            + resourceStr.toString()
        ));

        return complete(messages, 0.5, 2000);
    }

    // ========================================================================
    // LLM 응답 파싱 (자원 체크리스트 병합)
    // ========================================================================
    private ParsedLlmData parseLlmResponse(
            String rawResponse, String pmsEmployeeId,
            List<ResourceInfo> resources
    ) {
        ParsedLlmData data = new ParsedLlmData();
        try {
            int descIdx = rawResponse.indexOf("[DESCRIPTION]");
            if (descIdx == -1) throw new Exception("Format Error");

            String metaPart = rawResponse.substring(0, descIdx);
            String descPart = rawResponse.substring(descIdx + "[DESCRIPTION]".length()).trim();

            // Label 추출
            int labelIdx = metaPart.indexOf("Label:");
            if (labelIdx != -1) {
                int endOfLine = metaPart.indexOf("\n", labelIdx);
                if (endOfLine == -1) endOfLine = metaPart.length();
                String labelStr = metaPart.substring(labelIdx + "Label:".length(), endOfLine).trim();
                labelStr = labelStr.replaceAll("[\\(\\[\\]]", "").replace("\"", "").trim();
                data.labels = labelStr;
            }

            // DueDate 추출
            int dueDateIdx = metaPart.indexOf("DueDate:");
            if (dueDateIdx != -1) {
                int endOfLine = metaPart.indexOf("\n", dueDateIdx);
                if (endOfLine == -1) endOfLine = metaPart.length();
                data.dueDate = metaPart.substring(dueDateIdx + "DueDate:".length(), endOfLine).trim();
            }

            // 체크리스트에 자원 목록 보강 (LLM이 누락한 경우 대비)
            if (resources != null && !resources.isEmpty()) {
                if (!descPart.contains("#### 수정 자원")) {
                    StringBuilder checklist = new StringBuilder();
                    checklist.append("\n#### 수정 자원\n");
                    for (ResourceInfo r : resources) {
                        checklist.append("- [ ] `").append(r.name).append("` - ").append(r.desc).append("\n");
                    }
                    checklist.append("\n#### 신규 자원\n(개발자 직접 추가)\n");
                    descPart = descPart + checklist.toString();
                }
            }

            // 최종 description 조립
            StringBuilder sb = new StringBuilder();
            sb.append("**담당자: [").append(pmsEmployeeId).append("]**\n\n");
            sb.append(descPart);
            data.fullDescription = sb.toString();

        } catch (Exception e) {
            data.labels = "Task";
            // 파싱 실패 시에도 자원 체크리스트는 보장
            StringBuilder fallback = new StringBuilder();
            fallback.append("**담당자: [").append(pmsEmployeeId).append("]**\n\n");
            fallback.append("⚠️ LLM 파싱 오류\n\n");
            if (resources != null && !resources.isEmpty()) {
                fallback.append("### ✅ 작업 체크리스트\n#### 수정 자원\n");
                for (ResourceInfo r : resources) {
                    fallback.append("- [ ] `").append(r.name).append("` - ").append(r.desc).append("\n");
                }
                fallback.append("\n#### 신규 자원\n(개발자 직접 추가)\n");
            }
            data.fullDescription = fallback.toString();
        }
        return data;
    }

    // ========================================================================
    // 이슈 생성 (마일스톤 ID 포함)
    // ========================================================================
    private String createGitLabIssue(
            String encodedPath, String title, String labels,
            String description, Long assigneeId, Long milestoneId
    ) throws IOException {
        String urlPath = "api/v4/projects/" + encodedPath + "/issues";
        String jsonLabels = formatLabelsToJsonArray(labels);

        StringBuilder sb = new StringBuilder();
        sb.append("{");
        sb.append("\"title\":").append(jsonStr(title)).append(",");
        sb.append("\"labels\":").append(jsonLabels).append(",");
        sb.append("\"description\":").append(jsonStr(description)).append(",");
        sb.append("\"assignee_id\":").append(assigneeId).append(",");
        sb.append("\"milestone_id\":").append(milestoneId);
        sb.append("}");

        String responseJson = post(urlPath, sb.toString(), gitLabAccessToken);
        if (responseJson.contains("Error")) return "Error: " + responseJson;
        return responseJson;
    }

    // ========================================================================
    // 이슈 종료 (기존 유지)
    // ========================================================================
    public String closeIssueByProjectIdAndNumber(String projectId, String gitLabSystemPath) {
        if (projectId == null || gitLabSystemPath == null) return "Fail: 파라미터가 누락되었습니다.";
        try {
            String encodedPath = gitLabSystemPath.replace("/", "%2F");
            String listUrl = "api/v4/projects/" + encodedPath + "/issues?per_page=100";
            String responseJson = get(listUrl, gitLabAccessToken);
            if (responseJson == null || responseJson.trim().isEmpty()) return "Fail: 이슈 목록을 가져오지 못했습니다.";

            String issueIid = findIidByTitle(responseJson, projectId);
            if (issueIid == null) return "Fail: [" + projectId + "] 제목의 이슈를 찾을 수 없습니다.";

            String updateUrl = "api/v4/projects/" + encodedPath + "/issues/" + issueIid;
            String response = put(updateUrl, "{\"state_event\": \"close\"}", gitLabAccessToken);
            if (response.contains("Error")) return "Fail: 이슈 종료 실패. 응답: " + response;
            return "Success: [" + projectId + "] 이슈(IID: " + issueIid + ")를 성공적으로 종료했습니다.";
        } catch (Exception e) {
            return "Error: " + e.getMessage();
        }
    }

