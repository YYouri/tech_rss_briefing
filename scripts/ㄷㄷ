        String pmsId      = "IB1117";
        String systemPath = "TEST/TEST_MYDATA";

        // 자원 목록 구성
        List<ResourceInfo> resources = new ArrayList<ResourceInfo>();
        resources.add(new ResourceInfo("BTd54265VO.java",  "개발원자동차사양 BTDO VO (N01051200)"));
        resources.add(new ResourceInfo("LTEE0640S.java",   "휴대폰전자서명 변경(해외장기체류 사후환급) 처리 sub service"));

