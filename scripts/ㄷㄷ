
package hi.bxm.assist.test;

import java.io.BufferedReader;
import java.io.IOException;
import java.io.InputStream;
import java.io.InputStreamReader;
import java.io.OutputStream;
import java.net.HttpURLConnection;
import java.net.URL;
import java.net.URLEncoder;
import java.nio.charset.StandardCharsets;
import java.util.ArrayList;
import java.util.List;

/**

PMS -> LLM -> GitLab 통합 서비스 클래스
[Updated] 프로젝트 ID를 찾기 위해 영문 시스템명(Path)을 사용하는 기능 추가
*/
public class PmsGitLabIntegrationService {  // 설정 정보
 private final String llmBaseUrl = "http://dev-fms.hi-portal.co.kr/fms/api/llm/gemma/chat.do";
 private final String gitLabBaseUrl = "http://10.2.12.77:48000/";
 private final String gitLabAccessToken = "Snp4WHJox4JYUf4byNZ4";
 private final String defaultModel = "/app/models/gemma4-31b-it-awq-4bit";  /**
통합 프로세스 실행 메서드
@param pmsTaskContent PMS 작업 내용
@param pmsEmployeeId PMS 사번
@param gitLabSystemPath GitLab 프로젝트 경로 (예: "my-group/my-project")
*/
public String processPmsToGitLab(String projectid, String pmsTaskContent, String pmsEmployeeId, String gitLabSystemPath) {
 try {
 // [Step 0] 프로젝트 ID 조회: 영문 시스템명(Path)을 통해 숫자 ID를 가져옴
 String gitLabProjectId = findProjectIdBySystemName(gitLabSystemPath);
 if (gitLabProjectId == null) {
     return "Fail: GitLab 프로젝트를 찾을 수 없습니다. (Path: " + gitLabSystemPath + ")";
 }

 // [Step 1] LLM 변환
 String markdownTemplate = convertToMarkdownWithLLM(pmsTaskContent);

 // [Step 2] 사용자 매핑
 Long gitLabUserId = findGitLabUserIdByUsername(pmsEmployeeId);

 // [Step 3] 이슈 등록
 if (gitLabUserId != null) {
     String issueResult = createGitLabIssue(projectid, gitLabProjectId, markdownTemplate, gitLabUserId);
     return "Success: " + issueResult;
 } else {
     return "Fail: GitLab User ID를 찾을 수 없습니다. (사번: " + pmsEmployeeId + ")";
 }
 } catch (Exception e) {
 e.printStackTrace();
 return "Error: 프로세스 진행 중 오류 발생 - " + e.getMessage();
 }
} // ========================================================================
// NEW: STEP 0 - 프로젝트 ID 조회 (영문 시스템명 기반)
// ======================================================================== /**
GitLab의 프로젝트 경로(Namespace/Project Name)를 사용하여 숫자 ID를 반환합니다.
@param systemName 영문 시스템명 (예: "dev-group/web-service")
@return GitLab 프로젝트 숫자 ID (문자열), 찾을 수 없으면 null
*/
private String findProjectIdBySystemName(String systemName) throws IOException {
 if (systemName == null || systemName.trim().isEmpty()) return null;  // GitLab API는 프로젝트 경로를 URL-encoded하여 사용할 수 있음 (예: api/v4/projects/dev-group%2Fweb-service)
 String encodedPath = URLEncoder.encode(systemName, StandardCharsets.UTF_8.toString());
 String urlPath = "api/v4/projects/" + encodedPath;  String responseJson = get(urlPath, gitLabAccessToken);  if (responseJson == null || responseJson.trim().equals("") || responseJson.trim().equals("{}")) {
 return null;
 }  // 응답 JSON에서 "id" 필드의 값을 추출 (수동 파싱)
 try {
 String idKey = "\"id\":";
 int idIdx = responseJson.indexOf(idKey);
 if (idIdx != -1) {
     int start = idIdx + idKey.length();
     // 숫자 뒤에 오는 문자( , 또는 } ) 전까지 추출
     int end = responseJson.indexOf(",", start);
     if (end == -1) end = responseJson.indexOf("}", start);
     
     String idValue = responseJson.substring(start, end).trim();
     return idValue;
 }
 } catch (Exception e) {
 return null;
 }
 return null;
} // ========================================================================
// STEP 1: LLM 변환 로직
// ======================================================================== private String convertToMarkdownWithLLM(String taskContent) throws IOException {
 List<ChatMessage> messages = new ArrayList<ChatMessage>();
 messages.add(new ChatMessage("system", "당신은 시니어 개발자입니다. 입력된 작업 요청 내용을 분석하여, "
     + "개발자가 수행해야 할 단계를 구체적인 '마크다운 체크리스트(- [ ])' 형태로 생성하십시오. "
     + "분석 결과 요약도 반드시 포함하십시오."));
 messages.add(new ChatMessage("user", "다음 작업 요청을 분석해서 체크리스트로 만들어줘: " + taskContent));  return complete(messages, 0.7, 1000);
} private String complete(List<ChatMessage> messages, double temp, int maxTokens) throws IOException {
 String body = buildChatBody(defaultModel, messages, temp, maxTokens, false, null);
 String responseJson = post("v1/chat/completions", body);
 return parseChoiceContent(responseJson);
} private String buildChatBody(String model, List<ChatMessage> messages, double temperature, int maxTokens, boolean stream, String[] stopSequences) {
 StringBuilder sb = new StringBuilder();
 sb.append("{");
 sb.append("\"model\":").append(jsonStr(model)).append(',');
 sb.append("\"temperature\":").append(temperature).append(',');
 sb.append("\"max_tokens\":").append(maxTokens).append(',');
 if (stream) sb.append("\"stream\":true,");
 
 if (stopSequences != null) {
 sb.append("\"stop\":[");
 for (int i = 0; i < stopSequences.length; i++) {
     sb.append(jsonStr(stopSequences[i]));
     if (i < stopSequences.length - 1) sb.append(",");
 }
 sb.append("],");
 }  sb.append("\"messages\":rage:");
 for (int i = 0; i < messages.size(); i++) {
 ChatMessage m = messages.get(i);
 sb.append("{\"role\":").append(jsonStr(m.getRoleString()))
   .append(",\"content\":").append(jsonStr(m.getContent())).append('}');
 if (i < messages.size() - 1) sb.append(',');
 }
 sb.append("]}");
 return sb.toString();
} // ========================================================================
// STEP 2: GitLab 사용자 검색 로직
// ======================================================================== private Long findGitLabUserIdByUsername(String username) throws IOException {
 String urlPath = "api/v4/users?username=" + username;
 String responseJson = get(urlPath, gitLabAccessToken);  if (responseJson == null || responseJson.trim().equals("[]") || responseJson.trim().equals("")) {
 return null;
 }  try {
 String idKey = "\"id\":";
 int idIdx = responseJson.indexOf(idKey);
 if (idIdx != -1) {
     int start = idIdx + idKey.length();
     int end = responseJson.indexOf(",", start);
     if (end == -1) end = responseJson.indexOf("}", start);
     
     return Long.parseLong(responseJson.substring(start, end).trim());
 }
 } catch (Exception e) {
 return null;
 }
 return null;
} // ========================================================================
// STEP 3: GitLab 이슈 등록 로직
// ======================================================================== private String createGitLabIssue(String projectId, String systemid, String description, Long assigneeId) throws IOException {
 String urlPath = "api/v4/projects/" + systemid + "/issues";
 
 StringBuilder sb = new StringBuilder();
 sb.append("{");
 sb.append("\"title\":").append(jsonStr(projectId)).append(","); // <--- 이 부분이 핵심입니다.
 sb.append("\"description\":").append(jsonStr(description)).append(",");
 sb.append("\"assignee_id\":").append(assigneeId);
 sb.append("}");
 
 String responseJson = post(urlPath, sb.toString(), gitLabAccessToken);
 return "Issue Created: " + responseJson;
} // ========================================================================
// HTTP 통신 및 유틸리티 (기존 스타일 유지)
// ======================================================================== private String post(String path, String body, String token) throws IOException {
 URL url = new URL(gitLabBaseUrl + path);
 HttpURLConnection conn = (HttpURLConnection) url.openConnection();
 conn.setRequestMethod("POST");
 conn.setRequestProperty("Content-Type", "application/json; charset=UTF-8");
 conn.setRequestProperty("PRIVATE-TOKEN", token);
 conn.setDoOutput(true);  try (OutputStream os = conn.getOutputStream()) {
 byte[] input = body.getBytes(StandardCharsets.UTF_8);
 os.write(input, 0, input.length);
 }  int code = conn.getResponseCode();
 if (code >= 200 && code < 300) {
 return readAll(conn.getInputStream());
 } else {
 return "Error Response: " + code + " - " + readAll(conn.getErrorStream());
 }
} private String post(String path, String body) throws IOException {
 URL url = new URL(llmBaseUrl);
 HttpURLConnection conn = (HttpURLConnection) url.openConnection();
 conn.setRequestMethod("POST");
 conn.setRequestProperty("Content-Type", "application/json; charset=UTF-8");
 conn.setDoOutput(true);  try (OutputStream os = conn.getOutputStream()) {
 byte[] input = body.getBytes(StandardCharsets.UTF_8);
 os.write(input, 0, input.length);
 }  return readAll(conn.getInputStream());
} private String get(String path, String token) throws IOException {
 URL url = new URL(gitLabBaseUrl + path);
 HttpURLConnection conn = (HttpURLConnection) url.openConnection();
 conn.setRequestMethod("GET");
 conn.setRequestProperty("PRIVATE-TOKEN", token);  int code = conn.getResponseCode();
 if (code == 200) {
 return readAll(conn.getInputStream());
 } else {
 return "";
 }
} private String readAll(InputStream is) throws IOException {
 if (is == null) return "";
 try (BufferedReader r = new BufferedReader(new InputStreamReader(is, StandardCharsets.UTF_8))) {
 StringBuilder sb = new StringBuilder();
 String line;
 while ((line = r.readLine()) != null) sb.append(line).append('\n');
 return sb.toString().trim();
 }
} private String jsonStr(String str) {
 if (str == null) return "null";
 StringBuilder sb = new StringBuilder();
 sb.append('"');
 for (int i = 0; i < str.length(); i++) {
 char c = str.charAt(i);
 if (c == '"' || c == '\\' || c == '/' || c == '\b' || c == '\f' || c == '\n' || c == '\r' || c == '\t') {
     sb.append('\\');
     switch (c) {
         case '"': sb.append('"'); break;
         case '\\': sb.append('\\'); break;
         case '/': sb.append('/'); break;
         case '\b': sb.append('b'); break;
         case '\f': sb.append('f'); break;
         case '\n': sb.append('n'); break;
         case '\r': sb.append('r'); break;
         case '\t': sb.append('t'); break;
     }
 } else {
     sb.append(c);
 }
 }
 sb.append('"');
 return sb.toString();
} private String parseChoiceContent(String responseJson) {
 try {
 String searchKey = "\"content\":\"";
 int contentIdx = responseJson.indexOf(searchKey);
 if (contentIdx == -1) return "Parse Error";
 
 int start = contentIdx + searchKey.length();
 int end = findClosingQuote(responseJson, start);
 return responseJson.substring(start, end).replace("\\n", "\n").replace("\\\"", "\"");
 } catch (Exception e) {
 return "Parse Error: " + e.getMessage();
 }
} private int findClosingQuote(String str, int start) {
 boolean escaped = false;
 for (int i = start; i < str.length(); i++) {
 char c = str.charAt(i);
 if (c == '\\' && !escaped) {
     escaped = true;
     continue;
 }
 if (c == '"' && !escaped) return i;
 escaped = false;
 }
 return str.length();
} public static class ChatMessage {
 private final String role;
 private final String content;
 public ChatMessage(String role, String content) { this.role = role; this.content = content; }
 public String getRoleString() { return role; }
 public String getContent() { return content; }
}
}