package jef.application.resource.imdg.nearcache;

import java.text.SimpleDateFormat;
import java.util.Collections;
import java.util.Date;
import java.util.Map;
import java.util.WeakHashMap;
import java.util.concurrent.locks.ReentrantReadWriteLock;

import org.slf4j.Logger;
import org.slf4j.LoggerFactory;

import com.github.benmanes.caffeine.cache.Cache;
import com.github.benmanes.caffeine.cache.Caffeine;

import jef.application.resource.imdg.ImdgCache;
import jef.application.resource.imdg.ImdgClient;
public class BatchJefNearCache<K, V> implements ImdgCache<K, V>{

    private static final Logger logger = LoggerFactory.getLogger(BatchJefNearCache.class);

    private final ImdgClient imdgClient;
    private final ImdgCache<K, V> internalCache;
    private volatile boolean enabledStat = false;
    private Thread statPrintThread = null;
    
//    private final Map<Long, Cache<K, V>> cacheMap = new ConcurrentHashMap<>();
    private final Map<Thread, Cache<K, V>> cacheMap = Collections.synchronizedMap(new WeakHashMap<>());
    private final ReentrantReadWriteLock mainLock = new ReentrantReadWriteLock();
    private ThreadLocal<Cache<K, V>> threadLocalCache = null;

	private JefNearCacheConfiguration config;

    public BatchJefNearCache(ImdgCache<K, V> internalCache,
                             ImdgClient imdgClient,
                             JefNearCacheConfiguration config) {
        this.internalCache = internalCache;
        this.imdgClient = imdgClient;
		this.config = config;
        
        this.threadLocalCache = new ThreadLocal<Cache<K, V>>() {
        	
            @Override
            protected Cache<K, V> initialValue() {
            	// 현재 스레드 ID와 캐시를 맵에 등록
            	Thread currentThread = Thread.currentThread();
                Cache<K, V> cache = getInitialCache(currentThread);
                cacheMap.put(currentThread, cache);
				return cache;
            }

        };

        // 통계 기록 설정이 true인 경우 모니터링 쓰레드 시작
        if (config.isRecordStat()) {
            startStatThread();
        }

        logger.info("[IMDG] BatchJefNearCache({}) created.", internalCache.getName());
    }

    private Cache<K, V> getInitialCache(Thread currentThread) {
    	Cache<K, V> cache = Caffeine.newBuilder()
    			.maximumSize(config.getMaxCapacity())
    			.recordStats()
    			.build();
        logger.info("[IMDG]BatchJefNearCacheByThreadId({}) created. [maxCapacity: {}][recordStat: {}]", 
                    new Object[] {currentThread.getId(), config.getMaxCapacity(), config.isRecordStat()});
        
        return cache;
    }

    private Cache<K, V> getCacheForCurrentThread() {
//        long threadId = Thread.currentThread().getId();
//        Cache<K, V> cache = cacheMap.get(threadId);
//
//        if (cache == null) {
//        	cache = getInitialCache(threadId);
//            cacheMap.put(threadId, cache);
//        }
//        return cache;
    	return threadLocalCache.get();
    }

    @Override
    public V get(K key) {
    	V value = null;
    	Cache<K, V> cache = getCacheForCurrentThread();
    	try {
    		value = cache.getIfPresent(key);

    		if (logger.isDebugEnabled()) {
    			logger.debug("NearCache GET: threadid={}, key={}, value={}", new Object[] {Thread.currentThread().getId(), key, value});
    		}

    	} catch (Exception e) {
    		logger.error("NearCache GET ERROR. : threadid={}, key={}, error={}", 
    				new Object[] { 
    						Thread.currentThread().getId(), 
    						key, 
    						e.getMessage() 
    		});
    	}
    	
    	if (value == null && imdgClient.isActive() && !internalCache.isClosed()) {
    		try {
    			value = internalCache.get(key);
    			
    			if (value != null && cache != null ) {
    				cache.put(key, value);

    				if (logger.isDebugEnabled())
    					logger.debug("NearCache PUT (after miss): threadid={}, key={}, value={}", new Object[] {Thread.currentThread().getId(), key, value});
    			} 
    		} catch (Exception e) {
    			logger.error("InternalCache GET ERROR. : threadid={}, key={}, error={}", 
        				new Object[] { 
        						Thread.currentThread().getId(), 
        						key, 
        						e.getMessage() 
        		});
    		}
    	}

    	return value;
    }

    @Override
    public void put(K key, V value) {
        Cache<K, V> cache = getCacheForCurrentThread();

        if (imdgClient.isActive() && !internalCache.isClosed()) {
            try {
                internalCache.put(key, value);
                if (logger.isDebugEnabled())
                	logger.debug("InternalCache PUT: threadid={}, key={}, value={}", new Object[] {Thread.currentThread().getId(), key, value});
                
            } catch (Exception e) {
            	logger.error("InternalCache PUT ERROR. : threadid={}, key={}, error={}", 
        				new Object[] { 
        						Thread.currentThread().getId(), 
        						key, 
        						e.getMessage() 
        		});
            }
        }

        try {
        	if(cache != null)
        		cache.put(key, value);
        	
            if (logger.isDebugEnabled())
            	logger.debug("NearCache PUT: threadid={}, key={}, value={}", new Object[] {Thread.currentThread().getId(), key, value});
            
        } catch (Exception e) {
        	logger.error("NearCache PUT ERROR. : threadid={}, key={}, error={}", 
    				new Object[] { 
    						Thread.currentThread().getId(), 
    						key, 
    						e.getMessage() 
    		});
        }
    }

    @Override
    public boolean remove(K key) {
        Cache<K, V> cache = getCacheForCurrentThread();
        cache.invalidate(key);   

        try {
            boolean removed = internalCache.remove(key);
            if (logger.isDebugEnabled())
                logger.debug("InternalCache remove(key={}) → {}", key, removed);
            return removed;
        } catch (Exception e) {
            logger.error("InternalCache.remove. "+ e.getMessage(), e);
            return false;
        }
    }

    @Override
    public boolean remove(K key, V value) {
        Cache<K, V> cache = getCacheForCurrentThread();
        cache.invalidate(key);

        try {
            boolean removed = internalCache.remove(key, value);
            if (logger.isDebugEnabled())
                logger.debug("InternalCache remove(key={}, value={}) ", key, value);
            return removed;
        } catch (Exception e) {
        	logger.error("InternalCache.remove. "+ e.getMessage(), e);
            return false;
        }
    }

    @Override
    public boolean removeAll() {
        cleanupThreadMapAll();  // Near Cache 모두 정리

        try {
            boolean removed = internalCache.removeAll();
            if (logger.isDebugEnabled())
                logger.debug("InternalCache.removeAll() → {}", removed);
            return removed;
        } catch (Exception e) {
        	logger.error("InternalCache.removeAll. "+ e.getMessage(), e);
            return false;
        }
    }

    @Override
    public void putAsync(K key, V value) {
        put(key, value);
    }

    @Override
    public void putAsyncExt(K key, V value) throws Exception {
    	  put(key, value);
    }

    @Override
    public V getExt(K key) throws Exception {
        return get(key);
    }

    @Override
    public void putExt(K key, V value) throws Exception {
        put(key, value);
    }

    @Override
    public String getName() {
        return "BatchJefNearCache(" + internalCache.getName() + ")";
    }

    @Override
    public boolean isNearCache() { return true; }

    @Override
    public boolean clearNearCache() {
        cleanupThreadMapAll();
        return true;
    }

    @Override
    public void close() {
        cleanupThreadMapAll();
    }

    @Override
    public boolean isClosed() {
        return cacheMap.isEmpty();
    }

    public void clearNearRuleCache(String stepName, Thread threadId) {
//    	CacheStats stats = getStats( stepName, threadId);
//    	if (stats == null)
//    		logger.info("RuleCacheClearEvent → stepId:{"+stepName+"}, threadId:{"+threadId+"}, stat:{null..}");
//    	else
//    		logger.info("RuleCacheClearEvent → stepId:{"+stepName+"}, threadId:{"+threadId+"}, stat:{"+stats.toString()+"}");
//    	cleanupThread(threadId);
    }
	
    public void cleanupThread(Thread threadId) {
        mainLock.writeLock().lock();
        try {
            cacheMap.remove(threadId);
        } finally {
            mainLock.writeLock().unlock();
        }
    }
    
    public void cleanupThreadMapAll() {
        mainLock.writeLock().lock();
        try {
            cacheMap.clear();
            threadLocalCache.remove();   // 남은 ThreadLocal 가 있으면 정리
        } finally {
            mainLock.writeLock().unlock();
        }
    }
    
    private void startStatThread() {
        this.enabledStat = true;
        this.statPrintThread = new Thread(() -> {
            while (enabledStat) {
                try {
                    Thread.sleep(config.getPrintStatInterval());
                } catch (InterruptedException e) {
                    Thread.currentThread().interrupt();
                    break;
                } catch (Exception e) {
                    // ignore
                }

                if (Thread.currentThread().isInterrupted()) break;

                printAggregateStats();
            }
        });

        SimpleDateFormat format = new SimpleDateFormat("yyyy-MM-dd-HH:mm:ss.SSS");
        this.statPrintThread.setName("[IMDG]JefNearCache(" + internalCache.getName() + ")-STAT-" + format.format(new Date()));
        this.statPrintThread.start();
    }
    
    private void printAggregateStats() {
        long totalHit = 0;
        long totalMiss = 0;
        long totalSize = 0;
        int threadCount = 0;

        synchronized (cacheMap) {
            for (Cache<K, V> cache : cacheMap.values()) {
                if (cache != null) {
                    com.github.benmanes.caffeine.cache.stats.CacheStats s = cache.stats(); 
                    if (s != null) {
                        totalHit += s.hitCount();
                        totalMiss += s.missCount();
                    }
                    totalSize += cache.estimatedSize();
                    threadCount++;
                }
            }
        }

        long totalRequest = totalHit + totalMiss;
        double hitRate = totalRequest > 0 ? (double) totalHit / totalRequest * 100 : 0.0;
        double missRate = totalRequest > 0 ? (double) totalMiss / totalRequest * 100 : 0.0;

        StringBuilder sb = new StringBuilder();
        sb.append("[JefNearCache(").append(internalCache.getName()).append(") Aggregate Stat]")
          .append(" [Threads: ").append(threadCount).append("]")
          .append(" [TotalCapacity: ").append(String.format("%,d", (long)config.getMaxCapacity() * threadCount)).append("]")
          .append(" [CurrentSize: ").append(String.format("%,d", totalSize)).append("]")
          .append(" [RequestCnt: ").append(String.format("%,d", totalRequest)).append("]")
          .append(" [HitCnt: ").append(String.format("%,d", totalHit)).append("]")
          .append(" [HitRate: ").append(String.format("%.2f", hitRate)).append("%]")
          .append(" [MissCnt: ").append(String.format("%,d", totalMiss)).append("]")
          .append(" [MissRate: ").append(String.format("%.2f", missRate)).append("%]");

        logger.debug(sb.toString());
    }
}