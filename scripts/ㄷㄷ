import { useState, useCallback } from "react";
import * as mammoth from "mammoth";

const CLAUDE_API_URL = "https://api.anthropic.com/v1/messages";

export default function DocxExtractor() {
  const [extractedText, setExtractedText] = useState("");
  const [prompt, setPrompt] = useState("");
  const [loading, setLoading] = useState(false);
  const [promptLoading, setPromptLoading] = useState(false);
  const [fileName, setFileName] = useState("");
  const [dragOver, setDragOver] = useState(false);
  const [error, setError] = useState("");
  const [copied, setCopied] = useState(false);
  const [promptType, setPromptType] = useState("code-assist");

  const extractFromFile = async (file) => {
    setError("");
    setExtractedText("");
    setPrompt("");
    setFileName(file.name);
    setLoading(true);
    try {
      const arrayBuffer = await file.arrayBuffer();
      const result = await mammoth.extractRawText({ arrayBuffer });
      const text = result.value.trim();
      if (!text) {
        setError("텍스트를 추출할 수 없습니다. 이미지만 있는 문서일 수 있습니다.");
      } else {
        setExtractedText(text);
      }
    } catch (e) {
      setError("파일 읽기 실패: " + e.message);
    } finally {
      setLoading(false);
    }
  };

  const handleFile = (file) => {
    if (!file) return;
    if (!file.name.endsWith(".docx")) {
      setError(".docx 파일만 지원합니다.");
      return;
    }
    extractFromFile(file);
  };

  const handleDrop = useCallback((e) => {
    e.preventDefault();
    setDragOver(false);
    const file = e.dataTransfer.files[0];
    handleFile(file);
  }, []);

  const handleDragOver = (e) => { e.preventDefault(); setDragOver(true); };
  const handleDragLeave = () => setDragOver(false);

  const handleFileInput = (e) => {
    handleFile(e.target.files[0]);
  };

  const generatePrompt = async () => {
    if (!extractedText) return;
    setPromptLoading(true);
    setPrompt("");
    setError("");

    const systemMsg = `You are an expert at writing system prompts for LLM-based code assistants.
Given a technical guide document, create a concise and effective system prompt in Korean for a code assist feature.
The prompt should help an LLM understand the framework's conventions, patterns, and rules so it can generate correct code.
Respond ONLY with the system prompt text, no explanation, no markdown fences.`;

    const typeLabel = {
      "code-assist": "코드 자동완성/생성 어시스트",
      "chat": "개발자 채팅 어시스트",
      "review": "코드 리뷰 어시스트",
    }[promptType];

    const userMsg = `아래는 가이드 문서에서 추출한 내용입니다. 이 내용을 바탕으로 "${typeLabel}" 용도의 LLM 시스템 프롬프트를 작성해주세요.

[가이드 내용]
${extractedText.slice(0, 6000)}`;

    try {
      const res = await fetch(CLAUDE_API_URL, {
        method: "POST",
        headers: { "Content-Type": "application/json" },
        body: JSON.stringify({
          model: "claude-sonnet-4-20250514",
          max_tokens: 1000,
          system: systemMsg,
          messages: [{ role: "user", content: userMsg }],
        }),
      });
      const data = await res.json();
      const text = data.content?.map((c) => c.text || "").join("") || "";
      setPrompt(text.trim());
    } catch (e) {
      setError("프롬프트 생성 실패: " + e.message);
    } finally {
      setPromptLoading(false);
    }
  };

  const copyText = (text, target) => {
    navigator.clipboard.writeText(text).then(() => {
      setCopied(target);
      setTimeout(() => setCopied(""), 2000);
    });
  };

  return (
    <div style={{
      minHeight: "100vh",
      background: "#0f1117",
      color: "#e2e8f0",
      fontFamily: "'JetBrains Mono', 'Fira Code', 'Consolas', monospace",
      padding: "32px 20px",
    }}>
      <div style={{ maxWidth: 800, margin: "0 auto" }}>

        {/* Header */}
        <div style={{ marginBottom: 32 }}>
          <div style={{ display: "flex", alignItems: "center", gap: 10, marginBottom: 6 }}>
            <span style={{ fontSize: 22, color: "#7c3aed" }}>⬡</span>
            <span style={{ fontSize: 13, color: "#7c3aed", letterSpacing: "0.12em", textTransform: "uppercase" }}>
              Docx → Prompt
            </span>
          </div>
          <h1 style={{ fontSize: 26, fontWeight: 700, margin: 0, color: "#f1f5f9" }}>
            가이드 문서에서 LLM 프롬프트 생성
          </h1>
          <p style={{ fontSize: 13, color: "#64748b", marginTop: 6 }}>
            .docx 파일을 업로드하면 텍스트를 추출하고 코드 어시스트용 프롬프트를 만들어줍니다
          </p>
        </div>

        {/* Drop Zone */}
        <div
          onDrop={handleDrop}
          onDragOver={handleDragOver}
          onDragLeave={handleDragLeave}
          style={{
            border: `2px dashed ${dragOver ? "#7c3aed" : "#334155"}`,
            borderRadius: 10,
            padding: "36px 24px",
            textAlign: "center",
            background: dragOver ? "#1e1b4b22" : "#161b27",
            cursor: "pointer",
            transition: "all 0.15s",
            marginBottom: 24,
            position: "relative",
          }}
        >
          <input
            type="file"
            accept=".docx"
            onChange={handleFileInput}
            style={{ position: "absolute", inset: 0, opacity: 0, cursor: "pointer" }}
          />
          <div style={{ fontSize: 32, marginBottom: 8 }}>📄</div>
          <div style={{ fontSize: 14, color: "#94a3b8" }}>
            {fileName
              ? <span style={{ color: "#a78bfa" }}>✓ {fileName}</span>
              : <>.docx 파일을 드래그하거나 클릭해서 선택</>
            }
          </div>
          {loading && <div style={{ marginTop: 10, color: "#7c3aed", fontSize: 13 }}>추출 중...</div>}
        </div>

        {/* Error */}
        {error && (
          <div style={{
            background: "#1e0a0a", border: "1px solid #7f1d1d",
            borderRadius: 8, padding: "12px 16px", marginBottom: 20,
            color: "#fca5a5", fontSize: 13,
          }}>
            ⚠ {error}
          </div>
        )}

        {/* Extracted Text */}
        {extractedText && (
          <div style={{ marginBottom: 24 }}>
            <div style={{
              display: "flex", justifyContent: "space-between", alignItems: "center",
              marginBottom: 8,
            }}>
              <span style={{ fontSize: 12, color: "#64748b", textTransform: "uppercase", letterSpacing: "0.1em" }}>
                추출된 텍스트 ({extractedText.length.toLocaleString()}자)
              </span>
              <button
                onClick={() => copyText(extractedText, "extracted")}
                style={{
                  background: "none", border: "1px solid #334155",
                  color: copied === "extracted" ? "#4ade80" : "#94a3b8",
                  borderRadius: 6, padding: "4px 12px", fontSize: 12, cursor: "pointer",
                }}
              >
                {copied === "extracted" ? "복사됨 ✓" : "복사"}
              </button>
            </div>
            <textarea
              readOnly
              value={extractedText}
              style={{
                width: "100%", height: 180, background: "#0d1117",
                border: "1px solid #1e293b", borderRadius: 8,
                color: "#cbd5e1", fontSize: 12, padding: "12px 14px",
                resize: "vertical", fontFamily: "inherit", lineHeight: 1.6,
                boxSizing: "border-box",
              }}
            />

            {/* Prompt Type Selector */}
            <div style={{ display: "flex", gap: 8, marginTop: 16, marginBottom: 12, flexWrap: "wrap" }}>
              {[
                { key: "code-assist", label: "코드 자동완성/생성" },
                { key: "chat", label: "채팅 어시스트" },
                { key: "review", label: "코드 리뷰" },
              ].map(({ key, label }) => (
                <button
                  key={key}
                  onClick={() => setPromptType(key)}
                  style={{
                    background: promptType === key ? "#4c1d95" : "#1e293b",
                    border: `1px solid ${promptType === key ? "#7c3aed" : "#334155"}`,
                    color: promptType === key ? "#c4b5fd" : "#64748b",
                    borderRadius: 20, padding: "6px 14px", fontSize: 12, cursor: "pointer",
                    transition: "all 0.12s",
                  }}
                >
                  {label}
                </button>
              ))}
            </div>

            <button
              onClick={generatePrompt}
              disabled={promptLoading}
              style={{
                width: "100%", padding: "12px",
                background: promptLoading ? "#3b0764" : "linear-gradient(135deg, #6d28d9, #4c1d95)",
                border: "none", borderRadius: 8, color: "#e9d5ff",
                fontSize: 14, fontWeight: 600, cursor: promptLoading ? "not-allowed" : "pointer",
                fontFamily: "inherit",
              }}
            >
              {promptLoading ? "⟳ 프롬프트 생성 중..." : "✦ LLM 프롬프트 생성"}
            </button>
          </div>
        )}

        {/* Generated Prompt */}
        {prompt && (
          <div>
            <div style={{
              display: "flex", justifyContent: "space-between", alignItems: "center",
              marginBottom: 8,
            }}>
              <span style={{ fontSize: 12, color: "#64748b", textTransform: "uppercase", letterSpacing: "0.1em" }}>
                생성된 시스템 프롬프트
              </span>
              <button
                onClick={() => copyText(prompt, "prompt")}
                style={{
                  background: "none", border: "1px solid #4c1d95",
                  color: copied === "prompt" ? "#4ade80" : "#a78bfa",
                  borderRadius: 6, padding: "4px 12px", fontSize: 12, cursor: "pointer",
                }}
              >
                {copied === "prompt" ? "복사됨 ✓" : "복사"}
              </button>
            </div>
            <div style={{
              background: "#0d1117", border: "1px solid #4c1d95",
              borderRadius: 8, padding: "16px", fontSize: 13,
              color: "#e2e8f0", lineHeight: 1.75, whiteSpace: "pre-wrap",
              minHeight: 120,
            }}>
              {prompt}
            </div>
          </div>
        )}
      </div>
    </div>
  );
}
