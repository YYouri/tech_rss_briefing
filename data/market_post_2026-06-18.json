  "content_html": "<div style=\"font-family:'Noto Sans KR','Malgun Gothic',Apple SD Gothic Neo,sans-serif;max-width:720px;margin:0 auto;color:#1a1a1a;word-break:keep-all;background:#ffffff;padding:4px;\"><div style=\"background:#f4f6f9;border-radius:12px;padding:20px;margin-bottom:1.8em;border:1px solid #e4e9f0;\"><div style=\"display:flex;align-items:center;justify-content:space-between;margin-bottom:16px;\"><div style=\"display:flex;align-items:center;gap:8px;\"><span style=\"display:inline-block;width:4px;height:18px;background:#1261c4;border-radius:2px;\"></span><span style=\"font-size:0.95em;font-weight:700;color:#1a1a1a;\">미국 증시 시세</span></div><span style=\"font-size:0.72em;color:#9ea7b4;\">2026.06.18 07:55 KST 기준</span></div><div style=\"font-size:0.72em;font-weight:600;color:#666e7a;margin-bottom:8px;letter-spacing:0.5px;\">주요 지수</div><div style=\"display:flex;flex-wrap:wrap;gap:8px;margin-bottom:18px;\"><div style=\"background:#ffffff;border:1px solid #e4e9f0;border-radius:8px;padding:14px 16px;flex:1;min-width:110px;text-align:center;\"><div style=\"font-size:0.75em;color:#666e7a;margin-bottom:6px;font-weight:500;\">나스닥</div><div style=\"font-size:1.22em;font-weight:700;color:#1a1a1a;font-variant-numeric:tabular-nums;\">26,021.66</div><div style=\"display:inline-flex;align-items:center;gap:4px;margin-top:5px;padding:3px 8px;background:#f0f4ff;border-radius:4px;\"><span style=\"font-size:0.78em;font-weight:700;color:#1261c4;\">▼ 2.48%</span></div></div><div style=\"background:#ffffff;border:1px solid #e4e9f0;border-radius:8px;padding:14px 16px;flex:1;min-width:110px;text-align:center;\"><div style=\"font-size:0.75em;color:#666e7a;margin-bottom:6px;font-weight:500;\">S&P500</div><div style=\"font-size:1.22em;font-weight:700;color:#1a1a1a;font-variant-numeric:tabular-nums;\">7,420.10</div><div style=\"display:inline-flex;align-items:center;gap:4px;margin-top:5px;padding:3px 8px;background:#f0f4ff;border-radius:4px;\"><span style=\"font-size:0.78em;font-weight