function containsCi(str, keyword) { return str.toLowerCase().indexOf(keyword.toLowerCase()) !== -1; }
function basenameOf(p) { var parts = p.split("/"); return parts[parts.length - 1]; }
function parseToRows(rawText) {
  var rows = [];
  var lines = rawText.split(/\r\n|\n|\r/);
  for (var i = 0; i < lines.length; i++) {
    var line = lines[i].replace(/\r/g, "");
    if (line.trim() === "" || line.trim().indexOf("#") === 0) continue;
