package jef.application.channel.gateway.servlet;

import java.util.Enumeration;
import java.util.Properties;

import org.springframework.web.context.ContextLoaderListener;
import org.springframework.web.context.WebApplicationContext;

import jef.foundation.afc.locator.EnvLocator;
import jef.foundation.logging.ConsoleLogger;

/**
 * JEF Application Context을 초기화한다
 * @author NCIS05
 *
 */
public class JEFSpringContextListener extends ContextLoaderListener {

	public JEFSpringContextListener() {
		super();
		loadServerInformation();
	}

	public JEFSpringContextListener(WebApplicationContext context) {
		super(context);
		loadServerInformation();
	}

	@SuppressWarnings("rawtypes")
	private void loadServerInformation() {

		try {
			ConsoleLogger.info("Server information loading start.");

			EnvLocator.loadServerInfo(false);
			
			String instanceName = System.getProperty("bxm.instance.name");
			if (instanceName == null || "".equals(instanceName)) {
				System.setProperty("bxm.instance.name", EnvLocator.getServerName());
			}
			
			StringBuilder sb = new StringBuilder();
			sb.append("domain name=").append(EnvLocator.getDomainName()).append("\n");
			sb.append("cluster name=").append(EnvLocator.getClusterName()).append("\n");
			sb.append("server name=").append(EnvLocator.getServerName()).append("\n");
			sb.append("listen port=").append(EnvLocator.getListenPort());

			ConsoleLogger.info("Server Information\n" + sb.toString());

			StringBuilder builder = new StringBuilder();
			Properties props = System.getProperties();
			String key = null;
			String value = null;
			for (Enumeration e = props.keys(); e.hasMoreElements();) {
				key = (String) e.nextElement();
				value = (String) props.get(key);
				builder.append(key).append("=").append(value).append("\n");
			}
			ConsoleLogger.info("Java System Properties\n" + builder.toString());

			ConsoleLogger.info("Server information loading finish.");
		} catch (Exception e) {
			ConsoleLogger.error("Cannot loading Server information.", e);
		}
	}

}



