@SpringBootApplication(
		scanBasePackages = {"jef", "bxm", "hi.example"},
		exclude = {
				org.springframework.boot.autoconfigure.jdbc.DataSourceAutoConfiguration.class,
				DataSourceAutoConfiguration.class,
				DataSourceTransactionManagerAutoConfiguration.class,
				HibernateJpaAutoConfiguration.class,
				JdbcTemplateAutoConfiguration.class
				// DispatcherServletAutoConfiguration은 절대 exclude 하지 마세요!
		}
		)
@ImportResource({
	"classpath:context-application.xml",
	"classpath:context-interceptor.xml",
	"classpath:context-servlet.xml"
})
public class JefBootTestApplication {
	public static void main(String[] args) {
		SpringApplication.run(JefBootTestApplication.class, args);
	}
}

1. context-application.xml
<?xml version="1.0" encoding="UTF-8"?>
<beans xmlns:xsi="http://www.w3.org/2001/XMLSchema-instance" 
	xmlns="http://www.springframework.org/schema/beans"
	xmlns:context="http://www.springframework.org/schema/context"
	xmlns:mvc="http://www.springframework.org/schema/mvc"
	xsi:schemaLocation="http://www.springframework.org/schema/beans http://www.springframework.org/schema/beans/spring-beans.xsd
					http://www.springframework.org/schema/context http://www.springframework.org/schema/context/spring-context.xsd
					http://www.springframework.org/schema/mvc http://www.springframework.org/schema/mvc/spring-mvc.xsd">

	<import resource="context-interceptor.xml" />
	
	<context:component-scan	base-package="hi.example" />
	
	<mvc:annotation-driven />

	<!-- Gateway -->
	<bean id="gateway" class="jef.application.channel.gateway.servlet.ServletGateway" abstract="true">
		<property name="gatewayType" value="SERVLET" />
		<property name="msgCharset" value="UTF-8" />
	</bean>
	<bean id="xInternetGateway" class="jef.application.channel.gateway.servlet.ServletGateway" parent="gateway">
		<property name="channelType" value="XINTERNET" />
		<property name="e2eLayerName" value="GW_XINTERNET" />
		<property name="msgConverter" ref="xInternetHttpMessageConverter" />
		<property name="interceptorChain" value="basicChain" />
	</bean>
	<bean id="websquareGateway" class="jef.application.channel.gateway.servlet.ServletGateway" parent="gateway">
		<property name="channelType" value="XINTERNET" />
		<property name="e2eLayerName" value="GW_XINTERNET" />
		<property name="msgConverter" ref="websquareHttpMessageConverter" />
		<property name="interceptorChain" value="basicChain" />
	</bean>
	<bean id="internalGateway" class="jef.application.channel.gateway.servlet.ServletGateway" parent="gateway">
		<property name="channelType" value="INTERNAL" />
		<property name="e2eLayerName" value="GW_INTERNAL" />
		<property name="msgConverter" ref="internalHttpMessageConverter" />
		<property name="msgCharset" value="EUC-KR" />
		<property name="interceptorChain" value="channelChain" />
	</bean>
	<bean id="objectGateway" class="jef.application.channel.gateway.servlet.ServletGateway" parent="gateway">
		<property name="channelType" value="XINTERNET" />
		<property name="e2eLayerName" value="GW_XINTERNET" />
		<property name="msgConverter" ref="objectHttpMessageConverter" />
		<property name="interceptorChain" value="objectChain" />
	</bean>
	<bean id="pojoGateway" class="jef.application.channel.gateway.pojo.PojoServiceGateway" parent="gateway">
		<property name="channelType" value="POJO" />
		<property name="e2eLayerName" value="GW_POJO" />
		<property name="msgConverter" ref="pojoServiceMessageConverter" />
		<property name="interceptorChain" value="pojoChain" />
	</bean>
	<bean id="fileDownloadGateway" class="jef.application.channel.gateway.servlet.ServletNonServiceGateway" parent="gateway">
		<property name="channelType" value="FILEDOWNLOAD" />
		<property name="e2eLayerName" value="GW_FILEDOWNLOAD"/>
		<property name="msgConverter" ref="dummyServletConverter" />
		<property name="interceptorChain" value="fileDownloadChain" />
	</bean>
	<bean id="externalGateway" class="jef.application.channel.gateway.servlet.ServletGateway" parent="gateway">
		<property name="channelType" value="EXTERNAL" />
		<property name="e2eLayerName" value="GW_EXTERNAL"/>
		<property name="msgConverter" ref="externalHttpMessageConverter" />
		<property name="msgCharset" value="EUC-KR" />
		<property name="interceptorChain" value="channelChain" />
	</bean>
	<bean id="externalSoapGateway" class="jef.application.channel.gateway.servlet.ServletGateway" parent="gateway">
		<property name="channelType" value="EXTERNAL" />
		<property name="e2eLayerName" value="GW_EXTERNAL"/>
		<property name="msgConverter" ref="externalSoapMessageConverter" />
		<property name="msgCharset" value="EUC-KR" />
		<property name="interceptorChain" value="channelChain" />
	</bean>
	
	<!-- Converter -->
	<bean id="xInternetHttpMessageConverter" class="jef.application.channel.converter.XInternetHttpMessageConverter" />
	
	<bean id="internalHttpMessageConverter" class="jef.application.channel.converter.InternalHttpMessageConverter" />
	<bean id="internalMessageConverter"	class="jef.application.channel.converter.InternalMessageConverter" />
	
	<bean id="externalSoapMessageConverter" class="jef.application.channel.converter.ExternalSoapMessageConverter" />
	<bean id="externalHttpMessageConverter" class="jef.application.channel.converter.ExternalHttpMessageConverter" />
	<bean id="externalMessageConverter"	class="jef.application.channel.converter.ExternalMessageConverter" />
	
	<bean id="websquareHttpMessageConverter" class="jef.application.channel.converter.WebSquareHttpMessageConverter" />
	<bean id="objectHttpMessageConverter" class="jef.application.channel.converter.ObjectHttpMessageConverter" />
	<bean id="pojoServiceMessageConverter"	class="jef.application.channel.converter.PojoServiceMessageConverter" />
	<bean id="dummyServletConverter"	class="jef.application.channel.converter.HttpServletDummyConverter" />
	
	<!-- ApplicationContextUtil -->
	<bean id="applicationContextUtils" class="jef.foundation.bxm.util.SystemApplicationContextUtils" />
	<bean id="newE2EBizClient" class="jef.foundation.ne2e.config.NewE2EBizClient" />

	<bean id="antPathMatcher" class="org.springframework.util.AntPathMatcher"/>

	<!-- RuleEngine Timestamp Check -->
	<!-- bean id="ruleTimestampCheck" class="jef.application.resource.imdg.util.rule.RuleTimestampService">
		<property name="checkInterval" value="1000" />
	</bean-->

</beans>
