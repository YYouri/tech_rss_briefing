/* ============================================================
   app-theme.css
   - menu.jsp / menu.html이 반드시 이 파일 하나만 링크해서 씁니다.
   - 여기 있는 값이 두 화면 모두에 동시 적용되는 "단일 소스"입니다.
   - 각 파일 안에 <style> 로 새로 색상/네브바 스타일을 만들지 마세요.
   ============================================================ */

:root {
  --bg: #fafafa;
  --card: #ffffff;
  --border: #e4e4e7;
  --border-strong: #d4d4d8;
  --text: #18181b;
  --text-muted: #71717a;
  --text-faint: #a1a1aa;
  --primary: #18181b;
  --primary-hover: #27272a;
  --danger: #dc2626;
  --danger-bg: #fef2f2;
  --danger-border: #fecaca;
  --success: #16a34a;
  --info-bg: #f4f4f5;
  --radius-lg: 10px;
  --radius-md: 6px;
  --radius-pill: 999px;
}

body {
  background-color: var(--bg);
  font-family: -apple-system, BlinkMacSystemFont, "Segoe UI", "Malgun Gothic", Roboto, Helvetica, Arial, sans-serif;
  color: var(--text);
  margin: 0;
}

/* ------------------------------------------------------------
   메뉴바 (navbar)
   ------------------------------------------------------------ */
#menuItem { padding: 0; margin: 0; }

.custom-navbar {
  background-color: var(--card) !important;
  border-bottom: 1px solid var(--border);
  padding: 0 16px !important;
  display: flex;
  align-items: center;
  height: 56px;
  min-height: 56px;
  max-height: 56px;
  box-sizing: border-box;
  overflow: visible !important;
}

#menuItem,
.custom-navbar,
.custom-navbar .collapse.navbar-collapse,
.custom-navbar .navbar-nav {
  overflow: visible !important; /* 드롭다운 패널이 잘리지 않도록 체인 전체에 명시 */
}

/* 레거시 화면에 남아있기 쉬운 잔재 태그/유틸리티 클래스를 네브바 안에서는 전부 무력화
   (font 태그, mt-5, float-right 등 - 이런 게 남아있어도 높이에 영향을 주지 않도록 방어) */
.custom-navbar * {
  box-sizing: border-box;
  line-height: 1.2;
}
.custom-navbar font { font: inherit; color: inherit; vertical-align: middle; }
.custom-navbar [class*="mt-"],
.custom-navbar [class*="mb-"],
.custom-navbar [class*="pt-"],
.custom-navbar [class*="pb-"] {
  margin-top: 0 !important;
  margin-bottom: 0 !important;
  padding-top: 0 !important;
  padding-bottom: 0 !important;
}
.custom-navbar .float-right,
.custom-navbar .float-left {
  float: none !important;
}
.custom-navbar > .navbar-toggler {
  display: none !important; /* 데스크톱 전용 화면이므로 토글 버튼은 항상 숨김 - 높이에 관여 못하게 */
}
.custom-navbar .collapse.navbar-collapse {
  display: flex !important;
  align-items: center;
  height: 100%;
}
.custom-navbar .navbar-nav {
  flex-direction: row;
  align-items: center;
  height: 100%;
  margin: 0;
}
.custom-navbar .nav-item {
  position: relative;
  display: flex;
  align-items: center;
  height: 100%;
}
.custom-navbar .navbar-brand {
  font-size: 16px;
  font-weight: 600;
  color: var(--text) !important;
  text-decoration: none;
}
.custom-navbar .nav-link {
  color: var(--text-muted) !important;
  font-size: 14px;
  font-weight: 500;
  padding: 8px 12px !important;
  transition: color 0.15s ease;
  display: flex;
  align-items: center;
}
.custom-navbar .nav-link i {
  margin-right: 6px;
  font-size: 13px;
  color: var(--text-faint);
  width: 15px;
  text-align: center;
}
.custom-navbar .nav-link:hover { color: var(--text) !important; }
.custom-navbar .nav-link:hover i { color: var(--text); }
.custom-navbar .nav-link.active { color: var(--text) !important; font-weight: 600; }

.custom-navbar .dropdown-menu {
  display: none;
  position: absolute !important;
  top: 100% !important;
  left: 0 !important;
  z-index: 3000 !important;
  min-width: 200px;
  background-color: var(--card);
  border: 1px solid var(--border);
  border-radius: var(--radius-md);
  box-shadow: 0 4px 6px -1px rgba(0,0,0,0.1), 0 2px 4px -1px rgba(0,0,0,0.06);
  padding: 4px;
  margin-top: 5px !important;
}
.custom-navbar .dropdown-menu.show {
  display: block !important;
}
.custom-navbar .dropdown-item {
  font-size: 14px;
  color: var(--text-muted);
  padding: 6px 12px;
  border-radius: 4px;
  display: flex;
  align-items: center;
}
.custom-navbar .dropdown-item i {
  width: 16px;
  margin-right: 8px;
  text-align: center;
  font-size: 13px;
}
.custom-navbar .dropdown-item:hover { background-color: var(--info-bg); color: var(--text); }
.custom-navbar .dropdown-header {
  font-size: 12px; font-weight: 600; color: var(--text-faint);
  text-transform: uppercase; letter-spacing: 0.05em; padding: 8px 12px;
}
.custom-navbar .dropdown-divider { height: 1px; background-color: var(--border); margin: 4px 0; }

.custom-navbar .btn-action {
  background-color: var(--primary) !important;
  color: #ffffff !important;
  border: none;
  border-radius: var(--radius-md);
  font-size: 13px;
  font-weight: 500;
  padding: 6px 14px;
  transition: opacity 0.15s;
}
.custom-navbar .btn-action:hover { opacity: 0.9; }
.custom-navbar .navbar-user { color: var(--text-muted); font-size: 13px; margin-right: 10px; }
.custom-navbar .ml-auto,
.custom-navbar .float-right {
  margin-left: auto !important;
  display: flex !important;
  align-items: center;
  height: 100%;
}

/* ------------------------------------------------------------
   헤더-본문 간격 규칙 (핵심)
   - #menuItem은 <header id="header"> 안쪽(포함된 요소)이라, "#menuItem 다음 형제"로는
     본문(#pageWrap, #app 등 - 이건 <header>의 형제)에 절대 안 걸립니다. (이전 버전의 버그)
   - 그래서 이 방식 대신, 본문 컨테이너 자체에 padding-top: 40px를 직접 주는 것으로 통일합니다.
   - 새 화면을 만들 때도 본문 최상위 wrapper(#app, #pageWrap 등)에
     "padding: 40px 24px 80px;" 를 그대로 적용하면 항상 동일한 간격이 나옵니다.
   ------------------------------------------------------------ */

/* 구버전 화면에 남아있는 <hr> 구분선은 더 이상 쓰지 않음 (네브바 자체 border-bottom으로 대체) */
#menuItem hr,
#menuItem + hr {
  display: none;
}
