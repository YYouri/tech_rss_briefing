#!/bin/bash
# ==================================================
# cleanup_cron.sh
# 미사용 자원 정리 - 크론 자동 실행 스크립트
#
# 사용법:
#   ./cleanup_cron.sh              # 오늘 날짜 폴더 아래 모든 TASK_ID 처리
#   ./cleanup_cron.sh <TASK_ID>    # 오늘 날짜 폴더 아래 지정한 TASK_ID 하나만 처리
#
#   크론 등록 예:
#   0 2 * * * /Appl/IDES/PmsDeploy/cleanup_cron.sh >> /Logs/IDES/PMS/CIS_RM/cron/cron_$(date +\%Y\%m\%d).log 2>&1
#
# 전제 (작업자가 미리 이 구조로 파일을 둔다): (위 5개 중 존재하는 파일만 해당 서버군/로컬 실행)
#   REQUEST_DIR/YYYY/MM/DD/TASK_ID/TASK_ID_online.txt
#   REQUEST_DIR/YYYY/MM/DD/TASK_ID/TASK_ID_batch.txt
#   REQUEST_DIR/YYYY/MM/DD/TASK_ID/TASK_ID_coweb.txt
#   REQUEST_DIR/YYYY/MM/DD/TASK_ID/TASK_ID_dpweb.txt
#   REQUEST_DIR/YYYY/MM/DD/TASK_ID/TASK_ID_local.txt
#   
# 안전장치:
#   - 동시 실행 방지 (PID 파일 기반)
#   - 이미 처리한 TASK_ID는 재실행하지 않음 (.processed 마커 파일)
#   - 로그 파일명에 실행 타임스탬프가 붙어서, 같은 TASK_ID를 재시도해도
#     이전 로그를 덮어쓰지 않고 별도 파일로 남음
# ==================================================

set -euo pipefail

# ==================================================
# [설정 구역] 환경이 바뀌면 이 블록만 수정하면 된다
# ==================================================
WORK_DIR="/Appl/IDES/PmsDeploy"
ANT_HOME="/Appl/IDES/apache-ant-1.7.1/bin"
JAVA_HOME="/Product/java/jdk1.8.0_271"

export JAVA_HOME
export PATH="$JAVA_HOME/bin:$PATH"

LANG=ko_KR.EUC
export LANG

REQUEST_DIR="/DEPLOY/IDES/PMS/CIS_RM/TASK_ID"      # 작업의뢰 파일 루트 (이 아래 YYYY/MM/DD/TASK_ID 구조)
LOG_DIR="/Logs/IDES/PMS/CIS_RM"                 # 실행 로그가 쌓이는 폴더
BACKUP_ROOT="/DEPLOY/IDES/PMS/CIS_RM/BACK_UP"
BUILD_FILE="cleanup_build.xml"
PID_FILE="/tmp/cleanup_cron.pid"
ADMIN_EMAIL="IB1117@himsg.com"            		# TASK_ID_email.txt 없을 때 받을 관리자 이메일

# 서버군 이름 -> Ant 타겟 이름 매핑 (local은 SSH 없이 별도 함수로 처리하므로 여기 없음)
declare -A TARGET_MAP=(
  [online]="cleanup.legacy.resources.online"
  [batch]="cleanup.legacy.resources.batch"
  [coweb]="cleanup.legacy.resources.coweb"
  [dpweb]="cleanup.legacy.resources.dpweb"
)
# ==================================================
# [설정 구역 끝]
# ==================================================

# --------------------------------------------------
# [로컬 정리 함수] SSH 없이, 이 스크립트가 실행되는 서버 자체의 자원을 정리
#   TASK_ID_local.txt 가 있을 때만 호출됨
#   subshell( ) 로 정의해서 set -e 가 걸려있어도 ls/mv 실패 시 스크립트 전체가
#   죽지 않고, 실패 여부만 로그에 [FAIL]/[SUCCESS]로 남도록 격리함
#   ※ 헤더는 반드시 cleanup_build.xml 의 echo 헤더(SERVER:)와 동일한 표기를 써야
#     아래 HOST_BREAKDOWN 집계 정규식에 걸린다 (한글/영문 표기 불일치 주의)
# --------------------------------------------------
do_cleanup_local() (
  set +e
  local_request_file="$1"; task_id="$2"; backup_root="$3"; combined_log="$4"
  host_label="LOCAL_$(hostname)"
  backup_dir="${backup_root}/${task_id}/${host_label}"
  
  SUCCESS=0        # [추가] 성공 카운트 초기화
  FAIL=0           # [추가] 실패 카운트 초기화
  SKIPPED=0           # [추가] 실패 카운트 초기화
  {
    echo ""
    echo "===== SERVER: ${host_label} ====="
    echo "1. Pre-Check"
    while IFS= read -r p || [ -n "$p" ]; do
      p=$(printf '%s\n' "$p" | sed 's/[ \t\r]*$//'); [ -z "$p" ] && continue
      ls -l "$p" 2>&1
    done < "$local_request_file"
    echo "2. Move Result"
    while IFS= read -r p || [ -n "$p" ]; do
      p=$(printf '%s\n' "$p" | sed 's/[ \t\r]*$//'); [ -z "$p" ] && continue
      if [ -f "$p" ]; then
        mkdir -p "$backup_dir$(dirname "$p")"
        mv "$p" "$backup_dir$p"
        if [ -f "$p" ]; then 
			echo "mv $p -> $backup_dir$p [FAIL]"
			FAIL=$((FAIL + 1))      # [추가] 이동 실패 카운트
        else echo "mv $p -> $backup_dir$p [SUCCESS]"; 
			SUCCESS=$((SUCCESS + 1)) # [추가] 이동 성공 카운트
		fi
      else
        echo "mv $p -> (SKIPPED: NO PAGE)"
		SKIPPED=$((SKIPPED + 1))          # [추가] 파일 없음(SKIP) 카운트
      fi
    done < "$local_request_file"
	echo "===== SUMMARY: SUCCESS=$SUCCESS FAIL=$FAIL SKIPPED=$SKIPPED" # [추가]
    echo "3. Post Check"
    while IFS= read -r p || [ -n "$p" ]; do
      p=$(printf '%s\n' "$p" | sed 's/[ \t\r]*$//'); [ -z "$p" ] && continue
      ls -l "$p" 2>&1
    done < "$local_request_file"
    mkdir -p "$backup_dir"
    cp "$local_request_file" "$backup_dir/request_list.txt"
  } >> "$combined_log"
  exit 0
)

# --------------------------------------------------
# [파라미터 처리] 인자로 TASK_ID를 주면 오늘 날짜 폴더 중 그 하나만 처리
# --------------------------------------------------
TASK_ID_PARAM="${1:-}"

cd "$WORK_DIR" || { echo "[에러] $WORK_DIR 로 이동 실패"; exit 1; }

# --------------------------------------------------
# [0] 동시 실행 방지 (PID 파일 기반)
# --------------------------------------------------
if [ -f "$PID_FILE" ]; then
  OLD_PID=$(cat "$PID_FILE")
  if kill -0 "$OLD_PID" 2>/dev/null; then
    echo "[건너뜀] 이전 실행이 아직 진행 중입니다. (PID: $OLD_PID)"
    exit 0
  else
    echo "[정보] 이전 PID($OLD_PID)는 이미 종료됨. 잔재 PID 파일 정리 후 진행."
  fi
fi
echo $$ > "$PID_FILE"
trap 'rm -f "$PID_FILE"' EXIT

TODAY_Y=$(date +%Y)
TODAY_M=$(date +%m)
TODAY_D=$(date +%d)
TODAY_STAMP="${TODAY_Y}${TODAY_M}${TODAY_D}"
TODAY_DIR="${REQUEST_DIR}/${TODAY_Y}/${TODAY_M}/${TODAY_D}"

# 이 스크립트 한 번 실행 전체에 붙는 타임스탬프 (로그 파일명 충돌/덮어쓰기 방지용)
RUN_TIMESTAMP=$(date +%Y%m%d_%H%M%S)

mkdir -p "$LOG_DIR"
CRON_LOG_DIR="${LOG_DIR}/cron"
mkdir -p "$CRON_LOG_DIR"

RUN_TIME=$(date '+%Y-%m-%d %H:%M:%S')

echo "=================================================="
echo " 실행 시각      : $RUN_TIME"
echo " 실행 태그      : $RUN_TIMESTAMP"
echo " 대상 날짜 폴더  : $TODAY_DIR"
[ -n "$TASK_ID_PARAM" ] && echo " 지정 TASK_ID   : $TASK_ID_PARAM (이 작업만 처리)"
echo "=================================================="

# --------------------------------------------------
# [1] 처리할 TASK_ID 폴더 목록 구성
#     파라미터가 있으면 그 폴더 하나만, 없으면 오늘 폴더 아래 전체
# --------------------------------------------------
declare -a TASK_DIR_LIST=()

if [ -n "$TASK_ID_PARAM" ]; then
  SINGLE_TASK_DIR="${TODAY_DIR}/${TASK_ID_PARAM}"
  if [ ! -d "$SINGLE_TASK_DIR" ]; then
    echo "[에러] 지정한 작업 폴더를 찾을 수 없습니다: $SINGLE_TASK_DIR"
    exit 1
  fi
  TASK_DIR_LIST=("${SINGLE_TASK_DIR}/")
else
  if [ ! -d "$TODAY_DIR" ]; then
    echo "[정보] 오늘 처리할 작업의뢰 폴더가 없습니다. 종료합니다."
    exit 0
  fi
  TASK_DIR_LIST=("$TODAY_DIR"/*/)
fi

if [ ! -d "${TASK_DIR_LIST[0]}" ]; then
  echo "[정보] 오늘 폴더는 있지만 처리할 TASK_ID가 하나도 없습니다."
  exit 0
fi
# --------------------------------------------------
# [2] TASK_ID 폴더 순회 처리
# --------------------------------------------------
PROCESSED_COUNT=0
SKIPPED_COUNT=0
FAILED_COUNT=0

declare -a TASK_RESULT_LINES=()
declare -a FAILED_TASK_LINES=()

for TASK_DIR in "${TASK_DIR_LIST[@]}"; do
  [ -d "$TASK_DIR" ] || continue

  TASK_ID=$(basename "$TASK_DIR")
  MARKER_FILE="${TASK_DIR}.processed"
  COMBINED_LOG="${LOG_DIR}/${TASK_ID}_${RUN_TIMESTAMP}.log"

  # 이미 처리 완료된 작업이면 건너뜀 (같은 날 크론이 여러 번 돌아도 중복 실행 안 되게)
  if [ -f "$MARKER_FILE" ]; then
    echo "[건너뜀] $TASK_ID (이미 처리됨: $MARKER_FILE)"
    SKIPPED_COUNT=$((SKIPPED_COUNT + 1))
    continue
  fi

  echo "--------------------------------------------------"
  echo "[시작] TASK_ID = $TASK_ID"

  # 이 TASK_ID에 대해 online/batch/coweb/dpweb/local 중 존재하는 파일 확인
  FOUND_ANY="false"
  for TYPE in "${!TARGET_MAP[@]}"; do
    REQUEST_FILE="${TASK_DIR}${TASK_ID}_${TYPE}.txt"
    [ -f "$REQUEST_FILE" ] && FOUND_ANY="true"
  done
  [ -f "${TASK_DIR}${TASK_ID}_local.txt" ] && FOUND_ANY="true"

  if [ "$FOUND_ANY" = "false" ]; then
    echo "[경고] $TASK_ID 폴더에 _online/_batch/_coweb/_dpweb/_local.txt 파일이 하나도 없습니다. 건너뜁니다."
    SKIPPED_COUNT=$((SKIPPED_COUNT + 1))
    continue
  fi

  # 이전 로그 잔재 있으면 초기화 (파일명 자체가 타임스탬프로 구분되니 사실상
  # 매번 새 파일이지만, 방어적으로 유지)
  > "$COMBINED_LOG"

  TASK_FAILED="false"

  for TYPE in "${!TARGET_MAP[@]}"; do
    REQUEST_FILE="${TASK_DIR}${TASK_ID}_${TYPE}.txt"
    [ -f "$REQUEST_FILE" ] || continue

    TARGET_NAME="${TARGET_MAP[$TYPE]}"

    echo "  [진행] $TYPE 서버군 실행 중... (target=$TARGET_NAME)"

    if "$ANT_HOME/ant"  -quiet -f "$BUILD_FILE" -lib lib:classes "$TARGET_NAME" \
        -Dtask_id="$TASK_ID" \
        -Ddryrun="false" \
        -Drequest_file="$REQUEST_FILE" \
        -Dlog_dir="$LOG_DIR" \
        -Dcombined_log="$COMBINED_LOG" \
        -Dbackup_root="$BACKUP_ROOT" \
        -Dverbose=false \
        >> "$COMBINED_LOG" 2>&1
    then
      echo "  [완료] $TYPE"
    else
      echo "  [에러] $TYPE 실행 실패. 로그 확인: $COMBINED_LOG"
      TASK_FAILED="true"
    fi
  done

  LOCAL_REQUEST_FILE="${TASK_DIR}${TASK_ID}_local.txt"
  if [ -f "$LOCAL_REQUEST_FILE" ]; then
    echo "  [진행] local 자원 정리 실행 중..."
    do_cleanup_local "$LOCAL_REQUEST_FILE" "$TASK_ID" "$BACKUP_ROOT" "$COMBINED_LOG"
    echo "  [완료] local"
  fi

  # --------------------------------------------------
  # 이 TASK_ID 결과 집계 (로그 포맷: mv 원본 -> 대상 [SUCCESS]/[FAIL], SKIPPED: NO PAGE)
  # --------------------------------------------------
  MOVED_COUNT=$(grep -c '^mv .*\[SUCCESS\]' "$COMBINED_LOG" 2>/dev/null || true)
  MOVE_FAIL_COUNT=$(grep -c '^mv .*\[FAIL\]' "$COMBINED_LOG" 2>/dev/null || true)
  NOTFOUND_COUNT=$(grep -c '^mv .*SKIPPED: NO PAGE' "$COMBINED_LOG" 2>/dev/null || true)

  echo "  [결과] 성공=$MOVED_COUNT  실패=$MOVE_FAIL_COUNT  원본없음=$NOTFOUND_COUNT"

  # --------------------------------------------------
  # 서버(호스트)별 성공/실패/원본없음 집계
  #   "===== SERVER: X =====" 헤더를 기준으로 구간을 나눠서 계산
  #   (do_cleanup_local, cleanup_build.xml 양쪽 헤더 표기가 반드시 SERVER: 로 동일해야 함)
  # --------------------------------------------------
  HOST_BREAKDOWN=$(awk '
    /^===== SERVER: / {
      if (server != "") {
        printf "   - %s : SUCCESS=%d, FAIL=%d, SKIPPED=%d\n", server, moved, fail, notfound
      }
      server = $3
      moved = 0; fail = 0; notfound = 0
      next
    }
    /^mv .*\[SUCCESS\]/       { moved++ }
    /^mv .*\[FAIL\]/          { fail++ }
    /^mv .*SKIPPED: NO PAGE/  { notfound++ }
    END {
      if (server != "") {
        printf "   - %s : SUCCESS=%d, FAIL=%d, SKIPPED=%d\n", server, moved, fail, notfound
      }
    }
  ' "$COMBINED_LOG" 2>/dev/null)
  [ -z "$HOST_BREAKDOWN" ] && HOST_BREAKDOWN="   (서버별 상세 없음)"

  # --------------------------------------------------
  # 이 TASK_ID 요청자 이메일 확인
  # --------------------------------------------------
  EMAIL_FILE="${TASK_DIR}${TASK_ID}_email.txt"
  if [ -f "$EMAIL_FILE" ]; then
    TASK_EMAIL=$(head -n 1 "$EMAIL_FILE" | tr -d ' \t\r\n')
    [ -z "$TASK_EMAIL" ] && TASK_EMAIL="$ADMIN_EMAIL"
  else
    TASK_EMAIL="$ADMIN_EMAIL"
  fi

  if [ "$TASK_FAILED" = "true" ]; then
    echo "[실패] TASK_ID = $TASK_ID (마커 생성 안 함, 다음 크론에서 재시도됨)"
    FAILED_COUNT=$((FAILED_COUNT + 1))
	FAILED_TASK_LINES+=(" - ${TASK_ID} : Ant 빌드 실패 (로그: ${COMBINED_LOG})")
    TASK_RESULT_LINES+=(" - ${TASK_ID} : [실패] 빌드 에러")
	TASK_NOTIFY_TITLE="[운영_자원삭제] ${TASK_ID} 실패 - Ant 빌드 에러"
    TASK_NOTIFY_MSG="[운영_자원삭제] ${TASK_ID} 실패 - Ant 빌드 에러

로그 위치
 - 결과 로그 : ${COMBINED_LOG}

서버별 결과 (빌드 실패 전까지 처리된 부분만 반영됨)
${HOST_BREAKDOWN}"
    NOTIFY_TARGETS=("$TASK_EMAIL")
    [ "$TASK_EMAIL" != "$ADMIN_EMAIL" ] && NOTIFY_TARGETS+=("$ADMIN_EMAIL")
  else
    touch "$MARKER_FILE"
    echo "[완료] TASK_ID = $TASK_ID (마커 생성: $MARKER_FILE)"
    PROCESSED_COUNT=$((PROCESSED_COUNT + 1))
    TASK_RESULT_LINES+=(" - ${TASK_ID} : [완료] 성공=${MOVED_COUNT}건 실패=${MOVE_FAIL_COUNT}건 원본없음=${NOTFOUND_COUNT}건 (로그: ${COMBINED_LOG})")
    TASK_NOTIFY_TITLE="[운영_자원삭제] ${TASK_ID} 완료"
	TASK_NOTIFY_MSG="[운영_자원삭제] ${TASK_ID} 완료 - 성공=${MOVED_COUNT}건 실패=${MOVE_FAIL_COUNT}건 원본없음=${NOTFOUND_COUNT}건

로그 위치 : ${COMBINED_LOG}

서버별 결과
${HOST_BREAKDOWN}"
    NOTIFY_TARGETS=("$TASK_EMAIL")
  fi

  # --------------------------------------------------
  # TASK_ID별 알림 발송 (기존 pmsDeployErrAlert 타겟 재사용)
  # --------------------------------------------------
 

done

# --------------------------------------------------
# [3] 전체 실행 요약 (콘솔/크론 로그용)
# --------------------------------------------------
echo "=================================================="
echo " 전체 요약 : 처리완료=$PROCESSED_COUNT  건너뜀=$SKIPPED_COUNT  실패=$FAILED_COUNT"
echo "=================================================="

# --------------------------------------------------
# [4] 알림 메시지 파일 생성 (파일명에도 타임스탬프 반영 - 재실행 시 덮어쓰기 방지)
# --------------------------------------------------
NOTIFY_FILE="${CRON_LOG_DIR}/notify_${RUN_TIMESTAMP}.txt"

{
  if [ "$FAILED_COUNT" -gt 0 ]; then
    echo "[자원삭제] ${TODAY_Y}-${TODAY_M}-${TODAY_D} 실행 결과 - 실패 ${FAILED_COUNT}건 발생"
  else
    echo "[자원삭제] ${TODAY_Y}-${TODAY_M}-${TODAY_D} 실행 결과 - 전체 성공"
  fi
  echo ""
  echo "=================================================="
  echo " 실행 시각   : $RUN_TIME"
  echo " 대상 폴더   : $TODAY_DIR"
  [ -n "$TASK_ID_PARAM" ] && echo " 지정 TASK_ID : $TASK_ID_PARAM"
  echo "=================================================="
  echo " 처리완료 : ${PROCESSED_COUNT}건"
  echo " 건너뜀   : ${SKIPPED_COUNT}건"
  echo " 실패     : ${FAILED_COUNT}건"
  echo "=================================================="

  if [ "${#TASK_RESULT_LINES[@]}" -gt 0 ]; then
    echo "[작업별 상세]"
    for LINE in "${TASK_RESULT_LINES[@]}"; do
      echo "$LINE"
    done
    echo "=================================================="
  fi

  if [ "${#FAILED_TASK_LINES[@]}" -gt 0 ]; then
    echo "[실패 목록 - 확인 필요]"
    for LINE in "${FAILED_TASK_LINES[@]}"; do
      echo "$LINE"
    done
    echo "=================================================="
  fi

  echo " 크론 실행 로그 : ${CRON_LOG_DIR}/cron_${TODAY_STAMP}.log"
  echo "=================================================="
} > "$NOTIFY_FILE"

echo "[완료] 알림 메시지 생성됨: $NOTIFY_FILE"
cat "$NOTIFY_FILE"

if [ "$FAILED_COUNT" -gt 0 ]; then
  exit 2
fi

exit 0

