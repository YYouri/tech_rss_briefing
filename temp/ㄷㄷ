package hi.framework.deploymanager.resourceDown.service;

import java.io.File;
import java.util.ArrayList;
import java.util.Collections;
import java.util.List;
import java.util.Properties;
import java.util.UUID;

import javax.annotation.PostConstruct;

import org.apache.logging.log4j.LogManager;
import org.apache.logging.log4j.Logger;
import org.springframework.beans.factory.annotation.Autowired;
import org.springframework.core.io.support.PropertiesLoaderUtils;
import org.springframework.stereotype.Service;

import com.wbjsoft.lib.StFileInfo;

import hi.framework.deploymanager.image.dao.ProjectMngNoDao;
import hi.framework.deploymanager.resourceDown.entity.FileDTO;
import hi.framework.deploymanager.resourceDown.entity.TaskDTO;
import hi.framework.deploymanager.server.entity.DeployInfo;
import hi.framework.deploymanager.server.job.CommonSyncService;

@Service
public class DiffResourceService {
	private static final Logger logger = LogManager.getLogger(DiffResourceService.class);
	private static final String PROPERTIES_CLASSPATH = "server.properties"; 
	@Autowired
	private CommonSyncService commonSyncService;
	@Autowired
	private ProjectMngNoDao projectMngNoDao;
	
	private Properties props;
	@PostConstruct
	public void init() throws Exception {
		props = PropertiesLoaderUtils.loadAllProperties(PROPERTIES_CLASSPATH);
	}
	private String get(String key) {
		String v = props.getProperty(key);
		if (v == null) {
			throw new IllegalStateException("server.properties 에 " + key + " 값이 없습니다.");
		}
		return v;
	}
	private String resolveTmpCheckoutPath() {
		return get("deploy.checkout.path");
	}
	/** 삭제(자원정리) 작업을 백그라운드로 시작 (이 작업만의 로그인 -> 건건이 delete -> 이 작업만의 로그아웃) */
	protected String login(DeployInfo deployInfo) {
		String session = "";
		try {
			session = com.wbjsoft.module.softmanagerapi.LoginSession(deployInfo.getSoftmanager_ip(), deployInfo.getSoftmanager_port(), "frmadmin1", "admin1!@");
			
			if (session.equals("NONE")) {
				// logger.error("로그인되지 않았습니다.");
			}
			// logger.info("로그인 했습니다");
		} catch (Exception e) {
			e.printStackTrace();
		}
		return session;
	}

	protected void logout(String session) {
		try {
			if (com.wbjsoft.module.softmanagerapi.LogOutSession(session)) {
				// logger.error("연결을 종료합니다.");
			}
		} catch (Exception e) {
			e.printStackTrace();
		}
	}

	public List<TaskDTO> selectTasksByDate(String searchDate) throws Exception {
		try {
			List<TaskDTO> selectTasksByDate = projectMngNoDao.selectTasksByDate(searchDate);
			
			logger.info("[작업의뢰 조회 ] searchDate={} size={} ", searchDate, selectTasksByDate.size() );
			return selectTasksByDate;
		} catch (Exception e) {
			logger.error("[작업의뢰 조회 실패] searchDate={} 원인={} ", searchDate, e.getMessage(), e);
			return null;
		}
	}
	
	public List<FileDTO> selectFilesByDescr(String descr) throws Exception {
		logger.info("[형상자원 비교- 시작] taskId={} ", descr );
		List<FileDTO> fileList = new ArrayList<>();
		String token = null;
		try {
			DeployInfo deployInfo  = commonSyncService.getDeployInfo();
			if(deployInfo == null ) {
				throw new Exception("[형상자원-비교 실패] deployInfo is null..");
			}
			try {
				token = login(deployInfo); 
				if(token.equals("NONE")){
					throw new Exception("형상서버 연결 실패");
				}
				logger.info("[형상서버 연결 성공] "+deployInfo.getSoftmanager_ip());
			} catch (Exception loginError) {
				logger.error("[형상자원 비교- 실패] taskId={} 원인={}", descr, loginError.getMessage(), loginError);
			}
			// 1. 데이터 결과물을 담을 리스트
			// 2. 배포 마스터 정보 조회 (UPTDID와 USID 추출)
			String masterSql = "SELECT UPTDID, USID FROM softmanager.dbo.updatetd WHERE DESCR = '" + descr + "'";
			String[][] masterArray = com.wbjsoft.module.softmanagerapi.DBSelect(token, masterSql);

			// 데이터가 없는 경우 체크 (헤더 제외하고 데이터가 있는지 확인)
			if (masterArray == null || masterArray.length <= 2) {
				logger.error("[형상자원 비교- 실패] 배포 마스터 정보가 없습니다.");
			}
			logger.info("[형상자원 비교- 1.배포 마스터 정보 조회] taskId={} masterArray.length={}", descr ,masterArray.length);
			// 3. 마스터 데이터를 순회하며 상세/사용자 정보 매칭
			for (int i = 2; i < masterArray.length; i++) {
				String uptdid = masterArray[i][0];
				String usid = masterArray[i][1];

				// [STEP 1] 상세 정보 조회 (updatedtd)
				// 조건: DESTDIR NOT LIKE 'QA%' AND VERINDEX IS NOT NULL
				String detailSql = "SELECT DESTDIR, FILENAME, VERINDEX FROM softmanager.dbo.updatedtd "
						+ "WHERE UPTDID = '" + uptdid + "' "
						+ "AND DESTDIR NOT LIKE 'QA%' "
						+ "AND VERINDEX IS NOT NULL";
				String[][] detailArray = com.wbjsoft.module.softmanagerapi.DBSelect(token, detailSql);

				// 상세 데이터가 없으면 다음 마스터로 넘어감
				if (detailArray == null || detailArray.length <= 1) continue;
				logger.info("[형상자원 비교- 2.정보 매칭] taskId={} uptdid={} usid={}", descr, uptdid, usid);

				// [STEP 2] 사용자 정보 조회 (usermt)
				String userSql = "SELECT LOGINID, REALNAME FROM softmanager.dbo.usermt WHERE USID = '" + usid + "'";
				String[][] userArray = com.wbjsoft.module.softmanagerapi.DBSelect(token, userSql);

				// 사용자 정보가 없을 경우를 대비한 기본값
				String realName = ""; 
				if (userArray != null && userArray.length > 2) {
					realName = userArray[2][1]; // REALNAME 추출
				}
				// [STEP 3] 상세 데이터(파일 단위)를 순회하며 DTO 생성
				for (int j = 2; j < detailArray.length; j++) {
					String destDir = detailArray[j][0];
					String fileName = detailArray[j][1];
					String verIndex = detailArray[j][2];

					// 요청하신 생성자 호출: public FileDTO(String dirInfo, String fileName, String verIndex, String realName)
					FileDTO dto = new FileDTO(destDir, fileName, verIndex, realName);
					logger.info("[형상자원 비교- 3.상세 데이터] taskId={} destDir={} fileName={} verIndex={}", descr, destDir, fileName, verIndex);

					fileList.add(dto);
				}
			}

			if(fileList.size() >0 )
				Collections.sort(fileList, (a, b) -> a.getFileName().compareTo(b.getFileName()));

		} catch (Exception e) {
			logger.error("[형상자원 비교-실패] taskId={} 원인={}", descr, e.getMessage(), e);
			throw e;
		} finally {
			try {
				logout(token); 
			} catch (Exception logoutError) {
				logger.error("[형상자원 비교-실패] taskId={} 원인={}", descr, logoutError.getMessage(), logoutError);
			}
		}
		return fileList;
	}
	
	public String resolveCheckedOutPath(String dirInfoi, String fileName, String ver) throws Exception {
		
		String checkoutRootPath = resolveTmpCheckoutPath()+File.separator+UUID.randomUUID().toString();
		String checkedOutPath = "";
		logger.info("[형상자원 체크아웃] dirInfo={} fileName={} version={}", dirInfoi,fileName,ver );
		String token = null;
		String dirInfo = null;
		try {
			DeployInfo deployInfo  = commonSyncService.getDeployInfo();
			if(deployInfo == null ) {
				throw new Exception("[형상자원 체크아웃] deployInfo is null..");
			}
			try {
				token = login(deployInfo); 
				if(token.isEmpty() || token.equals("NONE")){
					throw new Exception("형상서버 연결 실패");
				}
			} catch (Exception loginError) {
				logger.error("[형상자원 체크아웃] 형상서버 Login 에러. 원인={}", loginError.getMessage(), loginError);
			}
			
			dirInfo = dirInfoi.replace("/", "\\");
			if(dirInfo.startsWith("\\")){
				dirInfo = dirInfo.substring(1);
			}
			if(!dirInfo.endsWith("\\")) {
				dirInfo = dirInfo+"\\";
			}
			StFileInfo cInfo = com.wbjsoft.module.softmanagerapi.GetFileInfo(token, dirInfo, fileName); 
			cInfo.setLASTVERINDEX(Integer.valueOf(ver)); //[파일버전인덱스] -1
			checkedOutPath = checkoutRootPath + dirInfo + fileName;
			cInfo.setLocalFileName(checkedOutPath);
			int checkOut = com.wbjsoft.module.softmanagerapi.CheckOutByFileInfo(token, cInfo);
			if(checkOut >= 0 && new File(checkedOutPath).exists()) {
				logger.info("[형상자원 체크아웃 성공] dirInfo={} fileName={} version={} checkedOutPath={}", dirInfo,fileName,ver, checkedOutPath );
			}else {
				logger.error("[형상자원 체크아웃 실패] dirInfo={} fileName={} version={} result={} checkedOutPath={}", dirInfo,fileName,ver, checkOut, checkedOutPath );
			}
		} catch (Exception e) {
			logger.error("[형상자원 체크아웃]  dirInfo={} fileName={} version={} 원인={}", dirInfo,fileName,ver, e.getMessage(), e);
			throw e;
		} finally {
			try {
				logout(token); 
			} catch (Exception logoutError) {
				logger.error("[형상자원 체크아웃] 형상서버 Logout 에러. 원인={}", logoutError.getMessage(), logoutError);
			}
		}
		return checkedOutPath;
	
	}


}



