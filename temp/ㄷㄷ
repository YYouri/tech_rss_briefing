<body>
	<header id="header"><jsp:include page="/bin/menu.jsp" flush="false"/></header>	
  	<div id="imagesAuthList" class="container-fluid" style="float:left;">
		<div class="container logSearchForm_Area">			
			<form id="logSearchForm">
				<input type="hidden" style="display:inline;" id="userId" name="userId" placeholder="" value="${userId}">
				<input type="hidden" style="display:inline;" id="interval" name="interval" placeholder="" value="${interval}">
				<div class="row">
					<div class="col-6 " style="vertical-align: middle;">
						<h5 class="card-title" >
							<%-- <span class='font-weight-bold'>통합배포 로그 조회 (성공 : ${resultTrueCount} / 실패 : ${resultFalseCount})</span> --%>
							<span class='font-weight-bold'>통합배포 로그 조회</span>
						</h5>
					</div>
					<div class="col-5" style="vertical-align: middle; text-align: right">
						<span>자동갱신 : </span>
			    		<select id="refreashInterval" name="refreashInterval" class=" btn btn-light btn-light-sm" >  
			      			<option value="9999999999999" <c:if test='${refreashInterval eq "9999999999999"}'>selected</c:if>>갱신안함</option>  
            				<option value="60000" <c:if test='${refreashInterval eq "60000"}'>selected</c:if>>1분</option>  
            				<option value="300000" <c:if test='${refreashInterval eq "300000"}'>selected</c:if>>5분</option>  
            				<option value="600000" <c:if test='${refreashInterval eq "600000"}'>selected</c:if>>10분</option>
			    		</select> 
					</div>
					<div class="col-1" style="vertical-align: right;">
						<button id="searchBtn" type="button" class="btn-md btn btn-primary" style="text-align:right; margin-left:5px; margin-bottom:5px; float:right;">검색</button> 
					</div>
				</div>
				<div class="row">
					<a id="back-to-top"></a>
					<table id="searchTable" class="table table-bordered text-center text-middle" style="width:100%; font-size:10pt; font-weight: bold; text-align: center; vertical-align:middle;">
		    			<tbody>
	      					<tr>
		        				<td style="width:15%; vertical-align:middle;">시스템명</td>        						
        						<td style="width:5%; vertical-align:middle;">
									<input type="text" class="form-control" style="width:70px; display:inline; font-size:12px;" id="sys_name" name="sys_name" placeholder="" value="${sys_name}">
								</td>
        						<td style="width:17%; vertical-align:middle;">작업의뢰번호</td>
        						<td style="width:3%; vertical-align:middle;">
									<input type="text" class="form-control" style="width:115px; display:inline; font-size:12px;" id=prj_mng_no name="prj_mng_no" placeholder="" value="${prj_mng_no}">        						
        						</td>	
        						<td style="width:17%; vertical-align:middle;">배포실행기능</td>
        						<td style="width:5%; vertical-align:middle;">
									<select id="shell" name="shell" style="width:140px; font-size:12px; text-align: left;" class="btn btn-light btn-light-sm">
  										<option value="" <c:if test='${shell eq ""}'>selected</c:if>>전체조회</option>
				  						<option value="pms.qa.all" <c:if test='${shell eq "pms.qa.all"}'>selected</c:if> >체크인 (pms.qa.all)</option>
  										<option value="pms.prod.compile" <c:if test='${shell eq "pms.prod.compile"}'>selected</c:if> >운영계 컴파일 (pms.prod.compile)</option>
  										<option value="pms.prod.checkin" <c:if test='${shell eq "pms.prod.checkin"}'>selected</c:if> >운영계 이행승인 (pms.prod.checkin)</option> 
  										<option value="pms.prod.scheduler" <c:if test='${shell eq "pms.prod.scheduler"}'>selected</c:if> >정기배포 (pms.prod.scheduler)</option>  
  										<option value="pms.prod.quick.deploy" <c:if test='${shell eq "pms.prod.quick.deploy"}'>selected</c:if> >긴급배포 (pms.prod.quick.deploy)</option> 
  										<option value="pms.prod.scheduler.quartz" <c:if test='${shell eq "pms.prod.scheduler.quartz"}'>selected</c:if> >운영계 스케줄 배포 (pms.prod.scheduler.quartz)</option>  	 
  										<option value="pms.staging.all" <c:if test='${shell eq "pms.staging.all"}'>selected</c:if> >배포 수집 (pms.staging.all)</option>  		 		  		
  										<option value="pms.img.qa.deploy" <c:if test='${shell eq "pms.img.qa.deploy"}'>selected</c:if> >검증계 이미지 배포 (pms.img.qa.deploy)</option> 		  		  		
  										<option value="pms.img.prod.deploy" <c:if test='${shell eq "pms.img.prod.deploy"}'>selected</c:if> >운영계 이미지 배포 (pms.img.prod.deploy)</option> 		  		  		
  										<option value="pms.checkout" <c:if test='${shell eq "pms.checkout"}'>selected</c:if> >운영계 체크아웃 (pms.checkout)</option> 				
  									</select>									
								</td>		
        						<td style="width:17%; vertical-align:middle;">로그생성일자</td>
        						<td style="width:10%; vertical-align:middle;">
									<input type="text" class="form-control" style="width:110px; display:inline; font-size:12px; text-align: center;" id="regDate" name="regDate" placeholder="연월일입력" value="${regDate}" maxlength="8" >
									<input type="hidden" class="form-control" style="width:100px; display:inline;" id="fileDirectory" name="fileDirectory" placeholder="" value="">
        						</td>		
        						<td style="width:14%; vertical-align:middle; padding-left:9px; padding-right:9px;">실행결과</td>
        						<td style="width:9%; vertical-align:middle;">
        							<select id="result" name="result" style="width:80px; font-size:15px; text-align: left;" class="btn btn-light btn-light-sm">
  										<option value="" <c:if test='${result eq ""}'>selected</c:if>>전체</option>
				  						<option value="TRUE" <c:if test='${result eq "TRUE"}'>selected</c:if> >성공</option>
  										<option value="FALSE" <c:if test='${result eq "FALSE"}'>selected</c:if> >실패</option>				
  									</select>
        						</td>
      						</tr>
      					</tbody>
    				</table>
				</div>
			</form>
			<div class="row">
				<table id="imageAuthTable" class="table table-bordered text-center" style="width:100%; font-size:12pt; font-weight: bold; vertical-align:middle;">
	    			<thead>
      					<tr style="padding-left:3px; padding-right:3px; font-size:11pt;">
      						<td style="width:3%; vertical-align:middle;">No</td>
	        				<th style="width:7%; height:25px;">시스템명</th>
        					<th style="width:10%; height:25px;">작업의뢰번호</th>
        					<th style="width:4%; height:25px; padding-left:2px; padding-right:2px;">차수</th>		
        					<th style="width:18%; height:25px;">배포실행기능</th>		
        					<th style="width:12%; height:25px;">로그생성시간</th>		
        					<th style="width:6%; height:25px; padding-left:3px; padding-right:3px;">실행결과</th>
        					<th style="width:11%; height:25px;">배포건수</th>	
        					<th style="width:15%; height:25px;">로그조회</th>
      					</tr>
    				</thead>
    				<tbody style="overflow: auto;">
    				<c:choose>
		      			<c:when test="${fileInfoListForMongo.size() == 0 }">
	      					<tr>
    							<td colspan="9">[ 조회 결과 없음 ]</td>
    						</tr>
	      				</c:when>
						<c:otherwise>
	    					<c:forEach var="item" items="${fileInfoListForMongo}" varStatus="status">
    							<fmt:parseDate var="dateString" value="${item.getRegDate()}" pattern="yyyyMMddHHmmss" />
    							<tr style=" font-size:10pt; font-size:10pt;">
									<td style="width:3%;  vertical-align:middle;">${status.index + 1}</td>
	    							<td style="width:7%; padding-top:1px; padding-bottom:1px; padding-left:1px; padding-right:1px; white-space: nowrap; vertical-align:middle; font-size:10pt;">
	    								${item.getSysname()}<br> (${item.getSys_code()})
	    							</td>
    								<td style="width:10%; padding-top:1px; padding-bottom:1px; padding-left:3px; padding-right:3px; vertical-align:middle; font-size:10pt;">${item.getPrj_mng_no()}</td>
    								<td style="width:4%;  vertical-align:middle;">${item.getSdlc_seq()}</td>
    								<td style="width:18%; padding-top:1px; padding-bottom:1px; padding-top:1px; padding-bottom:1px; padding-left:2px; padding-right:2px; vertical-align:middle; ">${item.getShell()}</td>
    								<%-- <td style="width:20%"><input id="regDate_${status.index}" class="form-control mr-sm-2 text-center" type="text" readonly value="${item.getRegDate()}" /> --%>
    								<td style="width:12%; padding-top:1px; padding-bottom:1px; padding-left:5px; padding-right:5px; vertical-align:middle;"><fmt:formatDate value="${dateString}" pattern="yyyy-MM-dd HH:mm:ss" /></td>
									<td style="width:6%; padding-top:1px; padding-bottom:1px; padding-left:7px; padding-right:7px; vertical-align:middle;">${item.getResult()}</td>
									<c:choose>
		      							<c:when test="${item.getResult() eq '성공' }">
		      								<td style="width:11%; padding-top:1px; padding-bottom:1px; padding-left:4px; padding-right:4px; vertical-align:middle; font-size:5pt;">${item.getFilecount()}</td>
											<td style="width:15%; padding-top:1px; padding-bottom:1px; padding-left:3px; padding-right:3px; padding-top:5px; padding-bottom:5px; vertical-align:middle;"><a href="${item.getFileDirectory()}" target="_blank" class="btn-md btn btn-success" style="width:190px;">전체로그</a></td>
										</c:when>
										<c:otherwise>
											<td style="width:11%; padding-top:1px; padding-bottom:1px; padding-left:4px; padding-right:4px; vertical-align:middle; font-size:5pt;">${item.getFilecount()}</td>
											<td style="width:15%; padding-top:1px; padding-bottom:1px; padding-left:1px; padding-right:1px; padding-top:5px; padding-bottom:5px; vertical-align:middle;">
											<a class=" btn btn-warning" id="errorOpen" onclick="errorOpen('${item.getErrDetail()}')">에러로그</a>
											&nbsp;<a href="${item.getFileDirectory()}" target="_blank" class="btn btn-success">전체로그</a></td>
										</c:otherwise>									
									</c:choose>
									
    							</tr>
    						</c:forEach>
						</c:otherwise>
	      			</c:choose>
    				</tbody>
    			</table>
    		</div>
  		</div>
	</div>
</body>
<script type="text/javascript">

var logSearchForm = $("#logSearchForm");
var timer;

$(document).ready(function(){

	var interval = $("#refreashInterval");
	console.log("[Changed refreashInterval] : " + interval.val());
	timer = setInterval(init, interval.val());
});

$(".logSearchForm_Area button").on("click", function(e){
	if($('#regDate').val().length != 0 && $('#regDate').val().length != 8 ){
		Swal.fire("생성일자 8자리를 입력하세요", "", "info");
		return false;
	}
	
	e.preventDefault();
	logSearchForm.attr("method", "post");
	logSearchForm.attr("action", "logSearchProcess.json");
	logSearchForm.submit();
});

function errorOpen(eMessage){
	errorAlert("배포에러로그", eMessage, "error", "", false);
}

//SweetAlert 함수
function errorAlert(title, text, icon, link, flag){
	Swal.fire({
		  title: title,
		  html: text,
		  icon: icon
	}).then((result) => {
		if(flag == true){
			location.href=link;
		}
	})
}

function myFunc() {
	  window.open("../logs/","_blank");
}

function logout() {
	document.Form.action = "logoutProcess.json";
	document.Form.submit();
}
$(function() {	
	$('#regDate').datepicker({
	    format: "yyyymmdd",	//데이터 포맷 형식(yyyy : 년 mm : 월 dd : 일 )
	    //startDate: '-10d',	//달력에서 선택 할 수 있는 가장 빠른 날짜. 이전으로는 선택 불가능 ( d : 일 m : 달 y : 년 w : 주)
	    //endDate: '+10d',	//달력에서 선택 할 수 있는 가장 느린 날짜. 이후로 선택 불가 ( d : 일 m : 달 y : 년 w : 주)
	    autoclose : true,	//사용자가 날짜를 클릭하면 자동 캘린더가 닫히는 옵션
	    calendarWeeks : false, //캘린더 옆에 몇 주차인지 보여주는 옵션 기본값 false 보여주려면 true
	    clearBtn : false, //날짜 선택한 값 초기화 해주는 버튼 보여주는 옵션 기본값 false 보여주려면 true
	    //datesDisabled : ['2019-06-24','2019-06-26'],//선택 불가능한 일 설정 하는 배열 위에 있는 format 과 형식이 같아야함.
	    //daysOfWeekDisabled : [0,6],	//선택 불가능한 요일 설정 0 : 일요일 ~ 6 : 토요일
	    //daysOfWeekHighlighted : [3], //강조 되어야 하는 요일 설정
	    disableTouchKeyboard : false,	//모바일에서 플러그인 작동 여부 기본값 false 가 작동 true가 작동 안함.
	    immediateUpdates: false,	//사용자가 보는 화면으로 바로바로 날짜를 변경할지 여부 기본값 :false 
	    multidate : false, //여러 날짜 선택할 수 있게 하는 옵션 기본값 :false 
	    multidateSeparator :",", //여러 날짜를 선택했을 때 사이에 나타나는 글짜 2019-05-01,2019-06-01
	    templates : {
	        leftArrow: '&laquo;',
	        rightArrow: '&raquo;'
	    }, //다음달 이전달로 넘어가는 화살표 모양 커스텀 마이징 
	    showWeekDays : true ,// 위에 요일 보여주는 옵션 기본값 : true
	    title: "로그생성일자",	//캘린더 상단에 보여주는 타이틀
	    todayHighlight : true ,	//오늘 날짜에 하이라이팅 기능 기본값 :false 
	    toggleActive : true,	//이미 선택된 날짜 선택하면 기본값 : false인경우 그대로 유지 true인 경우 날짜 삭제
	    weekStart : 0 ,//달력 시작 요일 선택하는 것 기본값은 0인 일요일 
	    
	}).on("changeDate", function(e){
		console.log("달력 입력");
	});
});   //ready end

$(function(){
	  $('#back-to-top').on('click',function(e){
	      e.preventDefault();
	      $('html,body').animate({scrollTop:0},600);
	  });
	  
	  $(window).scroll(function() {
	    if ($(document).scrollTop() > 100) {
	      $('#back-to-top').addClass('show');
	    } else {
	      $('#back-to-top').removeClass('show');
	    }
	  });
});


function init(){
	var now = new Date();
	console.log("[Excute RealTime JobList] 갱신시간  : " + now.getHours() + ":" + now.getMinutes() + ":" + now.getSeconds());
	  
	if($('#regDate').val().length != 0 && $('#regDate').val().length != 8 ){
		Swal.fire("생성일자 8자리를 입력하세요", "", "info");
		return false;
	}

	logSearchForm.attr("method", "post");
	logSearchForm.attr("action", "logSearchProcess.json");
	logSearchForm.submit(); 
	
}

$(function(){
	$('#refreashInterval').change(function(e){
		var interval = $("#refreashInterval");
		console.log("[Changed refreashInterval] : " + interval.val() / 60000 + "분");
		clearInterval(timer);
		
		$("#interval").val(timer);		
		timer = setInterval(init(), interval.val());		
		
		console.log("리스트 갱신시간이 " + (interval.val()/60000) + "분으로 변경 되었습니다." );

	});
});

</script>
