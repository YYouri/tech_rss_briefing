	@Override
	public <T> T getBeanFromContext( Class<T> requiredType) throws NestedRuntimeException
	{
		ConfigurableListableBeanFactoryDelegate factory= (ConfigurableListableBeanFactoryDelegate)this.context.getBeanFactory();
		ConfigurableListableBeanFactoryDelegate[] factories= factory.getContainingBeanFactories( requiredType);
		if( factories== null || factories.length<= 0)
			throw new NoSuchBeanDefinitionException( requiredType);
		Map<ConfigurableListableBeanFactoryDelegate, String> beanNames=
				new HashMap<ConfigurableListableBeanFactoryDelegate, String>();
		for( ConfigurableListableBeanFactoryDelegate fac: factories)
		{
			String[] names= fac.getDelegate().getBeanNamesForType( requiredType);
			if( names!= null && names.length> 0)
			for( String name: names)
				beanNames.put( fac, name);
		}

		if( beanNames.size()== 1)
			return beanNames.keySet().iterator().next().getBean( requiredType);
		else
			throw new NoSuchBeanDefinitionException(requiredType, "expected single bean but found " +
					beanNames.size() + ": " + beanNames.values());
	}

