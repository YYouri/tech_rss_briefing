[대상 3: LegacyWebConfig]
import org.springframework.boot.web.servlet.FilterRegistrationBean;
import org.springframework.boot.web.servlet.ServletRegistrationBean;
import org.springframework.context.annotation.Bean;
import org.springframework.context.annotation.Configuration;

import hi.framework.web.xss.XssFilter;
import jef.application.channel.filter.EncodingFilter;
import jef.application.channel.fms.ServiceInfoServlet;
import jef.application.channel.gateway.servlet.DispatcherServletGateway;

@Configuration
public class LegacyWebConfig {

    // 1. Gateway Servlet
    @Bean
    public ServletRegistrationBean<DispatcherServletGateway> gatewayServletRegistrationBean() {
        DispatcherServletGateway servlet = new DispatcherServletGateway();
        servlet.setContextConfigLocation("classpath:context-servlet.xml");
        
        ServletRegistrationBean<DispatcherServletGateway> registrationBean = 
            new ServletRegistrationBean<>(servlet, "*.hi", "*.do", "*.nhi", "*.download", "*.int", "*.ext", "*.obj", "*.extsoap" ,"/EX/*");
        registrationBean.setName("gateway");
        registrationBean.setLoadOnStartup(1);
        return registrationBean;
    }

    // 2. FMS Servlet
    @Bean
    public ServletRegistrationBean<ServiceInfoServlet> fmsServletRegistrationBean() {
        ServiceInfoServlet servlet = new ServiceInfoServlet();
        ServletRegistrationBean<ServiceInfoServlet> registrationBean = 
            new ServletRegistrationBean<>(servlet, "*.fms");
        registrationBean.setName("fmssvc");
        return registrationBean;
    }

    // 3. EncodingFilter (기본)
    @Bean
    public FilterRegistrationBean<EncodingFilter> encodingFilter() {
        EncodingFilter filter = new EncodingFilter();
        FilterRegistrationBean<EncodingFilter> registrationBean = new FilterRegistrationBean<>(filter);
        
        // [중요] filter.setInitParameter 대신 registrationBean.addInitParameter를 사용합니다.
        // 이것이 web.xml의 <init-param>과 동일한 역할을 합니다.
        registrationBean.addInitParameter("encoding", "UTF-8");
        registrationBean.addInitParameter("responseContentType", "application/json");
        
        registrationBean.addUrlPatterns("*.hi", "*.do", "*.nhi", "*.obj");
        registrationBean.setName("EncodingFilter");
        return registrationBean;
    }

    // 4. ExternalEncodingFilter
    @Bean
    public FilterRegistrationBean<EncodingFilter> externalEncodingFilter() {
        EncodingFilter filter = new EncodingFilter();
        FilterRegistrationBean<EncodingFilter> registrationBean = new FilterRegistrationBean<>(filter);
        
        registrationBean.addInitParameter("encoding", "EUC-KR");
        registrationBean.addInitParameter("responseContentType", "text/xml");
        
        registrationBean.addUrlPatterns("*.ext");
        registrationBean.setName("ExternalEncodingFilter");
        return registrationBean;
    }

    // 5. InternalEncodingFilter
    @Bean
    public FilterRegistrationBean<EncodingFilter> internalEncodingFilter() {
        EncodingFilter filter = new EncodingFilter();
        FilterRegistrationBean<EncodingFilter> registrationBean = new FilterRegistrationBean<>(filter);
        
        registrationBean.addInitParameter("encoding", "EUC-KR");
        registrationBean.addInitParameter("responseContentType", "application/json");
        
        registrationBean.addUrlPatterns("*.int");
        registrationBean.setName("InternalEncodingFilter");
        return registrationBean;
    }

    // 6. FMS Encoding Filter
    @Bean
    public FilterRegistrationBean<EncodingFilter> fmsEncodingFilter() {
        EncodingFilter filter = new EncodingFilter();
        FilterRegistrationBean<EncodingFilter> registrationBean = new FilterRegistrationBean<>(filter);
        
        registrationBean.addInitParameter("encoding", "UTF-8");
        registrationBean.addInitParameter("responseContentType", "application/json");
        
        registrationBean.addUrlPatterns("*.fms");
        registrationBean.setName("FmsEncodingFilter");
        return registrationBean;
    }

    // 7. XSS Filter
    @Bean
    public FilterRegistrationBean<XssFilter> xssFilter() {
        XssFilter filter = new XssFilter();
        FilterRegistrationBean<XssFilter> registrationBean = new FilterRegistrationBean<>(filter);
        
        // XSS 필터의 patterns 설정
        registrationBean.addInitParameter("patterns", "<\\<=<|\\>=>|'='");
        
        registrationBean.addUrlPatterns("*.hi", "*.nhi");
        registrationBean.setName("XssFilter");
        return registrationBean;
    }
}	
