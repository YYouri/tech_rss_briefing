	public static URL createClassPathEntry( File pathEntry) throws MalformedURLException
	{
		if( pathEntry.isFile())
		{
			if( pathEntry.getName().toLowerCase().endsWith( ResourceUtils.URL_PROTOCOL_JAR))
				return new URL( "jar", "", StringUtils.cleanPath( pathEntry.getAbsolutePath()));
			else if( pathEntry.getName().toLowerCase().endsWith( ResourceUtils.URL_PROTOCOL_ZIP))
				return new URL( "zip", "", StringUtils.cleanPath( pathEntry.getAbsolutePath()));
			else if( pathEntry.getName().toLowerCase().endsWith( ResourceUtils.URL_PROTOCOL_PAR))
				return new URL( "par", "", 0, StringUtils.cleanPath( pathEntry.getAbsolutePath()), new ParURLStreamHandler());
		}
		else if( pathEntry.isDirectory())
			return new URL( "file:"+ pathEntry.getAbsolutePath());
		throw new MalformedURLException( "not supported classpath url");
	}

	public ClassLoaderRef getClassLoaderFor( String applicationName) throws ApplicationNotFoundException
	{
		synchronized( monitor)
		{
			if( this.sharedLoaderRefs.containsKey( applicationName))
				return this.sharedLoaderRefs.get( applicationName).enref();
			else if( this.isolatedLoaderRefs.containsKey( applicationName))
				return this.isolatedLoaderRefs.get( applicationName).enref();

			throw new ApplicationNotFoundException( applicationName);
		}
	}

	public void removeApplication( String applicationName) throws InvalidCommandException, ApplicationNotFoundException
	{
		synchronized( monitor)
		{
			List<String> usedApplications= new ArrayList<String>();
			ApplicationClassLoaderHandleRef usedRef= this.sharedLoaderRefs.get( applicationName);
			if( usedRef== null)
				usedRef= this.isolatedLoaderRefs.get( applicationName);

			if( usedRef== null)
				throw new ApplicationNotFoundException( applicationName);

			AbstractApplicationClassLoader usedLoader= usedRef.getClassLoader();

			synchronized( loaderLock)
			{
				for( Map.Entry<String, ApplicationClassLoaderHandleRef> entry: this.sharedLoaderRefs.entrySet())
				{
					ApplicationClassLoaderHandleRef ref= entry.getValue();
					ApplicationClassLoader loader= (ApplicationClassLoader)ref.getClassLoader();
					ClassLoaderRef[] shRefs= loader.getUsedShared();
					for( ClassLoaderRef shRef: shRefs)
					{
						if( shRef.getClassLoader().getApplicationName().equals( usedLoader.getApplicationName()))
						{
							usedApplications.add( loader.getApplicationName());
							break;
						}
					}
				}

				for( Map.Entry<String, ApplicationClassLoaderHandleRef> entry: this.isolatedLoaderRefs.entrySet())
				{
					ApplicationClassLoaderHandleRef ref= entry.getValue();
					ApplicationClassLoader loader= (ApplicationClassLoader)ref.getClassLoader();
					ClassLoaderRef[] shRefs= loader.getUsedShared();
					for( ClassLoaderRef shRef: shRefs)
					{
						if( shRef.getClassLoader().getApplicationName().equals( usedLoader.getApplicationName()))
						{
							usedApplications.add( loader.getApplicationName());
							break;
						}
					}
				}
				if( usedApplications.size()> 0)
					throw new InvalidCommandException(
							CommandResponse.SHAREDAPPLICATION_REFRESH_OR_REMOVE_NOTSUPPORTED,
							"current application ["+ applicationName+ "]'s classloader used for ["+ usedApplications+ "].");

				usedRef= this.sharedLoaderRefs.remove( applicationName);
				if( usedRef== null)	usedRef= this.isolatedLoaderRefs.remove( applicationName);
				if( usedRef!= null)
				{
					usedRef.getClassLoader().setPooled( false);
					usedRef.getClassLoader().setStatus( ClassLoaderStatus.DIRTY);
					logger.info( "Current ClassLoader [{}/{}] released from ApplicationClassLoaderManager.",
							usedRef.getClassLoader().getUUID(), usedRef.getClassLoader());
					usedRef.release();
				}
			}
		}
	}

	public String[] registerApplication( String applicationName, URL[] classpath, URL[] localAppPaths, boolean shared,
			ApplicationClassLoaderListener[] listeners, File deleteTo, String[] referenceTos, Instrument instrument)
				throws InvalidCommandException
	{
		synchronized( monitor)
		{
			if( this.sharedLoaderRefs.containsKey( applicationName) || this.isolatedLoaderRefs.containsKey( applicationName))
			{
				try
				{
					return refreshApplication(
							applicationName, classpath, localAppPaths, shared, listeners, deleteTo, referenceTos, instrument);
				}
				catch( ApplicationNotFoundException e)
				{
					throw new InvalidCommandException( CommandResponse.APPLICATION_NOTFOUND,
							"application ["+ applicationName+ "] is already deployed.");
				}
			}
//				throw new InvalidCommandException( CommandResponse.APPLICATION_ALREADY_DEPLOYED,
//						"application ["+ applicationName+ "] is already deployed.");

			ApplicationClassLoaderHandleRef nRef= newClassLoader(
					applicationName, classpath, localAppPaths, deleteTo, instrument, listeners, shared, referenceTos);
			ApplicationClassLoader nLoader= (ApplicationClassLoader)nRef.getClassLoader();
			if( shared)	this.sharedLoaderRefs.put( applicationName, nRef);
			else	this.isolatedLoaderRefs.put( applicationName, nRef);

			synchronized( loaderLock)
			{
				if( shared)
				{
					for( Map.Entry<String, ApplicationClassLoaderHandleRef> entry: this.sharedLoaderRefs.entrySet())
					{
						ApplicationClassLoaderHandleRef ref= entry.getValue();
						ApplicationClassLoader loader= (ApplicationClassLoader)ref.getClassLoader();
						if( loader.getReferenceTos().contains( applicationName)
								&& !loader.getApplicationName().equals( applicationName))
							loader.addSharedClassLoaders( new ClassLoaderRef[]{ nRef.enref()});
					}

					for( Map.Entry<String, ApplicationClassLoaderHandleRef> entry: this.isolatedLoaderRefs.entrySet())
					{
						ApplicationClassLoaderHandleRef ref= entry.getValue();
						ApplicationClassLoader loader= (ApplicationClassLoader)ref.getClassLoader();
						if( loader.getReferenceTos().contains( applicationName)
								&& !loader.getApplicationName().equals( applicationName))
							loader.addSharedClassLoaders( new ClassLoaderRef[]{ nRef.enref()});
					}
				}
				for( String shApp: referenceTos)
				{
					ApplicationClassLoaderHandleRef shRef= this.sharedLoaderRefs.get( shApp);
					if( shRef!= null && !shApp.equals( applicationName))
						nLoader.addSharedClassLoaders( new ClassLoaderRef[]{ shRef.enref()});
//					else
//						logger.warn( "reference application [{}] for application [{}] is not shared. so can not be referenced.",
//								shApp, applicationName);
				}
			}
			return new String[]{ applicationName};
		}
	}

	@SuppressWarnings( "unchecked")
	public String[] refreshApplication( String applicationName, URL[] classpath, URL[] localAppPaths, boolean shared,
			ApplicationClassLoaderListener[] listeners, File deleteTo, String[] referenceTos, Instrument instrument)
				throws ApplicationNotFoundException
	{
		Set<String> refreshToApplications= new HashSet<String>();
		synchronized( monitor)
		{
			ApplicationClassLoaderHandleRef usedRef= this.sharedLoaderRefs.get( applicationName);
			if( usedRef== null)
				usedRef= this.isolatedLoaderRefs.get( applicationName);

			if( usedRef== null)
				throw new ApplicationNotFoundException( applicationName);

			ApplicationClassLoaderHandleRef nRef= newClassLoader(
					applicationName, classpath, localAppPaths, deleteTo, instrument, listeners, shared, referenceTos);

			synchronized( loaderLock)
			{
				ApplicationClassLoaderHandleRef[][] context= refreshClassLoaderContext( usedRef, nRef, new HashSet<String>());

				ApplicationClassLoaderHandleRef[] toUses= context[0];
				ApplicationClassLoaderHandleRef[] toClears= context[1];
				for( ApplicationClassLoaderHandleRef ref: toClears)
				{
					// sequence of statements is very important!!!
					ApplicationClassLoader loader= (ApplicationClassLoader)ref.getClassLoader();
					if( loader.isShared())	this.sharedLoaderRefs.remove( loader.getApplicationName());
					else	this.isolatedLoaderRefs.remove( loader.getApplicationName());

					ClassLoaderRef[] shRefs= loader.getSharedClassLoaderRefs();
					for( ClassLoaderRef shRef: shRefs)
					{
						logger.info( "Shared ClassLoader [{}/{}/{}] for application [{}] is released for clearance.",
								new Object[]{ shRef.getClassLoader().getUUID(), shRef.getClassLoader(),
								shRef.getClassLoader().getApplicationName(), loader.getApplicationName()});
						shRef.release();
					}
					loader.setPooled( false);
					loader.setStatus( ClassLoaderStatus.DIRTY);

					logger.info( "Current ClassLoader [{}/{}/{}] released from ApplicationClassLoaderManager.",
							new Object[]{ loader.getUUID(), loader, loader.getApplicationName()});
					// last reference will be released in application destroy time.
					ref.release();
				}

				for( ApplicationClassLoaderHandleRef ref: toUses)
				{
					ApplicationClassLoader loader= (ApplicationClassLoader)ref.getClassLoader();
					if( loader.isShared())	this.sharedLoaderRefs.put( loader.getApplicationName(), ref);
					else	this.isolatedLoaderRefs.put( loader.getApplicationName(), ref);
					refreshToApplications.add( loader.getApplicationName());
					logger.info( "Applicaiton ClassLoader[{}/{}] for application [{}] will be used.",
							new Object[]{ loader.getUUID(), loader, loader.getApplicationName()});
				}

				for( ApplicationClassLoaderHandleRef ref: toUses)
				{
					ApplicationClassLoader loader= (ApplicationClassLoader)ref.getClassLoader();
					Set<String> refApps= !loader.getApplicationName().equals( applicationName) ? loader.getReferenceTos() : null;
					if( refApps== null)
					{
						refApps= new HashSet<String>();
						refApps.addAll( CollectionUtils.arrayToList( referenceTos));
					}

					logger.debug( "{} loader referencetos {}.", loader.getApplicationName(), refApps);
					for( String shApp: refApps)
					{
						ApplicationClassLoaderHandleRef shRef= this.sharedLoaderRefs.get( shApp);
						if( shRef!= null && !shApp.equals( loader.getApplicationName()))
						{
							logger.info( "shared Classloader [{}/{}/{}] is assigned to application [{}].",
									new Object[]{ shRef.getClassLoader().getUUID(), shRef.getClassLoader(),
									shRef.getClassLoader().getApplicationName(), loader.getApplicationName()});
							loader.addSharedClassLoaders( new ClassLoaderRef[]{ shRef.enref()});
						}
						else
							logger.warn( "reference application [{}] for application [{}] is not shared. so can not be referenced.",
									shApp, loader.getApplicationName());
					}
				}
			}
			return refreshToApplications.toArray( new String[refreshToApplications.size()]);
		}
	}

	public ClassLoaderRef[] getClassLoaderForStaging( String applicationName, URL[] classpath, URL[] localApplicationPaths,
			boolean shared, ApplicationClassLoaderListener[] listeners, File deleteTo, String[] referenceTos, Instrument instrument)
				throws ApplicationNotFoundException
	{
		Set<ClassLoaderRef> refreshToApplications= new HashSet<ClassLoaderRef>();
		synchronized( monitor)
		{
			ApplicationClassLoaderHandleRef usedRef= this.sharedLoaderRefs.get( applicationName);
			if( usedRef== null)
				usedRef= this.isolatedLoaderRefs.get( applicationName);

			if( usedRef== null)
				throw new ApplicationNotFoundException( applicationName);

			ApplicationClassLoaderHandleRef nRef= newClassLoader(
					applicationName, classpath, localApplicationPaths, deleteTo, instrument, listeners, shared, referenceTos);

			synchronized( loaderLock)
			{
				ApplicationClassLoaderHandleRef[][] context= refreshClassLoaderContext( usedRef, nRef, new HashSet<String>());
				ApplicationClassLoaderHandleRef[] toUses= context[0];

				Map<String, ApplicationClassLoaderHandleRef> shRefsToUse=
						new HashMap<String, ApplicationClassLoaderHandleRef>();
				for( Map.Entry<String, ApplicationClassLoaderHandleRef> entry: this.sharedLoaderRefs.entrySet())
					shRefsToUse.put( entry.getKey(), entry.getValue());

				for( ApplicationClassLoaderHandleRef ref: toUses)
				{
					ApplicationClassLoader loader= (ApplicationClassLoader)ref.getClassLoader();
					if( loader.isShared())	shRefsToUse.put( loader.getApplicationName(), ref);
					refreshToApplications.add( ref);
					logger.info( "Application ClassLoader[{}/{}] for application [{}] will be used in staging.",
							new Object[]{ loader.getUUID(), loader, loader.getApplicationName()});
				}

				for( ApplicationClassLoaderHandleRef ref: toUses)
				{
					ApplicationClassLoader loader= (ApplicationClassLoader)ref.getClassLoader();
					for( String shApp: loader.getReferenceTos())
					{
						ApplicationClassLoaderHandleRef shRef= shRefsToUse.get( shApp);
						if( shRef!= null && !shApp.equals( loader.getApplicationName()))
							loader.addSharedClassLoaders( new ClassLoaderRef[]{ shRef.enref()});
						else
							logger.warn( "reference application [{}] for application [{}] is not shared. so can not be referenced.",
									shApp, loader.getApplicationName());
					}
				}
			}
			return refreshToApplications.toArray( new ClassLoaderRef[refreshToApplications.size()]);
		}
	}

	public ClassLoaderRef[] getClassLoaderForMultiStaging( ClassLoaderElementsForCreation[] classLoaderElements)
			throws ApplicationNotFoundException
	{
		Set<ClassLoaderRef> refreshToApplications= new HashSet<ClassLoaderRef>();
		Set<ApplicationClassLoaderHandleRef> newClassLoaders= new HashSet<ApplicationClassLoaderHandleRef>();
		synchronized( monitor)
		{
			// 1. preCheck
			for( ClassLoaderElementsForCreation element: classLoaderElements)
			{
				if( !this.sharedLoaderRefs.containsKey( element.applicationName)
						&& !this.isolatedLoaderRefs.containsKey( element.applicationName))
					throw new ApplicationNotFoundException( element.applicationName);
			}

			// 2. create new classLoaders
			Set<String> excludes= new HashSet<String>();
			for( ClassLoaderElementsForCreation element: classLoaderElements)
			{
				newClassLoaders.add( newClassLoader(
						element.applicationName, element.classpath, element.localApplicationPath, element.deleteTo,
						element.instrument, element.listeners, element.shared, element.referenceTos));
				excludes.add( element.applicationName);
			}

			synchronized( loaderLock)
			{
				Map<String, ApplicationClassLoaderHandleRef> toUses= new HashMap<String, ApplicationClassLoaderHandleRef>();

				// 3. refresh ClassLoader Context
				for( ApplicationClassLoaderHandleRef nRef: newClassLoaders)
				{
					if( toUses.containsKey( nRef.getClassLoader().getApplicationName()))
						continue;
					ApplicationClassLoaderHandleRef usedRef= this.sharedLoaderRefs.get( nRef.getClassLoader().getApplicationName());
					if( usedRef== null)
						usedRef= this.isolatedLoaderRefs.get( nRef.getClassLoader().getApplicationName());
					if( usedRef== null) continue;

					ApplicationClassLoaderHandleRef[] refresheds= refreshClassLoaderContext( usedRef, nRef, excludes)[0];
					for( ApplicationClassLoaderHandleRef toUse: refresheds)
					{
						toUses.put( toUse.getClassLoader().getApplicationName(), toUse);
						excludes.add( toUse.getClassLoader().getApplicationName());
					}
				}

				Map<String, ApplicationClassLoaderHandleRef> shRefsToUse=
						new HashMap<String, ApplicationClassLoaderHandleRef>();
				for( Map.Entry<String, ApplicationClassLoaderHandleRef> entry: this.sharedLoaderRefs.entrySet())
					shRefsToUse.put( entry.getKey(), entry.getValue());

				for( ApplicationClassLoaderHandleRef ref: toUses.values())
				{
					ApplicationClassLoader loader= (ApplicationClassLoader)ref.getClassLoader();
					if( loader.isShared()) shRefsToUse.put( loader.getApplicationName(), ref);
					refreshToApplications.add( ref);
					logger.info( "Application ClassLoader[{}/{}] for application [{}] will be used in staging.",
							new Object[]{ loader.getUUID(), loader, loader.getApplicationName()});
				}

				for( ApplicationClassLoaderHandleRef ref: toUses.values())
				{
					ApplicationClassLoader loader= (ApplicationClassLoader)ref.getClassLoader();
					for( String shApp: loader.getReferenceTos())
					{
						ApplicationClassLoaderHandleRef shRef= shRefsToUse.get( shApp);
						if( shRef!= null && !shApp.equals( loader.getApplicationName()))
							loader.addSharedClassLoaders( new ClassLoaderRef[]{ shRef.enref()});
						else
							logger.warn( "reference application [{}] for application [{}] is not shared. so can not be referenced.",
									shApp, loader.getApplicationName());
					}
				}
			}
			return refreshToApplications.toArray( new ClassLoaderRef[refreshToApplications.size()]);
		}
	}

	public void clearThrowawayedRefs( ClassLoaderRef[] refsToClear)
	{
		synchronized( monitor)
		{
			for( ClassLoaderRef ref: refsToClear)
			{
				// sequence of statements is very important!!!
				ApplicationClassLoader loader= (ApplicationClassLoader)ref.getClassLoader();
				ClassLoaderRef[] shRefs= loader.getSharedClassLoaderRefs();
				for( ClassLoaderRef shRef: shRefs)
				{
					logger.info( "Shared ClassLoader [{}/{}] for application [{}] is released for clearance.",
							new Object[]{ shRef.getClassLoader().getUUID(), shRef.getClassLoader(), loader.getApplicationName()});
					shRef.release();
				}
			}
		}
	}

	public void applyClassLoaderForStaging( ClassLoaderRef[] refsToUse, ClassLoaderRef[] refsToClear)
	{
		synchronized( monitor)
		{
			for( ClassLoaderRef ref: refsToClear)
			{
				// sequence of statements is very important!!!
				ApplicationClassLoader loader= (ApplicationClassLoader)ref.getClassLoader();
				ClassLoaderRef refToRelease= null;
				if( loader.isShared())	refToRelease= this.sharedLoaderRefs.remove( loader.getApplicationName());
				else	refToRelease= this.isolatedLoaderRefs.remove( loader.getApplicationName());

				ClassLoaderRef[] shRefs= loader.getSharedClassLoaderRefs();
				for( ClassLoaderRef shRef: shRefs)
				{
					logger.info( "Shared ClassLoader [{}/{}] for application [{}] is released for clearance.",
							new Object[]{ shRef.getClassLoader().getUUID(), shRef.getClassLoader(), loader.getApplicationName()});
					shRef.release();
				}
				loader.setPooled( false);
				loader.setStatus( ClassLoaderStatus.DIRTY);
				logger.info( "Current ClassLoader [{}/{}] released from ApplicationClassLoaderManager.", loader.getUUID(), loader);

				// fault last reference will be released in application destroy time. delete below
				if( refToRelease!= null)
					refToRelease.release();
			}

			for( ClassLoaderRef ref: refsToUse)
			{
				ApplicationClassLoader loader= (ApplicationClassLoader)ref.getClassLoader();
				if( loader.isShared())
					this.sharedLoaderRefs.put( loader.getApplicationName(),
							(ApplicationClassLoaderHandleRef)( (ApplicationClassLoaderHandleRef)ref).enref());
				else
					this.isolatedLoaderRefs.put( loader.getApplicationName(),
							(ApplicationClassLoaderHandleRef)( (ApplicationClassLoaderHandleRef)ref).enref());
				logger.info( "Applicaiton ClassLoader[{}/{}] for application [{}] will be used.",
						new Object[]{ loader.getUUID(), loader, loader.getApplicationName()});
			}
		}
	}

	private ApplicationClassLoaderHandleRef[][] refreshClassLoaderContext(
			ApplicationClassLoaderHandleRef usedRef, ApplicationClassLoaderHandleRef nRef, Set<String> excludes)
	{
		ApplicationClassLoaderHandleRef[][] context= new ApplicationClassLoaderHandleRef[2][];
		Set<ApplicationClassLoaderHandleRef> toUses= new HashSet<ApplicationClassLoaderHandleRef>();
		Set<ApplicationClassLoaderHandleRef> toClears= new HashSet<ApplicationClassLoaderHandleRef>();
		if( usedRef!= null)
		{
			toClears.add( usedRef);

			Map<String, ApplicationClassLoaderHandleRef> toChecks= new HashMap<String, ApplicationClassLoaderHandleRef>();
			logger.info( "check sharedLoaders pool.");
			for( Map.Entry<String, ApplicationClassLoaderHandleRef> entry: this.sharedLoaderRefs.entrySet())
			{
				ApplicationClassLoaderHandleRef ref= entry.getValue();
				ApplicationClassLoader loader= (ApplicationClassLoader)ref.getClassLoader();
				if( nRef.getClassLoader().getApplicationName().equals( loader.getApplicationName()))
					continue;

				toChecks.clear();
				toChecks.putAll( this.sharedLoaderRefs);
				toChecks.putAll( this.isolatedLoaderRefs);
				traceLoaderReferences( ref, usedRef, toChecks, loader.getReferenceTos(), toUses, toClears, excludes);
			}

			logger.info( "check isolatedLoaders pool.");
			for( Map.Entry<String, ApplicationClassLoaderHandleRef> entry: this.isolatedLoaderRefs.entrySet())
			{
				ApplicationClassLoaderHandleRef ref= entry.getValue();
				ApplicationClassLoader loader= (ApplicationClassLoader)ref.getClassLoader();
				if( nRef.getClassLoader().getApplicationName().equals( loader.getApplicationName()))
					continue;

				toChecks.clear();
				toChecks.putAll( this.sharedLoaderRefs);
				toChecks.putAll( this.isolatedLoaderRefs);
				traceLoaderReferences( ref, usedRef, toChecks, loader.getReferenceTos(), toUses, toClears, excludes);
			}
		}

		if( nRef!= null)
			toUses.add( nRef);

		context[0]= toUses.toArray( new ApplicationClassLoaderHandleRef[toUses.size()]);
		context[1]= toClears.toArray( new ApplicationClassLoaderHandleRef[toClears.size()]);
		return context;
	}

	private boolean traceLoaderReferences( ApplicationClassLoaderHandleRef usedRef,
			ApplicationClassLoaderHandleRef checkFor, Map<String, ApplicationClassLoaderHandleRef> toChecks,
			Set<String> referenceTos, Set<ApplicationClassLoaderHandleRef> toUses,
			Set<ApplicationClassLoaderHandleRef> toClears, Set<String> excludes)
	{
//		logger.info( "loader for check {}/{}/{}/{}",
//				new Object[]{ usedRef.getClassLoader().getApplicationName(), referenceTos,
//				checkFor.getClassLoader().getApplicationName(), toChecks.keySet()});
		ApplicationClassLoader usedLoader= (ApplicationClassLoader)usedRef.getClassLoader();

		if( referenceTos.contains( checkFor.getClassLoader().getApplicationName()))
		{
			if( excludes.contains( usedLoader.getApplicationName()))
				return true;

			toUses.add( newClassLoader( usedLoader.getApplicationName(), usedLoader.getFinder().getInitialUrls(),
					usedLoader.getLocalApplicationClasspaths(),  usedLoader.getDeleteTo(), usedLoader.getInstrument(),
					usedLoader.getListeners(), usedLoader.isShared(),
					usedLoader.getReferenceTos().toArray( new String[usedLoader.getReferenceTos().size()])));
			usedRef.getClassLoader().setDeleteOnDestroy( false);
			toClears.add( usedRef);
			logger.info( "managed ClassLoader [{}/{}] for application [{}] will be refreshed.",
					new Object[]{  usedLoader.getUUID(), usedLoader, usedLoader.getApplicationName()});
			return true;
		}
		else
		{
			for( String referenceTo: referenceTos)
			{
				ApplicationClassLoaderHandleRef toCheck= toChecks.remove( referenceTo);
				if( toCheck!= null)
				{
					if( traceLoaderReferences( usedRef, checkFor, toChecks,
							( (ApplicationClassLoader)toCheck.getClassLoader()).getReferenceTos(), toUses, toClears, excludes))
						return true;
				}
			}
			return false;
		}
	}


	private ApplicationClassLoaderHandleRef newClassLoader( String applicationName, URL[] classpath, URL[] localApplicationPaths,
			File deleteTo, Instrument instrument, ApplicationClassLoaderListener[] listeners, boolean shared, String[] referenceTos)
	{
		AbstractApplicationClassLoader loader=
				new ApplicationClassLoader( applicationName,
					new DefaultApplicationClassFinder( classpath),
					shared, deleteTo, referenceTos, instrument, this.parentLoader, this.loaderLock);
		loader.setInstrument( instrument);
		loader.setInstrumentableMetadataCachesize( this.instrumentableMetadataCachesize);
		loader.setClassTransformerMetadataCachesize( this.classTransformerMetadataCachesize);
		loader.setClassLoaderDelegate(this.classloaderDelegate);
		//[[ T#34 patch
		if (this.nouseSnapshot)
		{
			loader.setDeleteOnDestroy(false);
		}
		else
		{
			loader.setDeleteOnDestroy(true);
		}
		//]] T#34 patch
		List<URL> apppaths= new ArrayList<URL>();
		apppaths.addAll( Arrays.asList( localApplicationPaths));
		loader.setLocalApplicationClasspaths( apppaths);
		if( listeners!= null)
		{
			for( ApplicationClassLoaderListener listener: listeners)
				loader.addListener( listener);
		}
		loader.setPooled( true);
		loader.setStatus( ClassLoaderStatus.POOLED);
		this.weakLoaders.put( loader, loader.toString());
		ApplicationClassLoaderHandleRef nref=
				ApplicationClassLoaderHandleRef.refInstance(
						new LoaderHandleReferent( ApplicationClassLoaderHandler.adapt( loader)));
		logger.info( "ApplicationClassLoader [{}/{}] for {} application [{}] is created.",
				new Object[]{ loader.getUUID(), loader, shared ? "shared" : "", applicationName});

		loader.publishPostInitializeEvent( new ApplicationClassLoaderEvent( applicationName, shared, loader));
		return nref;
	}

