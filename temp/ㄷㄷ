<!DOCTYPE html>
<html lang="ko">
<head>
<meta charset="UTF-8">
<title>기간계 자원정리 관리</title>
<link href="../css/bootstrap.min.css" rel="stylesheet">
<link href="../css/jquery-ui.min.css" rel="stylesheet">
<link href="../css/custom.css" rel="stylesheet">
<style>
  /* shadcn/ui 기반 리디자인 스타일 가이드 적용 */
  :root {
    --background: #fafafa;
    --card: #ffffff;
    --card-border: #e4e4e7;
    --card-border-dark: #d4d4d8;
    --text-main: #18181b;
    --text-muted: #71717a;
    --text-faint: #a1a1aa;
    --primary: #18181b;
    --primary-hover: #27272a;
    --danger: #dc2626;
    --success: #16a34a;
    --warning: #f59e0b;
    --warning-bg: #fffbeb;
    --warning-border: #fde68a;
    --radius-lg: 10px;
    --radius-md: 6px;
    --radius-pill: 999px;
    --shadow: 0 1px 2px rgba(0,0,0,0.03);
  }

  body {
    background-color: var(--background);
    font-family: -apple-system, BlinkMacSystemFont, "Segoe UI", "Malgun Gothic", Roboto, sans-serif;
    color: var(--text-main);
    margin: 0;
  }

  /* 본문 컨테이너: 입력 위주 화면이므로 860px 제한 */
  #app { 
    max-width: 860px; 
    margin: 0 auto; 
    padding: 40px 24px 80px; 
  }

  /* Header 영역 (메뉴바 include 부분은 건드리지 않음) */
  .main-header { margin-bottom: 32px; }
  .eyebrow { font-size: 12px; font-weight: 700; color: var(--text-faint); text-transform: uppercase; margin-bottom: 4px; }
  .main-header h4 { font-size: 1.4rem; font-weight: 600; color: var(--text-main); margin: 0; }
  .main-header .desc { font-size: 13px; color: var(--text-muted); margin-top: 4px; }

  /* Card & Section Style */
  .section-card {
    background: var(--card);
    border: 1px solid var(--card-border);
    border-radius: var(--radius-lg);
    margin-bottom: 32px;
    box-shadow: var(--shadow);
    overflow: hidden;
  }
  .section-disabled { opacity: 0.5; pointer-events: none; }

  .section-head {
    padding: 16px 20px;
    border-bottom: 1px solid var(--card-border);
    display: flex;
    align-items: center;
  }
  .badge-step {
    background: var(--text-main);
    color: #fff;
    width: 22px;
    height: 22px;
    border-radius: 4px;
    display: inline-flex;
    align-items: center;
    justify-content: center;
    font-size: 11px;
    font-weight: 700;
    margin-right: 10px;
  }
  .section-title { font-weight: 600; font-size: 15px; color: var(--text-main); }
  .section-hint { margin-left: auto; font-size: 13px; color: var(--text-muted); }

  .section-body { padding: 20px; }

  /* Environment Toggle */
  .env-btn-group { display: flex; gap: 8px; }
  .env-btn {
    padding: 6px 16px;
    border-radius: var(--radius-md);
    border: 1px solid var(--card-border);
    background: #fff;
    color: var(--text-main);
    font-size: 14px;
    font-weight: 500;
    transition: all 0.2s;
  }
  .env-btn:hover { background-color: #f4f4f5; }
  .env-btn-active-qa { background-color: var(--primary) !important; color: white !important; border-color: var(--primary); }
  .env-btn-active-prod { background-color: var(--danger) !important; color: white !important; border-color: var(--danger); }

  /* Sticky Env Badge */
  .env-sticky-badge {
    position: fixed;
    top: 20px;
    right: 24px;
    z-index: 1000;
    padding: 6px 14px;
    border-radius: var(--radius-pill);
    font-weight: 600;
    font-size: 12px;
    box-shadow: var(--shadow);
  }
  .env-sticky-qa { background: var(--primary); color: #fff; }
  .env-sticky-prod { background: var(--danger); color: #fff; animation: env-pulse 1.5s infinite; }
  @keyframes env-pulse { 0%, 100% { opacity: 1; } 50% { opacity: 0.7; } }

  /* Form & Input */
  .form-control {
    border: 1px solid var(--card-border);
    border-radius: var(--radius-md);
    font-size: 14px;
    transition: border-color 0.2s;
  }
  .form-control:focus { border-color: var(--text-main); outline: none; box-shadow: 0 0 0 2px rgba(0,0,0,0.05); }
  .mono { font-family: 'Cascadia Code', 'Consolas', monospace; }

  /* Table */
  .table-container {
    border: 1px solid var(--card-border);
    border-radius: var(--radius-md);
    overflow: auto;
  }
  .table { margin-bottom: 0; font-size: 14px; }
  .table thead th {
    position: sticky; top: 0; background: #f8f9fa;
    color: var(--text-muted); font-weight: 600;
    border-bottom: 1px solid var(--card-border);
    padding: 12px 8px; font-size: 13px; text-align: center;
  }
  .table tbody td { padding: 10px 12px; border-bottom: 1px solid #f4f4f5; color: var(--text-main); }
  .table tbody tr:hover { background-color: #f8f9fa; }

  /* Tabs */
  .tab-btn {
    border-radius: var(--radius-pill);
    padding: 4px 14px;
    font-size: 13px;
    font-weight: 500;
    margin-right: 6px;
    margin-bottom: 8px;
    border: 1px solid var(--card-border);
    background: #fff;
    color: var(--text-muted);
    transition: all 0.2s;
  }
  .tab-btn.active { background-color: var(--text-main); color: #fff; border-color: var(--text-main); }
  .tab-btn.warn { border-color: var(--warning); color: var(--warning); }

  /* Export/Path Items */
  .export-item {
    background: #f8f9fa;
    padding: 10px 14px;
    border-radius: var(--radius-md);
    border: 1px solid var(--card-border);
    display: flex;
    justify-content: space-between;
    align-items: center;
    margin-bottom: 8px;
  }
  .path-edit-row {
    display: flex;
    align-items: center;
    gap: 8px;
    padding: 6px 12px;
    border-bottom: 1px solid #f4f4f5;
  }
  .path-edit-input {
    border: 1px solid transparent;
    background: transparent;
    font-size: 13px;
    padding: 4px 8px;
    width: 100%;
  }
  .path-edit-input:focus { border-color: var(--card-border); background: #fff; }

  /* Log Viewers */
  .log-container {
    border-radius: var(--radius-md);
    font-size: 13px;
    line-height: 1.5;
    border: 1px solid var(--card-border);
    padding: 12px;
  }
  .log-agent { background-color: #18181b; color: #e4e4e7; }
  .log-full { background-color: #fffbeb; color: #451a03; }

  /* Action Buttons */
  .btn { border-radius: var(--radius-md); font-weight: 500; transition: all 0.2s; }
  .btn-primary { background-color: var(--primary); color: #fff; border: none; }
  .btn-primary:hover { background-color: var(--primary-hover); color: #fff; }
  .btn-outline-secondary { color: var(--text-muted); border-color: var(--card-border); }
  .btn-outline-secondary:hover { background-color: #f4f4f5; color: var(--text-main); }
  .btn-success { background-color: var(--success); color: #fff; border: none; }
  .btn-warning { background-color: var(--warning); color: #fff; border: none; }
  .btn-link { text-decoration: none; }

  /* Empty/Loading State */
  .empty-state { padding: 40px; text-align: center; color: var(--text-muted); font-size: 13px; }

  .btn-group-custom { display: flex; gap: 8px; flex-wrap: wrap; }
  .text-primary { color: #2563eb !important; }
</style>
</head>
<body>
<header id="header"></header>
<div id="app">
  <!-- 환경 경고 배지 -->
  <div class="env-sticky-badge" v-bind:class="env === 'PROD' ? 'env-sticky-prod' : 'env-sticky-qa'">
    {{ env === 'PROD' ? '● 운영 환경 (PROD)' : '● 개발/검증 환경 (QA)' }}
  </div>

  <!-- 메인 타이틀 블록 -->
  <div class="main-header">
    <div class="eyebrow">System Administration</div>
    <h4 class="mb-1">기간계 서버 자원정리 관리</h4>
    <p class="desc">삭제 대상 자원을 분류하여 배포 서버로 전송 및 정리합니다.</p>
  </div>

  <!-- 환경 선택 섹션 -->
  <div class="section-card">
    <div class="section-body">
      <label class="font-weight-bold mb-2 d-block" style="font-size:14px; color:var(--text-muted);">대상 서버 환경</label>
      <div class="env-btn-group">
        <button type="button" class="env-btn" v-bind:class="{ 'env-btn-active-qa': env === 'QA' }" v-on:click="env = 'QA'">개발/검증 환경</button>
        <button type="button" class="env-btn" v-bind:class="{ 'env-btn-active-prod': env === 'PROD' }" v-on:click="env = 'PROD'">운영 환경</button>
      </div>
    </div>
  </div>

  <!-- STEP 1: 입력 -->
  <div class="section-card">
    <div class="section-head">
      <span class="badge-step">01</span>
      <span class="section-title">삭제 자원 데이터 입력</span>
      <span class="section-hint">파일명 [탭/공백] 경로</span>
    </div>
    <div class="section-body">
      <p class="text-muted mb-2" style="font-size:12px;">엑셀에서 복사한 "파일명 [탭/공백] 경로"를 아래에 붙여넣으세요.</p>
      <textarea class="form-control mono" rows="7" v-model="pasteText" placeholder="예: LT0001002.class  \LT\source\ONLINE\LT\src\hi\dbio\cdo\lt\lt0001002\"></textarea>
      <div class="mt-3">
        <button type="button" class="btn btn-primary btn-sm px-3" v-on:click="handleImport">테이블로 가져오기</button>
        <button type="button" class="btn btn-outline-secondary btn-sm px-3" v-on:click="handleSample">샘플 데이터 채우기</button>
      </div>
    </div>
  </div>

  <!-- STEP 2: 편집 -->
  <div class="section-card" v-bind:class="{ 'section-disabled': !imported }">
    <div class="section-head">
      <span class="badge-step">02</span>
      <span class="section-title">데이터 검증 및 편집</span>
      <span class="section-hint">{{ tableRows.length }} 건 추출됨</span>
    </div>
    <div class="section-body">
      <div class="table-container" style="max-height:300px;">
        <table class="table table-hover mb-0" v-if="tableRows.length > 0">
          <thead class="mono">
            <tr style="font-size:13px;">
              <th style="width:30%;">파일명</th>
              <th>대상 경로</th>
              <th style="width:50px;">삭제</th>
            </tr>
          </thead>
          <tbody class="mono">
            <tr v-for="(row, index) in tableRows" :key="index">
              <td><input type="text" class="form-control form-control-sm border-0 bg-transparent" v-model="row.fileName"></td>
              <td><input type="text" class="form-control form-control-sm border-0 bg-transparent" v-model="row.dirInfo"></td>
              <td class="text-center">
                <button type="button" class="btn btn-link text-danger p-0" v-on:click="deleteRow(index)">✕</button>
              </td>
            </tr>
          </tbody>
        </table>
        <div class="empty-state" v-else>데이터를 가져오면 목록이 표시됩니다.</div>
      </div>
      <div class="mt-3 d-flex justify-content-between">
        <button type="button" class="btn btn-outline-secondary btn-sm px-3" v-on:click="addRow">행 추가</button>
        <button type="button" class="btn btn-primary btn-sm px-4" v-on:click="handleConvert">분류 및 변환 실행</button>
      </div>
    </div>
  </div>

  <!-- STEP 3: 결과 -->
  <div class="section-card" v-bind:class="{ 'section-disabled': !classifyResult }">
    <div class="section-head">
      <span class="badge-step">03</span>
      <span class="section-title">타입별 분류 결과</span>
    </div>
    <div class="section-body">
      <div class="mb-3">
        <button type="button" class="tab-btn"
          v-for="key in order" :key="key"
          :class="{ 'active': activeTab === key, 'warn': key === 'unknown' && classifyResult && classifyResult.unknown.length > 0 }"
          v-on:click="activeTab = key">
          {{ labels[key] }} <small class="ml-1" style="opacity:0.7;">({{ classifyResult ? classifyResult[key].length : 0 }})</small>
        </button>
      </div>
      <div class="table-container" style="max-height:300px; background:#fff;">
        <template v-if="classifyResult && classifyResult[activeTab].length > 0">
          <div class="path-edit-row" v-for="(p, i) in classifyResult[activeTab]" :key="activeTab + '-' + i">
            <input type="text" class="form-control form-control-sm mono path-edit-input" v-model="classifyResult[activeTab][i]">
            <button type="button" class="btn btn-link text-danger p-0" v-on:click="deletePathRow(i)">✕</button>
          </div>
        </template>
        <div class="empty-state" v-else>해당 없음</div>
      </div>
      <div class="mt-3">
        <button type="button" class="btn btn-outline-secondary btn-sm" v-on:click="addPathRow">행 추가</button>
      </div>
    </div>
  </div>

  <!-- STEP 4: 실행 -->
  <div class="section-card" v-bind:class="{ 'section-disabled': !classifyResult }">
    <div class="section-head">
      <span class="badge-step">04</span>
      <span class="section-title">배포 서버 전송 및 실행</span>
      <span class="section-hint">TASK_ID_online.txt 형식</span>
    </div>
    <div class="section-body">
      <div class="row mb-3 align-items-center">
        <div class="col-auto"><label class="font-weight-bold mb-0" style="font-size:14px;">신청서 번호</label></div>
        <div class="col-auto">
          <input type="text" class="form-control form-control-sm mono" style="width:220px;" v-model="taskId" placeholder="예: F20260724-0031">
        </div>
      </div>
      <div class="row no-gutters mb-4" style="gap:12px;">
        <div class="export-item" style="flex:1 1 160px;" v-for="key in order.filter(k => k !== 'unknown')" :key="key">
          <span><b style="font-size:13px;">{{ labels[key] }}</b> <small class="text-muted ml-1">{{ classifyResult ? classifyResult[key].length : 0 }}</small></span>
          <button type="button" class="btn btn-sm btn-outline-primary py-0" :disabled="!classifyResult || classifyResult[key].length === 0" @click="downloadType(key)">다운로드</button>
        </div>
      </div>
      <hr class="my-4" style="border-top: 1px dashed var(--card-border);">
      <div class="btn-group-custom">
        <button type="button" class="btn btn-success btn-sm px-3" :disabled="uploading" @click="handleUpload">
          {{ uploading ? '업로드 중...' : (env === 'PROD' ? '[운영] 배포서버 업로드' : '[개발/검증] 배포서버 업로드') }}
        </button>
        <button type="button" class="btn btn-warning btn-sm px-3" :disabled="!executeEnabled || executing" @click="handleExecute">
          {{ executing ? '실행 중...' : (env === 'PROD' ? '[운영] Cleanup 실행' : '[개발/검증] Cleanup 실행') }}
        </button>
        <button type="button" class="btn btn-outline-secondary btn-sm px-3" :disabled="!executed || fetchingLog" @click="handleFetchLog">로그 조회</button>
        <button type="button" class="btn btn-outline-secondary btn-sm px-3" :disabled="!fullLog" @click="downloadFullLog">로그 다운로드</button>
      </div>
      <div class="mt-3" v-if="agentStatus.text" :class="agentStatus.isError ? 'alert alert-danger py-2' : 'alert alert-info py-2'" style="font-size:13px; border-radius:6px;">
        {{ agentStatus.text }}
      </div>
      <div v-if="agentLog" class="mt-3">
        <small class="text-muted mb-1 d-block">실행 결과 로그 (Agent Output)</small>
        <pre class="mono log-container log-agent p-3" style="max-height:260px; overflow-y:auto; white-space:pre-wrap;">{{ agentLog }}</pre>
      </div>
      <div v-if="fullLog" class="mt-3">
        <small class="text-muted mb-1 d-block">전체 로그 파일 내용 (Full Log)</small>
        <pre class="mono log-container log-full p-3" style="max-height:400px; overflow-y:auto; white-space:pre-wrap;">{{ fullLog }}</pre>
      </div>
    </div>
  </div>
</div>

