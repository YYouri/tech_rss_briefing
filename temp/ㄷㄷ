	/**
	 * XML 을 분석하여 문자열로 반환한다.
	 *
	 * @param node XML node
	 * 
	 * @return String
	 * 
	 * @throws TransformerException
	 * @throws IOException
	 */
	public static String toString(Element node) throws TransformerException, IOException {
		return toString(node, DEFAULT_ENCODING);
	}
	
	/**
	 * 파라미터로 받은 캐릭터셋을 이용하여 XML 을 분석하여 문자열로 반환한다.
	 *
	 * @param node XML node
	 * @param encoding 캐릭터셋
	 * 
	 * @return String
	 * 
	 * @throws TransformerException
	 * @throws IOException
	 */
	public static String toString(Element node, String encoding) throws TransformerException, IOException {
		node.normalize();

		StringWriter sw = new StringWriter();
		BufferedWriter bw = new BufferedWriter(sw);

		// 분석된 XML을 String으로 변환한다.
		Transformer transformer = XMLUtils.newTransformer();
		transformer.setOutputProperty(OutputKeys.INDENT, XMLUtils.INDENT_YES);
		transformer.setOutputProperty(OutputKeys.METHOD, XMLUtils.METHOD);
		transformer.setOutputProperty(OutputKeys.ENCODING, encoding);
		transformer.transform(new DOMSource(node), new StreamResult(bw));

		bw.flush();
		bw.close();
		return sw.toString();
	}

	/**
	 * XML 문자열에서 유효하지 않은 문자를 삭제한다.
	 *
	 * @param s XML 문자열
	 * 
	 * @return String
	 */
	public static String removeInvalidXMLCharacters(String s) {
		// Used to hold the output.
		StringBuilder out = new StringBuilder();
		// Used to reference the current character.
		int codePoint;
		// This is actualy one unicode character, represented by two code
		// units!!!.
		// String ss = "\ud801\udc00";
		// System.out.println(ss.codePointCount(0, ss.length()));// See: 1
		int i = 0;
		while (i < s.length()) {
			// System.out.println("i=" + i);
			// This is the unicode code of the character.
			codePoint = s.codePointAt(i);
			// Consider testing larger ranges first to improve speed.
			if ((codePoint == 0x9) || (codePoint == 0xA) || (codePoint == 0xD)
					|| ((codePoint >= 0x20) && (codePoint <= 0xD7FF))
					|| ((codePoint >= 0xE000) && (codePoint <= 0xFFFD))
					|| ((codePoint >= 0x10000) && (codePoint <= 0x10FFFF))) {
				out.append(Character.toChars(codePoint));
			}
			// Increment with the number of code units(java chars)
			// needed to represent a Unicode char.
			i += Character.charCount(codePoint);
		}
		return out.toString();
	}
	
	/**
	 * BusinessVO 를 XML로 변환한다. 변환시 xml 선언부와 root 태그는 제거한다.
	 * @param businessVO
	 * @return XML String
	 * @throws TransformerException
	 */
	public String toStringOnlyBodyXML(BusinessVO businessVO) throws DataParsingException {
		try {
			XmlBuilder builder = new XmlBuilder();
			
			Document doc = XMLUtils.getDocument(XMLUtils.addXmlDeclaration("<root></root>", DEFAULT_ENCODING));
			Element responseNode = XMLUtils.createNode(doc, (Element)doc.getFirstChild(), MessageConstants.BODY_RESPONSE_XINTERNET);
			builder.build(doc, businessVO, responseNode);
			
			return XMLUtils.removeXmlDeclaration(XMLUtils.toString((Element) responseNode));
		} catch (DataParsingException e) {
			throw e;
		} catch (Exception e) {
			throw new DataParsingException(e, "JEF54001", "");
		}
	}
		private void loadData() throws ConfigurationException {
		
		if (configManager == null || configManager.getURI() == null) {
			throw new ConfigurationException("JEF38001", CONFIG_NAME, CONFIG_FILE);	
		}

		HashMap<String, JobInfo> _tmpMap = new HashMap<String, JobInfo>();
		try {
			
			File _file = new File(new URI(configManager.getURI()));
			Document doc = XMLUtils.getDocument(_file);
			Node node = (Node) XMLUtils.getXPathValue(doc, "/root/jobs", XPathConstants.NODE);
			NodeList childs = node.getChildNodes();
			int len = childs.getLength();
			for (int i=0 ; i<len ; i++) {
				Node cnode = childs.item(i);
				if ("job".equals(cnode.getNodeName())) {
					JobInfo info = new JobInfo();
					readJobInfo(info, cnode);
					if (info.getJobName() != null) {
						_tmpMap.put(info.getJobName(), info);	
					}
				}
			}
		} catch (Exception e) {
			ConsoleLogger.fatal(CLASS_NAME + " 초기화 실패. 설정파일:" + CONFIG_FILE, e);
			Logger.fatal(CLASS_NAME + " 초기화 실패. 설정파일:" + CONFIG_FILE, e);
			throw new ConfigurationException("JEF38001", CONFIG_NAME, CONFIG_FILE);
		}
		schedulerMap = _tmpMap;
	}
	
