@GetMapping("/config-cleanup-status.json")
public ResponseEntity<Map<String, Object>> configCleanupStatus(
        @RequestParam("env") String env,
        @RequestParam("taskId") String taskId,
        @RequestParam(value = "since", defaultValue = "0") int since) {
    return configJobStatus("cleanup", env, taskId, since);
}

private ResponseEntity<Map<String, Object>> configJobStatus(String jobType, String env, String taskId, int since) {
    Map<String, Object> body = new HashMap<>();
    try {
        CleanupResourceService.AsyncJobStatus job = cleanupResourceService.getConfigJobStatus(jobType, env, taskId);
        body.put("success", true);
        body.put("status", job.getStatus()); // RUNNING / SUCCESS / FAILED
        body.put("log", job.getLogSince(since));   // since 이후 새로 쌓인 부분만
        body.put("logLength", job.getLogLength());  // 다음 폴링 때 since로 그대로 넘기면 됨
        if (!job.isRunning()) {
            body.put("exitCode", job.getExitCode());
        }
        return ResponseEntity.ok(body);
    } catch (IllegalStateException notFound) {
        body.put("success", false);
        body.put("message", notFound.getMessage());
        return ResponseEntity.status(HttpStatus.NOT_FOUND).body(body);
    } catch (Exception e) {
        logger.error("[Config Job Status Error] jobType: {}, env: {}, taskId: {}, message: {}", jobType, env, taskId, e.getMessage(), e);
        body.put("success", false);
        body.put("message", "상태 조회 실패: " + e.getMessage());
        return ResponseEntity.status(HttpStatus.INTERNAL_SERVER_ERROR).body(body);
    }
}

public static class BackupRequest {
    private String env;
    private String taskId;
    private java.util.List<String> paths;
    public String getEnv() {return env;}
    public void setEnv(String env) { this.env = env; }
    public String getTaskId() {    return taskId; }
    public void setTaskId(String taskId) { this.taskId = taskId; }
    public java.util.List<String> getPaths() { return paths; }
    public void setPaths(java.util.List<String> paths) { this.paths = paths; }
}

public static class UploadRequest {
    private String env;
    private String taskId;
    private Map<String, String> files;

    public String getEnv() { return env; }
    public void setEnv(String env) { this.env = env; }
    public String getTaskId() { return taskId; }
    public void setTaskId(String taskId) { this.taskId = taskId; }
    public Map<String, String> getFiles() { return files; }
    public void setFiles(Map<String, String> files) { this.files = files; }
}

public static class ExecuteRequest {
    private String env;
    private String taskId;

    public String getEnv() { return env; }
    public void setEnv(String env) { this.env = env; }
    public String getTaskId() { return taskId; }
    public void setTaskId(String taskId) { this.taskId = taskId; }
}
}
