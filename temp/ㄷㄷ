	}

	public static class ExecResult {
		private final int exitCode;
		private final String output;

		public ExecResult(int exitCode, String output) {
			this.exitCode = exitCode;
			this.output = output;
		}

		public int getExitCode() { return exitCode; }
		public String getOutput() { return output; }
		public boolean isSuccess() { return exitCode == 0; }
	}
	// 필드로 추가:
	private final ExecutorService configJobExecutor = Executors.newCachedThreadPool();
	private final ConcurrentHashMap<String, AsyncJobStatus> configJobs = new ConcurrentHashMap<>();
	
	/** 백업 작업을 백그라운드로 시작
	 * @throws Exception */
	public void startConfigBackupAsync(String env, String taskId, List<String> paths) throws Exception {
		validateTaskId(taskId);
		validateEnv(env);
		EnvConfig cfg = resolveEnv(env);
		if (paths == null || paths.isEmpty()) {
			throw new IllegalArgumentException("백업할 자원 목록이 없습니다.");
		}
		String key = "backup_" + env + "_" + taskId;
		AsyncJobStatus existing = configJobs.get(key);
		if (existing != null && existing.isRunning()) {
			throw new IllegalStateException("이미 백업이 진행 중입니다: " + taskId);
		}

		AsyncJobStatus job = new AsyncJobStatus();
		configJobs.put(key, job);

		logger.info("[형상자원-백업시작] env={} taskId={} 건수={}", env, taskId, paths.size());
		if(commonSyncService == null) {
			commonSyncService = (CommonSyncService) ApplicationContextProvider.getApplicationContext().getBean(CommonSyncService.class);
		}
		try {
			final DeployInfo deployInfo = commonSyncService.getDeployInfo();
			String BACKUP_ROOT = cfg.softm_back+File.separator+taskId+File.separator;
			if(deployInfo == null ) {
				logger.warn("[형상자원-백업로그인실패] env={} taskId={} 원인={}", env, taskId, "deployInfo is null..");
			}

			configJobExecutor.submit(() -> {
				int success = 0, fail = 0;

				// ==================================================================================
				// TODO: 아래 SolutionApiClient 부분을 실제 SDK 클래스/메서드 시그니처로 교체
				// ==================================================================================
				String token;
				try {
					token = login(deployInfo); 
					job.appendLog("[형상서버 연결 성공] "+deployInfo.getSoftmanager_ip() +" \n");
					if(token.equals("NONE")){
						throw new Exception("");
					}
				} catch (Exception loginError) {
					job.appendLog("[FAIL] 소프트매니저 로그인 실패 {frmadmin1} -\n");
					job.appendLog("SUMMARY: SUCCESS=0 FAIL=" + paths.size() + "\n");
					job.complete(1);
					logger.error("[형상자원-백업로그인실패] env={} taskId={} 원인={}", env, taskId, loginError.getMessage(), loginError);
					return;
				}
				try {
					for (int i = 0; i < paths.size(); i++) {
						String dirInfo = paths.get(i).replace("/", "\\");
						if(dirInfo.startsWith("\\")){
							dirInfo = dirInfo.substring(1);
						}
						String localFile = (BACKUP_ROOT + dirInfo).replace("\\", "/");

						if(logger.isDebugEnabled()){
							logger.debug("\t localFile: \n\t" + localFile);
							logger.debug("\t repoFile: \n\t" + dirInfo);
						}

						String filePath = localFile.replaceAll("//", "/");
						boolean isSuccess = false;

						try {
							int nRet = com.wbjsoft.module.softmanagerapi.CheckOut(token, dirInfo, localFile);

							if (nRet == WBJConstant.SMC_OK) {
								logger.info("[성공] Check Out 파일 정보 : " + filePath);
								job.appendLog("[SUCCESS] " + filePath + "\n");
								success++;
								isSuccess = true;
							} else {
								String failMsg = "[FAIL] " + filePath + " - " + nRet + " 코드 반환 됨";
								job.appendLog(failMsg + "\n");
								logger.error("[실패] Check Out 파일 정보 : " + filePath + " (Return Code: " + nRet + ")");
							}
						} catch (Exception e) {
							logger.error("[오류] Check Out 처리 중 예외 발생. 파일 경로: " + filePath, e);
							job.appendLog("[ERROR] " + filePath + " - 예외 발생\n");
						} finally {
							if (!isSuccess) {
								fail++;
							}
						}

					}

				} finally {
					try {
						logout(token); 
					} catch (Exception logoutError) {
						logger.warn("[형상자원-백업로그아웃실패] env={} taskId={} 원인={}", env, taskId, logoutError.getMessage());
					}
				}

				job.appendLog("SUMMARY: SUCCESS=" + success + " FAIL=" + fail + "\n");
				job.complete(fail == 0 ? 0 : 1);
				logger.info("[형상자원-백업완료] env={} taskId={} success={} fail={}", env, taskId, success, fail);
			});
		} catch (Exception e) {
			logger.error("[형상자원-백업로그인실패] env={} taskId={} 원인={}", env, taskId, e.getMessage(), e);
			throw e;
		}
	}
	public void startConfigCleanupAsync(String env, String taskId, List<String> paths) throws Exception {
		validateTaskId(taskId);
		validateEnv(env);
		if (paths == null || paths.isEmpty()) {
			throw new IllegalArgumentException("정리할 자원 목록이 없습니다.");
		}
		String key = "cleanup_" + env + "_" + taskId;
		AsyncJobStatus existing = configJobs.get(key);
		if (existing != null && existing.isRunning()) {
			throw new IllegalStateException("이미 자원정리가 진행 중입니다: " + taskId);
		}

		AsyncJobStatus job = new AsyncJobStatus();
		configJobs.put(key, job);

		logger.info("[형상자원-정리 시작] env={} taskId={} 건수={}", env, taskId, paths.size());
		if(commonSyncService == null) {
			commonSyncService = (CommonSyncService) ApplicationContextProvider.getApplicationContext().getBean(CommonSyncService.class);
		}
		try {
			final DeployInfo deployInfo = commonSyncService.getDeployInfo();
			if(deployInfo == null ) {
				throw new Exception("[형상자원-정리 시작] deployInfo is null..");
			}

			configJobExecutor.submit(() -> {
				int success = 0, fail = 0;

				String token;
				try {
					token = login(deployInfo); 
					job.appendLog("[형상서버 연결 성공] "+deployInfo.getSoftmanager_ip() +" \n");
					if(token.equals("NONE")){
						throw new Exception("형상서버 연결 실패");
					}
				} catch (Exception loginError) {
					job.appendLog("[FAIL] 소프트매니저 로그인 실패 {frmadmin1} -\n");
					job.appendLog("SUMMARY: SUCCESS=0 FAIL=" + paths.size() + "\n");
					job.complete(1);
					logger.error("[형상자원-정리로그인실패] env={} taskId={} 원인={}", env, taskId, loginError.getMessage(), loginError);
					return;
				}
				try {
					for (int i = 0; i < paths.size(); i++) {
						String path = paths.get(i);
						int idx = path.lastIndexOf("/");

						String dir = (idx == -1) ? "" : path.substring(0, idx);
						String fileName = (idx == -1) ? path : path.substring(idx + 1);
						
						String dirInfo = dir.replace("/", "\\");
						if(dirInfo.startsWith("\\")){
							dirInfo = dirInfo.substring(1);
						}
						
						if(!dirInfo.endsWith("\\")) {
							dirInfo = dirInfo+"\\";
						}
						
						if(logger.isDebugEnabled()){
							logger.debug("\t repoFile: \n\t" + dirInfo+".."+fileName);
						}

						boolean isSuccess = false;

						try {
							int nRet = com.wbjsoft.module.softmanagerapi.RemoveFile(token, dirInfo, fileName);

							if (nRet == -1) {
								String failMsg = "[FAIL] " + dirInfo+fileName + " - " + nRet + " 코드 반환 됨";
								job.appendLog(failMsg + "\n");
								logger.error("[실패] RemoveFile 파일 정보 : " + dirInfo+fileName + " (Return Code: " + nRet + ")");
								
							} else {
								logger.info("[성공] RemoveFile 파일 정보 : " + dirInfo+fileName);
								job.appendLog("[SUCCESS] " + dirInfo+fileName +"="+ nRet+"\n");
								success++;
								isSuccess = true;
							}
						} catch (Exception e) {
							logger.error("[오류] RemoveFile 처리 중 예외 발생. 파일 경로: " + dirInfo+fileName, e);
							job.appendLog("[ERROR] " + dirInfo+fileName + " - 예외 발생\n");
						} finally {
							if (!isSuccess) {
								fail++;
							}
						}

					}

				} finally {
					try {
						logout(token); 
					} catch (Exception logoutError) {
						logger.warn("[형상자원-정리로그아웃실패] env={} taskId={} 원인={}", env, taskId, logoutError.getMessage());
					}
				}

				job.appendLog("SUMMARY: SUCCESS=" + success + " FAIL=" + fail + "\n");
				job.complete(fail == 0 ? 0 : 1);
				logger.info("[형상자원-정리완료] env={} taskId={} success={} fail={}", env, taskId, success, fail);
			});
		} catch (Exception e) {
			logger.error("[형상자원-정리 실패] env={} taskId={} 원인={}", env, taskId, e.getMessage(), e);
			throw e;
		}
	}
	/** 삭제(자원정리) 작업을 백그라운드로 시작 (이 작업만의 로그인 -> 건건이 delete -> 이 작업만의 로그아웃) */
