	@Override
	public boolean initialize()
	{
		// system message resolver use message source of config file
		if (getSystemMessageSource() != null)
		{
			logger.debug("SystemMessageResolver use SystemMessageSource.");
			SystemMessageResolver.setMessageSource(getSystemMessageSource());
		}
		else
		{
			logger.debug("SystemMessageResolver use MessageSource.");
			SystemMessageResolver.setMessageSource(getMessageSource());
		}

		this.classLoaderManager.setInstrumentableMetadataCachesize(
				this.applicationLoader.getInstrumentableMetadataCachesizePerApplication());
		this.classLoaderManager.setClassTransformerMetadataCachesize(
				this.applicationLoader.getClassTransformerMetadataCachesizePerApplication());

		this.classLoaderManager.setClassloaderDelegate(this.applicationLoader.getClassLoaderDelegate());

		//[[ T#34 patch
		this.classLoaderManager.setNouseSnapshot(this.applicationLoader.isNouseSnapshot());
		//]] T#34 patch

		if( !Boolean.valueOf( System.getProperty( CONTAINER_FOR_BATCH)))
		{
			if( !( this.appHome= new File( this.applicationLoader.getApplicationHome())).exists() || !this.appHome.isDirectory())
			{
				logger.error( "configured application-home dir [{}] is not exist.", this.applicationLoader.getApplicationHome());
				return false;
			}
			AsyncTaskExecutorFactory.getAsyncTaskExecutor();
			try{ TransactionManagerFactory.getPlatformJtaTransactionManager();}catch( Exception e){}
			OperationTimeoutManager.getOperationTimeOutManager();
		}
		else
			batch= true;

		if( !StringUtils.hasText( this.applicationLoader.getDeployedHome()))
		{
			logger.error( "configured deploy-home dir [{}] is not exist.", this.applicationLoader.getDeployedHome());
			return false;
		}

		this.deployHome= new File( this.applicationLoader.getDeployedHome());
//		if( !deployHome.exists() && !( this.batch && this.applicationLoader.isNouseSnapshot()))
		if( !deployHome.exists() && !( this.applicationLoader.isNouseSnapshot()))
			this.deployHome.mkdirs();
		this.deployHome.deleteOnExit();


		// for legacy extractedHome clearance
		File extractedHome= new File( applicationLoader.getApplicationHome()+ File.separator+ EXTRACTED_PATH_SUFFIX);
		File[] entries= null;
		if( extractedHome.exists() && extractedHome.isDirectory())
		{
			entries= extractedHome.listFiles();
			for( File entry: entries)
			{
				if( entry.getName().endsWith( ".svn")) continue;
				ResourceUtils.deleteFile( entry);
			}
		}
		ResourceUtils.deleteFile( extractedHome);

		entries= this.deployHome.listFiles();
		if( entries!= null)
		{
			for( File entry: entries)
			{
				if( entry.getName().endsWith( ".svn")) continue;
				ResourceUtils.deleteFile( entry);
			}
		}

		try
		{
			String headerClassName= this.instanceContext.getRequestType().getHeaderClassName();
			URL resourceUrl= Thread.currentThread().getContextClassLoader().getResource(
					ClassUtils.convertClassNameToResourcePath( headerClassName)+ ClassUtils.CLASS_FILE_SUFFIX);

			if( resourceUrl!= null)
			{
				URLResource resource= new URLResource( resourceUrl);
//				ClassReader clsReader= new ClassReader( resource.getInputStream());
				byte[] classbytes= ClassResourceReader.readClassResource( resource.getInputStream());
				if( classbytes.length< 8) throw new IOException( "insufficient class bytes length.");
				ClassReader clsReader= new ClassReader( classbytes);
				ServiceIOmmFieldProperties iommFieldProperties= new ServiceIOmmFieldProperties();
				clsReader.accept( new IOmmTypeClassVisitor( null, iommFieldProperties, null), ClassReader.SKIP_DEBUG);
				this.headerProperties= iommFieldProperties.getFieldDescriptors( headerClassName);
			}
			else
			{
				logger.error( "header class resource can not be loaded.");
				return false;
			}
		}
		catch( Exception e)
		{
			logger.error( "can not load configured system header class [{}].",
					new Object[]{ this.instanceContext.getRequestType().getHeaderClassName(), e});
			return false;
		}

		Set<String> targetApplications= this.applicationLoader.getTargetApplications();
		if( targetApplications!= null && targetApplications.size()> 0)
		{
			Map<BxmApplication, File> candidateConfs= loadApplicationConfs( this.appHome, this.appHome);
			Set<BxmApplication> toDeployConfs= new HashSet<BxmApplication>();
			Map<String, BxmApplication> checkTos= new HashMap<String, BxmApplication>();
			for( BxmApplication cconf: candidateConfs.keySet())
				checkTos.put( cconf.getName(), cconf);

			for( String targetApplication: targetApplications)
			{
				BxmApplication conf= null;
				if( toDeployConfs.contains( targetApplication) || ( conf= checkTos.get( targetApplication))== null)
					continue;
				checkReferenceApplications( conf, checkTos, toDeployConfs);
			}

			for( BxmApplication bxmApplication: toDeployConfs)
				targetApplications.add( bxmApplication.getName());
		}


		if( this.instanceManager== null && this.applicationLoader.isAutodeploy())
		{
			try{ autoDeployApplicationCandidates();}
			catch( Throwable ath)
			{
				logger.error( "AutoDeploy Task of [{}/{}] is failed", new Object[]{ this.uuid, this.name, ath});
			}

			if( HOT== applicationLoader.getLoadingMode())
			{
				if( StringUtils.hasText( this.applicationLoader.getScheduleExpression()))
				{
					this.scheduledApplicationLoader= new ScheduledTaskRegistrar();
					this.scheduledApplicationLoader.addTriggerTask( this,
							new CronTrigger( this.applicationLoader.getScheduleExpression()));
					this.scheduledApplicationLoader.start( NamedExecutors.namedPrivilegedThreadFactory( "Framework_ApplicationLoader"));
				}
				else
				{
					this.scheduledApplicationLoader= new ScheduledTaskRegistrar();
					this.scheduledApplicationLoader.addTriggerTask( this,
							new PeriodicTrigger( this.applicationLoader.getRefreshInterval()));
					this.scheduledApplicationLoader.start( NamedExecutors.namedPrivilegedThreadFactory( "Framework_ApplicationLoader"));
				}
			}
		}

		if( this.instanceManager!= null)
		{
			this.instanceManager.getDeploySessionManager().addListener( new ApplicationDeploySessionListener( this));
			this.instanceManager.setFrameworkInstance( this);
		}
		else
		{
			if( this.chunkedResponseHandler!= null)
				this.chunkedResponseHandler.init( containerName);
		}

		logger.info( "[{}] current framework instance [{}] is initialized.", getUUID(), this);
		publishPostInitializeEvent( new InstanceEvent( this));

		if( !this.standalone && this.instanceManager== null && !this.applicationLoader.isAutodeploy())
		{
			logger.info( "application init deploy.");
			autoDeployApplicationCandidates();
		}

		return true;
	}

