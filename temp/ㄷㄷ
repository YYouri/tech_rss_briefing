	public void registerServiceInstance( String serviceName, ContainerManagedService serviceInstance)
	{
		if( this.services.containsKey( serviceName))
		{
			synchronized( this.serviceInstances)
			{
				this.serviceInstances.put( serviceName, serviceInstance);
			}
		}
	}

	public ContainerManagedService lookupServiceInstance( String serviceName) throws ServiceNotFoundException
	{
		ContainerManagedService instance= this.serviceInstances.get( serviceName);
		if( instance!= null) return instance;
		logger.debug( "request bean creation for service [{}].", serviceName);
		Object serviceInstance= this.applicationContext.getBean( serviceName);
		if( !( serviceInstance instanceof ContainerManagedService))
			throw new ServiceNotFoundException( this.applicationName, serviceName,
					"requested service type is not matched with [" + ContainerManagedService.class.getName()+ "].");

		synchronized( this.serviceInstances)
		{
			logger.debug( "register ContainerManagedBean Instance [{}].", serviceName);
			if( !isDestroyed())
				this.serviceInstances.put( serviceName, (ContainerManagedService)serviceInstance);
		}
		return (ContainerManagedService)serviceInstance;
	}

