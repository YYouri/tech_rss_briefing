      var tid = (this.taskId || "").trim();
      if (this.env === "PROD") {
        var ok = window.confirm("운영(PROD) 자원을 실제로 정리(삭제)합니다. 계속하시겠습니까?");
        if (!ok) return;
      }

      var paths = this.tableRows.map(function (row) { return buildFullPath(row.fileName, row.dirInfo); });

      this.cleaning = true;
      this.agentLog = "";
      this.agentStatus = { text: "자원정리 시작 중... (" + this.env + ")", isError: false };
      fetch("/api/resource-cleanup/config-cleanup.json", {
        method: "POST",
        headers: { "Content-Type": "application/json" },
        body: JSON.stringify({ env: this.env, taskId: tid, paths: paths }),
      })
        .then(function (res) { return res.json(); })
        .then(function (data) {
          if (!data.success) {
            self.agentStatus = { text: "자원정리 시작 실패: " + (data.message || "알 수 없는 오류"), isError: true };
            self.cleaning = false;
            return;
          }
          self.agentStatus = { text: "자원정리 중... (" + self.env + ", 건건이 처리라 시간이 걸릴 수 있어요)", isError: false };
          self.pollJobStatus("cleanup", tid, function (finalData) {
            self.cleaning = false;
            self.executed = true;
            var ok = finalData.status === "SUCCESS";
            self.agentStatus = { text: ok ? "자원정리 완료" : "자원정리 일부 실패 (로그 확인)", isError: !ok };
          });
        })
        .catch(function (err) {
          self.agentStatus = { text: "요청 실패: " + err.message, isError: true };
          self.cleaning = false;
        });
    },

    /**
     * jobType: "backup" 또는 "cleanup"
     * 진행 중에도 지금까지의 로그를 계속 화면에 반영하고, 끝나면 onDone 콜백 호출
     */
    pollJobStatus: function (jobType, taskId, onDone) {
      var self = this;
      var statusUrl = jobType === "backup"
        ? "/api/resource-cleanup/config-backup-status.json"
        : "/api/resource-cleanup/config-cleanup-status.json";
      var lastLogLength = 0; // 이 값 이후로 새로 쌓인 로그만 받아옴 (누적 재전송 방지)

      this._pollTimer = setInterval(function () {
        fetch(statusUrl + "?env=" + encodeURIComponent(self.env) + "&taskId=" + encodeURIComponent(taskId) + "&since=" + lastLogLength)
          .then(function (res) { return res.json(); })
          .then(function (data) {
            if (!data.success) {
              clearInterval(self._pollTimer);
              if (jobType === "backup") self.backingUp = false; else self.cleaning = false;
              self.agentStatus = { text: "상태 조회 실패: " + (data.message || "알 수 없는 오류"), isError: true };
              return;
            }

            // 새로 쌓인 부분만 이어붙임 (전체를 매번 덮어쓰지 않음)
            if (data.log) {
              if (jobType === "backup") self.backupLog += data.log;
              else self.agentLog += data.log;
            }
            if (typeof data.logLength === "number") lastLogLength = data.logLength;

            if (data.status === "RUNNING") return; // 계속 폴링

            clearInterval(self._pollTimer);
            onDone(data);
          })
          .catch(function (err) {
            clearInterval(self._pollTimer);
            if (jobType === "backup") self.backingUp = false; else self.cleaning = false;
            self.agentStatus = { text: "상태 폴링 실패: " + err.message, isError: true };
          });
      }, 3000);
    },
    handleFetchLog: function () {
      var self = this;
      var tid = (this.taskId || "").trim();
      this.fetchingLog = true;
      this.agentStatus = { text: "로그 조회 중...", isError: false };
      fetch("/api/resource-cleanup/log.json?env=" + encodeURIComponent(this.env) + "&taskId=" + encodeURIComponent(tid))
        .then(function (res) { return res.json(); })
        .then(function (data) {
          if (data.success) {
            self.fullLog = data.log;
            self.agentStatus = { text: "로그 조회 완료", isError: false };
          } else {
            self.agentStatus = { text: "로그 조회 실패: " + (data.message || "알 수 없는 오류"), isError: true };
          }
        })
        .catch(function (err) {
          self.agentStatus = { text: "로그 조회 요청 실패: " + err.message, isError: true };
        })
        .finally(function () { self.fetchingLog = false; });
    },
  },
  beforeDestroy: function () {
    // 페이지 이탈/컴포넌트 종료 시 폴링 타이머가 계속 도는 것 방지
    if (this._pollTimer) clearInterval(this._pollTimer);
  },
});
</script>
