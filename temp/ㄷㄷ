<!-- 수정된 menu.html -->

<!DOCTYPE html>

<html lang="ko">
<head>
    <meta charset="UTF-8">
    <title>Menu Test</title>
    <link href="/css/bootstrap.min.css" rel="stylesheet">
    <link href="/css/font-awesome/css/all.min.css" rel="stylesheet">
    <link href="/css/app-theme.css" rel="stylesheet">
    <style>
        /* 권한에 따라 메뉴를 숨기기 위한 기본 스타일 /
        .auth-menu { display: none; }
        / 메뉴바가 본문과 겹치지 않도록 설정 */
        #menuItem { width: 100%; }
    </style>
</head>
<body>
    <!-- [수정] <form> 태그를 제거했습니다. 메뉴는 데이터를 전송하는 양식이 아니므로 form이 있으면 동작이 꼬입니다. -->
    <div id="menuItem" class="container-fluid">
        <nav class="navbar navbar-expand-lg custom-navbar">
            <!-- 브랜드 영역 -->
            <a class="navbar-brand" href="javascript:void(0)" onclick="location.href='/imageHomeProcess.json'">배포 관리 시스템</a>
            
            <button class="navbar-toggler" type="button" data-toggle="collapse" data-target="#navbarSupportedContent">
                <span class="navbar-toggler-icon"></span>
            </button>

            <div class="collapse navbar-collapse" id="navbarSupportedContent">
                <ul class="navbar-nav mr-auto" id="main-menu-list">
                    <li class="nav-item active">
                        <a class="nav-link" href="javascript:void(0)" onclick="location.href='/imageHomeProcess.json'"><i class="fas fa-home"></i> Home</a>
                    </li>
                    
                    <!-- [권한: admin OR user] 공통 메뉴 -->
                    <li class="nav-item auth-menu user-admin-menu">
                        <a class="nav-link" href="javascript:void(0)" onclick="myFunc()"> (구)배포 로그 조회</a>
                    </li>
                    <li class="nav-item auth-menu user-admin-menu">
                        <a class="nav-link" href="javascript:void(0)" onclick="location.href='/logViewerProcess.json'">배포 로그 조회</a>
                    </li>

                    <!-- [권한: admin] 전용 메뉴 -->
                    <li class="nav-item auth-menu admin-only-menu">
                        <a class="nav-link" href="javascript:void(0)" onclick="location.href='/AgentCheckProcess.json'">Agent 모니터링</a>
                    </li>

                    <!-- 배포 설정 관리 (Dropdown) -->
                    <li class="nav-item dropdown auth-menu admin-only-menu">
                        <a class="nav-link dropdown-toggle" href="#" id="navbarDropdown1" role="button" data-toggle="dropdown" aria-haspopup="true" aria-expanded="false"> 
                            배포 설정 관리 
                        </a>
                        <div class="dropdown-menu" aria-labelledby="navbarDropdown1">
                            <a class="dropdown-item" href="javascript:void(0)" onclick="location.href='/MetaProcess.json'">메타 정보 관리</a>
                            <a class="dropdown-item" href="javascript:void(0)" onclick="location.href='/ConfigProcess.json'">시스템별 정보 관리</a>
                            <a class="dropdown-item" href="javascript:void(0)" onclick="location.href='/AgentProcess.json'">Agent 정보 관리</a>
                            <a class="dropdown-item" href="javascript:void(0)" onclick="location.href='/imageAuthProcess.json'">이미지 배포 관리</a>
                            <a class="dropdown-item" href="javascript:void(0)" onclick="location.href='/ApSchedule.json'">AP스케줄 관리</a>
                        </div>
                    </li>

                    <!-- 계정 관리 (Dropdown) -->
                    <li class="nav-item dropdown auth-menu admin-only-menu">
                        <a class="nav-link dropdown-toggle" href="#" id="navbarDropdownAcc" role="button" data-toggle="dropdown" aria-haspopup="true" aria-expanded="false">계정 관리</a>
                        <div class="dropdown-menu" aria-labelledby="navbarDropdownAcc">
                            <a class="dropdown-item" href="javascript:void(0)" onclick="location.href='/Imsync.json'">계정 동기화 관리</a>
                        </div>
                    </li>

                    <!-- 자원 관리 (Dropdown) -->
                    <li class="nav-item dropdown auth-menu admin-only-menu">
                        <a class="nav-link dropdown-toggle" href="#" id="navbarDropdownRes" role="button" data-toggle="dropdown" aria-haspopup="true" aria-expanded="false">자원 관리</a>
                        <div class="dropdown-menu" aria-labelledby="navbarDropdownRes">
                            <a class="dropdown-item" href="javascript:void(0)" onclick="location.href='/resDownloadProcess.json'">배포 자원 다운로드</a>
                            <a class="dropdown-item" href="javascript:void(0)" onclick="location.href='/DiffSoftmResource.json'">배포 자원 조회</a>
                            <div class="dropdown-divider"></div>
                            <a class="dropdown-item" href="javascript:void(0)" onclick="location.href='/CleanCisResource.json'">기간계 서버 자원 정리</a>
                            <a class="dropdown-item" href="javascript:void(0)" onclick="location.href='/CleanSoftmResource.json'">형상 서버 자원 정리</a>
                        </div>
                    </li>

                    <!-- 이미지 배포 (Dropdown) -->
                    <li class="nav-item dropdown auth-menu user-admin-menu">
                        <a class="nav-link dropdown-toggle" href="#" id="navbarDropdown3" role="button" data-toggle="dropdown" aria-haspopup="true" aria-expanded="false"> 이미지 배포 </a>
                        <div class="dropdown-menu" aria-labelledby="navbarDropdown3">
                            <a class="dropdown-item" href="javascript:void(0)" onclick="location.href='/imageProcess.json'">이미지 배포</a>
                        </div>
                    </li>

                    <!-- 배포 지원 기능 (Dropdown) -->
                    <li class="nav-item dropdown auth-menu special-user-menu">
                        <a class="nav-link dropdown-toggle" href="#" id="navbarDropdownSpecial" role="button" data-toggle="dropdown" aria-haspopup="true" aria-expanded="false">배포 지원 기능</a>
                        <div class="dropdown-menu" aria-labelledby="navbarDropdownSpecial">
                            <a class="dropdown-item" href="javascript:void(0)" onclick="location.href='/TestProcess.json'">배포 태스크 호출</a>
                            <a class="dropdown-item" href="javascript:void(0)" onclick="location.href='/queryProcess.json'">Query Execute</a>
                        </div>
                    </li>
                </ul>
            </div>

            <!-- 사용자 영역 -->
            <div class="ml-auto">
                <span class="navbar-user" id="user-name" style="color: var(--text-main); padding-right: 15px;"></span>
                <button class="btn-action" type="button" onclick="location.href='/logoutProcess.json'">
                    <i class="fas fa-sign-out-alt" style="margin-right:4px; font-size:12px;"></i> 로그아웃
                </button>
            </div>
        </nav>
    </div>
    <script src="/js/jquery.min.3.4.1.js"></script> 
    <script src="/js/popper.min.1.16.1.js"></script>
    <script src="/js/bootstrap.min.js"></script>
    <script type="text/javascript">
        function loadUserInfoAndMenu() {
            $.ajax({
                url: '/getUserInfo.json',
                type: 'GET',
                dataType: 'json',
                success: function(data) {
                    if (data) {
                        $('#user-name').text(data.response_username);
                        const groupId = data.response_group_id;
                        const userId = data.response_user_Id;
                        if (groupId === 'admin' || groupId === 'user') {
                            $('.user-admin-menu').show();
                        }
                        if (groupId === 'admin') {
                            $('.admin-only-menu').show();
                        }
                        if (userId === 'IB1192' || userId === 'IB1117') {
                            $('.special-user-menu').show();
                        }
                    } else {
                        $('#user-name').text("Guest");
                    }
                },
                error: function() {
                    $('#user-name').text("Error");
                }
            });
        }

        // [핵심 수정 부분]
        $(document).ready(function() {
            // 1. 권한 로드
            loadUserInfoAndMenu();

            // 2. [이벤트 위임] 메뉴 클릭(Dropdown)이 안 될 때를 대비한 강제 바인딩
            // 메뉴가 나중에 로드되어도 'document'가 클릭을 감지해서 처리합니다.
            $(document).on('click', '.dropdown-toggle', function (e) {
                // Bootstrap의 기본 동작을 실행시킵니다.
                $(this).parent().find('.dropdown-menu').toggleClass('show');
            });
        });

        function myFunc() {
            alert("기존 배포 로그 조회 기능을 실행합니다.");
        }
    </script>
</body>
</html>