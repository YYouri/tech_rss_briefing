	public DeployedResourceScannerConfigurer( Set<MetadataReader> beanCandidates, BeanDefinitionRegistry registry,
			DataSource containerDataSource, DataAccessContext dasContext, Map<String, ApplicationDataSource> datasources,
			ClassLoaderRef loaderRef, boolean useDefaultFilters, boolean sessionFactoryLazyInit, LazyInitFilter lazyInitFilter)
	{
		super( registry, useDefaultFilters);
		this.beanCandidates= beanCandidates;
		this.containerDataSource= containerDataSource;
		this.dasContext= dasContext;
		this.datasources= datasources;
		this.loaderRef= loaderRef;
		this.sessionFactoryLazyInit= sessionFactoryLazyInit;
		this.lazyInitFilter= lazyInitFilter;
		this.environment= new StandardEnvironment();
		try
		{
			Class<?> fc= Thread.currentThread().getContextClassLoader().loadClass( "org.apache.ibatis.logging.LogFactory");
			Field field= fc.getDeclaredField( "logConstructor");
			field.setAccessible( true);
			field.set( fc, EsIBatisLogger.class.getConstructor( new Class[]{ String.class}));	// mybatis 3.2 수정사항.
		}
		catch( Throwable th)
		{
			logger.error( th.getMessage(), th);
		}

		initPredefinedTypes();

		boolean isDaemon = false;
		String springBatchRepo = System.getProperty(SPRING_BATCH_RESPOSITORY);
		if(StringUtils.hasText(springBatchRepo))
		{
			if(SPRING_BATCH_RESPOSITORY_MAP.equals(springBatchRepo))
			{
				isDaemon = true;
			}
		}

		if(!Boolean.parseBoolean(System.getProperty(LOCAL_BATCH_EXECUTION)) && !isDaemon)
		{
			DasExceptionTranslator.dasExceptionTranslator( containerDataSource);
		}
	}

	@Override
	public Set<BeanDefinition> findCandidateComponents( String basePackage)
	{
		Set<BeanDefinition> candidates= new LinkedHashSet<BeanDefinition>();
		MetadataReaderFactory metadataReaderFactory= new CachingMetadataReaderFactory( getResourceLoader());
		try
		{
			for( MetadataReader reader: this.beanCandidates)
			{
				Resource resource= new UrlResource( reader.getResourceURL());

				try
				{
					if( isCandidateComponent( reader) && checkProfile( reader) && checkComponentType( reader))
					{
						GenericBeanDefinition bd= null;
						Set<String> annotations= new HashSet<String>();
						annotations.addAll( reader.getAnnotationMetadata().getAnnotationTypes());
						annotations.remove( BxmCategory.class.getName());

						if( annotations!= null && annotations.size()> 1)
						{
							org.springframework.core.type.classreading.MetadataReader metadataReader=
									metadataReaderFactory.getMetadataReader( resource);
							bd= new ScannedGenericBeanDefinition( metadataReader);

						}
						else
						{
							bd= new GenericBeanDefinition();
							bd.setBeanClassName( reader.getClassMetadata().getClassName());
						}

						bd.setResource( resource);
						bd.setSource( resource);

						if( this.lazyInitFilter!= null && this.lazyInitFilter.checkLazyInitRuleFilter(
								reader.getClassMetadata().getClassName(), this.loaderRef.getResourceLoader()))
							bd.addMetadataAttribute( new BeanMetadataAttribute( FORCEDLAZYINIT, true));

						candidates.add( bd);

						Map<String, Object> attributes= reader.getAnnotationMetadata().getAnnotationAttributes(
								DATAACCESS_OBJECT_ANNOTATION_CLASSNAME);
						if( attributes== null || attributes.size()== 0)
							attributes= reader.getAnnotationMetadata().getAnnotationAttributes(
									DATAACCESS_OBJECT_METAANNOTATION_CLASSNAME);
						if( attributes== null || attributes.size()== 0)
							continue;

						String datasource= (String)attributes.get( DATASORUCE_ATTRIBUTE_NAME);
						String mapper= (String)attributes.get( MAPPER_ATTRIBUTE_NAME);
						if( !StringUtils.hasText( datasource) || !StringUtils.hasText( mapper)) continue;

						if( !this.datasources.containsKey( datasource))
						{
							ApplicationResourceInitializer.logger.warn(
									"invalid datasource name in DBIO [{}/{}], this DBIO will be removed in registry.",
									datasource, bd.getBeanClassName());
							candidates.remove( bd);
						}

						defineMapperResources( datasource, reader.getClassMetadata().getClassName(), mapper);
						bd.getPropertyValues().add( MAPPER_INTERFACE_ATTRIBUTE, bd.getBeanClassName());
						bd.getPropertyValues().add( "addToConfig", true);
						if( this.mapperDefs.containsKey( datasource))
							this.mapperDefs.get( datasource).add( bd);
						else
						{
							List<GenericBeanDefinition> defs= new ArrayList<GenericBeanDefinition>();
							defs.add( bd);
							this.mapperDefs.put( datasource, defs);
						}
					}
				}
				catch( Throwable th)
				{
					throw new BeanDefinitionStoreException( "Failed to read candidate component class: " + resource, th);
				}
			}
		}
		catch( Exception ex)
		{
			throw new BeanDefinitionStoreException("failure during classpath scanning", ex);
		}
		return candidates;
	}

	private boolean checkComponentType( MetadataReader reader)
	{
		try
		{
			Set<String> annotationTypes= reader.getAnnotationMetadata().getAnnotationTypes();
			Set<String> metaAnnotationTypes=
					reader.getAnnotationMetadata().getMetaAnnotationTypes( DATAACCESS_OBJECT_METAANNOTATION_CLASSNAME);
			if( ( annotationTypes!= null && annotationTypes.contains( DATAACCESS_OBJECT_ANNOTATION_CLASSNAME)) ||
					( metaAnnotationTypes!= null && metaAnnotationTypes.contains( DATAACCESS_OBJECT_METAANNOTATION_CLASSNAME)))
				return ( reader.getClassMetadata().isInterface() && reader.getClassMetadata().isIndependent());
			else
				return ( reader.getClassMetadata().isConcrete() && reader.getClassMetadata().isIndependent());
		}
		catch( Throwable th)
		{
			logger.warn( "ignored invalid bean definition [{}].", new Object[]{ reader, th});
			return false;
		}
	}

	private boolean isCandidateComponent( MetadataReader reader) throws IOException
	{
		try
		{
			boolean managedType= ( reader.getAnnotationMetadata().hasAnnotation( MANAGED_OBJECT_ANNOTATION_CLASSNAME)
					|| reader.getAnnotationMetadata().hasMetaAnnotation( MANAGED_OBJECT_ANNOTATION_CLASSNAME)
					|| reader.getAnnotationMetadata().hasAnnotation( DATAACCESS_OBJECT_ANNOTATION_CLASSNAME)
					|| reader.getAnnotationMetadata().hasMetaAnnotation( DATAACCESS_OBJECT_METAANNOTATION_CLASSNAME)
					|| reader.getAnnotationMetadata().hasAnnotation( Component.class.getName())
					|| reader.getAnnotationMetadata().hasMetaAnnotation( Component.class.getName()));

			if( managedType) return true;

			boolean managedMethodContained= reader.getAnnotationMetadata().hasAnnotatedMethod(
					SERVICEOPERATION_ANNOTATION_CLASS.getName());

			if( managedMethodContained) return true;

			boolean jsrType= false;
			for( Class<?> type: JSRTypes)
			{
				jsrType= reader.getAnnotationMetadata().hasAnnotation( type.getName());
				if( jsrType) break;
			}

			if( jsrType) return true;

			return false;
		}
		catch( Throwable th)
		{
			//logger.warn( "ignored invalid resource [{}].",  new Object[]{ reader.getResourceURI(), th});
			ApplicationResourceInitializer.logger.warn( "ignored invalid resource [{}].",
					new Object[]{ reader.getResourceURL(), th});
			return false;
		}
	}

	protected boolean checkProfile( MetadataReader reader)
	{
		if( !reader.getAnnotationMetadata().hasAnnotation( Profile.class.getName()))
			return true;
		else
		{
			Map<String, Object> attributes= reader.getAnnotationMetadata().getAnnotationAttributes( Profile.class.getName());
			return this.environment.acceptsProfiles( (String[])attributes.get( "value"));
		}
	}

	@Override
	protected Set<BeanDefinitionHolder> doScan( String... basePackages)
	{
		Set<BeanDefinitionHolder> beanDefinitions= super.doScan( basePackages);
		registerSqlSessionFactory();

		if( Boolean.valueOf( System.getProperty( ApplicationContainerLoader.CONTAINER_FOR_BATCH)))
			registerBatchComponents( getRegistry());

		this.beanCandidates.clear();
		return beanDefinitions;
	}

	@Override
	protected void postProcessBeanDefinition( AbstractBeanDefinition beanDefinition, String beanName)
	{
		super.postProcessBeanDefinition( beanDefinition, beanName);

		BeanMetadataAttribute metaAttr= beanDefinition.getMetadataAttribute( FORCEDLAZYINIT);
		if( metaAttr!= null && metaAttr.getValue()!= null && Boolean.valueOf( metaAttr.getValue().toString()))
			beanDefinition.setLazyInit( true);
	}

	private void registerBatchComponents( BeanDefinitionRegistry registry)
	{
		GenericBeanDefinition beanDef= new GenericBeanDefinition();
		boolean isDaemon = false;
		String springBatchRepo = System.getProperty(SPRING_BATCH_RESPOSITORY);
		if(StringUtils.hasText(springBatchRepo))
		{
			if(SPRING_BATCH_RESPOSITORY_MAP.equals(springBatchRepo))
			{
				isDaemon = true;
			}
		}
		if(Boolean.parseBoolean(System.getProperty(LOCAL_BATCH_EXECUTION)) || isDaemon)
		{
			beanDef.setBeanClassName( LOCAL_JOBREPOSITORY_FACTORYBEAN_CLASSNAME);
		}
		else
		{
			beanDef.setBeanClassName( JOBREPOSITORY_FACTORYBEAN_CLASSNAME);
			beanDef.getPropertyValues().add( "tablePrefix", DEFAULT_TABLE_PREFIX);
			beanDef.getPropertyValues().add( "isolationLevelForCreate", DEFAULT_ISOLATION_LEVEL);
			beanDef.getPropertyValues().add( "dataSource", this.containerDataSource);
		}
		getRegistry().registerBeanDefinition( "jobRepository", beanDef);

		logger.debug( "jobRespository [{}] is registered.", beanDef);

		beanDef= new GenericBeanDefinition();
		beanDef.setBeanClassName( JOBLAUNCHER_BEAN_CLASSNAME);
		try {
			// jobRepository getBean Check..
			beanDef.getPropertyValues().add( "jobRepository", ( (BeanFactory)getRegistry()).getBean( "jobRepository"));
		} catch (Exception e) {
			logger.warn("jobRepository bean register error. {}. reload memory jobRepository.", e.getMessage());
			GenericBeanDefinition reloadBeanDef= new GenericBeanDefinition();
			reloadBeanDef.setBeanClassName( LOCAL_JOBREPOSITORY_FACTORYBEAN_CLASSNAME);
			getRegistry().registerBeanDefinition( "jobRepository", reloadBeanDef);
			beanDef.getPropertyValues().add( "jobRepository", ( (BeanFactory)getRegistry()).getBean( "jobRepository"));
			System.setProperty(LOCAL_BATCH_EXECUTION, "true");
		}

		getRegistry().registerBeanDefinition( "jobLauncher", beanDef);
		logger.debug( "jobLauncher [{}] is registered.", beanDef);

		beanDef= new GenericBeanDefinition();
		beanDef.setBeanClassName( JOBEXPLORER_FACTORYBEAN_CLASSNAME);
		beanDef.getPropertyValues().add( "dataSource", this.containerDataSource);
		getRegistry().registerBeanDefinition( "jobExplorer", beanDef);
		logger.debug( "jobExplorer [{}] is registered.", beanDef);

		beanDef= new GenericBeanDefinition();
		beanDef.setBeanClassName( JOBLOCATOR_BEAN_CLASSNAME);
		getRegistry().registerBeanDefinition( "jobRegistry", beanDef);
		logger.debug( "jobRegistry [{}] is registered.", beanDef);


		//** 2013.02.18 Kim Jinman
		//** 배치용 predefined bean 초기화 추가.
		if (Boolean.valueOf(System.getProperty(BXM_BATCH_USE_EXTENSION_BEAN, "false")) == true) {
			registerExtensionBatchComponents(registry);
		}
	}
