	public synchronized void destroy()
	{
		logger.info( "[{}] current framework instance [{}] will be destroyed.", getUUID(), this);

		if( this.scheduledApplicationLoader!= null)
			this.scheduledApplicationLoader.destroy();

		OperationTimeoutManager.getOperationTimeOutManager().close();

		stopInstanceManager();
		publishPrepareDestroyEvent( new InstanceEvent( this));

		String[] undeployeds= this.undeployedApplications.keySet().toArray( new String[this.undeployedApplications.size()]);
		for( String appName: undeployeds)
		{
			DeployedApplication application= this.undeployedApplications.remove( appName);
			if( application!= null)
			{
				application.setStage( ApplicationStage.THROWABLE);
				application.destroy();
			}
		}

		undeployeds= this.validatingApplications.keySet().toArray( new String[this.validatingApplications.size()]);
		for( String appName: undeployeds)
		{
			DeployedApplication application= this.validatingApplications.remove( appName);
			if( application!= null)
			{
				application.setStage( ApplicationStage.THROWABLE);
				application.destroy();
			}
		}

		undeployeds= this.deployedApplications.keySet().toArray( new String[this.deployedApplications.size()]);
		for( String appName: undeployeds)
		{
			DeployedApplication application= this.deployedApplications.remove( appName);
			if( application!= null)
			{
				application.setStage( ApplicationStage.THROWABLE);
				application.destroy();
			}
		}

		if( this.instanceManager!= null)
			this.instanceManager.getDeploySessionManager().destroy();

		if( this.datasource instanceof BasicDataSource)
			try{ ( (BasicDataSource)this.datasource).close();}catch( SQLException e){}
//		else if( this.datasource instanceof PooledDataSource)
//			try{ ( (PooledDataSource)this.datasource).close();}catch( Exception e){}

		if( this.jmsConnector!= null)
			this.jmsConnector.destroy();

		if( this.messageService!= null)
			this.messageService.destroy();


		this.classLoaderManager.destroy( true);
		if( this.deployHome!= null && this.deployHome.exists())
			ResourceUtils.deleteFile( this.deployHome);
		this.destroyedTime= System.currentTimeMillis();
		
		AsyncTaskExecutorFactory.closeAsyncTaskExecutor();
	}

