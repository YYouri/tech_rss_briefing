	
#!/bin/bash

set -euo pipefail

# ==================================================
# [설정 구역]
# ==================================================
REQUEST_DIR="/NFS/IDES/PMS/CIS_RM/TASK_ID"
STAGING_JAVA="/NFS/IDES/PMS/CIS/STAGING/JAVA"
STAGING_BATCH="/NFS/IDES/PMS/CIS/STAGING/JAVA/BATCH"
STAGING_BATCH_SRC="/NFS/IDES/PMS/CIS/STAGING/JAVA/BATCH_SOURCE"
STAGING_WEB="/NFS/IDES/PMS/CIS/STAGING/WEB"
TARGET_COWEB="/NFS/QA/QCOWEB"
TARGET_DPWEB="/NFS/QA/QDPWEB"
TARGET_COWAS="/Appl/Online"
TARGET_BATCH="/Appl/Batch"

# ==================================================
# [설정 구역 끝]
# ==================================================

if [ "$#" -lt 1 ]; then
  echo "사용법: $0 <신청서파일> [TASK_ID]"
  exit 1
fi

INPUT_FILE="$1"
if [ ! -f "$INPUT_FILE" ]; then
  echo "[에러] 신청서 파일을 찾을 수 없습니다: $INPUT_FILE"
  exit 1
fi

if [ "$#" -ge 2 ]; then
  TASK_ID="$2"
else
  TASK_ID=$(basename "$INPUT_FILE")
  TASK_ID="${TASK_ID%.*}"
fi

TODAY_DIR="${REQUEST_DIR}/$(date +%Y)/$(date +%m)/$(date +%d)"
OUT_DIR="${TODAY_DIR}/${TASK_ID}"
mkdir -p "$OUT_DIR"

echo "=================================================="
echo " 신청서       : $INPUT_FILE"
echo " TASK_ID      : $TASK_ID"
echo " 출력 위치    : $OUT_DIR"
echo "=================================================="

# --------------------------------------------------
# [핵심 유틸] 대소문자 무관하게 "/키워드/" 뒤의 상대경로를 잘라낸다
#   awk 프로세스 하나 안에서 위치 찾기(tolower+index) + 자르기(substr)를
#   전부 처리한다 - awk와 cut을 따로 섞어 쓰면 로케일/인코딩에 따라
#   둘의 문자 기준이 어긋날 수 있어(중간 경로 누락 원인), 반드시 한 도구로 통일.
#   반환: 성공 시 상대경로(trailing / 제거), 실패 시 빈 문자열
# --------------------------------------------------
extract_after() {
  # $1 = 원본 경로(대소문자 보존), $2 = 찾을 키워드(슬래시 없이, 예: "src")
  awk -v orig="$1" -v kw="$2" '
    BEGIN {
      lower = tolower(orig)
      marker = "/" kw "/"
      pos = index(lower, marker)
      if (pos > 0) {
        rel = substr(orig, pos + length(marker))
        sub(/[ \t\/]+$/, "", rel)
        print rel
      } else {
        print ""
      }
    }
  '
}

# --------------------------------------------------
# [핵심 유틸] 대소문자 무관 부분 문자열 포함 여부 (case문 글롭 매칭 - POSIX 호환)
# --------------------------------------------------
contains_ci() {
  # $1 = 원본 문자열, $2 = 찾을 키워드(소문자, 슬래시 포함해서 넘김 예: "/src/")
  local lower_str
  lower_str=$(printf '%s\n' "$1" | tr '[:upper:]' '[:lower:]')
  case "$lower_str" in
    *"$2"*) return 0 ;;
    *) return 1 ;;
  esac
}

# 타입별 경로를 모아둘 배열 (신청서 전체 기준으로 누적 - 취합의 핵심)
declare -a ONLINE_PATHS=()
declare -a BATCH_PATHS=()
declare -a COWEB_PATHS=()
declare -a DPWEB_PATHS=()
declare -a LOCAL_PATHS=()
declare -a UNKNOWN_LINES=()

LINE_NO=0

while IFS= read -r line || [ -n "$line" ]; do
  LINE_NO=$((LINE_NO + 1))

  # 윈도우 개행(\r) 제거
  line=$(printf '%s\n' "$line" | tr -d '\r')

  # 빈 줄/주석 건너뜀
  case "$line" in
    ""|"#"*) continue ;;
  esac

  # 공백/탭 기준 파일명 / 경로 분리 (일반 read - here-string 미사용)
  FILE_NAME=""
  DIR_INFO=""
  EXTRA=""
  # 첫 번째 필드(파일명)만 뽑고, 그 이후 전부(내부 공백 포함)를 경로로 취급.
  # read로 필드를 나누면 경로 중간에 우연히 공백이 껴있을 때 그 뒤가
  # 통째로 잘려나가는 문제가 있어(예: "hi\dbio cdo\..." -> "hi\dbio"에서 끊김),
  # 반드시 "첫 필드 이후 나머지 전체"를 그대로 보존해야 한다.
  FILE_NAME=$(printf '%s\n' "$line" | awk '{print $1}')
  DIR_INFO=$(printf '%s\n' "$line" | sed 's/^[^ 	]*[ 	]*//')
  # 줄 끝에 남은 공백/탭 제거 (신청서 원본에 트레일링 공백이 섞여 오는 경우 대비)
  DIR_INFO=$(printf '%s\n' "$DIR_INFO" | sed 's/[ 	]*$//')

  if [ -z "$FILE_NAME" ] || [ -z "$DIR_INFO" ]; then
    echo "[경고] ${LINE_NO}번째 줄 형식 오류, UNKNOWN 처리: $line"
    UNKNOWN_LINES+=("$line")
    continue
  fi

  # 경로 정규화 (\ -> /)
  DIR_PATH=$(printf '%s\n' "$DIR_INFO" | tr '\\' '/')
  BASE_FILE=$(basename "$FILE_NAME")

  MATCHED="false"

  # -----------------------------------------------------------------
  # [CASE 1] ONLINE Java
  # -----------------------------------------------------------------
  LOWER_FILE=$(printf '%s\n' "$BASE_FILE" | tr '[:upper:]' '[:lower:]')
  case "$LOWER_FILE" in
    *.java)
      if contains_ci "$DIR_PATH" "/online/" && contains_ci "$DIR_PATH" "/src/"; then
        MATCHED="true"
        CLASS_NAME="${BASE_FILE%.*}.class"
        RELATIVE_PATH=$(extract_after "$DIR_PATH" "src")
        ONLINE_PATHS+=("${TARGET_COWAS}/EAR/WEB/WEB-INF/classes/${RELATIVE_PATH}/${CLASS_NAME}")
        BATCH_PATHS+=("${TARGET_BATCH}/classes/${RELATIVE_PATH}/${CLASS_NAME}")
        LOCAL_PATHS+=("${STAGING_JAVA}/ONLINE/WEB/WEB-INF/classes/${RELATIVE_PATH}/${CLASS_NAME}")
        LOCAL_PATHS+=("${STAGING_JAVA}/ONLINE_SOURCE/${RELATIVE_PATH}/${BASE_FILE}")
      elif contains_ci "$DIR_PATH" "/batch/" && contains_ci "$DIR_PATH" "/src/"; then
        MATCHED="true"
        CLASS_NAME="${BASE_FILE%.*}.class"
        RELATIVE_PATH=$(extract_after "$DIR_PATH" "src")
        BATCH_PATHS+=("${TARGET_BATCH}/classes/${RELATIVE_PATH}/${CLASS_NAME}")
        LOCAL_PATHS+=("${STAGING_BATCH}/classes/${RELATIVE_PATH}/${CLASS_NAME}")
        LOCAL_PATHS+=("${STAGING_BATCH_SRC}/${RELATIVE_PATH}/${BASE_FILE}")
      fi
      ;;
    *.xml)
      if contains_ci "$DIR_PATH" "/batch/" && contains_ci "$DIR_PATH" "/config/"; then
        MATCHED="true"
        RELATIVE_PATH=$(extract_after "$DIR_PATH" "config")
        BATCH_PATHS+=("${TARGET_BATCH}/config/${RELATIVE_PATH}/${BASE_FILE}")
        LOCAL_PATHS+=("${STAGING_BATCH}/config/${RELATIVE_PATH}/${BASE_FILE}")
      fi
      ;;
  esac

  # -----------------------------------------------------------------
  # [CASE] WEB 계열 (COWEB / DPWEB) - 확장자 무관, 위에서 안 걸린 경우만
  # -----------------------------------------------------------------
  if [ "$MATCHED" = "false" ] && contains_ci "$DIR_PATH" "/web/"; then
    MATCHED="true"
    WEB_REL_PATH=$(extract_after "$DIR_PATH" "web")
    if contains_ci "$DIR_PATH" "/distribution/"; then
      DPWEB_PATHS+=("${TARGET_DPWEB}/${WEB_REL_PATH}/${BASE_FILE}")
      LOCAL_PATHS+=("${STAGING_WEB}/DPWEB/${WEB_REL_PATH}/${BASE_FILE}")
    else
      # coweb은 "web/" 바로 다음에 프로젝트 코드(예: LT)가 한 번 더 중복으로
      # 붙어있어 이 첫 세그먼트는 버리고 그 다음부터를 실제 상대경로로 쓴다.
      case "$WEB_REL_PATH" in
        */*) COWEB_REL=$(printf '%s\n' "$WEB_REL_PATH" | sed 's/^[^/]*\///') ;;
        *)   COWEB_REL="" ;;
      esac
      COWEB_PATHS+=("${TARGET_COWEB}/${COWEB_REL}/${BASE_FILE}")
      LOCAL_PATHS+=("${STAGING_WEB}/COWEB/${COWEB_REL}/${BASE_FILE}")
    fi
  fi

  # -----------------------------------------------------------------
  # [CASE] 기타 BATCH (src/config 패턴이 없는 경우의 기본값)
  #   ※ 목적지 규칙이 불명확하여 원본 상대경로를 최대한 보존. 확인 필요.
  # -----------------------------------------------------------------
  if [ "$MATCHED" = "false" ] && contains_ci "$DIR_PATH" "/batch/"; then
    MATCHED="true"
    RELATIVE_PATH=$(extract_after "$DIR_PATH" "batch")
    BATCH_PATHS+=("${TARGET_BATCH}/${RELATIVE_PATH}/${BASE_FILE}")
  fi

  if [ "$MATCHED" = "false" ]; then
    echo "[미분류] $FILE_NAME ($DIR_PATH)"
    UNKNOWN_LINES+=("$line")
  fi

done < "$INPUT_FILE"

# --------------------------------------------------
# 결과 파일 저장 (내용이 있는 타입만 생성)
# --------------------------------------------------
write_if_any() {
  local outfile="$1"; shift
  if [ "$#" -gt 0 ]; then
    printf '%s\n' "$@" > "$outfile"
    echo "[생성] $outfile ($# 줄)"
  fi
}

write_if_any "${OUT_DIR}/${TASK_ID}_online.txt" "${ONLINE_PATHS[@]}"
write_if_any "${OUT_DIR}/${TASK_ID}_batch.txt"  "${BATCH_PATHS[@]}"
write_if_any "${OUT_DIR}/${TASK_ID}_coweb.txt"  "${COWEB_PATHS[@]}"
write_if_any "${OUT_DIR}/${TASK_ID}_dpweb.txt"  "${DPWEB_PATHS[@]}"
write_if_any "${OUT_DIR}/${TASK_ID}_local.txt"  "${LOCAL_PATHS[@]}"

if [ "${#UNKNOWN_LINES[@]}" -gt 0 ]; then
  printf '%s\n' "${UNKNOWN_LINES[@]}" > "${OUT_DIR}/${TASK_ID}_unknown.txt"
  echo "[주의] 미분류 ${#UNKNOWN_LINES[@]}건 -> ${OUT_DIR}/${TASK_ID}_unknown.txt (수동 확인 필요)"
fi

echo "=================================================="
echo " 완료: online=${#ONLINE_PATHS[@]} batch=${#BATCH_PATHS[@]} coweb=${#COWEB_PATHS[@]} dpweb=${#DPWEB_PATHS[@]} local=${#LOCAL_PATHS[@]} unknown=${#UNKNOWN_LINES[@]}"
echo "=================================================="


