	public void resetValidClientPatterns( String... ipPatterns)
	{
		if( ipPatterns== null) return;
		this.validatingClients= ipPatterns;
		Pattern[][] patternsToUse= new Pattern[ipPatterns.length][];
		int index= 0;
		for( String validStr: ipPatterns)
		{
			List<Pattern> patterns= new ArrayList<Pattern>();
			String[] applyTokens= StringUtils.tokenizeToStringArray( validStr, ".");
			for( int i= 0; i< applyTokens.length; i++)
				patterns.add( Pattern.compile( StringUtils.replace( applyTokens[i], "*", "(\\d{1,3})")));

			patternsToUse[index++]= patterns.toArray( new Pattern[patterns.size()]);
		}
		this.validClientPatterns= patternsToUse;
	}

	public void resetValidClientPatterns()
	{
		this.validClientPatterns= new Pattern[0][0];
	}

