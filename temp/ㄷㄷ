var folderArray;
var fileCount = 0;
var totalCount = 10;
var fileNum = 0;
var content_files = new Array();

$(document).ready(function(){
	$("#input_file").on("change", fileCheck);	
	
	// 경로추가 / 경로삭제 / 이름변경 / 파일삭제 / 배포버튼
	$("#m_add").bind("click", {isParent:true}, add);
	$("#m_del").bind("click", remove);
	$("#m_modi").bind("click", edit);
	$("#m_reset").bind("click", refreash);
	$("#mf_del").bind("click", deleteAction);	
	$("#prodDeploy").bind("click", prodDeploy);
	
	// 서버구분 선택시 화면 선택초기화
	$("input:radio[name=serverType]").click(function(){
		initTreeAndList();
		initUploadType();
		
		if($("input:radio[name=serverType]")[0].checked == true){
			$("label[for='uploadType2']").text('검증배포');	
			$("#prodDeploy").text('검증계 배포');	
			$('#uploadType').attr('disabled', false);
			$('#btn-upload').attr('disabled', false);
			$('#projectMno').attr('disabled', true);	
			getServerList();
		}
		if($("input:radio[name=serverType]")[1].checked == true){
			$("label[for='uploadType2']").text('직접배포');
			$("#prodDeploy").text('운영계 직접배포');
			$("input:radio[name=uploadType]")[0].checked = true;
			$('#projectMno').attr('disabled', false);
			$('#upload').css("display", "");
			$('#prodDeploy').css("display", "none");
			getServerList();
		}
	});
	
	// 기능 선택시 화면 초기화 
	$("input:radio[name=uploadType]").click(function(){
		if($("input:radio[name=uploadType]")[0].checked == true){
			$('#upload').css("display", "");
			$('#prodDeploy').css("display", "none");
			$('#btn-upload').attr('disabled', false);
			$('#projectMno').attr('disabled', false);			
		}
		else if($("input:radio[name=uploadType]")[1].checked == true){
			$('#upload').css("display", "none");
			$('#prodDeploy').css("display", "");
			$('#btn-upload').attr('disabled', true);
			$('#projectMno').attr('disabled', true);
		}
		initTreeAndList();
	});
});

// 파일추가 버튼
$(function(){
	$('#btn-upload').click(function(e){
		e.preventDefault();
		$('#input_file').click();
	});
});

// 파일 추가시 파일목록 체크
function fileCheck(e) {
    var files = e.target.files;
    var filesArr = Array.prototype.slice.call(files);
    var msg;
	
    if(fileCount + filesArr.length > totalCount) {
        msg = "최대 등록 갯수는 "+totalCount+"개 입니다." + "<br>선택한 파일 : " + filesArr.length + "개 / 등록한 파일 : " + fileCount + "개";
        errorAlert("업로드 갯수 초과", msg, "error", "", false);

	    //초기화 한다.
	    $("#input_file").val("");
		return false;
		
    } else {
		fileCount = fileCount + filesArr.length;
    }
    
    // 중복 업로드 목록 체크
    for(var i=0; i<filesArr.length; i++){
    	var file = filesArr[i];
    	var filePath = file.value;
    	
        for(var j=0; j<content_files.length; j++){
        	
        	if((filesArr[i].name == content_files[j].name) && content_files[j].is_delete != true){
        		msg = filesArr[i].name;
        		errorAlert("동일한 파일이 존재 합니다.", msg, "info", "", false);

        	    //초기화 한다.
        	    $("#input_file").val("");
        		return false;
        	}
        }
    }
    
    // 각각의 파일 배열담기 및 기타
    filesArr.forEach(function (f) {
		var reader = new FileReader();
	    
		content_files.push(f);
    	reader.onload = function (e) {
           	$('#articlefileChange').append(
    	      		'<div id="file' + fileNum + '" >'
          			+ '<font style="font-size:12px">' + f.name + '</font>'  
          			+ '&nbsp;&nbsp;<img src="/images/icon_minus.png" onclick="fileDelete(\'file' + fileNum + '\', \'' + f.name + '\')" style="width:20px; height:auto; vertical-align: middle; cursor: pointer;"/>'
          			+ '<div/>'
    		);
    		fileNum++;
    	};
    	
    	reader.readAsDataURL(f);
	});
    
    //초기화 한다.
    $("#input_file").val("");
}

// 파일 업로드 목록 삭제
function fileDelete(fileNum, fileName){
	
	var no = fileNum.replace(/[^0-9]/g, "");	
	
	for(var a=0; a<content_files.length; a++){
		if(content_files[a].name == fileName){
			content_files[a].is_delete = true;
		}
	}    
	
	$('#' + fileNum).remove();
	fileCount--;
}

//대상 시스템 셀렉트 박스 선택시 파일트리 정보 로드
$(function(){
	$('#targetSystem').change(function(e){
		e.preventDefault();

		var ftpPath = $('#targetSystem option:selected').val();
		var targetCode = $('#targetSystem').val().split('/');
		$('#existQA').val(targetCode[2]);
		
		
		if($('#targetSystem option:selected').val() != "none"){
			$.ajax({
				type:'POST',
		        url : "/imageLoadFtpDir.json",
		        cache : false,
		        data : $("#imageUploadForm").serialize(),
		        contentType: "application/x-www-form-urlencoded; charset=euc-kr",
				dataType: 'JSON',
		        success : function(data){
		        	$('#connectedTargetSystem').val(data.connectedTargetSystem);
		        	console.log("treeData : " + data.treeData);
		        	folderArray = data.treeData;	
		        	console.log("folderArray : " + JSON.stringify(folderArray));
		        	
		        	$.fn.zTree.init($("#treeDemo"), setting, folderArray);
					rMenu = $("#rMenu");
		        },
		        error:function(request,status,error){
					errorAlert("FTP 연결 실패", "", "error", "imageProcess.json", true);
		        }
		    });
		}
		else{
			content_files = new Array();
	    	$.fn.zTree.init($("#treeDemo"), setting, "");	
			$('#filePath').val("");
			$('#articlefileChange').children("div").remove();
			fileCount = 0;
			
		}
	});
});

function initTreeAndList(){
	$('#targetSystem').prop('selectedIndex', 0);
	$('#projectMno').prop('selectedIndex', 0);
	$('#filePath').val("");
	$.fn.zTree.init($('#treeDemo'), setting, "");
	
	$('#articlefileChange').children("div").remove();
	content_files = new Array();
	fileCount = 0;
}

function initUploadType(){
	
	$("input:radio[name=uploadType]")[0].checked = true;
	$('#btn-upload').attr('disabled', false);
	$('#projectMno').attr('disabled', false);	
	
	$('#upload').css("display", "");
	$('#prodDeploy').css("display", "none");
	fileCount = 0;
}

//서버 구분 선택시 검증계 서버 여부에 맞는 대상시스템 리스트
//검증 : 검증계 서버 있는 대상시스템만 / 운영 : 검증계 서버 없는 대상시스템만
function getServerList(){
	
	var form = $("form")[1];        
 	var formData = new FormData(form);
	
 	$.ajax({
 		type: "POST",          
		url: "/imageServerList.json",
		data: formData,          
        processData: false,    
        contentType: false,      
        cache: false,
        dataType: 'JSON',
		success: function (data) {
			$('#targetSystem option').after().remove();
			$('#targetSystem').append("<option value='none'>시스템 이름</option>");
			for(i=0; i<data.serverList.length; i++){
        		var option = $("<option value='"+data.serverList[i].sys_code+"/"+data.serverList[i].sys_name + "/" + data.serverList[i].value + "'>"+data.serverList[i].sys_code+" ("+data.serverList[i].sys_name+")</option>");
            	$('#targetSystem').append(option);
        	}
		},
		error: function (xhr, status, error) {
			errorAlert("대상 시스템 리스트를 가져오지 못했습니다.", "", "error", "imageProcess.json", true);
		}
	});
 	
	return false;
}

// 파일 업로드 버튼
function registerAction(){
	
	var form = $("form")[1];        
 	var formData = new FormData(form);
 	var filePath = form.filePath.value;
 	var targetSystem = form.targetSystem.value;
 	
 	for (var x = 0; x < content_files.length; x++) {
		// 삭제 안한것만 담아 준다. 
		if(!content_files[x].is_delete){			
			formData.append("attachedFiles", content_files[x]);
		}
	}

	if($('#uploadSystem').val() == ""){
		Swal.fire("대상 시스템을 선택해주세요.", "", "info");
		return false;
	}	

	if(content_files.length == 0 ){
		Swal.fire("업로드 파일이 없습니다.", "", "info");
		return false;
	}
	
	if($('#filePath').val() == ""){
		Swal.fire("업로드 경로를 선택해주세요", "", "info");
		return false;
	}

	if($("input:radio[name=serverType]:checked").val() == "PROD" && $('#projectMno').val() == "none" && $('#operatorConfirm').val() == "N"){
		Swal.fire("프로젝트 번호를 선택해주세요.", "", "info");
		return false;
	}
	
 	$.ajax({
 		type: "POST",          
        enctype: 'multipart/form-data',
		url: "/imageFtpUpload.json",
		data: formData,          
        processData: false,    
        contentType: false,      
        cache: false,
		beforeSend: function() {
			Swal.fire({
                title: '처리 중 입니다.',
                showConfirmButton: false,
                willOpen: () => {
                    Swal.showLoading()
                },
            });
	    },
		success: function (data) {
			console.log(data);
			errorAlert("파일업로드 성공", "", "success", "", false);
			// 파일트리 새로고침, 파일목록 / 경로 초기화
			refreash();
			content_files = new Array();
			$('#filePath').val("");
			$('#articlefileChange').children("div").remove();
			fileCount = 0;
		},
		error: function (xhr, status, error, request) {
			errorAlert("서버오류로 업로드가 실패 했습니다.", "", "error", "imageProcess.json", true);
		}
	});
 	
	return false;
}

