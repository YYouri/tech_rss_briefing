<!DOCTYPE html>
<html lang="ko">
<head>
<meta charset="UTF-8">
<title>소프트매니저 자원 관리 시스템</title>
<!-- 기존 라이브러리 유지 -->
<link href="../css/bootstrap.min.css" rel="stylesheet">
<link href="../css/jquery-ui.min.css" rel="stylesheet">
<link href="../css/custom.css" rel="stylesheet">
<link href="../css/font-awesome/css/all.min.css" rel="stylesheet">

<style>
  /* [shadcn/ui 기반 리디자인 스타일] */
  :root {
    --background: #fafafa;
    --card: #ffffff;
    --card-border: #e4e4e7;
    --card-border-dark: #d4d4d8;
    --text-main: #18181b;
    --text-muted: #71717a;
    --text-faint: #a1a1aa;
    --primary: #18181b;
    --primary-hover: #27272a;
    --accent: #f59e0b; /* 경고/주의용 */
    --radius-lg: 10px;
    --radius-md: 6px;
    --radius-pill: 999px;
    --shadow: 0 1px 2px rgba(0,0,0,0.03);
  }

  body { 
    background-color: var(--background); 
    font-family: -apple-system, BlinkMacSystemFont, "Segoe UI", "Malgun Gothic", Roboto, sans-serif; 
    color: var(--text-main); 
    margin: 0; 
  }

  /* 본문 컨테이너 */
  #app { 
    max-width: 980px; 
    margin: 0 auto; 
    padding: 40px 24px 80px; 
  }

  /* 페이지 타이틀 블록 */
  .page-header { margin-bottom: 32px; }
  .eyebrow { font-size: 12px; font-weight: 700; color: var(--text-faint); text-transform: uppercase; margin-bottom: 4px; }
  .page-title { font-size: 1.4rem; font-weight: 600; color: var(--text-main); margin: 0; }
  .page-desc { font-size: 13px; color: var(--text-muted); margin-top: 4px; }

  /* 섹션 카드 스타일 */
  .section-card { 
    background: var(--card); 
    border: 1px solid var(--card-border); 
    border-radius: var(--radius-lg); 
    margin-bottom: 32px; 
    box-shadow: var(--shadow); 
    overflow: hidden; 
  }
  .section-head { 
    padding: 16px 20px; 
    border-bottom: 1px solid var(--card-border); 
    display: flex; 
    align-items: center; 
  }
  .section-head .badge-step { 
    background: var(--text-main); 
    color: #fff; 
    width: 22px; 
    height: 22px; 
    border-radius: 4px; 
    display: inline-flex; 
    align-items: center; 
    justify-content: center; 
    font-size: 11px; 
    font-weight: 700; 
    margin-right: 10px; 
  }
  .section-head .title { font-weight: 600; font-size: 15px; color: var(--text-main); }
  .section-body { padding: 20px; }

  /* 검색 필터 */
  .search-row { display: flex; gap: 16px; align-items: flex-end; }
  .search-item { flex: 1; }
  .search-item label { font-size: 13px; font-weight: 500; color: var(--text-main); margin-bottom: 8px; display: block; }
  .search-item input { height: 38px; border-radius: var(--radius-md); border: 1px solid var(--card-border); font-size: 14px; }

  /* 버튼 스타일 */
  .btn-primary-custom {
    background-color: var(--primary);
    color: #ffffff !important;
    border: none;
    border-radius: var(--radius-md);
    font-size: 14px;
    font-weight: 500;
    padding: 8px 20px;
  }
  .btn-accent-custom {
    background-color: var(--accent);
    color: #ffffff !important;
    border: none;
    border-radius: var(--radius-md);
    font-size: 14px;
    font-weight: 500;
    padding: 8px 20px;
  }

  /* 테이블 스타일 */
  .table-container { max-height: 350px; overflow-y: auto; border: 1px solid var(--card-border); border-radius: var(--radius-md); }
  .table-container-large { max-height: 500px; overflow-y: auto; border: 1px solid var(--card-border); border-radius: var(--radius-md); }
  
  .table { margin-bottom: 0; }
  .table thead th { 
    position: sticky; top: 0; background-color: #f8f9fa; z-index: 10; 
    font-size: 13px; color: var(--text-muted); border-bottom: 1px solid var(--card-border); 
    text-align: center; padding: 12px 8px; cursor: pointer; font-weight: 500;
  }
  .table thead th:hover { background-color: #f1f5f9; }
  .sort-icon { margin-left: 5px; font-size: 11px; color: #d1d5db; }
  .sort-asc { color: var(--text-main) !important; }
  .sort-desc { color: var(--text-main) !important; }
  
  .table tbody td { font-size: 14px; padding: 12px; vertical-align: middle; border-bottom: 1px solid #f1f3f5; color: var(--text-main); }
  .table tbody tr:hover { background-color: #f4f4f5; cursor: pointer; }
  .table tbody tr.selected-row { background-color: #f4f4f5 !important; font-weight: 600; }
  .mono { font-family: 'Cascadia Code', 'Consolas', monospace; }

  /* 컨텍스트 메뉴 */
  #context-menu { position: absolute; display: none; background: #ffffff; border: 1px solid var(--card-border); box-shadow: 0 10px 25px rgba(0,0,0,0.1); z-index: 3000; width: 180px; border-radius: var(--radius-md); padding: 4px; }
  #context-menu div { padding: 8px 12px; cursor: pointer; font-size: 14px; color: var(--text-main); border-radius: 4px; }
  #context-menu div:hover { background-color: #f4f4f5; color: var(--text-main); }

  /* Diff 모달 */
  .modal-content { border-radius: var(--radius-lg); border: 1px solid var(--card-border); box-shadow: 0 25px 50px -12px rgba(0,0,0,0.25); }
  .modal-header { border-bottom: 1px solid var(--card-border); background-color: #fff; }
  .diff-container { display: flex; height: 700px; gap: 15px; background: #fafafa; padding: 15px; border-radius: var(--radius-md); }
  .diff-pane { flex: 1; background: white; border: 1px solid var(--card-border); border-radius: var(--radius-md); overflow-y: auto; position: relative; display: flex; flex-direction: column; }
  .diff-header { position: sticky; top: 0; background: #f8f9fa; padding: 8px 16px; font-size: 13px; font-weight: 700; color: var(--text-muted); border-bottom: 1px solid var(--card-border); text-align: center; z-index: 5; }
  .diff-content-area { position: relative; width: 100%; }
  .diff-line { display: flex; height: 24px; line-height: 24px; font-family: 'Consolas', monospace; font-size: 13px; white-space: pre; width: 100%; }
  .line-num { width: 50px; color: #a1a1aa; text-align: right; padding-right: 10px; flex-shrink: 0; border-right: 1px solid #f1f3f5; margin-right: 10px; user-select: none; }
  .line-content { flex: 1; overflow: hidden; text-overflow: ellipsis; }
  .line-added { background-color: #f0fdf4; color: #166534; }
  .line-removed { background-color: #fef2f2; color: #991b1b; }
</style>
</head>
<body class="container-fluid">
<header id="header"></header>

<div id="app">
  <!-- 페이지 타이틀 블록 -->
  <div class="page-header">
    <div class="eyebrow">Resource Management</div>
    <h4 class="page-title">소프트매니저 자원 관리 시스템</h4>
    <p class="page-desc">날짜별 작업의뢰 조회 및 파일 버전 비교</p>
  </div>

  <!-- 상단 유저 정보 및 조회 버튼 영역 -->
  <div class="d-flex justify-content-between align-items-center mb-4">
    <div class="user-badge" style="font-size:14px; color:#71717a;">
      접속자: <strong style="color:#18181b;">${loginInfo.getResponse_username()}</strong>
    </div>
    <button type="button" class="btn-accent-custom" id="downloadSearch" onclick="">
      <i class="fa fa-search"></i> 조회하기
    </button>
  </div>

  <!-- STEP 1: 날짜 검색 -->
  <div class="section-card">
    <div class="section-head">
      <span class="badge-step">01</span>
      <span class="title">작업의뢰 검색</span>
    </div>
    <div class="section-body">
      <form id="resourceDownForm">
        <input type="hidden" id="ftpRootDir" name="ftpRootDir" value=""/>
        <input type="hidden" id="userAuth" name="userAuth" value="${loginInfo.getResponse_group_id()}"/>
        <div class="search-row">
          <div class="search-item">
            <label>배포 날짜</label>
            <input type="date" class="form-control form-control-sm" v-model="searchForm.date">
          </div>
          <div class="search-item" style="flex: 0 0 100px;">
            <button class="btn-primary-custom w-100" @click="searchTasks">조회</button>
          </div>
        </div>
      </form>
    </div>
  </div>

  <!-- STEP 2: 작업의뢰 목록 -->
  <div class="section-card" v-if="tasks.length > 0">
    <div class="section-head">
      <span class="badge-step">02</span>
      <span class="title">작업의뢰 목록</span>
    </div>
    <div class="section-body">
      <div class="table-container">
        <table class="table table-hover mb-0" @contextmenu.prevent="onContextMenuTask">
          <thead class="mono">
            <tr>
              <th @click="sortTasks('id')" style="width:60px;">No <span class="sort-icon" :class="getSortClass('id')"><i class="fas" :class="getSortIcon('id')"></i></span></th>
              <th @click="sortTasks('system_name')" style="width:150px;">시스템명 <span class="sort-icon" :class="getSortClass('system_name')"><i class="fas" :class="getSortIcon('system_name')"></i></span></th>
              <th @click="sortTasks('prj_mng_no')" style="width:150px;">작업의뢰번호 <span class="sort-icon" :class="getSortClass('prj_mng_no')"><i class="fas" :class="getSortIcon('prj_mng_no')"></i></span></th>
              <th @click="sortTasks('sdlc_seq')" style="width:100px;">SDLC 번호 <span class="sort-icon" :class="getSortClass('sdlc_seq')"><i class="fas" :class="getSortIcon('sdlc_seq')"></i></span></th>
              <th @click="sortTasks('transf_name')" style="width:auto;">작업의뢰 정보 <span class="sort-icon" :class="getSortClass('transf_name')"><i class="fas" :class="getSortIcon('transf_name')"></i></span></th>
              <th @click="sortTasks('transf_cmpl_date')" style="width:130px;">배포일 <span class="sort-icon" :class="getSortClass('transf_cmpl_date')"><i class="fas" :class="getSortIcon('transf_cmpl_date')"></i></span></th>
            </tr>
          </thead>
          <tbody class="mono">
            <tr v-for="(task, idx) in tasks" :key="idx" @click="selectTask(task)" :class="{ 'selected-row': selectedTask === task }">
              <td class="text-center">{{ idx + 1 }}</td>
              <td class="text-center">{{ task.system_name }}</td>
              <td class="text-center">{{ task.prj_mng_no }}</td>
              <td class="text-center">{{ task.sdlc_seq }}</td>
              <td>{{ task.transf_name }}</td>
              <td class="text-center">{{ task.transf_cmpl_date }}</td>
            </tr>
          </tbody>
        </table>
      </div>
    </div>
  </div>

  <!-- STEP 3: 상세 자원 목록 -->
  <div class="section-card" v-if="selectedTask" v-bind:class="{ 'opacity-50': loadingFiles }">
    <div class="section-head">
      <span class="badge-step">03</span>
      <span class="title">상세 자원 목록 ({{ selectedTask.fileNameCount }} 건)</span>
      <span class="ml-auto small text-muted" style="font-size:13px;">파일 우클릭 → [이전 버전 비교]</span>
    </div>
    <div class="section-body">
      <div class="table-container-large">
        <table class="table table-hover mb-0" @contextmenu.prevent="onContextMenuFile">
          <thead class="mono">
            <tr>
              <th style="width:60px;">No</th>
              <th style="width:250px;">저장경로</th>
              <th @click="sortFile('fileName')" style="width:auto;">파일명 <span class="sort-icon" :class="getSortClass('fileName')"><i class="fas" :class="getSortIcon('fileName')"></i></span></th>
              <th @click="sortFile('verIndex')" style="width:80px;">버전 <span class="sort-icon" :class="getSortClass('verIndex')"><i class="fas" :class="getSortIcon('verIndex')"></i></span></th>
              <th @click="sortFile('realName')" style="width:120px;">작업자 <span class="sort-icon" :class="getSortClass('realName')"><i class="fas" :class="getSortIcon('realName')"></i></span></th>
            </tr>
          </thead>
          <tbody class="mono">
            <tr v-for="(file, idx) in fileList" :key="idx" @click="selectedFile = file" :class="{ 'selected-row': selectedFile === file }">
              <td class="text-center">{{ idx + 1 }}</td>
              <td class="text-truncate">{{ file.dirInfo }}</td>
              <td class="font-weight-bold text-primary">{{ file.fileName }}</td>
              <td class="text-center">{{ file.verIndex }}</td>
              <td class="text-center">{{ file.realName }}</td>
            </tr>
          </tbody>
        </table>
      </div>
    </div>
  </div>

  <!-- 우클릭 메뉴 -->
  <div id="context-menu" ref="contextMenu">
    <div v-if="menuMode === 'FILE'" @click="handleDiff">
       <i class="fa fa-code-compare mr-2"></i> 이전 버전 비교
    </div>
  </div>

  <!-- DIFF 모달 -->
  <div class="modal fade" id="diffModal" tabindex="-1" role="dialog" aria-hidden="true">
    <div class="modal-dialog modal-xl resizable-modal" role="document">
      <div class="modal-content">
        <div class="modal-header">
          <h5 class="modal-title font-weight-bold text-dark">파일 버전 비교 (Current vs Previous)</h5>
          <button type="button" class="close" @click="closeModalDirectly" aria-label="Close">&times;</button>
        </div>
        <div class="modal-body">
          <div class="mb-3 d-flex justify-content-between align-items-center">
            <div>
              <span class="badge badge-dark p-2" style="font-size:13px;">대상: {{ diffTarget.fileName }}</span>
              <span class="ml-2 text-muted" style="font-size:13px;">버전: {{ diffTarget.verIndex }} &rarr; {{ diffTarget.prevVerIndex }}</span>
            </div>
          </div>
          <div class="diff-container">
            <!-- Current Pane -->
            <div class="diff-pane">
              <div class="diff-header">Current Version</div>
              <div class="diff-content-area" :style="{ height: (diffData.current.length ? (Math.max(...diffData.current.map(l => l.absoluteIndex)) + 1) * 24 + 'px' : '0') }">
                <div class="diff-line" v-for="(line, idx) in diffData.current" :class="{'line-removed': line.type === 'removed'}" :style="{ top: line.top + 'px', position: 'absolute', width: '100%' }">
                  <span class="line-num">{{ line.absoluteIndex + 1 }}</span>
                  <span class="line-content">{{ line.text }}</span>
                </div>
              </div>
            </div>
            <!-- Previous Pane -->
            <div class="diff-pane">
              <div class="diff-header">Previous Version</div>
              <div class="diff-content-area" :style="{ height: (diffData.previous.length ? (Math.max(...diffData.previous.map(l => l.absoluteIndex)) + 1) * 24 + 'px' : '0') }">
                <div class="diff-line" v-for="(line, idx) in diffData.previous" :class="{'line-added': line.type === 'added'}" :style="{ top: line.top + 'px', position: 'absolute', width: '100%' }">
                  <span class="line-num">{{ line.absoluteIndex + 1 }}</span>
                  <span class="line-content">{{ line.text }}</span>
                </div>
              </div>
            </div>
          </div>
        </div>
        <div class="modal-footer bg-light">
          <button type="button" class="btn btn-secondary px-4" @click="closeModalDirectly">닫기</button>
        </div>
      </div>
    </div>
  </div>
</div>

<script src="/js/vue.js"></script>
<script src="/js/jquery.min.3.4.1.js"></script>
<script src="/js/bootstrap.bundle.min.js"></script>
<script>
$(document).ready(function(){
  $("#header").load("/bin/html/menu.html", function(){
    $("#menuName").html("소프트매니저 자원 관리");
  });
});

new Vue({
  el: "#app",
  data: {
    searchForm: { date: '' },
    tasks: [],
    sortConfig: { key: null, order: null },
    selectedTask: null,
    fileList: [],
    selectedFile: null,
    loadingFiles: false,
    menuMode: '',
    diffTotalCurrent: 0,
    diffTotalPrevious: 0,
    diffTarget: { fileName: '', verIndex: '', prevVerIndex: '' },
    diffData: { current: [], previous: [] },
    fileSortConfig: { key: null, order: null } // 3번째 섹션용 정렬 상태
  },
  mounted: function() {
    const today = new Date().toISOString().split('T')[0];
    this.searchForm.date = today;
  },
  methods: {
    // [공통 정렬 로직]
    applySort: function(list, key, config) {
      if (config.key === key) {
        config.order = config.order === 'asc' ? 'desc' : 'asc';
      } else {
        config.key = key;
        config.order = 'asc';
      }
      list.sort((a, b) => {
        let valA = a[key];
        let valB = b[key];
        if (typeof valA === 'string') {
            valA = valA.toLowerCase();
            valB = valB.toLowerCase();
        }
        if (valA < valB) return config.order === 'asc' ? -1 : 1;
        if (valA > valB) return config.order === 'asc' ? 1 : -1;
        return 0;
      });
    },

    // [STEP 2 정렬]
    sortTasks: function(key) {
      this.applySort(this.tasks, key, this.sortConfig);
    },
    getSortClass: function(key) {
      if (this.sortConfig.key !== key) return '';
      return this.sortConfig.order === 'asc' ? 'sort-asc' : 'sort-desc';
    },
    getSortIcon: function(key) {
      if (this.sortConfig.key !== key) return 'fa-sort';
      return this.sortConfig.order === 'asc' ? 'fa-arrow-up' : 'fa-arrow-down';
    },

    // [STEP 3 정렬]
    sortFile: function(key) {
      this.applySort(this.fileList, key, this.fileSortConfig);
    },
    getSortClass: function(key) {
      if (this.fileSortConfig.key !== key) return '';
      return this.fileSortConfig.order === 'asc' ? 'sort-asc' : 'sort-desc';
    },
    getSortIcon: function(key) {
      if (this.fileSortConfig.key !== key) return 'fa-sort';
      return this.fileSortConfig.order === 'asc' ? 'fa-arrow-up' : 'fa-arrow-down';
    },

    searchTasks: function() {
      fetch("/api/resource-management/search-tasks.json", {
        method: "POST",
        headers: { "Content-Type": "application/json" },
        body: JSON.stringify(this.searchForm)
      })
      .then(res => res.json())
      .then(data => {
        if (data.success) {
          this.tasks = data.list;
          this.sortConfig = { key: null, order: null };
        } else {
          alert("조회 실패: " + data.message);
        }
      })
      .catch(err => console.error("Error:", err));
    },
    selectTask: function(task) {
      this.selectedTask = task;
      this.selectedFile = null;
      this.loadFileList();
    },
    loadFileList: function() {
      this.loadingFiles = true;
      fetch("/api/resource-management/search-files.json", {
       method: "POST",
       headers: { "Content-Type": "application/json" },
       body: JSON.stringify({
        prj_mng_no: this.selectedTask.prj_mng_no,
        sdlc_seq: this.selectedTask.sdlc_seq
       })
     })
     .then(res => res.json())
     .then(data => {
       if (data.success) {
        this.fileList = data.list;
        this.selectedTask.fileNameCount = this.fileList.length;
       } else {
         alert("자원조회 목록 실패: " + data.message);
       }
       this.loadingFiles = false;
     })
     .catch(err => {
       console.error("Error:", err);
       this.loadingFiles = false;
     });
    },
    onContextMenuTask: function(e) { this.menuMode = 'TASK'; this.showContextMenu(e); },
    onContextMenuFile: function(e) {
       if (!this.selectedFile) return;
       const allowedExt = ['java','xml','jsp','js','css','html','properties','sql','txt','json','yml','yaml','sh','bat','md'];
       const ext = this.selectedFile.fileName.split('.').pop().toLowerCase();
       if (!allowedExt.includes(ext)) {
         alert("이 파일 형식(." + ext + ")은 비교를 지원하지 않습니다.");
         return;
       }
       this.menuMode = 'FILE';
       this.showContextMenu(e);
     },
    showContextMenu: function(e) {
      const menu = this.$refs.contextMenu;
      menu.style.display = 'block';
      menu.style.left = e.pageX + 'px';
      menu.style.top = e.pageY + 'px';
    },

    // [핵심] 모달 직접 닫기 (Bootstrap 충돌 방지)
    closeModalDirectly: function() {
      const modalEl = document.getElementById('diffModal');
      modalEl.style.display = 'none';
      modalEl.classList.remove('show');
      document.body.classList.remove('modal-open');
    },

    handleDiff: function() {
      this.hideContextMenu();
      if (!this.selectedFile) return;

      const target = this.selectedFile;
      this.diffTarget.fileName = target.fileName;
      this.diffTarget.verIndex = target.verIndex;
      this.diffTarget.prevVerIndex = (parseInt(target.verIndex) - 1).toString();

      const modalEl = document.getElementById('diffModal');
      const modalDialogEl = modalEl.querySelector('.modal-dialog');

      modalEl.style.display = 'block';
      modalEl.classList.add('show');
      document.body.classList.add('modal-open');
      modalEl.removeAttribute('aria-hidden');

      this.initAbsoluteResize(modalDialogEl);

      fetch("/api/resource-management/compare-diff-range.json", {
        method: "POST",
        headers: { "Content-Type": "application/json" },
        body: JSON.stringify({
          dirInfo: target.dirInfo,
          fileName: target.fileName,
          currVer: this.diffTarget.verIndex,
          prevVer: this.diffTarget.prevVerIndex,
          startLine: 0,
          endLine: 200
        })
      })
      .then(res => res.json())
      .then(data => {
        if (data.success) {
          const LINE_HEIGHT = 22;
          this.diffData.current = data.currentLines.map(line => ({
              ...line,
              top: line.absoluteIndex * LINE_HEIGHT
          }));
          this.diffData.previous = data.previousLines.map(line => ({
              ...line,
              top: line.absoluteIndex * LINE_HEIGHT
          }));
        } else {
          alert("비교 실패: " + data.message);
        }
      })
      .catch(err => console.error("Error:", err));
    },

    initAbsoluteResize: function(el) {
      const oldHandle = el.querySelector('.custom-resize-handle');
      if (oldHandle) oldHandle.remove();

      const handle = document.createElement('div');
      handle.className = 'custom-resize-handle';
      Object.assign(handle.style, {
        width: '30px',
        height: '30px',
        position: 'absolute',
        right: '0',
        bottom: '0',
        cursor: 'nwse-resize',
        backgroundColor: '#007bff',
        clipPath: 'polygon(100% 0, 100% 100%, 0 100%)',
        zIndex: '10000',
        pointerEvents: 'auto'
      });

      el.style.position = 'relative';
      el.appendChild(handle);

      handle.addEventListener('mousedown', (e) => {
        e.preventDefault();
        e.stopPropagation();
        const startX = e.clientX;
        const startY = e.clientY;
        const startWidth = el.offsetWidth;
        const startHeight = el.offsetHeight;

        const onMouseMove = (moveEvent) => {
          const newWidth = startWidth + (moveEvent.clientX - startX);
          const newHeight = startHeight + (moveEvent.clientY - startY);

          if (newWidth > 500) el.style.width = newWidth + 'px';
          if (newHeight > 400) {
            el.style.height = newHeight + 'px';
            const container = el.querySelector('.diff-container');
            if (container) {
                container.style.height = (newHeight - 140) + 'px';
            }
          }
        };

        const onMouseUp = () => {
          document.removeEventListener('mousemove', onMouseMove);
          document.removeEventListener('mouseup', onMouseUp);
        };

        document.addEventListener('mousemove', onMouseMove);
        document.addEventListener('mouseup', onMouseUp);
      }, true);
    },
    hideContextMenu: function() { this.$refs.contextMenu.style.display = 'none'; }
  }
});
</script>
</body>
</html>