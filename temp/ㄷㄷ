	private List<ApplicationClassLoaderListener> getClassLoaderLifecycleListeners()
	{
		List<InterceptorDefinition> listenerDefs= applicationLoader.getClassLoaderLifecycleListeners();
		List<ApplicationClassLoaderListener> listeners= new ArrayList<ApplicationClassLoaderListener>();
		for( InterceptorDefinition def: listenerDefs)
		{
			ApplicationClassLoaderListener listener= def.getInterceptor();
			if( listener== null) continue;
			listeners.add( listener);
		}
		return listeners;
	}

	private void publishManagedEvent( final InstanceEvent event)
	{
		TaskExecutor executor= SimpleSyncTaskExecutor.executor();
		synchronized( this.instanceLifecycleListenes)
		{
			Iterator<InterceptorDefinition> defs= this.instanceLifecycleListenes.iterator();
			while( defs.hasNext())
			{
				final InstanceListener listener= defs.next().getInterceptor();
				if( listener== null) continue;
				executor.execute( new Runnable(){
					public void run()
					{
						listener.managedInstance( event);
					}
				});
			}
		}
	}

