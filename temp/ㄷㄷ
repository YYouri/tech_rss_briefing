//			 try{ super.closeBeanFactory();}
//			 catch( Throwable th){ logger.error( "disposable trace closeBeanFactory", th);}

			 // Let subclasses do some final clean-up if they wish...
			 try{ super.onClose();}
			 catch( Throwable th){ logger.error( "disposable trace onClose", th);}

			 this.active= false;
		 }
		 logger.info( "current WebApplicationContext [{}] is closed.", application.getApplicationName());
	 }

	 @Override
