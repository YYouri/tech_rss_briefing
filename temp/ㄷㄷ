<!DOCTYPE html>

<html lang="ko">
<head>
<meta charset="UTF-8">
<title>스케줄러 등록 관리</title>
<style>
  /* ---------- 에이전트 관리 화면 스타일 이식 ---------- /
  :root {
    --bg-main: #fafafa;
    --card: #ffffff;
    --border: #e4e4e7;
    --border-strong: #d4d4d8;
    --text: #18181b;
    --text-muted: #71717a;
    --text-faint: #a1a1aa;
    --primary: #18181b;
    --primary-hover: #27272a;
    --radius-md: 6px;
    --radius-lg: 10px;
    --danger: #dc2626;
    --info-bg: #f4f4f5;
    --shadow: 0 1px 2px rgba(0,0,0,0.03);
  }

  body {
    background-color: var(--bg-main);
    color: var(--text);
    font-family: -apple-system, BlinkMacSystemFont, "Segoe UI", "Malgun Gothic", sans-serif;
    margin: 0;
  }

  #app {
    max-width: 1400px;
    margin: 40px auto 80px;
    padding: 0 24px;
  }

  / 페이지 타이틀 /
  .page-header { margin-bottom: 32px; }
  .page-header .eyebrow {
    font-size: 12px;
    font-weight: 700;
    color: var(--text-faint);
    text-transform: uppercase;
    margin-bottom: 6px;
  }
  .page-header .page-title {
    font-size: 1.5rem;
    font-weight: 600;
    color: var(--text);
    margin: 0 0 4px 0;
  }
  .page-header .page-desc {
    font-size: 13px;
    color: var(--text-muted);
    margin: 0;
  }

  / 컨트롤 영역 (버튼 배치) /
  .control-card {
    background: var(--card);
    border: 1px solid var(--border);
    border-radius: var(--radius-lg);
    margin-bottom: 24px;
    box-shadow: var(--shadow);
    padding: 14px 20px;
    display: flex;
    justify-content: flex-end; / 버튼 우측 정렬 /
    gap: 10px;
  }

  / 섹션 카드 /
  .section-card {
    background: var(--card);
    border: 1px solid var(--border);
    border-radius: var(--radius-lg);
    margin-bottom: 24px;
    box-shadow: var(--shadow);
    overflow: hidden;
  }

  .section-head {
    padding: 14px 20px;
    border-bottom: 1px solid var(--border);
    display: flex;
    justify-content: space-between;
    align-items: center;
  }

  .section-title {
    font-weight: 600;
    font-size: 14px;
    color: var(--text);
  }

  .section-body { padding: 0; } / 테이블이 꽉 차도록 0 설정 /

/ [수정] 테이블 전체 컨테이너 /
.table-container { 
  overflow-x: auto; 
  width: 100%;
}

/ [수정] 테이블 기본 스타일 /
table { 
  width: 100%; 
  border-collapse: collapse; 
  table-layout: auto; / 내용에 따라 너비가 조절되도록 설정 /
}

/ [수정] 헤더 스타일: 에이전트 화면과 동일하게 /
th {
  background-color: var(--info-bg);
  color: var(--text-muted);
  font-weight: 600;
  font-size: 12px;
  padding: 12px 10px; / 헤더 높이 /
  border-bottom: 1px solid var(--border);
  text-align: left;
}

/ [수정] 데이터 셀 스타일: 여기가 핵심입니다 /
td {
  padding: 18px 10px; / 이 값을 늘리면 행 높이가 널찍해집니다 (기존 25px가 너무 크면 18px 추천) /
  font-size: 13px;
  border-bottom: 1px solid #f4f4f5;
  color: var(--text);
  vertical-align: middle;
  text-align: left;
}

/ 마우스 호버 효과 /
tr:hover td {
  background-color: #fafafa;
}

/ 텍스트 중앙 정렬용 유틸리티 /
.text-center { text-align: center !important; }

  / 유틸리티 /
  .mono { font-family: ui-monospace, SFMono-Regular, Menlo, Monaco, Consolas, monospace; }
  .text-center { text-align: center; }
  .d-none { display: none; }
  .d-block { display: block !important; }

  / 버튼 스타일 /
  .btn-primary-custom {
    background-color: var(--primary);
    color: #ffffff !important;
    border: none;
    border-radius: var(--radius-md);
    font-size: 13px;
    font-weight: 500;
    padding: 8px 16px;
    cursor: pointer;
  }
  .btn-primary-custom:hover { background-color: var(--primary-hover); }

  .btn-secondary-custom {
    background-color: #ffffff !important;
    color: var(--text) !important;
    border: 1px solid var(--border-strong) !important;
    border-radius: var(--radius-md);
    font-size: 13px;
    padding: 8px 16px;
    cursor: pointer;
  }
  .btn-secondary-custom:hover { background-color: #f4f4f5 !important; }

  .btn-danger-small {
    background-color: var(--danger) !important;
    color: white !important;
    border: none;
    border-radius: 4px;
    padding: 4px 10px;
    font-size: 12px;
    cursor: pointer;
  }

  / 모달 스타일 */
  .modal-content { border: 1px solid var(--border); border-radius: var(--radius-lg); box-shadow: 0 10px 25px rgba(0,0,0,0.1); }
  .modal-header { border-bottom: 1px solid var(--border); padding: 16px 20px; display: flex; justify-content: space-between; align-items: center; }
  .modal-title { margin: 0; font-size: 1.1rem; font-weight: 600; }
  .modal-body { padding: 20px; }
  .modal-footer { border-top: 1px solid var(--border); padding: 12px 20px; display: flex; justify-content: flex-end; gap: 8px; }
  .close-btn { background: none; border: none; font-size: 24px; cursor: pointer; color: var(--text-faint); }

  .form-group { margin-bottom: 16px; }
  .control-label { display: block; font-size: 12.5px; font-weight: 600; margin-bottom: 6px; color: var(--text); }
  .form-control { width: 100%; height: 36px; padding: 0 10px; font-size: 13px; border: 1px solid var(--border-strong); border-radius: var(--radius-md); box-sizing: border-box; }
</style>
</head>
<body>
  <header id="header"></header>
  <div id="app">
    <div class="page-header">
      <div class="eyebrow">Scheduler Management</div>
      <h4 class="page-title">스케줄러 등록 관리</h4>
      <p class="page-desc">스케줄러를 등록하고 실행 상태를 동기화하여 관리합니다.</p>
    </div>

    <!-- 컨트롤 영역 -->
    <div class="control-card">
      <button class="btn-primary-custom" type="button" @click="showModal = !showModal">스케줄러 등록</button>
      <button class="btn-primary-custom" type="button" v-on:click="initSche">스케줄러 동기화</button>
    </div>

    <!-- 테이블 영역 -->
<!-- 테이블 영역 -->
<div class="section-card">
  <div class="section-head">
    <span class="section-title">스케줄러 목록</span>
  </div>
  <div class="section-body">
    <div class="table-container">
      <table>
        <thead>
          <tr>
            <th style="width:120px;">TITLE</th>
            <th style="min-width:220px;">TARGET_CLASS</th>
            <th style="min-width:160px;">CRON_EXP</th>
            <th style="width:100px;" class="text-center">USE_YN</th>
            <th style="width:180px;">EXE_DATE</th>
            <th style="width:180px;">MOD_DATE</th>
            <th style="width:80px;" class="text-center">관리</th>
          </tr>
        </thead>
        <tbody>
          <tr v-for="(item, index) in items" :key="index">
            <!-- v-for 내부의 td에서 class="custom-td"를 삭제하세요 -->
            <td v-for="gridColumn in gridColumns" 
                :class="{ mono: ['target_id', 'target_class', 'cron_exp'].includes(gridColumn) }">
              {{item[gridColumn]}}
            </td>
            <!-- 관리 버튼 셀에서도 class="custom-td"를 삭제하세요 -->
            <td class="text-center">
              <button class="btn-danger-small" type="button" v-on:click="removeRow(index)">X</button>
            </td>
          </tr>
          <tr v-if="items.length === 0">
            <td colspan="7" style="text-align: center; color: var(--text-faint); padding: 60px;">
              등록된 스케줄러가 없습니다.
            </td>
          </tr>
        </tbody>
      </table>
    </div>
  </div>
</div>
    <!-- 모달 영역 -->
    <transition @enter="startTransitionModal" @after-enter="endTransitionModal" @before-leave="endTransitionModal" @after-leave="startTransitionModal">
      <div class="modal fade" v-if="showModal" ref="modal" style="position: fixed; top:0; left:0; width:100%; height:100%; z-index:1050;">
        <div class="modal-dialog" role="document" style="margin: 5% auto; width: 500px;">
          <div class="modal-content">
            <div class="modal-header">
              <h4 class="modal-title">스케줄러 등록</h4>
              <button class="close-btn" type="button" @click="showModal = !showModal">×</button>
            </div>
            <div class="modal-body">
              <form class="form-horizontal">
                <div class="form-group">
                  <label class="control-label">Title</label>
                  <input type="text" class="form-control" id="newmethod">
                </div>
                <div class="form-group">
                  <label class="control-label">Target_class</label>
                  <input type="text" class="form-control" id="newobject">
                </div>
                <div class="form-group">
                  <label class="control-label">Cron</label>
                  <input type="text" class="form-control" id="newcron">
                </div>
              </form>
            </div>
            <div class="modal-footer">
              <button class="btn-secondary-custom" @click="showModal = !showModal">Close</button>
              <button class="btn-primary-custom" type="button" v-on:click="addRow(this.newobject, this.newmethod, this.newcron)">Save</button>
            </div>
          </div>
        </div>
      </div>
    </transition>
    <div class="modal-backdrop fade d-none" ref="backdrop" style="position: fixed; top:0; left:0; width:100%; height:100%; background: rgba(0,0,0,0.4); z-index:1040;"></div>
  </div>

  <script>
    // 기존 Vue 로직 동일 유지
    $(document).ready(function(){
      $("#header").load("/bin/html/menu.html", function(){
        $("#menuName").html("스케줄러 등록 관리");
      });
    });

    var meta = new Vue({
      el : '#app',
      methods : {
        filTable : function(){
          for (var i = 0; i < meta.items.length; i++) {
            if(meta.items[i].mod_date != null)
              meta.items[i].mod_date =  moment(meta.items[i].mod_date).format('YYYY-MM-DD HH:mm:ss.SSS');
            if(meta.items[i].exe_date != null)
              meta.items[i].exe_date =  moment(meta.items[i].exe_date).format('YYYY-MM-DD HH:mm:ss.SSS');
          }
        },
        startTransitionModal() {
          meta.$refs.backdrop.classList.toggle("d-block");
          if(meta.$refs.modal != null) meta.$refs.modal.classList.toggle("d-block");
        },
        endTransitionModal() {
            meta.$refs.backdrop.classList.toggle("show");
            meta.$refs.modal.classList.toggle("show");
        },
        addRow : function(target_class, target_id, cron_exp){
          if(target_class.value=='' || target_id.value=='' || cron_exp.value == '')
            alert("입력을 완료해주세요")
          else{
            var rr = window.confirm("추가 하시겠습니까?");
            if(rr == true){
              axios.post("/insertApSchedule.json", null, {
                params : {target_class : target_class.value, target_id : target_id.value, cron_exp : cron_exp.value}
              }).then(function(res){
                meta.items = res.data;
                meta.filTable();
                alert("저장을 완료 했습니다.");
              }).catch(function(error){
                alert(error)
              });
            }
          }
        },
        removeRow : function(index){
          var rr = window.confirm("삭제 하시겠습니까? \r\n(삭제와 동시에 동기화 수행 함)");
          if(rr == true){
            axios.post("/deleteApSchedule.json", meta.items[index]).then(function(res){
              meta.items = res.data;
              meta.filTable();
              alert("저장을 완료 했습니다.");
            }).catch(function(error){
              alert(error)
            });
          }
        },
        initSche : function() {
          axios.get("/initApSchedule.json").then(function(res){
            meta.items = res.data;
            meta.filTable();
            alert("스케줄 동기화 완료");
          }).catch(function(error){
            alert("FAILED TO INIT")
          })
        }
      },
      data : {
        gridColumns:['target_id','target_class','cron_exp', 'use_yn', 'exe_date', 'mod_date'],
        showModal:false,
        items : [],
      },
      created : function(){
        axios.get("/getApSchedule.json").then(function(res){
          meta.items = res.data;
          meta.filTable();
        }).catch(function(error){
          console.error(error);
        });
      }
    });
  </script>
</body>
</html>

스케줄러 목록 테이블 이 해당 섹션에 너무 가득차 있어 다른 AI한테 물어봐서 여유를 줬는데도 화면에 적용되지 않아 ..
