        StringBuffer sb= new StringBuffer();
        AbstractApplicationClassLoader[] ldrs=
        	(AbstractApplicationClassLoader[])weakLoaders.keySet().toArray(
        			new AbstractApplicationClassLoader[weakLoaders.keySet().size()]);
        int cnt= 0;
        int gcCandidates= 0;
        sb.append( "\r\n#############################################################\r\n");
        sb.append( "#\r\n");
        sb.append( "#                                 dump ApplicationClassLoaders                                      \r\n");
        sb.append( "#\r\n");
        sb.append( "#############################################################\r\n");

        for( AbstractApplicationClassLoader ldr: ldrs)
		{
        	if( ldr== null)
        	{
        		gcCandidates++;
        		continue;
        	}
        	String loaderAddress = Long.toHexString(ApplicationClassLoaderManager.addressOf(ldr));
        	sb.append( this.weakLoaders.get( ldr)+ ", 0x" + loaderAddress +"\r\n");
			sb.append( "uuid : "+ ldr.getUUID()+ "\r\n");
			sb.append( "application : "+ ldr.getApplicationName()+ "\r\n");
			sb.append( "pooled : "+ ldr.isPooled()+ "\r\n");
			sb.append( "status : "+ ldr.getStatus().statusName()+ "\r\n");
			sb.append( "dirty : "+ ldr.isDirty()+ "\r\n");
			sb.append( "destroyed : "+ ldr.isDestroyed()+ "\r\n");
			sb.append( "shared : "+ ldr.isShared()+ "\r\n");

			for( File deleteTo: ldr.getDeleteOnDestroy())
				sb.append( "deleteOnDestroy path root : "+ deleteTo.getAbsolutePath()+ "\r\n");


			sb.append( "createdTime : "+ ldr.getCreatedTime() + ", " + new Date(ldr.getCreatedTime()) + "\r\n");
			if( ldr.isDestroyed())
				sb.append( "destroyedTime : "+ ldr.getDestroyedTime()+ "\r\n");
			sb.append( "----------------------------------------------------------------------\r\n");
			sb.append( "\r\n");
			cnt++;
		}
        sb.append( "----------------------------------------------------------------------\r\n");
        sb.append( " ApplicationClassLoader count= "+ cnt+  ", gc candidates= "+ gcCandidates+ " \r\n");
        sb.append( "----------------------------------------------------------------------\r\n");
        sb.append( "#############################################################\r\n");
        return sb;
	}

	public void dumpLoadersToFile( String path, boolean destroyedOnly)
	{
		AbstractApplicationClassLoader[] ldrs=
			(AbstractApplicationClassLoader[])weakLoaders.keySet().toArray(
					new AbstractApplicationClassLoader[weakLoaders.keySet().size()]);
		for( AbstractApplicationClassLoader ldr: ldrs)
		{
			if( ldr== null)	continue;
			if( destroyedOnly)
			{
				if( ldr.isDestroyed())	ldr.dumpLoadedClasses( path);
			}
			else
				ldr.dumpLoadedClasses( path);
		}
	}

	public void dumpLoaderToFIle( String loaderName, String path)
	{
		AbstractApplicationClassLoader[] ldrs=
			(AbstractApplicationClassLoader[])weakLoaders.keySet().toArray(
					new AbstractApplicationClassLoader[weakLoaders.keySet().size()]);
		for( AbstractApplicationClassLoader ldr: ldrs)
		{
			if( ldr== null)	continue;
			String ldrName= weakLoaders.get( ldr);
			if( ldrName.equals( loaderName))
			{
				ldr.dumpLoadedClasses( path);
				return;
			}
		}
	}
