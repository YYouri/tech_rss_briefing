	public void refresh() throws BeansException, IllegalStateException
	{
//		logger.info( "current WebApplicationContext [{}] will be refreshed.", application.getApplicationName());
		ClassLoader contextLoader= Thread.currentThread().getContextClassLoader();
		try
		{
			Thread.currentThread().setContextClassLoader( this.loaderRef.getClassLoader());
			this.loaderRef.getClassLoader().setApplicationContextInitializaing( true);
			super.refresh();
			synchronized( this.startupShudownCurrentMonitor)
			{
				// do something
			}
		}
		finally
		{
			this.loaderRef.getClassLoader().setApplicationContextInitializaing( false);
			Thread.currentThread().setContextClassLoader( contextLoader);
		}
//		logger.info( "current WebApplicationContext [{}] is refreshed.", application.getApplicationName());
	}

