	protected boolean checkCandidate( String beanName, BeanDefinition beanDefinition) throws IllegalStateException
	{
		if( !getRegistry().containsBeanDefinition( beanName)) return true;
		else
		{
			/* 2013.06.25 changyoung.shin update */
			if(LApplicationContext.isBatchContext())
			{
				logger.info( "Annotation-specified bean [{}] for bean class [{}] is already registered. " +
						"bean[{}] for bean class [{}] will be ignored.",
						new Object[]{ beanName, getRegistry().getBeanDefinition( beanName).getBeanClassName(),
								beanName, beanDefinition.getBeanClassName()});
			}
			else
			{
				logger.warn( "Annotation-specified bean [{}] for bean class [{}] is already registered. " +
						"bean[{}] for bean class [{}] will be ignored.",
						new Object[]{ beanName, getRegistry().getBeanDefinition( beanName).getBeanClassName(),
								beanName, beanDefinition.getBeanClassName(),
								new Throwable()});
			}

			return false;
		}
	}

