#!/bin/bash

# 사용법 안내
if [ "$#" -lt 1 ]; then
    echo "Usage: $0 <input_list_file>"
    echo "Example: $0 list.txt"
    exit 1
fi

INPUT_FILE=$1

# 입력 파일 존재 여부 확인
if [ ! -f "$INPUT_FILE" ]; then
    echo "Error: File '$INPUT_FILE' not found!"
    exit 1
fi

# 결과 파일들을 저장할 디렉토리 생성
RESULT_DIR="split_results"
mkdir -p "$RESULT_DIR"

echo "-------------------------------------------------------"
echo " 작업 시작: $INPUT_FILE 분석 및 타입별 경로 분류"
echo " 결과 저장 위치: ./$RESULT_DIR/"
echo "-------------------------------------------------------"

# 라인별로 읽기 (파일의 각 라인을 처리)
while IFS= read -r line || [ -n "$line" ]; do
    # 빈 라인이나 주석(#)은 건너뜀
    [[ -z "$line" || "$line" == \#* ]] && continue

    # 라인에서 파일명과 경로 추출 (공백 기준)
    FILE_NAME=$(echo "$line" | awk '{print $1}')
    DIR_INFO=$(echo "$line" | awk '{print $2}')

    # 데이터가 유효한지 확인
    if [ -z "$FILE_NAME" ] || [ -z "$DIR_INFO" ]; then
        continue
    fi

    # -----------------------------------------------------------------------------
    # 1. 분석 로직 (사용자님의 상세 경로 요구사항 반영)
    # -----------------------------------------------------------------------------
    
    # 경로 정규화 (\ -> /)
    DIR_PATH=$(echo "$DIR_INFO" | sed 's/\\/\//g')
    FILE_NAME_LOWER=$(echo "$FILE_NAME" | tr '[:upper:]' '[:lower:]')
    BASE_FILE=$(basename "$FILE_NAME")
    
    # 상수 설정
    STAGING_JAVA="/NFS/IDES/PMS/CIS/STAGING/JAVA"
    STAGING_BATCH="/NFS/IDES/PMS/CIS/STAGING/JAVA/BATCH"
    STAGING_BATCH_SRC="/NFS/IDES/PMS/CIS/STAGING/JAVA/BATCH_SOURCE"
    STAGING_WEB="/NFS/IDES/PMS/CIS/STAGING/WEB"
    
    TARGET_COWEB="/NFS/QA/QCOWEB"
    TARGET_DPWEB="/NFS/QA/QDPWEB"
    TARGET_COWAS="/Appl/Online"
    TARGET_BATCH="/Appl/Batch"

    TYPE="UNKNOWN"
    OUTPUT_CONTENT=""

    # [CASE 1] WEB 계열 (COWEB/DPWEB)
    # 문법 수정: [[ "$DIR_PATH" == *"WEB"* ]]
    if [[ "$DIR_PATH" == *"WEB"* ]]; then
        if [[ "$DIR_PATH" == *"distribution"* ]]; then
            TYPE="dpweb"
            TARGET_PREFIX="${TARGET_DPWEB}"
            STAGING_PREFIX="${STAGING_WEB}/DPWEB"
        else
            TYPE="coweb"
            TARGET_PREFIX="${TARGET_COWEB}"
            STAGING_PREFIX="${STAGING_WEB}/COWEB"
        fi
        WEB_REL_PATH=$(echo "$DIR_PATH" | sed -E 's|.*/WEB/||' | sed 's|/*$||')
        OUTPUT_CONTENT="${TARGET_PREFIX}/${WEB_REL_PATH}/${BASE_FILE}\nStaging: ${STAGING_PREFIX}/${WEB_REL_PATH}/${BASE_FILE}"

    # [CASE 2] ONLINE Java
    elif [[ "$FILE_NAME_LOWER" == *".java" && "$DIR_PATH" == *"ONLINE"* && "$DIR_PATH" == *"src"* ]]; then
        TYPE="online"
        CLASS_REPLACE=$(echo "$BASE_FILE" | sed 's/\.java$/.class/')
        RELATIVE_PATH=$(echo "$DIR_PATH" | sed -E 's|.*/src/||' | sed 's|/*$||')
        OUTPUT_CONTENT="${TARGET_COWAS}/EAR/WEB/WEB-INF/classes/${RELATIVE_PATH}/${CLASS_REPLACE}\n${TARGET_COWAS}/EAR/WEB2/WEB-INF/classes/${RELATIVE_PATH}/${CLASS_REPLACE}\n${TARGET_BATCH}/classes/${RELATIVE_PATH}/${CLASS_REPLACE}\n${STAGING_JAVA}/ONLINE/WEB/WEB-INF/classes/${RELATIVE_PATH}/${CLASS_REPLACE}\n${STAGING_JAVA}/ONLINE_SOURCE/${RELATIVE_PATH}/${BASE_FILE}"

    # [CASE 3] BATCH Java
    elif [[ "$FILE_NAME_LOWER" == *".java" && "$DIR_PATH" == *"BATCH"* && "$DIR_PATH" == *"src"* ]]; then
        TYPE="batch"
        CLASS_REPLACE=$(echo "$BASE_FILE" | sed 's/\.java$/.class/')
        RELATIVE_PATH=$(echo "$DIR_PATH" | sed -E 's|.*/src/||' | sed 's|/*$||')
        OUTPUT_CONTENT="${TARGET_BATCH}/classes/${RELATIVE_PATH}/${CLASS_REPLACE}\n${STAGING_BATCH}/classes/${RELATIVE_PATH}/${CLASS_REPLACE}\n${STAGING_BATCH_SRC}/${RELATIVE_PATH}/${BASE_FILE}"

    # [CASE 4] BATCH XML (Config)
    elif [[ "$FILE_NAME_LOWER" == *".xml" && "$DIR_PATH" == *"BATCH"* && "$DIR_PATH" == *"config"* ]]; then
        TYPE="batch_config"
        RELATIVE_PATH=$(echo "$DIR_PATH" | sed -E 's|.*/config/||' | sed 's|/*$||')
        OUTPUT_CONTENT="${TARGET_BATCH}/config/${RELATIVE_PATH}/${BASE_FILE}\n${STAGING_BATCH}/config/${RELATIVE_PATH}/${BASE_FILE}"

    # [CASE 5] 기타 BATCH
    elif [[ "$DIR_PATH" == *"BATCH"* ]]; then
        TYPE="batch"
        # 기본 BATCH 로직 (상세 경로가 없는 경우를 위한 기본값)
        OUTPUT_CONTENT="${TARGET_BATCH}/${DIR_PATH##*/}${BASE_FILE}"
    fi

    # -----------------------------------------------------------------------------
    # 2. 파일 분류 및 저장
    # -----------------------------------------------------------------------------
    if [ "$TYPE" != "UNKNOWN" ]; then
        # 파일명에서 확장자 제거 (예: CLC_online.txt)
        BASE_NAME=$(echo "$FILE_NAME" | sed 's/\.[^.]*$//')
        OUTPUT_FILE="${RESULT_DIR}/${BASE_NAME}_${TYPE}.txt"
        
        # 분석된 내용을 파일에 저장 (echo -e 사용으로 줄바꿈 적용)
        echo -e "$OUTPUT_CONTENT" > "$OUTPUT_FILE"
        echo "[성공] $FILE_NAME -> ${TYPE} 분류 완료"
    else
        BASE_NAME=$(echo "$FILE_NAME" | sed 's/\.[^.]*$//')
        echo "$line" > "${RESULT_DIR}/${BASE_NAME}_unknown.txt"
        echo "[실패] $FILE_NAME -> UNKNOWN (분류 불가)"
    fi

done < "$INPUT_FILE"

echo "-------------------------------------------------------"
echo " 작업 완료!"
echo " 생성된 파일 목록:"
ls -R "$RESULT_DIR"
echo "-------------------------------------------------------"

이쉘의 기능은 작업의뢰 파일명에 삭제가 필요한 자원의 메타 정보가 작성된 파일로 

