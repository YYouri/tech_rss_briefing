			logger.info("load beanScanPackage : {}", beanScanPackage);
			ArrayList<String> patterns = new ArrayList<String>();
			String postPatternStr = System.getProperty("bxm.system.online.base.packages.post.pattern");
			if (postPatternStr == null)
			{
				patterns.add("**/*.class");
			}
			else {
				String[] pttrns = postPatternStr.split(",");
				if (pttrns == null || pttrns.length == 0)
				{
					patterns.add("**/*.class");
				}
				else
				{
					for (String pattern : pttrns) {
						patterns.add(pattern);
					}
				}
			}

			for(String postPattern : patterns)
			{
				String path= CLASSPATH_ALL_URL_PREFIX+ ClassUtils.convertClassNameToResourcePath(
						SystemPropertyUtils.resolvePlaceholders(beanScanPackage, true)) + "/"+ postPattern;

				beanScanPaths.add(path);

				//Pattern pattern= Pattern.compile( "("+ "org/apache" + ")(/)(.*)(.class)");
				String[] splitPattern = postPattern.split("/\\**");
				String suffixPattern = "(.class)";
				if(splitPattern != null && splitPattern.length != 1)
				{
					suffixPattern = "(" + splitPattern[splitPattern.length - 1] + ")";

				}
				beanScanPatterns.add("(" + beanScanPackage + ")(/)(.*)" + suffixPattern);

			}
		}

		List<String> addPackages = getAddPackages();
		for(String addPackage : addPackages)
		{
			String path= CLASSPATH_ALL_URL_PREFIX+ ClassUtils.convertClassNameToResourcePath(
					SystemPropertyUtils.resolvePlaceholders(addPackage, true)) + "/"+ "**/*.class";
			beanScanPaths.add(path);
			beanScanPatterns.add("(" + addPackage + ")(/)(.*)(.class)");
		}

		List<Pattern> patternList = new ArrayList<Pattern>();
		for(String beanScanPattern : beanScanPatterns)
		{
			//[[CERT - Denial of Service: Regular Expression
			beanScanPattern= SecureCodingUtils.sanitizeRegularExpressionPattern(beanScanPattern);
			//]]
			Pattern pattern= Pattern.compile( beanScanPattern);
			patternList.add(pattern);
		}

		String applicationName = loaderRef.getClassLoader().getApplicationName();
		String onlineApplicationName = System.getProperty("bxm.system.default.application.name");

		boolean isLibraryLoad = false;
		if(onlineApplicationName.equals(applicationName))
		{
			isLibraryLoad = false;
		}
		else if(applicationName.endsWith("Batch") || applicationName.endsWith("BATCH") || applicationName.endsWith("batch"))
		{
			isLibraryLoad = true; // Library Load
		}
		else
		{
			isLibraryLoad = true;
		}

		if(isLibraryLoad)
		{
			// 온라인 라이브러리 체크
			if(loaderRef.getClassLoader().getLocalApplicationClasspaths() != null)
			{
				for(URL url : loaderRef.getClassLoader().getLocalApplicationClasspaths())
				{
					if(!url.getFile().endsWith(".jar"))
					{
						continue;
					}

					if(url.getFile().contains("online") || url.getFile().contains("interface"))
					{
						//Pattern pattern= Pattern.compile( "("+ "org/apache" + ")(/)(.*)(.class)");
						try
						{
							List<String> content = getJarContent(url.getFile());
							for(String classFile : content)
							{
								for(Pattern pattern : patternList)
								{
									Matcher matcher = pattern.matcher(classFile);
									if(matcher.matches() && classFile.endsWith(".class"))
									{
										String classname = classFile.replace('/', '.').substring(0, classFile.length() - 6);
										try
										{
											Class<?> c = Thread.currentThread().getContextClassLoader().loadClass(classname);
											for(Method m : c.getMethods())
											{
												BxmTranID bxmTranId = m.getAnnotation(BxmTranID.class);
												if(bxmTranId != null)
												{
													String tranId = bxmTranId.name();
													if(batchServices.containsKey(tranId)) continue;
													batchServices.put(tranId, classname);
												}
											}
										}
										catch (Throwable th)
										{
										}
									}
								}
							}
						}
						catch (Throwable th)
						{
							logger.error(th.getMessage());
						}

					}
				}
			}
		}
		else
		{
			try
			{
				for(String beanScanPath : beanScanPaths)
				{
					// 온라인 Application Resource 확인
					bxm.instance.loader.resource.Resource[] resources = loaderRef.getResourceLoader().getLocalResources(beanScanPath);
					if( resources!= null && resources.length> 0)
					{
						logger.info("find resource : {}/{}", beanScanPath, resources.length);
						for(bxm.instance.loader.resource.Resource resource : resources)
						{
							loadClass(resource);
						}
					}
				}
			}
			catch (Throwable th)
			{
				logger.error( "creation basepackage set for auto-find dependon packages is failed.", th);
			}
		}
	}

	private void loadClass(bxm.instance.loader.resource.Resource resource)
			throws Exception
	{
		MetadataReader reader= null;
		try
		{
			reader = loaderRef.getResourceLoader().getMetadataReader( resource);
			if( reader== null) return;

			org.objectweb.asm.commons.Method[] methods = reader.getAnnotationMetadata().getAnnotatedMethods(ServiceDefinitions.AnnotatedConfig.TRANID_ANNOTATION_CLASSNAME);

			if(methods != null)
			{
				for(org.objectweb.asm.commons.Method method : methods)
				{
					Map<String, Object> attrs = reader.getAnnotationMetadata().getAnnotatedMethodAttributes(ServiceDefinitions.AnnotatedConfig.TRANID_ANNOTATION_CLASSNAME, method);
					if(attrs != null)
					{
						String tranId = (String) attrs.get("name");
						if(batchServices.containsKey(tranId)) continue;
						batchServices.put(tranId, reader.getClassMetadata().getClassName());
					}
				}
			}

//			Class<?> loadedClass= loaderRef.getClassLoader().loadClass( className);
//			loadedClasses.add(loadedClass);
		}
		catch( Throwable th)
		{
			logger.warn( th.getMessage(), th);
		}
	}

	private String[] getBasePackagePatterns() {

		String envBasePackages = System.getProperty("bxm.system.online.base.packages");
		String[] strBasePackages = new String[0] ;

		if (StringUtils.hasLength(envBasePackages))
		{
			strBasePackages = envBasePackages.split(",");
		}

		return strBasePackages;
	}

	private ArrayList<String> getAddPackages() {

		ArrayList<String> addPackages = new ArrayList<String>();

		String addPackagesStr = System.getProperty("bxm.system.online.base.packages.added");
		if (addPackagesStr == null) {
		} else {
			String[] patterns = addPackagesStr.split(",");
			if (patterns == null || patterns.length == 0) {
			} else {
				for (String pattern : patterns) {
					addPackages.add(pattern);
				}
			}
		}
		return addPackages;
	}

	public boolean loadService(String tranId)
	{
		if(LApplicationContext.isBatchContext())
		{
			if(batchServices.containsKey(tranId))
			{
				String className = batchServices.get(tranId);
				try
				{
					Class<?> loadedClass= loaderRef.getClassLoader().loadClass(className);
					return beanScan(loadedClass, true);
				} catch (ClassNotFoundException e) {
					throw new RuntimeException(e.getMessage(), e);
				}
			}
		}
		return false;
	}

	public boolean loadSimpleService(String tranId, String className)
	{
		try
		{
			Class<?> loadedClass= loaderRef.getClassLoader().loadClass(className);
			return beanScan(loadedClass, true);
		} catch (ClassNotFoundException e) {
			throw new RuntimeException(e.getMessage(), e);
		}
	}

	/**
	 * List the content of the given jar
	 *
	 * @param jarPath
	 * @return
	 * @throws IOException
	 */
	public List<String> getJarContent(String jarPath) throws IOException {
		List<String> content = new ArrayList<String>();
		JarFile jarFile = new JarFile(jarPath);
		Enumeration<JarEntry> e = jarFile.entries();
		while (e.hasMoreElements()) {
			JarEntry entry = (JarEntry) e.nextElement();
			String name = entry.getName();
			content.add(name);
		}
		return content;
	}

