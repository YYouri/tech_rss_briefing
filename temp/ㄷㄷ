public class SpringLightweightApplicationContext implements LightweightApplicationContext
{
	private Logger logger= LoggerFactory.getLogger( LightweightApplicationContext.class);

	private String applicationId;

	private volatile AbstractRefreshableApplicationContext context;

	private volatile ServletContext servletContext;

	private ClassLoaderRef loaderRef;

	public SpringLightweightApplicationContext( String applicationId)
	{
		this.applicationId= applicationId;
	}

	public void initializeApplicationContext( ServletContext sc, String configLocation, ClassLoaderRef loaderRef,
			Application application, Object singletonLock, Object initializationLock, Set<MetadataReader> beanCandidates)
	{
		logger.info( "Initializing Spring root ApplicationContext. using classloader [{}]", loaderRef.getClassLoader());
		AbstractRefreshableApplicationContext ac;
		this.loaderRef= loaderRef;
		loaderRef.getClassLoader().setApplicationContextRef( new WeakReference<LightweightApplicationContext>( this));
		try
		{
			if( sc!= null)
			{
				this.servletContext= new ServletContextDelegate( sc);
				ac= new bxm.context.WebApplicationContext( application, singletonLock, initializationLock, beanCandidates);
				ConfigurableWebApplicationContext wac= (ConfigurableWebApplicationContext)ac;

				if( sc.getMajorVersion()== 2 && sc.getMinorVersion()< 5)
				{
					String servletContextName= sc.getServletContextName();
					wac.setId( ConfigurableWebApplicationContext.APPLICATION_CONTEXT_ID_PREFIX+
							ObjectUtils.getDisplayString( servletContextName));
				}
				else
				{
					try
					{
						String contextPath= (String)ServletContext.class.getMethod( "getContextPath").invoke(sc);
						wac.setId( ConfigurableWebApplicationContext.APPLICATION_CONTEXT_ID_PREFIX+
								ObjectUtils.getDisplayString( contextPath));
					}
					catch( Exception ex)
					{
						throw new IllegalStateException( "Failed to invoke Servlet 2.5 getContextPath method", ex);
					}
				}
				wac.setServletContext( servletContext);
				if( StringUtils.hasText( configLocation));
					wac.setConfigLocation( configLocation);
				this.context= (AbstractRefreshableApplicationContext)wac;
				this.servletContext.setAttribute( WebApplicationContext.ROOT_WEB_APPLICATION_CONTEXT_ATTRIBUTE, wac);
			}
			else
			{
				ac= new bxm.context.XmlApplicationContext( application, singletonLock, initializationLock, beanCandidates);
				ac.setId( applicationId+ ": "+ ObjectUtils.getDisplayString( this));
				if( StringUtils.hasText( configLocation))
					( (AbstractRefreshableConfigApplicationContext)ac).setConfigLocation( configLocation);
				this.context= ac;
			}

			if( ac instanceof ClassLoaderRefAware)
				( (ClassLoaderRefAware)ac).setClassLoaderRef( loaderRef);
			ac.refresh();
			logger.info( "Spring root ApplicationContext [{}] is initialized.",
					application!= null ? application.getApplicationName() : "null");
		}
		catch( Throwable th)
		{
			logger.error( "application context creation is failed.", th);
			if( this.servletContext!= null)
				this.servletContext.setAttribute( WebApplicationContext.ROOT_WEB_APPLICATION_CONTEXT_ATTRIBUTE, th);
			throw new NestedRuntimeException( th.getMessage(), th);
		}
	}

	public void postInitialization( LightweightApplicationContext[] refCtxs)
	{
		if( this.context instanceof bxm.context.WebApplicationContext)
			( (bxm.context.WebApplicationContext)this.context).postInitialization( refCtxs);
		else if( this.context instanceof bxm.context.XmlApplicationContext)
			( (bxm.context.XmlApplicationContext)this.context).postInitialization( refCtxs);
	}

	public void preInstantiate()
	{
		if( this.context instanceof bxm.context.WebApplicationContext)
			( (bxm.context.WebApplicationContext)this.context).preInstantiate();
		else if( this.context instanceof bxm.context.XmlApplicationContext)
			( (bxm.context.XmlApplicationContext)this.context).preInstantiate();
	}

	public void deferredInstantiate( LinkedList<GetBeanTask> deferredQueue, Object lock)
	{
		if( this.context instanceof bxm.context.WebApplicationContext)
		{
			bxm.context.WebApplicationContext wctx= (bxm.context.WebApplicationContext)this.context;
			wctx.setDeferredInitializerQueue( deferredQueue);
			wctx.setDeployerLock( lock);
			wctx.preInstantiate();
		}
	}

	public void interruptedDeferredInstantiate()
	{
		if( this.context instanceof bxm.context.WebApplicationContext)
		{
			bxm.context.WebApplicationContext wctx= (bxm.context.WebApplicationContext)this.context;
			wctx.setDeferredInitInterrupted( true);
		}
	}

	public ClassLoaderRef getClassLoaderRef()
