	protected void preInstantiate()
	{
		logger.info( "application [{}] preInstantiate started.", application.getApplicationName());

		final ConfigurableListableBeanFactory beanFactory= ( (ConfigurableListableBeanFactoryDelegate)getBeanFactory()).getDelegate();
		// Initialize conversion service for this context.
//		if( beanFactory.containsBean( CONVERSION_SERVICE_BEAN_NAME) &&
//				beanFactory.isTypeMatch( CONVERSION_SERVICE_BEAN_NAME, ConversionService.class))
//			beanFactory.setConversionService( beanFactory.getBean( CONVERSION_SERVICE_BEAN_NAME, ConversionService.class));

		// Stop using the temporary ClassLoader for type matching.
		beanFactory.setTempClassLoader( null);

		// Allow for caching all bean definition metadata, not expecting further changes.
		beanFactory.freezeConfiguration();

		// Instantiate all remaining (non-lazy-init) singletons.
		if( application.isDeferredInit())
		{
			final ConfigurableListableBeanFactoryDelegate dfactory= ( (ConfigurableListableBeanFactoryDelegate)getBeanFactory());
			final LinkedList<GetBeanTask> tasks= new LinkedList<GetBeanTask>();
			final ApplicationInitializerReference initReference= application.getApplicationInitailizerReference();
			final String[] beanNames= initReference!= null ?
					initReference.getPreInitializableBeanNames( new WeakReference<Application>( application)) :
					dfactory.getBeanDefinitionNames();

			if( initReference!= null)
				logger.debug( "use initializerreference[{}] bean name count [{}].", initReference,
						beanNames!= null && beanNames.length> 0 ? beanNames.length : 0);

			if( beanNames!= null && beanNames.length> 0)
			{
				dfactory.setDeployerLock( this.deployerLock);
				dfactory.setPqueue( this.deferredInitializerQueue);
				final CountDownLatch started= new CountDownLatch( 1);
				NamedExecutors.newPrivilegedThread( new Runnable(){
					boolean dstarted= false;
					public void run()
					{
						try
						{
							for( String beanName: beanNames)
							{
								synchronized( tasks)
								{
									GetBeanTask task= new GetBeanTask( application.getApplicationName(),
											GetBeanTask.DEPLOYER_TASK, beanName, null, (Object[])null);
									tasks.offer( task);
//									logger.debug( "offer {}", task);
								}

								if( !dstarted)
								{
									started.countDown();
									dstarted= true;
								}
							}
						}
						catch( Throwable th)
						{
							logger.error( "application [{}] deferred initializer queuing task is failed.",
									application.getApplicationName(), th);
						}
						finally
						{
							deferredQueueFinished= true;
						}
					}
				}, application.getApplicationName()+ "deferredInitializer-queue", true).start();

				NamedExecutors.newPrivilegedThread( new Runnable(){
					public void run()
					{
						try{ started.await();}
						catch( InterruptedException ie)
						{
							logger.error( "application [{}] deferred initializer create task start failed.",
									application.getApplicationName(), ie);
							return;
						}
						GetBeanTask task= null;

						try
						{
							while( !deferredInitInterrupted)
							{
								synchronized( deferredInitializerQueue){ task= deferredInitializerQueue.peekFirst();}

								if( task!= null && GetBeanTask.SERVICE_TASK== task.task)
								{
									synchronized( deployerLock){ try{ deployerLock.wait( 500L);}catch( InterruptedException e)
									{
										logger.error( "application [{}] deferred initializer create task wait failed.",
												application.getApplicationName(), e);
										return;
									}}

									if( application.getDeferredInitInterval()> 0)
									{
										try{ Thread.sleep( application.getDeferredInitInterval());}catch( InterruptedException e)
										{
											logger.error( "application [{}] deferred initializer create task wait failed.",
													application.getApplicationName(), e);
											return;
										}
									}
									continue;
								}

								synchronized( tasks)
								{
									if( tasks.isEmpty()) break;
									task= tasks.removeFirst();
								}
								if( task== null && deferredQueueFinished)
									break;
								dfactory.deferredInstantiateSingletons( application, task);
//								logger.debug( "getBean from deployer {}", task.beanName);
							}
						}
						catch( Throwable th)
						{
							logger.error( "application [{}] deferred initializer create task is failed.",
									application.getApplicationName(), th);
						}
						finally
						{
							tasks.clear();
							dfactory.setPqueue( null);
							dfactory.setDeployerLock( null);
							WebApplicationContext.this.deployerLock= null;
							WebApplicationContext.this.deferredInitializerQueue= null;
							if( initReference!= null)
								initReference.preInitializeCompleted( new WeakReference<Application>( application));
							logger.info( "======================================================");
							logger.info( "application [{}] deferred initialization is finished.", application.getApplicationName());
							logger.info( "======================================================");
						}
					}
				}, application.getApplicationName()+ "deferredInitializer-task", true).start();
			}
			else
			{
				tasks.clear();
				dfactory.setPqueue( null);
				dfactory.setDeployerLock( null);
				WebApplicationContext.this.deployerLock= null;
				WebApplicationContext.this.deferredInitializerQueue= null;
				if( initReference!= null)
					initReference.preInitializeCompleted( new WeakReference<Application>( application));
			}
		}
		else if( !application.isLazyInit())
			( (ConfigurableListableBeanFactoryDelegate)getBeanFactory()).preInstantiateSingletons( application);

		logger.info(  "beanfactory of [{}] initialization is finished.", application.getApplicationName());
	}

