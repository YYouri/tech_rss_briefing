	private List<URL> createLocalAppClasspath( File loaderTarget) throws IOException
	{
		List<URL> localAppClasspath= new ArrayList<URL>();

		if( loaderTarget.isFile() && loaderTarget.getName().endsWith( ResourceUtils.URL_PROTOCOL_PAR))
		{
			URL parUrl= ApplicationClassLoaderManager.createClassPathEntry( loaderTarget);
			JarFile parFile= new JarFile( loaderTarget);
			JarEntry classPath= parFile.getJarEntry( DeployedApplicationModel.CLASSES_PATH_SUFFIX+ "/");
			JarEntry binPath= parFile.getJarEntry( DeployedApplicationModel.BIN_PATH_SUFFIX+ "/");
			JarEntry libPath= parFile.getJarEntry( DeployedApplicationModel.LIB_PATH_SUFFIX+ "/");
			if( classPath!= null && classPath.isDirectory())
			{
				try
				{
					localAppClasspath.add(
							new URL( ResourceUtils.URL_PROTOCOL_PAR, "", 0, "file:"+ parUrl.getFile()+
									ParURLConnection.SEPARATOR+ DeployedApplicationModel.CLASSES_PATH_SUFFIX,
									new ParURLStreamHandler()));
				}
				catch( MalformedURLException ne){}
			}
			if( binPath!= null && binPath.isDirectory())
			{
				try
				{
					localAppClasspath.add(
						new URL( ResourceUtils.URL_PROTOCOL_PAR, "", 0, "file:"+ parUrl.getFile()+
								ParURLConnection.SEPARATOR+ DeployedApplicationModel.BIN_PATH_SUFFIX,
								new ParURLStreamHandler()));
				}
				catch( MalformedURLException ne){}
			}
			if( libPath!= null && libPath.isDirectory())
			{
				for( Enumeration<JarEntry> entries= parFile.entries(); entries.hasMoreElements();)
				{
					JarEntry candidate= entries.nextElement();
					if( candidate.getName().equals( ".svn")) continue;
					if( candidate.getName().startsWith( libPath.getName()) && !candidate.isDirectory() &&
							candidate.getName().endsWith( ResourceUtils.URL_PROTOCOL_JAR))
					{
						try
						{
							localAppClasspath.add(
								new URL( ResourceUtils.URL_PROTOCOL_PAR, "", 0, "file:"+ parUrl.getFile()+
										ParURLConnection.SEPARATOR+ candidate.getName(), new ParURLStreamHandler()));
						}
						catch( MalformedURLException ne){}
					}
				}
			}

			// Batch
			if( Boolean.valueOf( System.getProperty( ApplicationContainerLoader.CONTAINER_FOR_BATCH)))
			{
				JarEntry metaInfPath= parFile.getJarEntry( DeployedApplicationModel.META_PATH_SUFFIX+ "/");
				if( metaInfPath!= null && metaInfPath.isDirectory())
				{
					try
					{
						localAppClasspath.add(
								new URL( ResourceUtils.URL_PROTOCOL_PAR, "", 0, "file:"+ parUrl.getFile()+
										ParURLConnection.SEPARATOR+ DeployedApplicationModel.META_PATH_SUFFIX,
										new ParURLStreamHandler()));
					}
					catch( MalformedURLException ne){}
				}

				JarEntry configPath= parFile.getJarEntry( DeployedApplicationModel.CONFIG_PATH_SUFFIX+ "/");
				if( configPath!= null && configPath.isDirectory())
				{
					try
					{
						localAppClasspath.add(
								new URL( ResourceUtils.URL_PROTOCOL_PAR, "", 0, "file:"+ parUrl.getFile()+
										ParURLConnection.SEPARATOR+ DeployedApplicationModel.CONFIG_PATH_SUFFIX,
										new ParURLStreamHandler()));
					}
					catch( MalformedURLException ne){}
				}
			}
		}
		else
		{
			File libPath= new File( loaderTarget, DeployedApplicationModel.LIB_PATH_SUFFIX);
			File classPath= new File( loaderTarget, DeployedApplicationModel.CLASSES_PATH_SUFFIX);
			File binPath= new File( loaderTarget, DeployedApplicationModel.BIN_PATH_SUFFIX);

			if( classPath.exists() && classPath.isDirectory())
			{
				try{ localAppClasspath.add( ApplicationClassLoaderManager.createClassPathEntry( classPath));}
				catch( MalformedURLException ne){}
			}
			if( binPath.exists() && binPath.isDirectory())
			{
				try{ localAppClasspath.add( ApplicationClassLoaderManager.createClassPathEntry( binPath));}
				catch( MalformedURLException ne){}
			}

			if( Boolean.valueOf( System.getProperty( ApplicationContainerLoader.CONTAINER_FOR_BATCH)))
			{
				File file = new File(libPath + File.separator + "lib_version.properties");
				if(file.exists())
				{
					BufferedReader br = null;
					try
					{
						br = new BufferedReader(new FileReader(file));
						String read = br.readLine();
						if(StringUtils.hasText(read))
						{
							libPath = new File(libPath + File.separator + read);
						}
					}
					catch (Exception e)
					{
						throw new RuntimeException(e.getMessage(), e);
					}
					finally
					{
						if(br != null) try { br.close();} catch (Exception e2) {}
					}
				}

				if( libPath.exists() && libPath.isDirectory())
				{
					File[] libEntries= libPath.listFiles();
					for( File libEntry: libEntries)
					{
						if( libEntry.getName().equals( ".svn")) continue;
						if(libEntry.getName().endsWith(".jar"))
						{
							if(libEntry.getName().contains("online") || libEntry.getName().contains("interface") || libEntry.getName().contains("batch")
									|| libEntry.getName().contains("dbio"))
							try{ localAppClasspath.add( ApplicationClassLoaderManager.createClassPathEntry( libEntry));}
							catch( MalformedURLException ne){}
						}
					}
				}
			}
			else
			{
				if( libPath.exists() && libPath.isDirectory())
				{
					File[] libEntries= libPath.listFiles();
					for( File libEntry: libEntries)
					{
						if( libEntry.getName().equals( ".svn")) continue;
						try{ localAppClasspath.add( ApplicationClassLoaderManager.createClassPathEntry( libEntry));}
						catch( MalformedURLException ne){}
					}
				}
			}

			// Batch
			if( Boolean.valueOf( System.getProperty( ApplicationContainerLoader.CONTAINER_FOR_BATCH)))
			{
				File metaInfPath= new File( loaderTarget, DeployedApplicationModel.META_PATH_SUFFIX);
				if( metaInfPath.exists() && metaInfPath.isDirectory())
				{
					try{ localAppClasspath.add( ApplicationClassLoaderManager.createClassPathEntry( metaInfPath));}
					catch( MalformedURLException ne){}
				}

				File configPath= new File( loaderTarget, DeployedApplicationModel.CONFIG_PATH_SUFFIX);
				if( configPath.exists() && configPath.isDirectory())
				{
					try{ localAppClasspath.add( ApplicationClassLoaderManager.createClassPathEntry( configPath));}
					catch( MalformedURLException ne){}
				}
			}
		}

		String[] libHome= applicationLoader.getLibraryHome();
		if( libHome!= null && libHome.length> 0)
		{
			for( String path: libHome)
			{
				File pathFile= new File( path);
				if( !pathFile.exists() || !pathFile.canRead() || !pathFile.isDirectory())	continue;
				File[] pathList= pathFile.listFiles();
				for( File pathEntry: pathList)
				{
					if( pathEntry.getName().equals( ".svn"))	continue;
					try{ localAppClasspath.add( ApplicationClassLoaderManager.createClassPathEntry( pathEntry));}
					catch( MalformedURLException ne){}
				}
			}
		}

		return localAppClasspath;
	}

