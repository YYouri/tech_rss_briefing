function refreash() {
    hideRMenu();
    $.ajax({
        type: 'POST',
        url: "/imageLoadFtpDir.json",
        cache: false,
        data: $("#imageUploadForm").serialize(),
        contentType: "application/x-www-form-urlencoded; charset=UTF-8",
        dataType: 'JSON',
        success: function(data) {
            $('#connectedTargetSystem').val(data.connectedTargetSystem);
            var folderArray = data.treeData;

            // [핵심 수정] 복잡한 myNewSetting을 만들지 말고, 
            // 이미 상단에 정의된 'setting'을 그대로 사용합니다.
            // 단, 혹시 모르니 다시 한번 확정적으로 넣어줍니다.
            setting.beforeContextMenu = OnRightClick; 

            // 트리를 초기화할 때 상단의 setting을 사용합니다.
            $.fn.zTree.init($("#treeDemo"), setting, folderArray);
        },
        error: function(request, status, error) {
            errorAlert("FTP 연결 실패", "", "error", "imageProcess.json", true);
        }
    });
}

function getTreeInfo(nodes, nodeArray, zTree, v){

	var filename = nodes[0].name;
	
	while(1){
    	if(nodes[0].getParentNode() != null){
    		nodeArray.push(nodes[0].getParentNode().name);
    		nodes[0] = nodes[0].getParentNode();
    	}
    	else{
    		zTree = $.fn.zTree.getZTreeObj("treeDemo");
    		nodes = zTree.getSelectedNodes();
    		break;
    	}   	
    }
    
    var tempArray = nodeArray.reverse();
    tempArray.push(filename);
    
	if (v.length > 0 ) {
		v = v.substring(0, v.length-1);
	}
	
	for(var m=0; m<tempArray.length; m++){
		v+=tempArray[m]+"/";
	}

	content_files.push(v);

	return v;
}

function OnRightClick(event, treeId, path, node) {
    // 1. 브라우저 기본 메뉴(뒤로가기, 새로고침 등)를 차단하는 핵심 코드
    event.preventDefault(); 
    event.stopPropagation(); // 이벤트가 위로 퍼지는 것을 막음

    var zTreeObj = $.fn.zTree.getZTreeObj("treeDemo");
    
    // 2. 노드 정보 설정
    sharedNodes = [node]; 
    isFile = node.isFile;

    // 3. 클릭한 노드 선택
    zTreeObj.selectNode(node);

    // 4. 경로 정보 계산
    var v = "";
    var nodeArray = [];
    // getTreeInfo 호출 시 node가 포함된 배열을 전달
    v = getTreeInfo(sharedNodes, nodeArray, zTreeObj, "");
    $('#content').val(v);

    // 5. 메뉴 표시
    if($("input:radio[name=uploadType]:checked").val() == "fileUpload"){
        // event.pageX, event.pageY를 사용하여 마우스 위치에 메뉴를 띄움
        showRMenu("node", event.pageX, event.pageY, isFile, v);
    }
    
    return true; // zTree의 기본 동작을 허용
}
function showRMenu(type, x, y, isFile, v) {
    var rMenu = $("#rMenu");
    
    // 메뉴의 모든 리스트 항목을 일단 숨김
    $("#rMenu ul li").hide();

    // [중요] display를 block으로 설정해야 화면에 나타납니다.
    rMenu.css({
        "display": "block",  // <--- 이게 반드시 있어야 함!
        "top": y + "px",
        "left": x + "px",
        "visibility": "visible"
    });

    if (isFile == true) {
        rMenu.css({"height":"30px"});
        $("#mf_del").show();
        $("#m_add, #m_del, #m_modi, #m_reset").hide();
    } else {
        rMenu.css({"height":"105px"});
        $("#mf_del").hide();
        $("#m_add, #m_del, #m_modi, #m_reset").show();
    }

    // 마우스 클릭 시 메뉴 닫기 (중복 방지를 위해 off 후 on)
    $(document).off("mousedown.rMenu").on("mousedown.rMenu", function(e) {
        if (!$(e.target).closest("#rMenu").length) {
            hideRMenu();
        }
    });
}
function onBodyMouseDown(event) {
    var rMenu = $("#rMenu");
    // 메뉴 외부 클릭 시 메뉴 숨김
    if (!rMenu.is(event.target) && rMenu.has(event.target).length === 0) {
        hideRMenu();
    }
}

function hideRMenu() {
    $("#rMenu").hide();
    $(document).off("mousedown.rMenu"); // 이벤트 해제
}

