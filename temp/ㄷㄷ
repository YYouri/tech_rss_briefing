package hi.framework.deploymanager.resourceDown.service;

import java.io.IOException;
import java.nio.charset.StandardCharsets;
import java.nio.file.Files;
import java.nio.file.Paths;
import java.time.Duration;
import java.time.Instant;
import java.util.ArrayList;
import java.util.Collections;
import java.util.List;
import java.util.Map;
import java.util.concurrent.ConcurrentHashMap;

import org.apache.logging.log4j.LogManager;
import org.apache.logging.log4j.Logger;
import org.springframework.beans.factory.annotation.Autowired;
import org.springframework.scheduling.annotation.Scheduled;
import org.springframework.stereotype.Service;

import com.github.difflib.DiffUtils;
import com.github.difflib.patch.AbstractDelta;
import com.github.difflib.patch.Chunk;
import com.github.difflib.patch.Patch;

import hi.framework.deploymanager.resourceDown.entity.CompareCacheEntry;
import hi.framework.deploymanager.resourceDown.entity.CompareDiffRangeRequest;
import hi.framework.deploymanager.resourceDown.entity.CompareDiffRangeResponse;
import hi.framework.deploymanager.resourceDown.entity.DiffDisplayLine;

@Service
public class ResourceCompareService {
	private static final Logger logger = LogManager.getLogger(ResourceCompareService.class);
    /** 이 라인 수(old+new 합)를 넘으면 계산 자체를 거절 (서버 보호) */
    private static final int MAX_LINES_IN_MEMORY = 500_000;

    /** 한 번의 요청으로 내려줄 수 있는 최대 라인 수 (한쪽 기준) */
    private static final int MAX_CHUNK_LINES = 500;

    /** 캐시 보관 시간 - 화면을 오래 열어두면 다시 계산하도록 적당히만 유지 */
    private static final Duration CACHE_TTL = Duration.ofMinutes(20);

    @Autowired
    private DiffResourceService versionFileResolver;

    private final Map<String, CompareCacheEntry> cache = new ConcurrentHashMap<>();

    public CompareDiffRangeResponse compare(CompareDiffRangeRequest req) {
        CompareDiffRangeResponse res = new CompareDiffRangeResponse();

        if (isBlank(req.getDirInfo()) || isBlank(req.getFileName())
                || isBlank(req.getCurrVer()) || isBlank(req.getPrevVer())) {
            res.setSuccess(false);
            res.setMessage("비교에 필요한 정보(dirInfo/fileName/currVer/prevVer)가 부족합니다");
            return res;
        }

        String cacheKey = req.getDirInfo() + "|" + req.getFileName() + "|" + req.getCurrVer() + "|" + req.getPrevVer();

        CompareCacheEntry entry = null;
        try {
            entry = cache.computeIfAbsent(cacheKey, k -> {
                try {
                    return buildEntry(req);
                } catch (Exception e) {
                    return null; 
                }
            });
            if (entry == null) {
                res.setSuccess(false);
                res.setMessage("데이터 생성 실패");
                return res;
            }

        } catch (Exception e) {
            res.setSuccess(false);
            res.setMessage(e.getMessage());
            return res;
        }
        int start = req.getStartLine() == null ? 0 : Math.max(0, req.getStartLine());
        int end = req.getEndLine() == null ? start + 200 : req.getEndLine();
        int limit = Math.min(end - start, MAX_CHUNK_LINES);
        if (limit < 0) limit = 0;

        res.setSuccess(true);
        res.setTotalCurrentLines(entry.getCurrentAll().size());
        res.setTotalPreviousLines(entry.getPreviousAll().size());
        res.setCurrentLines(slice(entry.getCurrentAll(), start, limit));
        res.setPreviousLines(slice(entry.getPreviousAll(), start, limit));
        return res;
    }

    private List<DiffDisplayLine> slice(List<DiffDisplayLine> all, int start, int limit) {
        if (start >= all.size()) return Collections.emptyList();
        int end = Math.min(start + limit, all.size());
        return new ArrayList<>(all.subList(start, end));
    }

    /**
     * 실제 diff 계산. cache.computeIfAbsent 안에서 호출되므로 같은 키에 대해
     * 동시에 여러 요청이 와도 한 번만 계산된다.
     * @throws Exception 
     */
    private CompareCacheEntry buildEntry(CompareDiffRangeRequest req) throws Exception {
        String newPath = versionFileResolver.resolveCheckedOutPath(req.getDirInfo(), req.getFileName(), req.getCurrVer());
        if (newPath == null) {
        	throw new Exception("현재 버전(" + req.getCurrVer() + ") 파일을 찾을 수 없습니다");
        }
        
        List<String> oldLines;
        List<String> newLines;
        
        if(!"0".equals(req.getPrevVer())) {
        	String oldPath = versionFileResolver.resolveCheckedOutPath(req.getDirInfo(), req.getFileName(), req.getPrevVer());
        	if (oldPath == null) {
        		throw new Exception("이전 버전(" + req.getPrevVer() + ") 파일을 찾을 수 없습니다");
        	}
        	try {
        		oldLines = Files.readAllLines(Paths.get(oldPath), StandardCharsets.UTF_8);
        	} catch (IOException e) {
        		throw new Exception("파일 읽기 실패: " + e.getMessage(), e);
        	} finally {
        		
        		deleteQuietly(oldPath);
        	}
        	
        } else {
        	oldLines = new ArrayList<>();
        }
        
        try {
            newLines = Files.readAllLines(Paths.get(newPath), StandardCharsets.UTF_8);
        } catch (IOException e) {
            throw new Exception("파일 읽기 실패: " + e.getMessage(), e);
        }finally {
    		deleteQuietly(newPath);
    	}

        if (oldLines.size() + newLines.size() > MAX_LINES_IN_MEMORY) {
            throw new Exception("파일이 너무 커서 비교할 수 없습니다 (총 " + (oldLines.size() + newLines.size()) + "줄)");
        }

        Patch<String> patch = DiffUtils.diff(oldLines, newLines);
        return buildCacheEntry(oldLines, newLines, patch);
    }

    private void deleteQuietly(String path) {
    	if(path.isEmpty()) return;
    	try {
			Files.deleteIfExists(Paths.get(path));
		} catch (Exception e) {
			logger.error("임시 비교 파일 삭제 실패 (무시함) : path={}, 에러={}", path, e.getMessage(), e);
		}
    }
    /**
     * delta 사이사이 안 바뀐(EQUAL) 구간까지 채워서, current 자신의 전체 라인,
     * previous 자신의 전체 라인을 각각 만든다. (좌우가 서로 다른 줄 수를 가질 수 있는
     * 비정렬 방식 - 화면의 diffData.current / diffData.previous 구조와 대응)
     */
    private CompareCacheEntry buildCacheEntry(List<String> oldLines, List<String> newLines, Patch<String> patch) {
        List<DiffDisplayLine> currentAll = new ArrayList<>();
        List<DiffDisplayLine> previousAll = new ArrayList<>();
        int oldPos = 0;
        int newPos = 0;

        for (AbstractDelta<String> delta : patch.getDeltas()) {
            Chunk<String> source = delta.getSource();
            Chunk<String> target = delta.getTarget();
            int deltaOldStart = source.getPosition();
            int deltaNewStart = target.getPosition();

            while (oldPos < deltaOldStart) {
                String content = oldLines.get(oldPos);
                currentAll.add(new DiffDisplayLine(content, "normal", currentAll.size()));
                previousAll.add(new DiffDisplayLine(content, "normal", previousAll.size()));
                oldPos++;
                newPos++;
            }

            List<String> oldChunk = source.getLines();
            List<String> newChunk = target.getLines();

            switch (delta.getType()) {
                case DELETE:
                    for (String s : oldChunk) {
                        previousAll.add(new DiffDisplayLine(s, "removed", previousAll.size()));
                        oldPos++;
                    }
                    break;
                case INSERT:
                    for (String s : newChunk) {
                        currentAll.add(new DiffDisplayLine(s, "added", currentAll.size()));
                        newPos++;
                    }
                    break;
                case CHANGE:
                    int maxLen = Math.max(oldChunk.size(), newChunk.size());
                    for (int i = 0; i < maxLen; i++) {
                        if (i < oldChunk.size()) {
                            previousAll.add(new DiffDisplayLine(oldChunk.get(i), "changed", previousAll.size()));
                            oldPos++;
                        }
                        if (i < newChunk.size()) {
                            currentAll.add(new DiffDisplayLine(newChunk.get(i), "changed", currentAll.size()));
                            newPos++;
                        }
                    }
                    break;
                default:
                    break;
            }
        }

        while (oldPos < oldLines.size()) {
            String content = oldLines.get(oldPos);
            currentAll.add(new DiffDisplayLine(content, "normal", currentAll.size()));
            previousAll.add(new DiffDisplayLine(content, "normal", previousAll.size()));
            oldPos++;
            newPos++;
        }

        return new CompareCacheEntry(currentAll, previousAll);
    }

    private boolean isBlank(String s) {
        return s == null || s.trim().isEmpty();
    }

    /** 오래된 비교 결과는 주기적으로 정리 (스케줄링 쓰려면 @EnableScheduling 필요) */
    @Scheduled(fixedDelay = 10 * 60 * 1000)
    public void cleanupOldEntries() {
        Instant cutoff = Instant.now().minus(CACHE_TTL);
        cache.values().removeIf(e -> e.getCreatedAt().isBefore(cutoff));
    }
}
