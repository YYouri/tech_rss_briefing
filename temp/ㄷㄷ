	 * @param returnType 반환 데이터 타입
	 *  
	 * @return XPathExpression
	 * 
	 * @throws XPathExpressionException
	 */
	public static XPathExpression getXPathExpression(Document doc, String expression, QName returnType) throws XPathExpressionException {
		XPathExpression expr = null;
		expr = xpath.compile(expression);
		return expr;
	}

