	public void destroy( boolean forced)
	{
		logger.info( "ApplicationClassLoaderManager will be destoyed.");
		AbstractApplicationClassLoader loader= null;

		String[] names= this.sharedLoaderRefs.keySet().toArray( new String[this.sharedLoaderRefs.keySet().size()]);
		for( String name: names)
		{
			ClassLoaderRef ref= this.sharedLoaderRefs.remove( name);
			if( ref!= null)
			{
				try
				{
//					synchronized( loaderLock)
					{
						loader= null;
						try
						{
							loader= ref.getClassLoader();
							loader.setPooled( false);
							loader.setStatus( ClassLoaderStatus.DIRTY);
							ref.release();
							if( forced && !loader.isDestroyed())	loader.destroy();
						}catch( NilRefException ne){}
					}
				}
				catch( NilRefException e)
				{
					e.printStackTrace();
				}
			}
		}

		names= this.isolatedLoaderRefs.keySet().toArray( new String[this.isolatedLoaderRefs.keySet().size()]);
		for( String name: names)
		{
			ClassLoaderRef ref= this.isolatedLoaderRefs.remove( name);
			if( ref!= null)
			{
				try
				{
//					synchronized( loaderLock)
					{
						loader= null;
						try
						{
							loader= ref.getClassLoader();
							loader.setPooled( false);
							loader.setStatus( ClassLoaderStatus.DIRTY);
