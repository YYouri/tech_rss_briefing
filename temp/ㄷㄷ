package hi.framework.deploymanager.server.controller;

import java.util.HashMap;
import java.util.Map;

import org.apache.logging.log4j.LogManager;
import org.apache.logging.log4j.Logger;
import org.springframework.http.HttpStatus;
import org.springframework.http.ResponseEntity;
import org.springframework.web.bind.annotation.GetMapping;
import org.springframework.web.bind.annotation.PostMapping;
import org.springframework.web.bind.annotation.RequestBody;
import org.springframework.web.bind.annotation.RequestMapping;
import org.springframework.web.bind.annotation.RequestParam;
import org.springframework.web.bind.annotation.RestController;

import hi.framework.deploymanager.server.service.CleanupResourceService;

@RestController
@RequestMapping("/api/resource-cleanup")
public class CleanupResourceServiceController {
    private Logger logger = LogManager.getLogger(this.getClass().getName());

private final CleanupResourceService cleanupResourceService;

public CleanupResourceServiceController(CleanupResourceService cleanupResourceService) {
    this.cleanupResourceService = cleanupResourceService;
}

@PostMapping("/upload.json")
public ResponseEntity<Map<String, Object>> upload(@RequestBody UploadRequest request) {
    logger.info("[Upload Request] env: {}, taskId: {}, fileCount: {}", 
            request.getEnv(), request.getTaskId(), request.getFiles() != null ? request.getFiles().size() : 0);
    Map<String, Object> body = new HashMap<>();
    try {
        cleanupResourceService.validateTaskId(request.getTaskId());
        cleanupResourceService.validateEnv(request.getEnv());

        Map<String, String> uploaded = cleanupResourceService.uploadTaskFiles(request.getEnv(), request.getTaskId(), request.getFiles());

        logger.info("[Upload Success] env: {}, taskId: {}, uploadedFiles: {}", request.getEnv(), request.getTaskId(), uploaded);
        body.put("success", true);
        body.put("uploadedFiles", uploaded);
        return ResponseEntity.ok(body);
    } catch (IllegalArgumentException badRequest) {
        logger.warn("[Upload Validation Failed] env: {}, taskId: {}, message: {}", request.getEnv(), request.getTaskId(), badRequest.getMessage());
        body.put("success", false);
        body.put("message", badRequest.getMessage());
        return ResponseEntity.status(HttpStatus.BAD_REQUEST).body(body);
    } catch (Exception e) {
        logger.error("[Upload Error] env: {}, taskId: {}, message: {}", request.getEnv(), request.getTaskId(), e.getMessage(), e);
        body.put("success", false);
        body.put("message", "업로드 실패: " + e.getMessage());
        return ResponseEntity.status(HttpStatus.INTERNAL_SERVER_ERROR).body(body);
    }
}

@PostMapping("/execute.json")
public ResponseEntity<Map<String, Object>> execute(@RequestBody ExecuteRequest request) {
    logger.info("[Execute Request-Async] env: {}, taskId: {}", request.getEnv(), request.getTaskId());
    Map<String, Object> body = new HashMap<>();
    try {
        cleanupResourceService.validateTaskId(request.getTaskId());
        cleanupResourceService.validateEnv(request.getEnv());

        cleanupResourceService.startExecuteAsync(request.getEnv(), request.getTaskId());

        body.put("success", true);
        body.put("status", "RUNNING");
        return ResponseEntity.ok(body);
    } catch (IllegalStateException alreadyRunning) {
        // 이미 실행 중인 경우 (중복 클릭 등)
        logger.warn("[Execute Already Running] env: {}, taskId: {}, message: {}", request.getEnv(), request.getTaskId(), alreadyRunning.getMessage());
        body.put("success", false);
        body.put("message", alreadyRunning.getMessage());
        return ResponseEntity.status(HttpStatus.CONFLICT).body(body);
    } catch (IllegalArgumentException badRequest) {
        logger.warn("[Execute Validation Failed] env: {}, taskId: {}, message: {}", request.getEnv(), request.getTaskId(), badRequest.getMessage());
        body.put("success", false);
        body.put("message", badRequest.getMessage());
        return ResponseEntity.status(HttpStatus.BAD_REQUEST).body(body);
    } catch (Exception e) {
        logger.error("[Execute Error] env: {}, taskId: {}, message: {}", request.getEnv(), request.getTaskId(), e.getMessage(), e);
        body.put("success", false);
        body.put("message", "실행 시작 실패: " + e.getMessage());
        return ResponseEntity.status(HttpStatus.INTERNAL_SERVER_ERROR).body(body);
    }
}

@GetMapping("/execute-status.json")
public ResponseEntity<Map<String, Object>> executeStatus(@RequestParam("env") String env, @RequestParam("taskId") String taskId) {
    Map<String, Object> body = new HashMap<>();
    try {
        cleanupResourceService.validateTaskId(taskId);
        cleanupResourceService.validateEnv(env);

        CleanupResourceService.TaskExecution exec = cleanupResourceService.getExecutionStatus(env, taskId);

        body.put("success", true);
        body.put("status", exec.getStatus()); // RUNNING / SUCCESS / FAILED
        if (!exec.isRunning()) {
            body.put("exitCode", exec.getExitCode());
            body.put("output", exec.getOutput() != null ? exec.getOutput() : exec.getErrorMessage());
        }
        return ResponseEntity.ok(body);
    } catch (IllegalStateException notFound) {
        body.put("success", false);
        body.put("message", notFound.getMessage());
        return ResponseEntity.status(HttpStatus.NOT_FOUND).body(body);
    } catch (IllegalArgumentException badRequest) {
        body.put("success", false);
        body.put("message", badRequest.getMessage());
        return ResponseEntity.status(HttpStatus.BAD_REQUEST).body(body);
    } catch (Exception e) {
        logger.error("[Execute Status Error] env: {}, taskId: {}, message: {}", env, taskId, e.getMessage(), e);
        body.put("success", false);
        body.put("message", "상태 조회 실패: " + e.getMessage());
        return ResponseEntity.status(HttpStatus.INTERNAL_SERVER_ERROR).body(body);
    }
}


@GetMapping("/log.json")
public ResponseEntity<Map<String, Object>> log(@RequestParam("env") String env, @RequestParam("taskId") String taskId) {
    logger.info("[Log Fetch Request] env: {}, taskId: {}", env, taskId);
    Map<String, Object> body = new HashMap<>();
    try {
        cleanupResourceService.validateTaskId(taskId);
        cleanupResourceService.validateEnv(env);

        CleanupResourceService.ExecResult result = cleanupResourceService.fetchLatestLog(env, taskId);

        if (result.isSuccess()) {
            logger.info("[Log Fetch Success] env: {}, taskId: {}", env, taskId);
            body.put("success", true);
            body.put("log", result.getOutput());
        } else {
            logger.warn("[Log Fetch Failed] env: {}, taskId: {}, reason: {}", env, taskId, "No log file found or exit code: " + result.getExitCode());
            body.put("success", false);
            body.put("message", "로그 파일을 찾을 수 없습니다.");
        }
        return ResponseEntity.ok(body);
    } catch (IllegalArgumentException badRequest) {
        logger.warn("[Log Fetch Validation Failed] env: {}, taskId: {}, message: {}", env, taskId, badRequest.getMessage());
        body.put("success", false);
        body.put("message", badRequest.getMessage());
        return ResponseEntity.status(HttpStatus.BAD_REQUEST).body(body);
    } catch (Exception e) {
        logger.error("[Log Fetch Error] env: {}, taskId: {}, message: {}", env, taskId, e.getMessage(), e);
        body.put("success", false);
        body.put("message", "로그 조회 실패: " + e.getMessage());
        return ResponseEntity.status(HttpStatus.INTERNAL_SERVER_ERROR).body(body);
    }

}

