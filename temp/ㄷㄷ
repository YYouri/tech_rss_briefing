	public synchronized String[] predeployApplication(
			DeploySession session, String applicationName, File appRoot, String... applyPatterns)
			throws InvalidCommandException, ApplicationTargetException
	{
		if( TEPID!= this.applicationLoader.getLoadingMode())
		{
			logger.warn( "predeployApplication command is supported in TEPID loading mode.");
			throw new InvalidCommandException( INVALID_APPLICATION_LOADINGMODE,
					"predeployApplication command is supported in TEPID loading mode.");
		}

		List<String> stagingApplicationNames= new ArrayList<String>();
		Map<String, DeployedApplication> applications= deployApplicationInternal( applicationName, appRoot, true);
		if( applications!= null && applications.size()> 0)
		{
			prepareApplications( applications);

			for( DeployedApplication application: applications.values())
			{
				List<LightweightApplicationContext> refCtxs= new ArrayList<LightweightApplicationContext>();
				ClassLoaderRef[] shRefs=
						( (ApplicationClassLoader)application.getClassLoaderRef().getClassLoader()).getSharedClassLoaderRefs();
				for( ClassLoaderRef shRef: shRefs)
				{
					String shAppName= shRef.getClassLoader().getApplicationName();
					if( applications.containsKey( shAppName))
					{
						refCtxs.add( applications.get( shAppName).getLightweightApplicationContext());
						application.getIommFieldProperties().addReferenceIOmmFieldProperties(
								applications.get( shAppName).getIommFieldProperties());
					}
					else if( this.deployedApplications.containsKey( shAppName))
					{
						refCtxs.add( this.deployedApplications.get( shAppName).getLightweightApplicationContext());
						application.getIommFieldProperties().addReferenceIOmmFieldProperties(
								this.deployedApplications.get( shAppName).getIommFieldProperties());
					}
				}

				try
				{
					application.getLightweightApplicationContext().postInitialization(
							refCtxs.toArray( new LightweightApplicationContext[refCtxs.size()]));
				}
				catch( Throwable th)
				{
					logger.error( "application [{}] postInitialization is failed.",
							new Object[]{ application.getApplicationName(), th});
				}
			}

			for( DeployedApplication application: applications.values())
			{
				try
				{
					if( !this.batch && this.applicationLoader.isDeferredInit())
						application.getLightweightApplicationContext().deferredInstantiate( deferredTasks, deferredInitLock);
					else
						application.getLightweightApplicationContext().preInstantiate();
					application.resetValidClientPatterns( applyPatterns);
					this.validatingApplications.put( application.getApplicationName(), application);
					application.setStage( ApplicationStage.VALIDATING);
					application.predeployed( this.uuid, this.datasource);
					logger.info( "current application [{}] is registered for validating.", application.getApplicationName());
					stagingApplicationNames.add( application.getApplicationName());
				}
				catch( Throwable th)
				{
					logger.error( "application [{}] preInstantiate is failed.", new Object[]{ application.getApplicationName(), th});
					if( session!= null && application!= null && StringUtils.hasText( application.getApplicationName())
							&& stagingApplicationNames.contains( application.getApplicationName()))
						stagingApplicationNames.remove( application.getApplicationName());
					application.getLightweightApplicationContext().interruptedDeferredInstantiate();
					session.setForcedInvaliding( true);
				}
			}

			try
			{
				for( DeployedApplication application: applications.values())
				{
					if( !applicationLoader.isLazyInit() || COLD== applicationLoader.getLoadingMode()
							|| ( application.getApplicationSource()!= null
									&& StringUtils.hasText( application.getApplicationSource().getFile())
									&& application.getApplicationSource().getFile().endsWith( BXM_ARCHIVE_SUFFIX)))
					{
						try{ application.getClassLoaderRef().getResourceLoader().clearMetadataReadCache();}catch( Throwable th){}
					}
				}
			}catch( Throwable th){}
		}

		return stagingApplicationNames.toArray( new String[stagingApplicationNames.size()]);
	}

	public synchronized String[] predeployMultiApplications(
			DeploySession session, PreDeployApplicationRequest[] applications, String... applyPatterns)
			throws InvalidCommandException, ApplicationTargetException
	{
		if( TEPID!= this.applicationLoader.getLoadingMode())
		{
			logger.warn( "predeployApplication command is supported in TEPID loading mode.");
			throw new InvalidCommandException( INVALID_APPLICATION_LOADINGMODE,
					"predeployApplication command is supported in TEPID loading mode.");
		}

		List<String> stagingApplicationNames= new ArrayList<String>();
		Map<String, DeployedApplication> stagingTos= new HashMap<String, DeployedApplication>();
		Map<String, PreDeployApplicationRequest> requestApplications= new HashMap<String, PreDeployApplicationRequest>();

		for( PreDeployApplicationRequest appToStaging: applications)
		{
			logger.info( "application [{}] resource [{}] will be predeployed.",
					appToStaging.applicationName, appToStaging.resourceUrl);

			requestApplications.put( appToStaging.applicationName, appToStaging);

			File metaFile= null;
			URL applicationSource= null;
			InputStream inStream= null;
			BxmApplication conf= null;
			try
			{
				if( appToStaging.appRoot.isDirectory() && ( metaFile= new File( appToStaging.appRoot, APPLICATION_DD_FILE)).exists())
				{
					applicationSource= appToStaging.appRoot.toURI().toURL();
					inStream= new FileInputStream( metaFile);
				}
				else if( appToStaging.appRoot.isFile() && appToStaging.appRoot.getName().endsWith( BXM_ARCHIVE_SUFFIX))
				{
					applicationSource= appToStaging.appRoot.toURI().toURL();
					inStream= findApplicationConfigurationFromArchive( appToStaging.appRoot);
				}
				else
				{
					throw new InvalidCommandException( INVALID_APPLICATION_FORMAT,
							"invalid application format. ["+ appToStaging.appRoot.getAbsolutePath()+ "]" );
				}

				conf= marshallApplicationDescriptor( inStream);
				if( !StringUtils.hasText( appToStaging.applicationName) || !StringUtils.hasText( conf.getName())
						|| !appToStaging.applicationName.equals( conf.getName()))
					throw new InvalidCommandException( INVALID_APPLICATION_FORMAT,
							"request application not same with configured application name");

				appToStaging.conf= conf;
				appToStaging.applicationSource= applicationSource;

				List<URL> configuredClasspath= new ArrayList<URL>();
				configuredClasspath.addAll( applicationLoader.getApplicableClasspath());
				File loaderTarget= createLoaderTagetForApplication( conf.getName(), appToStaging.appRoot, null, false);
				appToStaging.loaderTarget= loaderTarget;
				List<URL> localAppClasspath= createLocalAppClasspath( loaderTarget);
				configuredClasspath.addAll( localAppClasspath);
				List<ApplicationClassLoaderListener> listeners= getClassLoaderLifecycleListeners();
				appToStaging.loaderElements=
						new ClassLoaderElementsForCreation(
								conf.getName(), configuredClasspath.toArray( new URL[configuredClasspath.size()]),
								localAppClasspath.toArray( new URL[localAppClasspath.size()]),
								conf.isShared(), listeners.toArray( new ApplicationClassLoaderListener[listeners.size()]),
								loaderTarget,
								StringUtils.hasText( conf.getReferenceApplications()) ?
										StringUtils.tokenizeToStringArray( conf.getReferenceApplications(), ",") : new String[]{},
								applicationLoader.getInstrument());
			}
			catch( Throwable th)
			{
				logger.error( "application [{}] resource [{}] deployment is failed.",
						new Object[]{ appToStaging.applicationName, appToStaging.appRoot.getAbsolutePath(), th});
				throw new ApplicationTargetException( "application ["+ appToStaging.applicationName+ "] resource ["
						+ appToStaging.appRoot.getAbsolutePath()+ "] deployment is failed.", th);
			}
			finally
			{
				if( inStream!= null) try{ inStream.close();}catch( IOException e){}
			}
		}

		List<ClassLoaderElementsForCreation> loaderElements= new ArrayList<ClassLoaderElementsForCreation>();
		for( PreDeployApplicationRequest appToStaging: applications)
			loaderElements.add( appToStaging.loaderElements);

		try
		{
			ClassLoaderRef[] changeTos= this.classLoaderManager.getClassLoaderForMultiStaging(
					loaderElements.toArray( new ClassLoaderElementsForCreation[loaderElements.size()]));

			for( ClassLoaderRef loaderRef: changeTos)
			{
//				String fullpath= ( (AbstractApplicationClassLoader)loaderRef.getClassLoader()).getFinder().getClassPath();
//				logger.debug( fullpath);

				String appName= loaderRef.getClassLoader().getApplicationName();
				PreDeployApplicationRequest request= requestApplications.get( appName);
				if( request!= null)
				{
					DeployedApplication target=
							(DeployedApplication)ApplicationConfigurationManager.configure( this, request.conf, true, loaderRef);
					target.setApplicationSource( request.applicationSource);
					target.setDeployedTarget( request.loaderTarget);
					stagingTos.put( target.getApplicationName(), target);
				}
				else
				{
					DeployedApplication deployedApp= this.deployedApplications.get( appName);
					if( deployedApp!= null)
					{
						DeployedApplication target= (DeployedApplication)ApplicationConfigurationManager.configure(
								this, deployedApp.getConfiguration(), true, loaderRef);
						target.setApplicationSource( deployedApp.getApplicationSource());
						target.setDeployedTarget( deployedApp.getDeployedTarget());
						stagingTos.put( target.getApplicationName(), target);
					}
					else
						logger.warn( "staging target application [{}] is not deployed.", appName);
				}
			}
		}
		catch( Throwable th)
		{
			logger.error( "applications [{}] resources [{}] deployment is failed.",
					new Object[]{ requestApplications.keySet(), requestApplications.values(), th});
			throw new ApplicationTargetException( "applications ["+ requestApplications.keySet()+ "] resource ["+
					requestApplications.values()+ "] deployment is failed.", th);
		}

		if( stagingTos!= null && stagingTos.size()> 0)
		{
			prepareApplications( stagingTos);

			for( DeployedApplication application: stagingTos.values())
			{
				List<LightweightApplicationContext> refCtxs= new ArrayList<LightweightApplicationContext>();
				ClassLoaderRef[] shRefs=
						( (ApplicationClassLoader)application.getClassLoaderRef().getClassLoader()).getSharedClassLoaderRefs();
				for( ClassLoaderRef shRef: shRefs)
				{
					String shAppName= shRef.getClassLoader().getApplicationName();
					if( stagingTos.containsKey( shAppName))
					{
						refCtxs.add( stagingTos.get( shAppName).getLightweightApplicationContext());
						application.getIommFieldProperties().addReferenceIOmmFieldProperties(
								stagingTos.get( shAppName).getIommFieldProperties());
					}
					else if( this.deployedApplications.containsKey( shAppName))
					{
						refCtxs.add( this.deployedApplications.get( shAppName).getLightweightApplicationContext());
						application.getIommFieldProperties().addReferenceIOmmFieldProperties(
								this.deployedApplications.get( shAppName).getIommFieldProperties());
					}
				}

				try
				{
					application.getLightweightApplicationContext().postInitialization(
							refCtxs.toArray( new LightweightApplicationContext[refCtxs.size()]));
				}
				catch( Throwable th)
				{ logger.error( "application [{}] postInitialization is failed.", application.getApplicationName(), th);}
			}

			for( DeployedApplication application: stagingTos.values())
			{
				try
				{
					if( !this.batch && this.applicationLoader.isDeferredInit())
						application.getLightweightApplicationContext().deferredInstantiate( deferredTasks, deferredInitLock);
					else
						application.getLightweightApplicationContext().preInstantiate();
					application.resetValidClientPatterns( applyPatterns);
					this.validatingApplications.put( application.getApplicationName(), application);
					application.setStage( ApplicationStage.VALIDATING);
					application.predeployed( this.uuid, this.datasource);
					logger.info( "current application [{}] is registered for validating.", application.getApplicationName());
					stagingApplicationNames.add( application.getApplicationName());
				}
				catch( Throwable th)
				{
					logger.error( "application [{}] preInstantiate is failed.", application.getApplicationName(), th);
					if( session!= null && application!= null
							&& StringUtils.hasText( application.getApplicationName())
							&& stagingApplicationNames.contains( application.getApplicationName()))
						stagingApplicationNames.remove( application.getApplicationName());
					application.getLightweightApplicationContext().interruptedDeferredInstantiate();
					session.setForcedInvaliding( true);
				}
			}

			try
			{
				for( DeployedApplication application: stagingTos.values())
				{
					if( !applicationLoader.isLazyInit() || COLD== applicationLoader.getLoadingMode()
							|| ( application.getApplicationSource()!= null
									&& StringUtils.hasText( application.getApplicationSource().getFile())
									&& application.getApplicationSource().getFile().endsWith( BXM_ARCHIVE_SUFFIX)))
					{
						try{ application.getClassLoaderRef().getResourceLoader().clearMetadataReadCache();}catch( Throwable th){}
					}
				}
			}catch( Throwable th){}
		}
		return stagingApplicationNames.toArray( new String[stagingApplicationNames.size()]);
	}

	@SuppressWarnings("static-access")
	public synchronized void deployPredeployedAppliation( String[] applicationNames)
			throws InvalidCommandException, ApplicationTargetException
	{
		logger.debug( "==============================================");
		logger.debug( "deployPredeployedApplication [{}/{}]", applicationNames!= null ?
				applicationNames.length : "null", applicationNames);
		logger.debug( "==============================================");

		if( TEPID!= this.applicationLoader.getLoadingMode())
		{
			logger.warn( "deployPredeployedAppliation command is supported in TEPID loading mode.");
			throw new InvalidCommandException( INVALID_APPLICATION_LOADINGMODE,
					"deployPredeployedAppliation command is supported in TEPID loading mode.");
		}

		List<ClassLoaderRef> refsToUse= new ArrayList<ClassLoaderRef>();
		List<ClassLoaderRef> refsToClear= new ArrayList<ClassLoaderRef>();
		for( String applicationName: applicationNames)
		{
			if( !this.validatingApplications.containsKey( applicationName))
			{
				logger.warn( "application [{}] is not found in predeployed application pool", applicationName);
				throw new InvalidCommandException( APPLICATION_NOTFOUND,
						"application ["+ applicationName+ "] is not found in predeployed application pool");
			}
			refsToUse.add( this.validatingApplications.get( applicationName).getClassLoaderRef());
			if( this.deployedApplications.containsKey( applicationName))
				refsToClear.add( this.deployedApplications.get( applicationName).getClassLoaderRef());
		}

		// only one deploy session is valid to staging is completed.

		this.classLoaderManager.applyClassLoaderForStaging(
				refsToUse.toArray( new ClassLoaderRef[refsToUse.size()]),
				refsToClear.toArray( new ClassLoaderRef[refsToClear.size()]));

		try
		{
			publishApplicationDeployStartedEvent( new InstanceEvent( this));

			for( String applicationName: applicationNames)
			{
				DeployedApplication application= this.validatingApplications.remove( applicationName);
				if( application== null) continue;

				application.setStage( ApplicationStage.EMPLOYED);
				application.resetValidClientPatterns();
				DeployedApplication das= this.deployedApplications.put( application.getApplicationName(), application);
				application.deployed( this.uuid, this.datasource);
				if( das== null) continue;

				// to avoid early gc effect
				this.referenceKeeper.add( das);
				das.getLightweightApplicationContext().interruptedDeferredInstantiate();
				das.setStage( ApplicationStage.THROWABLE);
				try{ das.undeployed( this.uuid, this.datasource);}catch( Throwable th){ logger.error( th.getMessage(), th);}
				finally{ das.destroy();}

				File dasSource= new File( das.getApplicationSource().getFile());
				File source= new File( application.getApplicationSource().getFile());
				if( !dasSource.exists() || !source.exists() || source.equals( dasSource)) continue;

				File lockFile= new File( appHome, "."+ application.getApplicationName()+"_lock");
				try {
					logger.debug("Lock File Path [{}]", lockFile.getCanonicalPath());
				} catch (IOException e1) {
					e1.printStackTrace();
				}

				/*
				 * par화일 교체시 아래와 같은 에러 발생. java.io.IOException: Permission denied
				 * 환경.
				 * SunOS 5.11 11.2
				 * java version "1.6.0_45"
				   Java(TM) SE Runtime Environment (build 1.6.0_45-b06)
				   Java HotSpot(TM) Server VM (build 20.45-b01, mixed mode)

				   에러StackTrace.
					java.io.IOException: Permission denied
			        at sun.nio.ch.FileChannelImpl.lock0(Native Method)
			        at sun.nio.ch.FileChannelImpl.tryLock(FileChannelImpl.java:871)
			        at java.nio.channels.FileChannel.tryLock(FileChannel.java:962)
			        at bxm.instance.FrameworkInstance.deployPredeployedAppliation(FrameworkInstance.java:1360)
		        */
				RandomAccessFile raFile= null;
				FileChannel channel= null;
				FileLock flock= null;
				try
				{
					raFile= new RandomAccessFile( lockFile, "rw");
					channel= raFile.getChannel();
					try {flock= channel.tryLock();} catch (Throwable e) {logger.warn("file lock acquisition failed. ", e);}
					int retryCount = 10;
					// file lock 얻지 못하는 경우 retry count횟수 만큼 재시도한다.
					if (flock == null)
					{
						for (int i = 0; i < retryCount; i++)
						{
							logger.debug("Lock file acquisition is failed. Lock File Path [{}]", lockFile.getCanonicalPath());
							try {Thread.currentThread().sleep(1000);} catch (Throwable e) {logger.warn("file lock acquisition failed. interrupted.", e);}
							try
							{
								flock= channel.tryLock();
							}
							catch (Throwable e)
							{
								logger.warn("file lock acquisition failed. count [{}]", i, e);
								// 반복횟수가 retryCount 만큼 진행되었으면 그대로 에러 발생.
								if (i == retryCount -1)
									throw e;
							}
							if (flock != null) break;
						}
					}
					if( flock!= null)
					{
						ResourceUtils.deleteFile( dasSource);
						if( source.isFile())
						{
							File nSource= new File( dasSource.getParentFile(), application.getApplicationName()+ ".par");
							ResourceUtils.copyStream( new FileInputStream( source), new FileOutputStream( nSource));
							logger.debug( "par archive is replaced.");
							application.setApplicationSource( nSource.toURI().toURL());
						}
						else if( source.isDirectory())
						{
							File nSource= new File( dasSource.getParentFile(), application.getApplicationName());
							ResourceUtils.fileCopyRecursively(
									source, nSource,
									new FilenameFilter(){
										public boolean accept( File dir, String name)
										{
											if( !DeployedApplicationModel.COMMAND_FILENAME.equals( name))
												return true;
											else
												return false;
										}
									}, new DefaultResourceErrorHandler(), true);
							logger.debug( "directory is replaced.");
							application.setApplicationSource( nSource.toURI().toURL());
						}
					}
					else
					{
						if( source.isFile())
							application.setApplicationSource(
									new File( dasSource.getParentFile(), application.getApplicationName()+ ".par").toURI().toURL());
						else if( source.isDirectory())
							application.setApplicationSource(
									new File( dasSource.getParentFile(), application.getApplicationName()).toURI().toURL());
					}
				}
				catch( Throwable e)
				{
					logger.error( "replace par archive failed.", e);
					throw new ApplicationTargetException( e.getMessage(), e);
				}
				finally
				{
					if( flock!= null)
					{
						try
						{
							flock.release();
							if( channel!= null) channel.close();
							if( raFile!= null) raFile.close();
							lockFile.delete();
						}
						catch( Exception e)
						{
							logger.error( "replace par archive failed.", e);
							throw new ApplicationTargetException( e.getMessage(), e);
						}
					}
					else
					{
						if( channel!= null)
							try{ channel.close();}catch( Exception e){}
						if( raFile!= null)
							try{ raFile.close();}catch( Exception e){}
					}
				}
			}
		}
		finally
		{
			this.referenceKeeper.clear();
		}

		publishApplicationDeployCompletedEvent( new InstanceEvent( this));

		// temporary action
		System.gc();
	}


	public synchronized void throwawayPredeployedApplication( Set<String> nCreatedApplications, String[] applicationNames)
			throws InvalidCommandException, ApplicationTargetException
	{
		if( TEPID!= this.applicationLoader.getLoadingMode())
		{
			logger.warn( "deployPredeployedAppliation command is supported in TEPID loading mode.");
			throw new InvalidCommandException( INVALID_APPLICATION_LOADINGMODE,
					"deployPredeployedAppliation command is supported in TEPID loading mode.");
		}

		for( String applicationName: applicationNames)
		{
			if( !this.validatingApplications.containsKey( applicationName))
			{
				logger.warn( "application [{}] is not found in predeployed application pool", applicationName);
				throw new InvalidCommandException( APPLICATION_NOTFOUND,
						"application ["+ applicationName+ "] is not found in predeployed application pool");
			}
		}

		List<ClassLoaderRef> refsToClear= new ArrayList<ClassLoaderRef>();
		for( String applicationName: applicationNames)
		{
			DeployedApplication application= null;
			application= this.validatingApplications.get( applicationName);
			if( application!= null)
				refsToClear.add( application.getClassLoaderRef());
		}
		this.classLoaderManager.clearThrowawayedRefs( refsToClear.toArray( new ClassLoaderRef[refsToClear.size()]));

		for( String applicationName: applicationNames)
		{
			DeployedApplication application= null;
			application= this.validatingApplications.remove( applicationName);
			if( application!= null)
			{
				if( !nCreatedApplications.contains( applicationName))
				{
					application.getClassLoaderRef().getClassLoader().setDeleteOnDestroy( false);
					this.deployedApplications.get( applicationName).getClassLoaderRef().getClassLoader().setDeleteOnDestroy( true);
				}
				refsToClear.add( application.getClassLoaderRef());
				application.getLightweightApplicationContext().interruptedDeferredInstantiate();
				application.setStage( ApplicationStage.THROWABLE);
				application.throwawayed( this.uuid);
				application.destroy();
				logger.info( "application [{}] is throwawayed permanently.", applicationName);
			}
		}
		synchronized( this.deferredTasks){ this.deferredTasks.clear();}
		// temporary action
		System.gc();
	}

	public synchronized void deployApplication( String name, File applicationLocation)
			throws InvalidCommandException, ApplicationTargetException
	{
		if( COLD== this.applicationLoader.getLoadingMode())
		{
			Map<String, DeployedApplication> applications= deployApplicationInternal( name, applicationLocation, false);
			if( applications!= null && applications.size()> 0)
			{
				for( DeployedApplication application: applications.values())
				{
					application.setStage( ApplicationStage.EMPLOYED);
					application.resetValidClientPatterns();
					this.deployedApplications.put( application.getApplicationName(), application);
					application.deployed( this.uuid, this.datasource);
					logger.info( "application [{}] is deployed.", application.getApplicationName());
				}
			}
			else
				throw new ApplicationTargetException( "application preparing for deployment is failed.");
		}
		else
		{
			publishApplicationDeployStartedEvent( new InstanceEvent( this));

			Map<String, DeployedApplication> applications= deployApplicationInternal( name, applicationLocation, false);
			if( applications!= null && applications.size()> 0)
			{
				prepareApplications( applications);

				for( DeployedApplication application: applications.values())
				{
					List<LightweightApplicationContext> refCtxs= new ArrayList<LightweightApplicationContext>();
					ClassLoaderRef[] shRefs=
							( (ApplicationClassLoader)application.getClassLoaderRef().getClassLoader()).getSharedClassLoaderRefs();
					for( ClassLoaderRef shRef: shRefs)
					{
						String shAppName= shRef.getClassLoader().getApplicationName();
						if( applications.containsKey( shAppName))
						{
							refCtxs.add( applications.get( shAppName).getLightweightApplicationContext());
							application.getIommFieldProperties().addReferenceIOmmFieldProperties(
									applications.get( shAppName).getIommFieldProperties());
						}
						else if( this.deployedApplications.containsKey( shAppName))
						{
							refCtxs.add( this.deployedApplications.get( shAppName).getLightweightApplicationContext());
							application.getIommFieldProperties().addReferenceIOmmFieldProperties(
									this.deployedApplications.get( shAppName).getIommFieldProperties());
						}
					}

					try
					{
						application.getLightweightApplicationContext().postInitialization(
								refCtxs.toArray( new LightweightApplicationContext[refCtxs.size()]));
					}
					catch( Throwable th)
					{
						logger.error( "application [{}] postInitialization is failed.",
								new Object[]{ application.getApplicationName(), th});
					}
				}

				try
				{
					for( DeployedApplication application: applications.values())
					{
						DeployedApplication das= null;
						try
						{
							if( !this.batch && this.applicationLoader.isDeferredInit())
								application.getLightweightApplicationContext().deferredInstantiate( deferredTasks, deferredInitLock);
							else
								application.getLightweightApplicationContext().preInstantiate();
							application.setStage( ApplicationStage.EMPLOYED);
							application.resetValidClientPatterns();
							das= this.deployedApplications.put( application.getApplicationName(), application);
							application.deployed( this.uuid, this.datasource);
							// to avoid early gc effect
							if( das!= null)
							{
								this.referenceKeeper.add( das);
								das.getLightweightApplicationContext().interruptedDeferredInstantiate();
							}
							logger.info( "application [{}] is deployed.", application.getApplicationName());
						}
						catch( Throwable th)
						{
							application.getLightweightApplicationContext().interruptedDeferredInstantiate();
							logger.error( "application [{}] preInstantiate is failed.",
									new Object[]{ application.getApplicationName(), th});
						}
					}
				}
				finally
				{
					try
					{
						for( DeployedApplication application: applications.values())
						{
							if( !applicationLoader.isLazyInit() || COLD== applicationLoader.getLoadingMode()
									|| ( application.getApplicationSource()!= null
											&& StringUtils.hasText( application.getApplicationSource().getFile())
											&& application.getApplicationSource().getFile().endsWith( BXM_ARCHIVE_SUFFIX)))
							{
								try{ application.getClassLoaderRef().getResourceLoader().clearMetadataReadCache();}
								catch( Throwable th){}
							}
						}
					}catch( Throwable th){}
					this.referenceKeeper.clear();
				}
			}
			else
				throw new ApplicationTargetException( "application preparing for deployment is failed.");

			publishApplicationDeployCompletedEvent( new InstanceEvent( this));
		}
	}

	public synchronized void undeployApplication( String name) throws InvalidCommandException, ApplicationTargetException
	{
		if( this.applicationLoader.isAutodeploy())
		{
			logger.warn( "application can not be undeployed from command in auto-deploy mode");
			throw new InvalidCommandException( INVALID_APPLICATION_LOADINGMODE,
					"application can not be undepoyed from command in auto-deploy mode");
		}

		if( !this.deployedApplications.containsKey( name))
			throw new InvalidCommandException( APPLICATION_NOTFOUND, "application ["+ name+ "] is not found.");

		if( HOT== this.applicationLoader.getLoadingMode() || TEPID== this.applicationLoader.getLoadingMode())
		{
			//if shared application throw InvalidCommandException in ApplicationClassLoaderManager
			try{ this.classLoaderManager.removeApplication( name);}
			catch( ApplicationNotFoundException e)
			{
				throw new InvalidCommandException( SHAREDAPPLICATION_REFRESH_OR_REMOVE_NOTSUPPORTED,
						"current application used for shared.");
			}
			logger.info( "application [{}] will be undeployed permanently.", name);
			DeployedApplication das= this.deployedApplications.remove( name);
			if( das!= null)
			{
				das.setStage( ApplicationStage.THROWABLE);
				das.getLightweightApplicationContext().interruptedDeferredInstantiate();
				try{ das.undeployed( this.uuid, this.datasource);}catch( Throwable th){ logger.error( th.getMessage(), th);}
				finally{ das.destroy();}
				logger.info( "application [{}] is undeployed permanently.");
			}
		}
		else if( COLD== this.applicationLoader.getLoadingMode())
		{
			if( this.undeployedApplications.containsKey( name))
				throw new InvalidCommandException( APPLICATION_ALREADY_UNDEPLOYED,
						"application ["+ name+ "] is already undeployed.");

			logger.info( "application [{}] will be undeployed temporarily.", name);
			DeployedApplication das= this.deployedApplications.remove( name);
			if( das!= null)
			{
				das.getLightweightApplicationContext().interruptedDeferredInstantiate();
				try{ das.undeployed( this.uuid, this.datasource);}catch( Throwable th){ logger.error( th.getMessage(), th);}
				this.undeployedApplications.put( das.getApplicationName(), das);
				logger.info( "application [{}] is undeployed temporarily.", name);
			}
		}
		// temporary action
		System.gc();
	}

	private Map<String, DeployedApplication> deployApplicationInternal( String name, File applicationLocation, boolean predeploy)
			throws InvalidCommandException, ApplicationTargetException
	{
		if( !predeploy && this.applicationLoader.isAutodeploy())
		{
			logger.warn( "current framework instance deploy applications from [{}] automatically.",
					this.applicationLoader.getApplicationHome());
			throw new InvalidCommandException( INVALID_APPLICATION_LOADINGMODE,
					"current framework instance deploy applications from ["+
					this.applicationLoader.getApplicationHome()+ "] automatically.");
		}

		if( !predeploy && this.deployedApplications.containsKey( name))
			throw new InvalidCommandException( APPLICATION_ALREADY_DEPLOYED, "application ["+ name+ "] is already deployed.");

		if( COLD== this.applicationLoader.getLoadingMode())
		{
			if( !this.undeployedApplications.containsKey( name))
				throw new InvalidCommandException( APPLICATION_NOTFOUND,
						"application ["+ name+ "] is not found in redeployable application pool.");
			logger.info( "application [{}] is redeployed from redeployable application pool.", name);

			Map<String, DeployedApplication> apps= new HashMap<String, DeployedApplication>();
			DeployedApplication app= this.undeployedApplications.get( name);
			apps.put( app.getApplicationName(), app);
			return apps;
		}
		else if( HOT== this.applicationLoader.getLoadingMode() || TEPID== this.applicationLoader.getLoadingMode())
		{
			logger.info( "application [{}] resource [{}] will be deployed.", name, applicationLocation.getAbsolutePath());
			File metaFile= null;
			URL applicationSource= null;
			InputStream inStream= null;
			BxmApplication conf= null;
			try
			{
				if( applicationLocation.isDirectory() && ( metaFile= new File( applicationLocation, APPLICATION_DD_FILE)).exists())
				{
					applicationSource= applicationLocation.toURI().toURL();
					inStream= new FileInputStream( metaFile);
				}
				else if( applicationLocation.isFile() && applicationLocation.getName().endsWith( BXM_ARCHIVE_SUFFIX))
				{
					applicationSource= applicationLocation.toURI().toURL();
					inStream= findApplicationConfigurationFromArchive( applicationLocation);
				}
				else
				{
					throw new InvalidCommandException( INVALID_APPLICATION_FORMAT,
							"invalid application format. ["+ applicationLocation.getAbsolutePath()+ "]" );
				}

				conf= marshallApplicationDescriptor( inStream);
				if( !StringUtils.hasText( name) || !StringUtils.hasText( conf.getName()) || !name.equals( conf.getName()))
					throw new InvalidCommandException( INVALID_APPLICATION_FORMAT,
							"request application not same with configured application name");

				Map<String, DeployedApplication> applications= null;
				if( !predeploy)
				{
					DeployedApplication das= null;
					if( ( das= this.deployedApplications.get( conf.getName()))!= null)
					{
						das.getLightweightApplicationContext().interruptedDeferredInstantiate();
						return refreshApplication( applicationLocation, conf, applicationSource,
								das.getClassLoaderRef().getClassLoader(), this.applicationLoader.isUseLastmodifiedCache());
					}
					else
						return newApplication( applicationLocation, conf, applicationSource);
				}
				else
					applications= stagingApplication( applicationLocation, conf, applicationSource);
				return applications;
			}
			catch( Throwable th)
			{
				logger.error( "application [{}] resource [{}] deployment is failed.",
						new Object[]{name, applicationLocation.getAbsolutePath(), th});
				throw new ApplicationTargetException( "application ["+ name+ "] resource ["+
						applicationLocation.getAbsolutePath()+ "] deployment is failed.", th);
			}
			finally
			{
				if( inStream!= null) try{ inStream.close();}catch( IOException e){}
			}
		}
		else
			throw new InvalidCommandException( INVALID_APPLICATION_LOADINGMODE, "invalid appliaction loading mode.");
	}

	public void run()
	{
//		logger.debug( "AutoDeploy Task started {}", new Date());
		try
		{
			synchronized( this.deferredTasks){ this.deferredTasks.clear();}
			autoDeployApplicationCandidates();
		}
		catch( Throwable th)
		{
			logger.error( "AutoDeploy Task of [{}/{}] is failed", new Object[]{ this.uuid, this.name, th});
		}
	}

