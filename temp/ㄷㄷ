	@Override
	public MetadataReader getMetadataReader( String clsName) throws IOException
	{
		synchronized( this.metadataReaderCache)
		{
			MetadataReader reader= this.metadataReaderCacheByClassName.get( clsName);
			if( reader== null)
			{
				String resourcePath=
						ResourceUtils.CLASSPATH_URL_PREFIX+
						ClassUtils.convertClassNameToResourcePath( clsName)+
						ClassUtils.CLASS_FILE_SUFFIX;
				reader= getMetadataReader( getResource( resourcePath));
			}
			return reader;
		}
	}

	@Override
	public MetadataReader getMetadataReaderIfNotMatchSelf( Resource resource) throws IOException
	{
		synchronized( this.metadataReaderCache)
		{
			MetadataReader reader= this.metadataReaderCache.get( resource);
			String[] infNames= null;
			if( reader!= null)
			{
				if( ( infNames= reader.getClassMetadata().getInterfaceNames())== null
						|| infNames.length== 0 || !Arrays.asList( infNames).contains( IOMMOBJECT_CLASS.getName()))
					return reader;
				else
					return null;
			}
			else
			{
				Long lastModified= null;
				try{ lastModified= resource.lastModified();}catch( Throwable th){}

				byte[] classbytes= ClassResourceReader.readClassResource( resource.getInputStream());
				if( classbytes.length< 8) throw new IOException( "insufficient class bytes length.");
				ClassReader clsReader= new ClassReader( classbytes);
				ClassVisitor clsVisitor= new ClassVisitor( resource.getURL());
				clsReader.accept( clsVisitor, SKIP_DEBUG | SKIP_FRAMES);

				if( ( infNames= clsVisitor.getInterfaceNames())== null
						|| infNames.length== 0 || !Arrays.asList( infNames).contains( IOMMOBJECT_CLASS.getName()))
				{
					AnnotatedClassVisitor annotatedClsVisitor= new AnnotatedClassVisitor( resource.getURL(), this.classLoader.get());
					clsReader.accept( annotatedClsVisitor, SKIP_DEBUG | SKIP_FRAMES);
					reader= new MetadataReader( resource.getURL(), clsVisitor, annotatedClsVisitor, lastModified);
					this.metadataReaderCache.put( resource, reader);
					this.metadataReaderCacheByClassName.put( clsVisitor.getClassName(), reader);
					return reader;
				}
				else
					return null;
			}
		}
	}

	@Override
	public MetadataReader getMetadataReader( Resource resource) throws IOException
	{
		synchronized( this.metadataReaderCache)
		{
			MetadataReader reader= this.metadataReaderCache.get( resource);
			if( reader== null)
			{
				Long lastModified= null;
				try{ lastModified= resource.lastModified();}catch( Throwable th){}

				byte[] classbytes= ClassResourceReader.readClassResource( resource.getInputStream());
				if( classbytes.length< 8) throw new IOException( "insufficient class bytes length.");
				ClassReader clsReader= new ClassReader( classbytes);
				reader= new MetadataReader( resource.getURL(), clsReader, this.classLoader.get(), lastModified);

				if(!LApplicationContext.isBatchContext() || Boolean.parseBoolean(System.getProperty("init.start")))
				{
					this.metadataReaderCache.put( resource, reader);
					this.metadataReaderCacheByClassName.put( reader.getClassMetadata().getClassName(), reader);
				}
			}
			return reader;
		}
	}

	@Override
	public MetadataReader removeMetadataReaderCache( String clsName)
	{
		synchronized( this.metadataReaderCache)
		{
			return this.metadataReaderCacheByClassName.remove( clsName);
		}
	}

	@Override
	public MetadataReader removeMetadataReaderCache( Resource resource)
	{
		synchronized( this.metadataReaderCache)
		{
			MetadataReader reader= this.metadataReaderCache.remove( resource);
			if( reader!= null)
			{
				String classname= reader.getClassMetadata().getClassName();
				this.metadataReaderCacheByClassName.remove( classname);
			}
			return reader;
		}
	}

	@Override
	public void clearMetadataReadCache()
	{
		synchronized( this.metadataReaderCache)
		{
			this.metadataReaderCache.clear();
			this.metadataReaderCacheByClassName.clear();
		}

		synchronized( this.metadataReaderLRUCache)
		{
			this.metadataReaderLRUCache.clear();
		}
	}

	static class ClassPathContextResource extends ClassPathResource
	{

		public ClassPathContextResource( String path, ClassLoader clsLoader)
		{
			super( path, clsLoader);
		}

		public String getPathWithinContext()
		{
			return getPath();
		}

		public Resource createRelative( String relativePath)
		{
			String pathToUse= StringUtils.applyRelativePath( getPath(),relativePath);
			return new ClassPathContextResource( pathToUse, getClassLoader());
		}

	}

}




