    if (!fileName || !dirInfo) { result.unknown.push(fileName + "\t" + dirInfo); continue; }
    var dirPath = dirInfo.replace(/\\/g, "/");
    var baseFile = basenameOf(fileName);
    var lowerFile = baseFile.toLowerCase();
    var matched = false;
    if (lowerFile.slice(-5) === ".java" || lowerFile.slice(-6) === ".class") {
      var isJavaSrc = lowerFile.slice(-5) === ".java";
      var className = baseFile.replace(/\.[^.]+$/, ".class");
      if (containsCi(dirPath, "/online/") && containsCi(dirPath, "/src/")) {
        matched = true;
        var rel1 = extractAfter(dirPath, "src");
        result.online.push(TARGETS.cowas + "/EAR/WEB/WEB-INF/classes/" + rel1 + "/" + className);
        if (env === 'QA') {
          result.online.push(TARGETS.cowas + "/EAR/WEB2/WEB-INF/classes/" + rel1 + "/" + className);
        }
        result.batch.push(TARGETS.batch + "/classes/" + rel1 + "/" + className);
        result.local.push(STAGING.javaOnline + "/WEB/WEB-INF/classes/" + rel1 + "/" + className);
        if (isJavaSrc) result.local.push(STAGING.javaOnlineSource + "/" + rel1 + "/" + baseFile);
      } else if (containsCi(dirPath, "/batch/") && containsCi(dirPath, "/src/")) {
        matched = true;
        var rel2 = extractAfter(dirPath, "src");
        result.batch.push(TARGETS.batch + "/classes/" + rel2 + "/" + className);
        result.local.push(STAGING.batch + "/classes/" + rel2 + "/" + className);
        if (isJavaSrc) result.local.push(STAGING.batchSource + "/" + rel2 + "/" + baseFile);
      }
    } else if (lowerFile.slice(-4) === ".xml") {
      if (containsCi(dirPath, "/batch/") && containsCi(dirPath, "/config/")) {
        matched = true;
        var rel3 = extractAfter(dirPath, "config");
        result.batch.push(TARGETS.batch + "/config/" + rel3 + "/" + baseFile);
        result.local.push(STAGING.batch + "/config/" + rel3 + "/" + baseFile);
      }
    }
    if (!matched && containsCi(dirPath, "/web/")) {
      matched = true;
      var webRel = extractAfter(dirPath, "web");
      if (containsCi(dirPath, "/distribution/")) {
        result.dpweb.push(TARGETS.dpweb + "/" + webRel + "/" + baseFile);
        result.local.push(STAGING.web + "/DPWEB/" + webRel + "/" + baseFile);
      } else {
        var cowebRel = "";
        var slashIdx = webRel.indexOf("/");
        if (slashIdx !== -1) cowebRel = webRel.substring(slashIdx + 1);
        result.coweb.push(TARGETS.coweb + "/" + cowebRel + "/" + baseFile);
        result.local.push(STAGING.web + "/COWEB/" + cowebRel + "/" + baseFile);
      }
    }
    if (!matched && containsCi(dirPath, "/batch/")) {
      matched = true;
      var rel4 = extractAfter(dirPath, "batch");
      result.batch.push(TARGETS.batch + "/" + rel4 + "/" + baseFile);
    }
    if (!matched) result.unknown.push(fileName + "\t" + dirInfo);
  }
  return result;
}
