public class DefaultApplicationClassFinder implements ApplicationClassFinder
{
	private Logger logger= LoggerFactory.getLogger( DefaultApplicationClassFinder.class);
	
	private static final String PATH_SEPARATOR= System.getProperty( "path.separator");
	
	private CopyOnWriteArrayList<URL> classpath= new CopyOnWriteArrayList<URL>();
	
	private CopyOnWriteArrayList<URL> localAppclasspath= new CopyOnWriteArrayList<URL>();

	private URL[] initialUrls;
	
	private AccessControlContext acc;
	
	public DefaultApplicationClassFinder( URL[] urls)
	{
		this.initialUrls= urls;
		for( URL url: urls)
			this.classpath.add( url);
		
		this.acc= AccessController.getContext();
	}
	
	public synchronized void addClassPath( URL[] urls)
	{
		for( URL url: urls)
			this.classpath.add( url);
		this.acc= AccessController.getContext();
	}
	
	public synchronized void removeClassPath( URL[] urls)
	{
		this.classpath.removeAll( Arrays.asList( urls));
		this.acc= AccessController.getContext();
	}
	
	public void setLocalApplicationClasspaths( List<URL> localAppClasspath)
	{
		this.localAppclasspath.clear();
		this.localAppclasspath.addAll( localAppClasspath);
	}
	
	public URL[] getLocalApplicationClasspaths()
	{
		return this.localAppclasspath.toArray( new URL[this.localAppclasspath.size()]);
	}
	
	public URL[] getInitialUrls()
	{
		return this.initialUrls;
	}
	
	public String getClassPath()
	{
		StringBuffer path= new StringBuffer();
		URL[] urls= this.classpath.toArray( new URL[this.classpath.size()]);
		for( URL pathElement: urls)
			path.append( pathElement+ PATH_SEPARATOR);
			
		if( path.lastIndexOf( PATH_SEPARATOR)!= -1)
			path.deleteCharAt( path.lastIndexOf( PATH_SEPARATOR));
		return path.toString();
	}

	public URL checkURL( URL url) 
	{
		try 
	    {
	        check( url);
	    } 
	    catch( Exception e) 
	    {
	        return null;
	    }
	    return url;
	}
	  
	void check( URL url) throws IOException 
	{
        SecurityManager security= System.getSecurityManager();
        if( security!= null) 
        {
            URLConnection urlConnection= url.openConnection();
            Permission perm= urlConnection.getPermission();
            if( perm!= null) 
            {
                try 
                {
                    security.checkPermission( perm);
                } 
                catch( SecurityException se) 
                {
                    // fallback to checkRead/checkConnect for pre 1.2
                    // security managers
                    if( (perm instanceof  java.io.FilePermission) && perm.getActions().indexOf( "read")!= -1) 
                        security.checkRead(perm.getName());
                    else if( (perm instanceof  java.net.SocketPermission) && perm.getActions().indexOf( "connect")!= -1) 
                    {
                        URL locUrl= url;
                        if( urlConnection instanceof  JarURLConnection) 
                            locUrl= ( (JarURLConnection)urlConnection).getJarFileURL();
                        else if( urlConnection instanceof ParURLConnection)
                        	locUrl= ( (ParURLConnection)urlConnection).getParFileURL();
                        security.checkConnect( locUrl.getHost(), locUrl.getPort());
                    }
                    else 
                        throw se;
                }
            }
        }
    }
	  
	@Override
	public boolean existClassSource( final String name)
	{
		return AccessController.doPrivileged( new PrivilegedAction<Boolean>(){			
			public Boolean run()
			{
				for( URL url: classpath)
				{
					if( ResourceUtils.URL_PROTOCOL_FILE.equalsIgnoreCase( url.getProtocol()))
					{
						try
						{
							File dir= new File( StringUtils.cleanPath( url.getFile()));
							if( dir.exists() && dir.isDirectory())
							{
								
								File srcFile= new File( dir.getAbsolutePath()+ 
										File.separatorChar+ ClassUtils.convertClassNameToResourcePath( name)+ 
										ClassUtils.CLASS_FILE_SUFFIX);
								if( srcFile.exists()) return true;
							}
						}
						catch( Exception e)
						{
							logger.error( e.getMessage(), e);
						}
					}
					else if( ResourceUtils.URL_PROTOCOL_JAR.equalsIgnoreCase( url.getProtocol()))
					{
						try
						{
							File fs= new File( StringUtils.cleanPath( url.getFile()));
							if( fs.exists() && fs.isFile())
							{
								JarFile jf= new JarFile( fs);
								if( jf.getJarEntry( ClassUtils.convertClassNameToResourcePath( name)+ 
										ClassUtils.CLASS_FILE_SUFFIX)!= null)
									return true;
							}
						}
						catch( Exception e)
						{
							logger.error( e.getMessage(), e);
						}
					}
					else if( ResourceUtils.URL_PROTOCOL_ZIP.equalsIgnoreCase( url.getProtocol()))
					{
						try
						{
							File fs= new File( StringUtils.cleanPath( url.getFile()));
							if( fs.exists() && fs.isFile())
							{
								ZipFile zf= new ZipFile( fs);
								if( zf.getEntry( ClassUtils.convertClassNameToResourcePath( name)+ 
										ClassUtils.CLASS_FILE_SUFFIX)!= null)
									return true;
							}
						}
						catch( Exception e)
						{
							logger.error( e.getMessage(), e);
						}
					}
					else if( ResourceUtils.URL_PROTOCOL_PAR.equalsIgnoreCase( url.getProtocol()))
					{
						try
						{
							ParURLConnection pcon= (ParURLConnection)url.openConnection();
							JarFile parFile= pcon.getParFile();
							String respath= ClassUtils.convertClassNameToResourcePath( name)+ ClassUtils.CLASS_FILE_SUFFIX;
							if( url.getFile().endsWith( DeployedApplicationModel.CLASSES_PATH_SUFFIX))
							{
								if( parFile.getEntry( DeployedApplicationModel.CLASSES_PATH_SUFFIX+ "/"+ respath)!= null)
									return true;
							}
							else if( url.getFile().endsWith( DeployedApplicationModel.BIN_PATH_SUFFIX))
							{
								if( parFile.getEntry( DeployedApplicationModel.BIN_PATH_SUFFIX+ "/"+ respath)!= null)
									return true;
							}
//							else if( url.getFile().endsWith( DeployedApplicationModel.LIB_PATH_SUFFIX))
							else if( url.getFile().endsWith( ResourceUtils.URL_PROTOCOL_JAR))
							{
//								URL resUrl= new URL( ResourceUtils.URL_PROTOCOL_PAR+ ":"+ url.getFile()+ 
//										ResourceUtils.JAR_URL_SEPARATOR+ respath);
//								ParURLConnection resCon= (ParURLConnection)resUrl.openConnection();
//								InputStream inStream= null;
//								try
//								{
//									if( ( inStream= resCon.getInputStream())!= null) 
//										return true; 
//								}catch( IOException ie){}
//								finally{ if( inStream!= null) try{ inStream.close();}catch( Exception ee){}}
								URL resUrl= new URL( ResourceUtils.URL_PROTOCOL_PAR, "", 0, url.getFile()+ 
										ResourceUtils.JAR_URL_SEPARATOR+ respath, new ParURLStreamHandler());
								ParURLConnection resCon= (ParURLConnection)resUrl.openConnection();
								InputStream inStream= null;
								try
								{
									if( ( inStream= resCon.getInputStream())!= null)
										return true;
								}catch( IOException ie){}
								finally{ if( inStream!= null) try{ inStream.close();}catch( Exception ee){}}
							}
						}
						catch( Exception e)
						{
							logger.error( e.getMessage(), e);
						}
					}
					else
						throw new IllegalStateException( "unsupported url protocol. ["+ url.getProtocol()+ "]");
				}
				return false;
			}
		}, acc);
	}
	
	@Override
	public synchronized ClassSource findClassSource( final String name)
	{
		ClassSource clsSource= AccessController.doPrivileged( new PrivilegedAction<ClassSource>(){			
			public ClassSource run()
			{
				for( URL url: classpath)
				{
					if( ResourceUtils.URL_PROTOCOL_FILE.equalsIgnoreCase( url.getProtocol()))
					{
						try
						{
							File dir= new File( StringUtils.cleanPath( url.getFile()));
							if( dir.exists() && dir.isDirectory())
							{
								
								File srcFile= new File( dir.getAbsolutePath()+ 
										File.separatorChar+ ClassUtils.convertClassNameToResourcePath( name)+ ClassUtils.CLASS_FILE_SUFFIX);
								if( srcFile.exists())
									return new FileClassSource( url, srcFile, name);
							}							
						}
						catch( Exception e)
						{
							logger.error( e.getMessage(), e);
						}
					}
					else if( ResourceUtils.URL_PROTOCOL_JAR.equalsIgnoreCase( url.getProtocol()))
					{
						try
						{
							File fs= new File( StringUtils.cleanPath( url.getFile()));
							if( fs.exists() && fs.isFile())
							{
								JarFile jf= new JarFile( fs);
								if( jf.getJarEntry( ClassUtils.convertClassNameToResourcePath( name)+ 
										ClassUtils.CLASS_FILE_SUFFIX)!= null)
									return new JarClassSource( url, jf, name);
							}							
						}
						catch( Exception e)
						{
							logger.error( e.getMessage(), e);
						}
					}
					else if( ResourceUtils.URL_PROTOCOL_ZIP.equalsIgnoreCase( url.getProtocol()))
					{
						try
						{
							File fs= new File( StringUtils.cleanPath( url.getFile()));
							if( fs.exists() && fs.isFile())
							{
								ZipFile zf= new ZipFile( fs);
								if( zf.getEntry( ClassUtils.convertClassNameToResourcePath( name)+ 
										ClassUtils.CLASS_FILE_SUFFIX)!= null)
									return new ZipClassSource( url, zf, name);
							}							
						}
						catch( Exception e)
						{
							logger.error( e.getMessage(), e);
						}
					}
					else if( ResourceUtils.URL_PROTOCOL_PAR.equalsIgnoreCase( url.getProtocol()))
					{
						try
						{
							ParURLConnection pcon= (ParURLConnection)url.openConnection();
							JarFile parFile= pcon.getParFile();
							String respath= ClassUtils.convertClassNameToResourcePath( name)+ ClassUtils.CLASS_FILE_SUFFIX;
							if( url.getFile().endsWith( DeployedApplicationModel.CLASSES_PATH_SUFFIX))
							{
								if( parFile.getEntry( DeployedApplicationModel.CLASSES_PATH_SUFFIX+ "/"+ respath)!= null)
									return new ParURLResourceClassSource( url, 
											new URL( ResourceUtils.URL_PROTOCOL_PAR, "", 0, url.getFile()+ "/"+ respath, 
													new ParURLStreamHandler()), name);
							}
							else if( url.getFile().endsWith( DeployedApplicationModel.BIN_PATH_SUFFIX))
							{
								if( parFile.getEntry( DeployedApplicationModel.BIN_PATH_SUFFIX+ "/"+ 
										ClassUtils.convertClassNameToResourcePath( name)+ 
										ClassUtils.CLASS_FILE_SUFFIX)!= null)
									return new ParURLResourceClassSource( url, 
											new URL( ResourceUtils.URL_PROTOCOL_PAR, "", 0, url.getFile()+ "/"+ respath, 
													new ParURLStreamHandler()), name);
							}
//							else if( url.getFile().endsWith( DeployedApplicationModel.LIB_PATH_SUFFIX))
							else if( url.getFile().endsWith( ResourceUtils.URL_PROTOCOL_JAR))
							{
								URL resUrl= new URL( ResourceUtils.URL_PROTOCOL_PAR, "", 0, url.getFile()+ 
										ResourceUtils.JAR_URL_SEPARATOR+ respath, new ParURLStreamHandler());
								ParURLConnection resCon= (ParURLConnection)resUrl.openConnection();
								InputStream inStream= null;
								try
								{
									if( ( inStream= resCon.getInputStream())!= null)
										return new ParURLResourceClassSource( url, resUrl, name);
								}catch( IOException ie){}
								finally{ if( inStream!= null) try{ inStream.close();}catch( Exception ee){}}
							}
						}
						catch( Exception e)
						{
							logger.error( e.getMessage(), e);
						}
					}
					else
						throw new IllegalStateException( "unsupported url protocol. ["+ url.getProtocol()+ "]");
				}
				return null;
			}
		}, acc);
		return clsSource;
	}

	@Override
	public void findClassSources( String name, List<ClassSource> list)
	{
		ClassSource clsSource= null;
		if( ( clsSource= findClassSource( name))!= null)
			list.add( clsSource);
	}

	public URL findResource( final URL url, final String name)
	{
		URL resource= AccessController.doPrivileged( new PrivilegedAction<URL>(){
			public URL run()
			{
				if( ResourceUtils.URL_PROTOCOL_FILE.equalsIgnoreCase( url.getProtocol()))
				{
					try
					{
						File dir= new File( StringUtils.cleanPath( url.getFile()));
						if( dir.exists() && dir.isDirectory())
						{
							File srcFile= new File( dir.getAbsolutePath()+ File.separatorChar+ name);
							if( srcFile.exists())
								return new URL( "file:"+ srcFile.getAbsolutePath());
						}							
					}
					catch( Exception e)
					{
						return null;
					}
				}
				else if( ResourceUtils.URL_PROTOCOL_JAR.equalsIgnoreCase( url.getProtocol()))
				{
					try
					{
						if( "".equals( name) || "/".equals( name))	return new URL(  "jar:file:"+ url.getFile()+ "!/");
						File fs= new File( StringUtils.cleanPath( url.getFile()));
						if( fs.exists() && fs.isFile())
						{
							JarFile jf= new JarFile( fs);
							JarEntry je= null;
							if( ( je= jf.getJarEntry( name))!= null)
							{
								String rsName= jf.getName().replace( File.separatorChar, '/');
								rsName= rsName+ "!"+ "/"+ je.getName();
								return new URL( "jar:file:"+ rsName);
							}
						}							
					}
					catch( Exception e)
					{
						return null;
					}
				}
				else if( ResourceUtils.URL_PROTOCOL_ZIP.equalsIgnoreCase( url.getProtocol()))
				{
					try
					{
						if( "".equals( name) || "/".equals( name))	return new URL(  "zip:file:"+ url.getFile()+ "!/");
						File fs= new File( StringUtils.cleanPath( url.getFile()));
						if( fs.exists() && fs.isFile())
						{
							ZipFile zf= new ZipFile( fs);
							ZipEntry ze= null; 
							if( ( ze= zf.getEntry( name))!= null)
							{
								String rsName= zf.getName().replace( File.separatorChar, '/');
								rsName= rsName+ "!"+ "/"+ ze.getName();
								return new URL( "zip:file:"+ rsName);
							}
						}							
					}
					catch( Exception e)
					{
						return null;
					}
				}
				else if( ResourceUtils.URL_PROTOCOL_PAR.equalsIgnoreCase( url.getProtocol()))
				{
					try
					{
						ParURLConnection pcon= (ParURLConnection)url.openConnection();
						JarFile parFile= pcon.getParFile();
						if( url.getFile().endsWith( DeployedApplicationModel.CLASSES_PATH_SUFFIX))
						{
							if( "".equals( name) || "/".equals( name)) return url;
							if( parFile.getEntry( DeployedApplicationModel.CLASSES_PATH_SUFFIX+ "/"+ name)!= null)
								return new URL( ResourceUtils.URL_PROTOCOL_PAR, "", 0, url.getFile()+ "/"+ name, 
										new ParURLStreamHandler());
						}
						else if( url.getFile().endsWith( DeployedApplicationModel.BIN_PATH_SUFFIX))
						{
							if( "".equals( name) || "/".equals( name)) return url;
							if( parFile.getEntry( DeployedApplicationModel.BIN_PATH_SUFFIX+ "/"+ name)!= null)
								return  new URL( ResourceUtils.URL_PROTOCOL_PAR, "", 0, url.getFile()+ "/"+ name,
										new ParURLStreamHandler());
						}
//						else if( url.getFile().endsWith( DeployedApplicationModel.LIB_PATH_SUFFIX))
						else if( url.getFile().endsWith( ResourceUtils.URL_PROTOCOL_JAR))
						{
							if( "".equals( name) || "/".equals( name)) 
								return new URL( ResourceUtils.URL_PROTOCOL_PAR, "", 0, 
										url.getFile()+ ResourceUtils.JAR_URL_SEPARATOR, new ParURLStreamHandler());
							URL resUrl= new URL( ResourceUtils.URL_PROTOCOL_PAR, "", 0, url.getFile()+ 
									ResourceUtils.JAR_URL_SEPARATOR+ name, new ParURLStreamHandler());
							ParURLConnection resCon= (ParURLConnection)resUrl.openConnection();
							InputStream inStream= null;
							try
							{
								if( ( inStream= resCon.getInputStream())!= null)
									return resUrl;
							}catch( IOException ie){}
							finally{ if( inStream!= null) try{ inStream.close();}catch( Exception ee){}}
						}
					}
					catch( Exception e)
					{
						return null;
					}
				}
				else
					throw new IllegalStateException( "unsupported url protocol. ["+ url.getProtocol()+ "]");
				
				return null;
			}
		});
		
		return resource!= null ? checkURL( resource) : null;
	}
	
	@Override
	public URL findResource( final String name)
	{
		URL resource= AccessController.doPrivileged( new PrivilegedAction<URL>(){
			public URL run()
			{
				URL url= null;
				for( URL path: classpath)
				{
					if( ( url=  findResource( path, name))!= null)
						return url;
				}
				return null;
			}
		}, acc);
		
		return resource;
	}

	@Override
	public Enumeration<URL> findApplicationResources( final String name)
	{
		final URL[] sources= this.localAppclasspath.toArray( new URL[this.localAppclasspath.size()]);
		return new Enumeration<URL>(){
			private URL url= null;
			int index= 0;
			private boolean next()
			{
				if( url!= null)
					return true;
				else
				{
					while( index+ 1<= sources.length)
					{
						try{ url= findResource( sources[index++], name);}catch( Exception e){}
						if( url!= null)
							return true;
					}
					return false;
				}
			}
			public boolean hasMoreElements()
			{
				return next();
			}

			public URL nextElement()
			{
				if( !next())
					throw new NoSuchElementException();
				URL u= url;
				url= null;
				return u;
			}
		};
	}
	
