allprojects {

    repositories {
        maven {
            url = uri("${repositoryUrl}/spring7")
            allowInsecureProtocol = true
            credentials {
                username "${repositoryUser}"
                password "${repositoryPassword}"
            }
        } 
    }
    configurations.all {
    	exclude group: 'xml-apis'
    	exclude group: 'xerces'
    	exclude group: 'xalan'
    	exclude group: 'stax'
    	exclude group: 'javax.xml.stream'
    	exclude group: 'javax-servlet', module: 'servlet-api'
    	exclude group: 'commons-logging', module: 'commons-logging'
    	exclude group: 'commons-dbcp', module: 'commons-dbcp'
        exclude group: 'commons-pool', module: 'commons-pool'
    	exclude group: 'org.apache.httpcomponents', module: 'httpclient'
    	exclude group: 'org.apache.httpcomponents', module: 'httpcore'
        exclude group: 'log4j',  module: 'log4j'
        exclude group: 'org.slf4j', module: 'slf4j-log4j12'        
        exclude group: 'woodstox', module: 'wstx-asl'        
    }
}

subprojects {
    apply plugin: 'java'
    apply plugin: 'eclipse'
    apply plugin: 'maven-publish'

    sourceCompatibility = rootProject.javaVersion   
    targetCompatibility = rootProject.javaVersion
    
    // libs 폴더를 비우는 태스크 정의
    task cleanLibs(type: Delete) {
        delete "${buildDir}/libs"
    }
        // jar 태스크 실행 전에 cleanLibs가 먼저 실행되도록 설정
    jar.dependsOn cleanLibs
    dependencies {
		//implementation platform("org.springframework:spring-framework-bom:${springVersion}")
	    //implementation platform("org.springframework:spring-framework-bom:${springVersion}")
	    implementation platform("org.springframework.boot:spring-boot-dependencies:${springBootVersion}")
	    
		implementation 'org.springframework:spring-aspects'
	    implementation 'org.springframework:spring-context'
	    implementation 'org.springframework:spring-aop'
	    implementation 'org.springframework:spring-context-support'
	    implementation 'org.springframework:spring-jms'
	    implementation 'org.springframework:spring-oxm'
	    implementation 'org.springframework:spring-beans'
	    implementation 'org.springframework:spring-core'
	    implementation 'org.springframework:spring-jcl'
	    implementation 'org.springframework:spring-aop'
	    implementation 'org.springframework:spring-expression'
	    implementation 'org.springframework:spring-tx'
		implementation 'org.springframework:spring-orm'
		implementation 'org.springframework:spring-jdbc'
		implementation 'org.springframework:spring-messaging'
	
	    implementation 'org.springframework:spring-web'
	    implementation 'org.springframework:spring-webmvc'
		
		// =========================================================
		// Spring Batch 5.x (Spring 6 대응)
		// =========================================================
		implementation "org.springframework.batch:spring-batch-core:${springBatchVersion}"
		implementation "org.springframework.batch:spring-batch-infrastructure:${springBatchVersion}"
		implementation "org.springframework.retry:spring-retry:${springRetryVersion}"
		
		// =========================================================
		// Spring WS 4.x (Spring 6 대응)
		// =========================================================
		implementation "org.springframework.ws:spring-ws-core:${springWsVersion}"
		implementation "org.springframework.ws:spring-ws-security:${springWsVersion}"
		implementation "org.springframework.ws:spring-ws-support:${springWsVersion}"
		implementation "org.springframework.ws:spring-xml:${springWsVersion}"

		// =========================================================
		// Jakarta EE (javax.* → jakarta.* 전환)
		// =========================================================
		implementation "jakarta.servlet:jakarta.servlet-api:${servletApiVersion}"
		implementation "jakarta.servlet.jsp:jakarta.servlet.jsp-api:${jspApiVersion}"
		implementation "jakarta.transaction:jakarta.transaction-api:${transactionApiVersion}"
		implementation "jakarta.mail:jakarta.mail-api:${mailApiVersion}"
		implementation "jakarta.xml.soap:jakarta.xml.soap-api:${xmlSoapApiVersion}"
		implementation "jakarta.jms:jakarta.jms-api:${jmsApiVersion}"
		implementation "jakarta.xml.bind:jakarta.xml.bind-api:${xmlBindApiVersion}"
		implementation "jakarta.activation:jakarta.activation-api:${activationVersion}"
		implementation "org.glassfish.jaxb:jaxb-runtime:${jaxbRuntimeVersion}"
		implementation "jakarta.annotation:jakarta.annotation-api:${annotationApiVersion}"
		implementation "jakarta.validation:jakarta.validation-api:${validationApiVersion}"
		implementation "com.sun.xml.messaging.saaj:saaj-impl:${saajImplVersion}"
		
		// =========================================================
		// Jackson 2.17.x
		// =========================================================				
		implementation "com.fasterxml.jackson.core:jackson-annotations:${jacksonVersion}"
		implementation "com.fasterxml.jackson.core:jackson-core:${jacksonVersion}"
		implementation "com.fasterxml.jackson.core:jackson-databind:${jacksonVersion}"
		implementation "com.fasterxml.jackson.datatype:jackson-datatype-jsr310:${jacksonVersion}"
		implementation "com.fasterxml.jackson.module:jackson-module-parameter-names:${jacksonVersion}"

		// =========================================================
		// MyBatis 3.5.x + MyBatis-Spring 3.x
		// =========================================================
		implementation "org.mybatis:mybatis:${mybatisVersion}"
		implementation "org.mybatis:mybatis-spring:${mybatisSpringVersion}"
		
		// =========================================================
		// MongoDB Driver 5.x
		// =========================================================
		implementation "org.mongodb:mongodb-driver-sync:${mongodbVersion}"
		implementation "org.mongodb:mongodb-driver-core:${mongodbVersion}"
		implementation "org.mongodb:bson:${mongodbVersion}"
		    		
		// =========================================================
		// Database Connection Pool
		// =========================================================
		implementation "org.apache.commons:commons-dbcp2:${commonsDbcp2Version}"
		implementation "org.apache.commons:commons-pool2:${commonsPool2Version}"
		implementation "com.mchange:c3p0:${c3p0Version}"
		
		// =========================================================
		// Apache Commons
		// =========================================================
		implementation "org.apache.commons:commons-lang3:${commonsLang3Version}"
		implementation "commons-codec:commons-codec:${commonsCodecVersion}"
		implementation "commons-io:commons-io:${commonsIoVersion}"
		implementation "commons-net:commons-net:${commonsNetVersion}"
		implementation "org.apache.commons:commons-compress:${commonsCompressVersion}"
		implementation "commons-validator:commons-validator:${commonsValidatorVersion}"
		implementation "org.apache.commons:commons-exec:${commonsExecVersion}"
		implementation "commons-beanutils:commons-beanutils:${commonsBeanutilsVersion}"
		
		implementation "commons-dbutils:commons-dbutils:${commonsDbUtilsVersion}"
		implementation "org.apache.commons:commons-vfs2:${commonsVfs2Version}"
		implementation "commons-math:commons-math:${mathVersion}"  // 최신 사용불가시 유지		
		
		implementation "org.apache.commons:commons-fileupload2:${commonsFileupload2Version}"
		implementation "org.apache.commons:commons-fileupload2-core:${commonsFileupload2Version}"
		implementation "org.apache.commons:commons-fileupload2-jakarta:${commonsFileupload2Version}"		
		
		// Log4j2 Core & API (커스텀 Appender/Layout/Filter/Logger 개발 필수)
		implementation "org.apache.logging.log4j:log4j-api:${log4j2Version}"
		implementation "org.apache.logging.log4j:log4j-core:${log4j2Version}"
		
		// SLF4J → Log4j2 브릿지  (SLF4J를 쓰는 외부 라이브러리 로그를 Log4j2로 수집)
		implementation "org.slf4j:slf4j-api:${slf4jVersion}"
		implementation "org.apache.logging.log4j:log4j-slf4j2-impl:${log4j2Version}"
		
		// 다른 로깅 프레임워크 → Log4j2 통합 브릿지
		implementation "org.apache.logging.log4j:log4j-jcl:${log4j2Version}"          // commons-logging 대체
		implementation "org.apache.logging.log4j:log4j-jul:${log4j2Version}"           // java.util.logging 대체
		implementation "org.slf4j:jcl-over-slf4j:${slf4jVersion}"                     // commons-logging 완전 차단
		
		// ★ 커스텀 플러그인 어노테이션 프로세서 @Plugin, @PluginFactory 등 빌드 시 캐시 생성 → 기동 속도 향상
		annotationProcessor "org.apache.logging.log4j:log4j-core:${log4j2Version}"

		// =========================================================
		// HTTP Client 5.x (4.x EOL)
		// =========================================================
		implementation "org.apache.httpcomponents.client5:httpclient5:${httpClient5Version}"
		implementation "org.apache.httpcomponents.core5:httpcore5:${httpCore5Version}"
		
		// =========================================================
		// Apache POI 5.x
		// =========================================================
		implementation "org.apache.poi:poi:${poiVersion}"
		implementation "org.apache.poi:poi-ooxml:${poiVersion}"
		
		// =========================================================
		// dom4j 2.x (JDK21 대응)
		// =========================================================
		implementation "org.dom4j:dom4j:${dom4jVersion}"	
		
		// =========================================================
		// AspectJ 1.9.22 (JDK21 대응)
		// =========================================================
		implementation "org.aspectj:aspectjrt:${aspectjVersion}"
		implementation "org.aspectj:aspectjweaver:${aspectjVersion}"
		
		// =========================================================
		// JSqlParser 4.9
		// =========================================================
	    implementation "com.github.jsqlparser:jsqlparser:${jsqlparserVersion}"	
	    
	    implementation "org.quartz-scheduler:quartz:${quartzVersion}"

		// =========================================================
		// Ehcache 3.x (Spring 6 대응)
		// =========================================================
		implementation "org.ehcache:ehcache:${ehcacheVersion}"
		implementation 'javax.cache:cache-api:1.1.1'	
		//NE2E
		implementation "org.zeromq:jeromq:${jeromqVersion}"
		implementation "org.apache.kafka:kafka-clients:${kafkaVersion}"
		implementation "io.netty:netty-all:${nettyVersion}"  
		
		implementation "com.thoughtworks.xstream:xstream:${xstreamVersion}"		  							
		implementation "org.ow2.asm:asm:${asmVersion}"
		implementation "org.ow2.asm:asm-commons:${asmVersion}"
		
		implementation "com.fasterxml.woodstox:woodstox-core:6.5.1"
		implementation "xerces:xercesImpl:${xerces2Version}"
		
		testImplementation "org.junit.jupiter:junit-jupiter:${junitVersion}"
		implementation fileTree(dir: "${rootDir}/common-lib", include: ['*.jar'])
		
    }
        // 서브모듈마다 sourcesJar 태스크 정의
	task sourcesJar(type: Jar) {
	    dependsOn cleanLibs // 소스 jar 생성 전에도 비우기
        // 버전과 source 사이에 하이픈 없이 언더바로 연결
        archiveFileName = "${project.name}-${project.version}_source.jar"
        from sourceSets.main.allSource
	}


    // build 태스크 실행 시 sourcesJar가 함께 실행되도록 설정
    build.dependsOn sourcesJar
   /* jar {
    	archiveBaseName = project.name
    	archiveVersion = ${version}
    }*/
}    

// =========================================================
// 의존성 버전 충돌 해결 전략
// =========================================================
configurations.all {
	    resolutionStrategy {
	        // Jackson 버전 강제 통일
	        force "com.fasterxml.jackson.core:jackson-databind:${jacksonVersion}"
	        force "com.fasterxml.jackson.core:jackson-core:${jacksonVersion}"
	        force "com.fasterxml.jackson.core:jackson-annotations:${jacksonVersion}"
	
	        // SLF4J 버전 강제 통일
	        force "org.slf4j:slf4j-api:${slf4jVersion}"
	
	        // Log4j2 버전 강제 통일 (하위 모듈 버전 충돌 방지)
	        force "org.apache.logging.log4j:log4j-api:${log4j2Version}"
	        force "org.apache.logging.log4j:log4j-core:${log4j2Version}"
	        force "org.apache.logging.log4j:log4j-slf4j2-impl:${log4j2Version}"
	        force "org.apache.logging.log4j:log4j-jcl:${log4j2Version}"
	        force "org.apache.logging.log4j:log4j-jul:${log4j2Version}"
	        force "org.apache.logging.log4j:log4j-1.2-api:${log4j2Version}"
	
	        // AspectJ 버전 강제 통일
	        force "org.aspectj:aspectjrt:${aspectjVersion}"
	        force "org.aspectj:aspectjweaver:${aspectjVersion}"
	
	        // Netty 버전 강제 통일
	        force "io.netty:netty-all:${nettyVersion}"
	
	        // commons-codec 버전 충돌 방지
	        force "commons-codec:commons-codec:${commonsCodecVersion}"
			force "org.mybatis:mybatis:${mybatisVersion}"
			force "org.mybatis:mybatis-spring:${mybatisSpringVersion}"
			        
	    }
}
task copyLibs(type: Copy) {
    dependsOn subprojects.collect { it.tasks.named('jar') }
    dependsOn subprojects.collect { it.tasks.named('sourcesJar') }
    
    subprojects.each { sub ->
        if(sub.name != 'EX') {
            from("${sub.buildDir}/libs") {
                include "jef*.jar"
                include "bxm*.jar"
                include "*_source.jar"
            }
            from(sub.configurations.runtimeClasspath) {
                include "jef*.jar"
                include "bxm*.jar"
                include "*_source.jar"
            }
        }
    }
    
   // into "${project(':EX').projectDir}/WebContent/WEB-INF/lib"
    duplicatesStrategy = DuplicatesStrategy.EXCLUDE
}
 
 
