	 {
		 logger.info( "current WebApplicationContext [{}] will be closed.", application.getApplicationName());
//		 super.doClose();
		 synchronized( this.startupShudownCurrentMonitor)
		 {
			 // do something

			 logger.info("Closing " + this);

			 try
			 {
				 // Publish shutdown event.
				 publishEvent( new ContextClosedEvent( this));
			 }
			 catch (Throwable ex)
			 {
				 logger.warn("Exception thrown from ApplicationListener handling ContextClosedEvent", ex);
			 }

			 // Stop all Lifecycle beans, to avoid delays during individual destruction.
			 try
			 {
				 if( this.lifecycleProcessor!= null) this.lifecycleProcessor.onClose();
			 }
			 catch (Throwable ex)
			 {
				 logger.warn("Exception thrown from LifecycleProcessor on context close", ex);
			 }


			 // IMPORTANT
			 // do not destroy for dirty use --. finalize

//			 // Destroy all cached singletons in the context's BeanFactory.
//			 try{ super.destroyBeans(); }
//			 catch( Throwable th){ logger.error( "disposable trace destroyBeans", th);}
//
