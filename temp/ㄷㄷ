	}

	/**
	 * XML 문자열에 XML 선언 정보가 있는지 확인하여 없으면 추가한다.
	 *
	 * @param xmlData XML 문자열
	 * 
	 * @return String
	 */
	public static String addXmlDeclaration(String xmlData) {
		if (xmlData.startsWith("<?xml")) {
			return xmlData;
		} else {
			StringBuilder builder = new StringBuilder();
//			builder.append(String.format(XML_DECLARATION, DEFAULT_ENCODING));
			
//			<?xml version=\"1.0\" encoding=\"%s\"?>
			builder.append("<?xml version=\"1.0\" encoding=\"");
			builder.append(DEFAULT_ENCODING);
			builder.append("\"?>");
			builder.append(xmlData);
			return builder.toString();
		}
	}

	
	/**
	 * XML 문자열에 XML 선언 정보가 있는지 확인하여 없으면 추가한다.
	 *
	 * @param xmlData XML 문자열
	 * @param encoding Declaration Encoding
	 * @return String
	 */
	public static String addXmlDeclaration(String xmlData, String encoding) {
		if (xmlData.startsWith("<?xml")) {
			return xmlData;
		} else {
			StringBuilder builder = new StringBuilder();
			builder.append("<?xml version=\"1.0\" encoding=\"");
			builder.append(encoding);
			builder.append("\"?>");
			builder.append(xmlData);
			return builder.toString();
		}
	}
	
	/**
	 * XML 문자열에 XML 선언 정보가 있는지 확인하여 있으면 제거한다.
	 *
	 * @param xml XML 문자열
	 * 
	 * @return String
	 */
	public static String removeXmlDeclaration(String xml) {
		xml = StringUtils.ltrim(xml);
		if (xml.startsWith("<?xml")) {
			int index = xml.indexOf("?>");
			return xml.substring(index + 2);
		}
		return xml;
	}
	

	/**
	 * XML Document 에서 특정 경로의 값을 반환한다.
	 *
	 * @param doc XML Document
	 * @param expression 경로
	 * @param returnType 반환 데이터 타입 
	 * 
	 * @return Object
	 * 
	 * @throws XPathExpressionException
	 */
	public static Object getXPathValue(Document doc, String expression, QName returnType)
			throws XPathExpressionException {
		XPathExpression expr = null;
		Object result = null;

		expr = xPathCache.get(expression);

		if (expr == null) {
			synchronized (syncXpathObj) {
				if (expr == null) {
					expr = xpath.compile(expression);
					xPathCache.put(expression, expr);
				}
			}
		}

		result = (Object) expr.evaluate(doc, returnType);

		return result;
	}

	/**
	 * 특정 경로에 대한 XPathExpression 정보를 반환한다.
	 *
	 * @param doc XML Document
