	@SuppressWarnings( "unchecked")
	@Override
	public <T> T getBeanFromContext( String name) throws NestedRuntimeException
	{
		ConfigurableListableBeanFactoryDelegate factory= (ConfigurableListableBeanFactoryDelegate)this.context.getBeanFactory();
		factory= factory.getContainingBeanFactory( name);
		if( factory== null)
			throw new NoSuchBeanDefinitionException( name);
		return (T)factory.getBean( name);
	}

