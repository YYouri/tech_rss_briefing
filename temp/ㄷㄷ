var TASK_ID_PATTERN = /^[A-Za-z0-9_-]{1,64}$/;

// 자원명 + 경로(디렉토리) -> 전체 원본 경로 조합
function buildFullPath(fileName, dirInfo) {
  var dir = (dirInfo || "").replace(/\\/g, "/").replace(/\/+$/, "");
  var name = (fileName || "").trim();
  return dir + "/" + name;
}

function parseToRows(rawText) {
  var rows = [];
  var lines = rawText.split(/\r\n|\n|\r/);
  for (var i = 0; i < lines.length; i++) {
    var line = lines[i].replace(/\r/g, "");
    if (line.trim() === "" || line.trim().indexOf("#") === 0) continue;
    var m = line.match(/^(\S+)[ \t]+(.*)$/);
    if (!m) continue;
    var fileName = m[1];
    var dirInfo = m[2].replace(/[ \t]+$/, "");
    if (!fileName || !dirInfo) continue;
    rows.push({ fileName: fileName, dirInfo: dirInfo });
  }
  return rows;
}

