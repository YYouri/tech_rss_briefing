package jef.application.channel.gateway.servlet;

import jakarta.servlet.ServletContextEvent;

import bxm.service.endpoint.http.HttpServiceEndpointContextListener;
import jef.foundation.bxm.defs.EnvConst;
import jef.foundation.configuration.helper.ConfigurationUtils;
import jef.foundation.util.StringUtils;

/**
 * BXM Application Context을 초기화한다
 *
 */
public class JEFBxmContextListener extends HttpServiceEndpointContextListener {

    public void contextInitialized(ServletContextEvent sce) {
        
    	System.setProperty("beantype.usemetadata", "true");
    	System.setProperty("bxm.use.mainservice", "true");
    	System.setProperty("bxm.servicelog.messageMaxSizeChar", "100000");
    	System.setProperty("bxm.system.ignore.container.datasource.connection.error", "true");
    	System.setProperty("com.mocomsys.parser.json.helper.external", "jef.application.channel.helper.DataHelperHIF20");

    	if (StringUtils.isEmpty(System.getProperty("bxm.system.custom.jndi.datasource.classname"))) {
    		if (ConfigurationUtils.matchTransactionMgrType(EnvConst.TRANSACTION_MGR_TYPE_JEF)) {
    			System.setProperty("bxm.system.custom.jndi.datasource.classname", "jef.application.bxm.instance.support.PersitenceJndiDataSource");
    		} else if (ConfigurationUtils.matchTransactionMgrType(EnvConst.TRANSACTION_MGR_TYPE_HIF10)) {
    			System.setProperty("bxm.system.custom.jndi.datasource.classname", "jef.application.bxm.instance.support.HiTransactionJndiDataSource");
    		} else if (ConfigurationUtils.matchTransactionMgrType(EnvConst.TRANSACTION_MGR_TYPE_HIF11)) {
    			System.setProperty("bxm.system.custom.jndi.datasource.classname", "jef.application.bxm.instance.support.HiTransactionJndiDataSource");
    		}
    	}
    	if (StringUtils.isEmpty(System.getProperty("bxm.system.custom.jndi.datasource.classname"))) {
    		System.setProperty("bxm.system.use.custom.jndi.datasource", "false");    		
    	} else {
    		System.setProperty("bxm.system.use.custom.jndi.datasource", "true");
    	}
    	if ("jef.application.bxm.instance.support.PersitenceJndiDataSource".equals(System.getProperty("bxm.system.custom.jndi.datasource.classname")) 
    			|| "jef.application.bxm.instance.support.HiTransactionJndiDataSource".equals(System.getProperty("bxm.system.custom.jndi.datasource.classname"))) {
    		System.setProperty("bxm.system.custom.jndi.another.trxmgr", "true");
    	}
    	
    	// Bxm ShutDown Class PreLoading.
    	try {
    		Class.forName(bxm.common.util.concurrent.worker.Worker.class.getName());
    		Class.forName(bxm.common.util.concurrent.worker.PooledWorker.Closed.class.getName());
    		Class.forName(bxm.common.util.concurrent.pool.internal.FrameBasicWorkerPooling.Destroyer.class.getName());
    		Class.forName(bxm.common.util.concurrent.task.ConcurrentTaskManager.Closed.class.getName());
    	} catch (Throwable t) {
    		t.printStackTrace();
    	}
    	
    	super.contextInitialized(sce);
    }
    
    public void contextDestroyed(ServletContextEvent sce) {
    	super.contextDestroyed(sce);
    }
}

