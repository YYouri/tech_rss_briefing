	protected void publishPostInitializeEvent( final ApplicationEvent event)
	{
		TaskExecutor executor= SimpleSyncTaskExecutor.executor();
		synchronized( this.applicationListeners)
		{
			Iterator<InterceptorDefinition> defs= this.applicationListeners.iterator();
			while( defs.hasNext())
			{
				final ApplicationListener listener= defs.next().getInterceptor();
				if( listener== null) continue;
				executor.execute( new Runnable(){
					public void run()
					{
						listener.postApplicationInitialize( event);
					}
				});
			}
		}
	}

