/**
 * 배포서버(QA/PROD)로 신청서 분할 결과를 SFTP 업로드하고,
 * cleanup_cron.sh 실행을 SSH로 트리거하고, 결과 로그 파일을 조회하는 서비스.
 *
 * server.properties 를 이 클래스가 직접 읽어온다 (기존 serverprops 빈 참조 방식 대신).
 * root/servlet 컨텍스트 분리 여부와 무관하게 항상 동작하도록 하기 위함
 * (BeanExpressionException 등 컨텍스트 간 빈 참조 문제 회피).
 *
 * server.properties 에 아래 키들을 추가해야 함:
 *   deploy.qa.ssh.host=cisq-cowas02
 *   deploy.qa.ssh.port=22
 *   deploy.qa.ssh.user=dsdeploy
 *   deploy.qa.ssh.passwd=****
 *   deploy.qa.request-dir=/NFS/IDES/PMS/CIS_RM/TASK_ID
 *   deploy.qa.work-dir=/Appl/IDES/PmsDeploy
 *   deploy.qa.log-dir=/Logs/IDES/PMS/CIS_RM
 *   deploy.prod.* 도 동일한 키로 별도 정의
 */
@Service
public class CleanupResourceService {
	private static final Logger logger = LogManager.getLogger(CleanupResourceService.class);
	private static final Pattern SAFE_TASK_ID = Pattern.compile("^[A-Za-z0-9_-]{1,64}$");
	private static final DateTimeFormatter DATE_FMT = DateTimeFormatter.ofPattern("yyyy/MM/dd");
	private static final String PROPERTIES_CLASSPATH = "server.properties"; // 실제 파일 위치에 맞게 수정
	@Autowired
	private CommonSyncService commonSyncService;
	
	private Properties props;

	@PostConstruct
	public void init() throws Exception {
		props = PropertiesLoaderUtils.loadAllProperties(PROPERTIES_CLASSPATH);
	}

	private String get(String key) {
		String v = props.getProperty(key);
		if (v == null) {
			throw new IllegalStateException("server.properties 에 " + key + " 값이 없습니다.");
		}
		return v;
	}

	private int getInt(String key, int defaultValue) {
		String v = props.getProperty(key);
		return v == null ? defaultValue : Integer.parseInt(v.trim());
	}

	/** env("QA"/"PROD")에 맞는 접속/경로 정보를 조립해서 반환. 잘못된 값이면 예외 */
	private EnvConfig resolveEnv(String env) {
		if ("QA".equals(env)) {
			return new EnvConfig(
					get("deploy.qa.ssh.host"),
					getInt("deploy.qa.ssh.port", 22),
					get("deploy.qa.ssh.user"),
					get("deploy.qa.ssh.passwd"),
					get("deploy.qa.request-dir"),
					get("deploy.qa.work-dir"),
					get("deploy.qa.log-dir"),
					get("deploy.qa.softm_back")
					);
		}
		if ("PROD".equals(env)) {
			return new EnvConfig(
					get("deploy.prod.ssh.host"),
					getInt("deploy.prod.ssh.port", 22),
					get("deploy.prod.ssh.user"),
					get("deploy.prod.ssh.passwd"),
					get("deploy.prod.request-dir"),
					get("deploy.prod.work-dir"),
					get("deploy.prod.log-dir"),
					get("deploy.prod.softm_back")
					);
		}
		throw new IllegalArgumentException("잘못된 env 값입니다: " + env + " (QA 또는 PROD만 허용)");
	}

	public void validateTaskId(String taskId) {
		if (taskId == null || !SAFE_TASK_ID.matcher(taskId).matches()) {
			throw new IllegalArgumentException("잘못된 TASK_ID 형식입니다: " + taskId);
		}
	}

	/** env 값 자체만 검증하고 싶을 때 컨트롤러에서 호출 (예외 발생 여부로 판단) */
	public void validateEnv(String env) {
		resolveEnv(env);
	}

	/**
	 * 타입별 파일 내용을 배포서버의 REQUEST_DIR/YYYY/MM/DD/TASK_ID/ 아래
	 * TASK_ID_<type>.txt 로 SFTP 업로드한다. 내용이 비어있는 타입은 건너뛴다.
	 */
	public Map<String, String> uploadTaskFiles(String env, String taskId, Map<String, String> filesByType) throws Exception {
		validateTaskId(taskId);
		EnvConfig cfg = resolveEnv(env);
		if(filesByType == null || filesByType.isEmpty())
			throw new IllegalArgumentException("업로드할 파일 내용이 없습니다.");

		logger.info("[자원정리-업로드 시작] env={} taskId={} 대상서버={} 유형={}", env, taskId, cfg.host, filesByType.keySet());

		String todayPath = LocalDate.now().format(DATE_FMT);
		String remoteDir = cfg.requestDir + "/" + todayPath + "/" + taskId;

		Map<String, String> uploaded = new LinkedHashMap<>();

		Session session = null;
		ChannelSftp sftp = null;
		try {
			session = openSession(cfg);
			sftp = (ChannelSftp) session.openChannel("sftp");
			sftp.connect(10_000);

			mkdirsRecursive(sftp, remoteDir);

			for (Map.Entry<String, String> entry : filesByType.entrySet()) {
				String type = entry.getKey();
				String content = entry.getValue();
				if (content == null || content.trim().isEmpty()) continue;

				String remoteFile = remoteDir + "/" + taskId + "_" + type + ".txt";
				String normalized = content.endsWith("\n") ? content : content + "\n";
				try (InputStream in = new ByteArrayInputStream(normalized.getBytes(StandardCharsets.UTF_8))) {
					sftp.put(in, remoteFile);
				}
				uploaded.put(type, remoteFile);
			}

			logger.info("[자원정리-업로드 완료] env={} taskId={} 업로드파일수={} 경로={}", env, taskId, uploaded.size(), remoteDir);
			return uploaded;
		} catch (Exception e) {
			logger.error("[자원정리-업로드 실패] env={} taskId={} 원인={}", env, taskId, e.getMessage(), e);
			throw e;
		} finally {
			if (sftp != null && sftp.isConnected()) sftp.disconnect();
			if (session != null && session.isConnected()) session.disconnect();
		}
	}

	/** 배포서버에서 cleanup_cron.sh <taskId> 를 실행하고 결과(stdout+stderr, exit code)를 반환 */
	public ExecResult executeCleanup(String env, String taskId) throws Exception {
		validateTaskId(taskId);
		EnvConfig cfg = resolveEnv(env);

		logger.info("[자원정리-실행 시작] env={} taskId={} 대상서버={}", env, taskId, cfg.host);

		String remoteCommand = "cd '" + cfg.workDir + "' && ./cleanup_cron.sh '" + taskId + "'";
		ExecResult result;
		try {
			result = runRemoteCommand(cfg, remoteCommand);
		} catch (Exception e) {
			logger.error("[자원정리-실행 실패] env={} taskId={} 원인={}", env, taskId, e.getMessage(), e);
			throw e;
		}
		logger.info("[자원정리-실행 완료] env={} taskId={} exitCode={}", env, taskId, result.getExitCode());
		return result;
	}

	/**
	 * 이 TASK_ID의 가장 최근 결과 로그 파일(<LOG_DIR>/<taskId>_<timestamp>.log)을 찾아
	 * 내용을 그대로 읽어온다. ant_console/NOTI_ERR 로그는 제외.
	 */
	public ExecResult fetchLatestLog(String env, String taskId) throws Exception {
		validateTaskId(taskId);
		EnvConfig cfg = resolveEnv(env);

		logger.info("[자원정리-로그조회] env={} taskId={}", env, taskId);

		String remoteCommand =
				"cd '" + cfg.logDir + "' && " +
						"f=$(ls -t '" + taskId + "'_*.log 2>/dev/null | grep -v '_ant_console' | grep -v '_NOTI_ERR' | head -1); " +
						"if [ -z \"$f\" ]; then echo '__NO_LOG_FOUND__'; exit 1; fi; " +
						"cat \"$f\"";

		try {
			return runRemoteCommand(cfg, remoteCommand);
		} catch (Exception e) {
			logger.error("[자원정리-로그조회 실패] env={} taskId={} 원인={}", env, taskId, e.getMessage(), e);
			throw e;
		}
	}

	private ExecResult runRemoteCommand(EnvConfig cfg, String remoteCommand) throws Exception {
		Session session = null;
		ChannelExec exec = null;
		try {
			session = openSession(cfg);
			exec = (ChannelExec) session.openChannel("exec");
			exec.setCommand(remoteCommand);
			exec.setErrStream(System.err, true);

			ByteArrayOutputStream stdout = new ByteArrayOutputStream();
			exec.setOutputStream(stdout);

			exec.connect(10_000);
			while (!exec.isClosed()) {
				Thread.sleep(200);
			}

			int exitCode = exec.getExitStatus();
			String output = stdout.toString("euc-kr");
			return new ExecResult(exitCode, output);
		} finally {
			if (exec != null && exec.isConnected()) exec.disconnect();
			if (session != null && session.isConnected()) session.disconnect();
		}
	}

	private Session openSession(EnvConfig cfg) throws Exception {
		JSch jsch = new JSch();
		Session session = jsch.getSession(cfg.user, cfg.host, cfg.port);
		session.setPassword(cfg.password);
		session.setConfig("StrictHostKeyChecking", "no"); // 사내 폐쇄망 전제. 가능하면 known_hosts 등록 후 "yes" 권장
		session.connect(10_000);
		return session;
	}

	private void mkdirsRecursive(ChannelSftp sftp, String path) throws Exception {
		String[] parts = path.split("/");
		StringBuilder current = new StringBuilder();
		for (String part : parts) {
			if (part.isEmpty()) continue;
			current.append("/").append(part);
			try {
				sftp.stat(current.toString());
			} catch (Exception notExists) {
				sftp.mkdir(current.toString());
			}
		}
	}
	private final ExecutorService executor = Executors.newCachedThreadPool();
	private final ConcurrentHashMap<String, TaskExecution> executions = new ConcurrentHashMap<>();

	/**
	 * cleanup_cron.sh 실행을 백그라운드 스레드로 시작하고 즉시 리턴한다.
	 * 이미 같은 (env,taskId) 조합이 실행 중이면 중복 시작하지 않는다.
	 */
	public void startExecuteAsync(String env, String taskId) {
		validateTaskId(taskId);
		validateEnv(env); // 잘못된 env면 스레드 띄우기 전에 여기서 바로 예외

		String key = env + "_" + taskId;
		TaskExecution existing = executions.get(key);
		if (existing != null && existing.isRunning()) {
			throw new IllegalStateException("이미 실행 중인 작업입니다: " + taskId);
		}

		TaskExecution exec = new TaskExecution();
		executions.put(key, exec);

		executor.submit(() -> {
			try {
				ExecResult result = executeCleanup(env, taskId); // 기존 동기 메서드 그대로 재사용
				exec.complete(result.getExitCode(), result.getOutput());
			} catch (Exception e) {
				logger.error("[자원정리-비동기실행 실패] env={} taskId={} 원인={}", env, taskId, e.getMessage(), e);
				exec.fail(e.getMessage());
			}
		});
	}

	/** 실행 상태 조회. 시작한 적 없는 taskId면 예외 */
	public TaskExecution getExecutionStatus(String env, String taskId) {
		validateTaskId(taskId);
		String key = env + "_" + taskId;
		TaskExecution exec = executions.get(key);
		if (exec == null) {
			throw new IllegalStateException("해당 TASK_ID의 실행 이력이 없습니다: " + taskId);
		}
		return exec;
	}

	/** 실행 상태를 담는 값 객체 (WAS 메모리에만 보관, DB 아님) */
	public static class TaskExecution {
		private volatile String status = "RUNNING"; // RUNNING, SUCCESS, FAILED
		private volatile Integer exitCode;
		private volatile String output;
		private volatile String errorMessage;
		private final long startedAt = System.currentTimeMillis();

		void complete(int exitCode, String output) {
			this.exitCode = exitCode;
			this.output = output;
			this.status = (exitCode == 0) ? "SUCCESS" : "FAILED";
		}

		void fail(String errorMessage) {
			this.errorMessage = errorMessage;
			this.status = "FAILED";
		}

		public boolean isRunning() { return "RUNNING".equals(status); }
		public String getStatus() { return status; }
		public Integer getExitCode() { return exitCode; }
		public String getOutput() { return output; }
		public String getErrorMessage() { return errorMessage; }
		public long getStartedAt() { return startedAt; }
	}

	/** env별 접속/경로 정보를 담는 단순 값 객체 (Spring Boot 바인딩 아닌 순수 POJO) */
