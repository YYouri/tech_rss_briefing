	 {
		 // Destroy all cached singletons in the context's BeanFactory.
		 ( (SingletonThreadSafeListableBeanFactory)(
					(ConfigurableListableBeanFactoryDelegate)getBeanFactory()).getDelegate()).initialized( false);
		 try{ super.destroyBeans(); }
		 catch( Throwable th){ logger.error( "disposable trace destroyBeans", th);}

		 // Close the state of this context itself.
		 try{ super.closeBeanFactory();}
		 catch( Throwable th){ logger.error( "disposable trace closeBeanFactory", th);}
	 }

