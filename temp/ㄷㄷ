	/**
	 * Perform a scan within the specified base packages,
	 * returning the registered bean definitions.
	 * <p>This method does <i>not</i> register an annotation config processor
	 * but rather leaves this up to the caller.
	 * @param basePackages the packages to check for annotated classes
	 * @return set of beans registered if any for tooling registration purposes (never {@code null})
	 */
	boolean doBeanScan(String findBeanName, boolean isServiceLoad) {
		boolean isResult = false;
		Assert.notNull(findBeanName, "At least one bean must be specified");
		Set<BeanDefinitionHolder> beanDefinitions = new LinkedHashSet<BeanDefinitionHolder>();

		MetadataReader reader = null;
		try {
			reader = loaderRef.getResourceLoader().getMetadataReader(findBeanName);
			if(isServiceLoad)
			{
				String applicationName = loaderRef.getClassLoader().getApplicationName();
				ApplicationContainer container = ApplicationContainerUtils.getApplicationContainer();
				Application application = container.lookupApplication(applicationName, null);
				AnnotatedDefinitionReader.defineAnnotatedResource(reader, (ServiceRegistry) application);
			}
		} catch (IOException e) {
			logger.error(e.getMessage(), e);
			throw new RuntimeException(e.getMessage(), e);
		} catch (ApplicationNotFoundException e) {
			logger.error(e.getMessage(), e);
			throw new RuntimeException(e.getMessage(), e);
		}

		Set<BeanDefinition> candidates = findCandidateBean(reader);
		for (BeanDefinition candidate : candidates) {
			ScopeMetadata scopeMetadata = this.scopeMetadataResolver.resolveScopeMetadata(candidate);
			candidate.setScope(scopeMetadata.getScopeName());
			String beanName = this.beanNameGenerator.generateBeanName(candidate, getRegistry());
			if (candidate instanceof AbstractBeanDefinition) {
				postProcessBeanDefinition((AbstractBeanDefinition) candidate, beanName);
			}
			if (candidate instanceof AnnotatedBeanDefinition) {
				processCommonDefinitionAnnotations((AnnotatedBeanDefinition) candidate);
			}
			if (checkCandidate(beanName, candidate)) {
				BeanDefinitionHolder definitionHolder = new BeanDefinitionHolder(candidate, beanName);
				definitionHolder = applyScopedProxyMode(scopeMetadata, definitionHolder, getRegistry());
				beanDefinitions.add(definitionHolder);
				registerBeanDefinition(definitionHolder, getRegistry());
				isResult = true;
			}
		}

		for(String dsName: this.datasources.keySet())
		{
			if( this.tempMapperDefs.containsKey( dsName))
			{
				String sfBeanName= DasUtils.SQL_SESSIONFACTORY_PREFIX+ loaderRef.getClassLoader().getApplicationName()+ "."+ dsName;

				GenericBeanDefinition sessionFactoryDef = (GenericBeanDefinition) getRegistry().getBeanDefinition(sfBeanName);

				if( this.mapperResources.containsKey( dsName))
				{
					sessionFactoryDef.getPropertyValues().add( "mapperLocations", this.mapperResources.get( dsName));
				}

				//				getRegistry().registerBeanDefinition( sfBeanName, sessionFactoryDef);

				try
				{
					getRegistry().registerBeanDefinition( sfBeanName, sessionFactoryDef);
				}
				catch (Throwable th)
				{
					throw new IllegalStateException(th.getMessage(), th);
				}

				List<GenericBeanDefinition> defs= this.tempMapperDefs.get( dsName);
				for( GenericBeanDefinition def: defs)
				{
					GenericBeanDefinition stDef= new GenericBeanDefinition();
					stDef.setBeanClass( SqlSessionTemplate.class);
					stDef.getConstructorArgumentValues().addGenericArgumentValue( new RuntimeBeanReference( sfBeanName));
					String stName= "STEMPLATE_"+ SystemUtils.generateGUID();
					getRegistry().registerBeanDefinition( stName, stDef);
					def.getPropertyValues().add( "sqlSessionTemplate", new RuntimeBeanReference( stName));
					def.setBeanClass( MapperFactoryBean.class);
				}
			}
		}

		tempMapperDefs.clear();

		return isResult;
	}

	private Set<BeanDefinition> findCandidateBean(MetadataReader reader)
	{
		Set<BeanDefinition> candidates= new LinkedHashSet<BeanDefinition>();
		MetadataReaderFactory metadataReaderFactory= new CachingMetadataReaderFactory( getResourceLoader());
		try
		{
			Resource resource= new UrlResource( reader.getResourceURL());

			try
			{
				if( isCandidateComponent( reader) && checkProfile( reader) && checkComponentType( reader))
				{
					GenericBeanDefinition bd= null;
					Set<String> annotations= new HashSet<String>();
					annotations.addAll( reader.getAnnotationMetadata().getAnnotationTypes());
					annotations.remove( BxmCategory.class.getName());

					if( annotations!= null && annotations.size()> 1)
					{
						org.springframework.core.type.classreading.MetadataReader metadataReader=
								metadataReaderFactory.getMetadataReader( resource);
						bd= new ScannedGenericBeanDefinition( metadataReader);

					}
					else
					{
						bd= new GenericBeanDefinition();
						bd.setBeanClassName( reader.getClassMetadata().getClassName());
					}

					bd.setResource( resource);
					bd.setSource( resource);

					if( this.lazyInitFilter!= null && this.lazyInitFilter.checkLazyInitRuleFilter(
							reader.getClassMetadata().getClassName(), this.loaderRef.getResourceLoader()))
						bd.addMetadataAttribute( new BeanMetadataAttribute( FORCEDLAZYINIT, true));

					candidates.add( bd);

					Map<String, Object> attributes= reader.getAnnotationMetadata().getAnnotationAttributes(
							DATAACCESS_OBJECT_ANNOTATION_CLASSNAME);
					if( attributes== null || attributes.size()== 0)
					{
						attributes= reader.getAnnotationMetadata().getAnnotationAttributes(
								DATAACCESS_OBJECT_METAANNOTATION_CLASSNAME);
					}
					if( attributes== null || attributes.size()== 0)
						return candidates;

					String datasource= (String)attributes.get( DATASORUCE_ATTRIBUTE_NAME);
					String mapper= (String)attributes.get( MAPPER_ATTRIBUTE_NAME);
					if( !StringUtils.hasText( datasource) || !StringUtils.hasText( mapper)) return candidates;

					if( !this.datasources.containsKey( datasource))
					{
						//						ApplicationResourceInitializer.logger.warn(
						//								"invalid datasource name in DBIO [{}/{}], this DBIO will be removed in registry.",
						//								datasource, bd.getBeanClassName());
						candidates.remove( bd);
					}

					defineMapperResources( datasource, reader.getClassMetadata().getClassName(), mapper);
					bd.getPropertyValues().add( MAPPER_INTERFACE_ATTRIBUTE, bd.getBeanClassName());
					bd.getPropertyValues().add( "addToConfig", true);
					if( this.mapperDefs.containsKey( datasource))
					{
						this.mapperDefs.get( datasource).add( bd);
						this.tempMapperDefs.get( datasource).add( bd);
					}
					else
					{
						List<GenericBeanDefinition> defs= new ArrayList<GenericBeanDefinition>();
						defs.add( bd);
						this.mapperDefs.put( datasource, defs);
						this.tempMapperDefs.put( datasource, defs);
					}
				}
			}
			catch( Throwable th)
			{
				throw new BeanDefinitionStoreException( "Failed to read candidate component class: " + resource, th);
			}
		}
		catch( Exception ex)
		{
			throw new BeanDefinitionStoreException("failure during classpath scanning", ex);
		}
		return candidates;
	}

	void processCommonDefinitionAnnotations(AnnotatedBeanDefinition abd) {
		AnnotationMetadata metadata = abd.getMetadata();
		if (metadata.isAnnotated(Primary.class.getName())) {
			abd.setPrimary(true);
		}
		if (metadata.isAnnotated(Lazy.class.getName())) {
			abd.setLazyInit(attributesFor(metadata, Lazy.class).getBoolean("value"));
		}
		if (metadata.isAnnotated(DependsOn.class.getName())) {
			abd.setDependsOn(attributesFor(metadata, DependsOn.class).getStringArray("value"));
		}
		if (abd instanceof AbstractBeanDefinition) {
			if (metadata.isAnnotated(Role.class.getName())) {
				Integer role = attributesFor(metadata, Role.class).getNumber("value");
				((AbstractBeanDefinition)abd).setRole(role);
			}
		}
	}

	static AnnotationAttributes attributesFor(AnnotationMetadata metadata, Class<?> annoClass) {
		return attributesFor(metadata, annoClass.getName());
	}

	static AnnotationAttributes attributesFor(AnnotationMetadata metadata, String annoClassName) {
		return AnnotationAttributes.fromMap(metadata.getAnnotationAttributes(annoClassName, false));
	}

	static AnnotationAttributes attributesFor(MethodMetadata metadata, Class<?> targetAnno) {
		return AnnotationAttributes.fromMap(metadata.getAnnotationAttributes(targetAnno.getName()));
	}

	static BeanDefinitionHolder applyScopedProxyMode(
			ScopeMetadata metadata, BeanDefinitionHolder definition, BeanDefinitionRegistry registry) {

		ScopedProxyMode scopedProxyMode = metadata.getScopedProxyMode();
		if (scopedProxyMode.equals(ScopedProxyMode.NO)) {
			return definition;
		}
		boolean proxyTargetClass = scopedProxyMode.equals(ScopedProxyMode.TARGET_CLASS);
		return createScopedProxy(definition, registry, proxyTargetClass);
	}

	static BeanDefinitionHolder createScopedProxy(
			BeanDefinitionHolder definitionHolder, BeanDefinitionRegistry registry, boolean proxyTargetClass) {

		return ScopedProxyUtils.createScopedProxy(definitionHolder, registry, proxyTargetClass);
	}

