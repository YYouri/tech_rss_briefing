	@SuppressWarnings( "rawtypes")
	private void cleanupServletContextAttributes()
	{
		Enumeration attrNames= this.servletContext.getAttributeNames();
		while( attrNames.hasMoreElements())
		{
			String attrName= (String)attrNames.nextElement();
			if( attrName.startsWith( "org.springframework."))
			{
				Object attrValue= this.servletContext.getAttribute( attrName);
				if( attrValue instanceof DisposableBean)
				{
					try{ ( (DisposableBean)attrValue).destroy();}
					catch( Throwable th)
					{
						logger.warn( th.getMessage(), th);
					}
				}
			}
		}
	}

	void checkStatus()
	{
		if( this.context== null || !this.context.isActive())
			throw new IllegalStateException( "current application context is not initialized.");
	}

