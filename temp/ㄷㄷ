<?xml version="1.0" encoding="UTF-8"?>
<!-- ==================================================
     [공통 로직] 서버 목록을 순회하며 파일 정리
     로그는 서버별로 3단계 구조로 남는다:
       1. 작업 전 자원 확인 (ls)
       2. 이동 결과 (경로별 mv 원본 -> 대상 [성공/실패] + 요약 건수)
       3. 작업 후 자원 확인 (ls)
     백업 경로는 서버 호스트명 단위로 분리되어 있어, 서버간 백업 덮어쓰기가 없음
     요청 목록 파일(PLIST)은 삭제하지 않고 백업 폴더에 request_list.txt로 보관
     ================================================== -->
<project name="cleanup_build" basedir="/Appl/IDES/PmsDeploy">
	<property file="./config/cis.deploy.properties" />
	<taskdef resource="net/sf/antcontrib/antlib.xml" />

	<taskdef name="pmsAlertSend" classname="hi.deploy.ant.PmsAlertSend" classpath="./classes"/>


	<macrodef name="do-cleanup">
		<attribute name="server.list"/>
		<attribute name="request.file"/>
		<attribute name="user"/>
		<attribute name="passwd"/>

		<sequential>
			<loadfile property="pathlist" srcFile="@{request.file}"/>

			<for list="@{server.list}" param="server.ip" delimiter=" ">
				<sequential>

					<sshexec host="@{server.ip}"
							username="@{user}"
							password="@{passwd}"
							trust="true"
							verbose="false"
							outputproperty="result.@{server.ip}"
							command="PLIST=/tmp/cleanup_paths_${task_id}_$$; echo '${pathlist}' > $PLIST; DRYRUN=${dryrun}; BACKUP_DIR=${backup_root}/${task_id}/$(hostname); echo "1. Pre-Check"; while read -r p || [ -n "$p" ]; do p=$(echo "$p" | sed 's/[ \t\r]*$//'); [ -z "$p" ] && continue; ls -l "$p" 2>&1; done < $PLIST; SUCCESS=0; FAIL=0; echo "2. Move Result"; while read -r p || [ -n "$p" ]; do p=$(echo "$p" | sed 's/[ \t\r]*$//'); [ -z "$p" ] && continue; if [ -f "$p" ]; then if [ "$DRYRUN" = "true" ]; then echo "mv $p -> $BACKUP_DIR$p (dry-run, NO RUN)"; SUCCESS=$((SUCCESS+1)); else mkdir -p "$BACKUP_DIR$(dirname "$p")"; mv "$p" "$BACKUP_DIR$p"; if [ -f "$p" ]; then echo "mv $p -> $BACKUP_DIR$p [FAIL]"; FAIL=$((FAIL+1)); else echo "mv $p -> $BACKUP_DIR$p [SUCCESS]"; SUCCESS=$((SUCCESS+1)); fi; fi; else echo "mv $p -> (SKIPPED: NO PAGE)"; FAIL=$((FAIL+1)); fi; done < $PLIST; echo "SUMMARY: SUCCESS=$SUCCESS FAIL=$FAIL"; echo "3. Post Check"; while read -r p || [ -n "$p" ]; do p=$(echo "$p" | sed 's/[ \t\r]*$//'); [ -z "$p" ] && continue; ls -l "$p" 2>&1; done < $PLIST; mkdir -p "$BACKUP_DIR"; mv "$PLIST" "$BACKUP_DIR/request_list.txt""/>

					<echo file="${log_dir}/${task_id}.log" append="true"
						message="${line.separator}===== 서버: @{server.ip} =====${line.separator}${result.@{server.ip}}${line.separator}"/>

				</sequential>
			</for>
		</sequential>
	</macrodef>


	<!-- ==================================================
	     [타겟 3개] 각자 자기 서버 목록/계정만 지정해서 위 매크로 호출
	     ================================================== -->
	<target name="cleanup.legacy.resources.online">
		<do-cleanup server.list="${cowas.server.ip.list}"
					request.file="${request_file}"
					user="${cowas.server.user}"
					passwd="${cowas.server.passwd}"/>
	</target>

	<target name="cleanup.legacy.resources.batch">
		<do-cleanup server.list="${batch.server.ip.list}"
					request.file="${request_file}"
					user="${batch.server.user}"
					passwd="${batch.server.passwd}"/>
	</target>

	<target name="cleanup.legacy.resources.web">
		<do-cleanup server.list="${coweb.server.ip.list}"
					request.file="${request_file}"
					user="${coweb.server.user}"
					passwd="${coweb.server.passwd}"/>
	</target>


	<!-- ==================================================
	     [알림 타겟] 작업 하나(TASK_ID) 처리 결과를 이메일로 발송
	     쉘 스크립트에서 -Dnotify_message, -Dnotify_email 넘겨서 호출
	     ================================================== -->
	<target name="notify.task.result">
		<echo message="notify_task: ${notify_task}===== notify_message: ${notify_message} ===== notify_email: ${notify_email}"/>
		<pmsAlertSend title="${notify_task}" message="${notify_message}" email="${notify_email}"/>
	</target>

</project>
