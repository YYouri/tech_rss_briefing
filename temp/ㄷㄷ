function addTreeNode() {
	hideRMenu();
	var selectedNode = sharedNodes;
	var newNode = { name:"newNode " + (newCount++)};
	if (selectedNode[0]) {
		newNode.checked = selectedNode[0].checked;
		zTree.addNodes(selectedNode[0], newNode);
	} else {
		zTree.addNodes(null, newNode);
	}
}

function add(e) {
	hideRMenu();
	isParent = e.data.isParent;
	
	var selectedNode = sharedNodes;
	var d = selectedNode[0];

	if(selectedNode.length != 0) {
		if (d) {
			d = zTree.addNodes(d, {id:(100 + newCount), pId:d.id, isParent:isParent, isFile:false, name:"newDir" + (newCount++)});
		} else {
			d = zTree.addNodes(null, {id:(100 + newCount), pId:0, isParent:isParent, isFile:false, name:"newDir" + (newCount++)});
		}		
	}
	else{
		errorAlert("선택된 경로가 없습니다.", "", "info", "", false);
	}
	
};
