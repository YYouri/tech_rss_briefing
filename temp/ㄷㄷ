	protected void loadBeanDefinitions( XmlBeanDefinitionReader reader) throws IOException
	{
		long now= System.currentTimeMillis();
		logger.debug( "loadBeanDefinitions [{}].", application.getApplicationName());
		File deployedTaret= application.getDeployedTarget();
		boolean batch= false;
		reader.setValidating( false);
		if( Boolean.valueOf( System.getProperty( ApplicationContainerLoader.CONTAINER_FOR_BATCH)))
		{
			batch= true;
			reader.setNamespaceHandlerResolver(
					new DefaultNamespaceHandlerResolver( loaderRef.getClassLoader(),
							XmlApplicationContext.BATCH_HANDLER_MAPPINGS_LOCATION));
			reader.setEntityResolver( new PluggableSchemaResolver( loaderRef.getClassLoader(),
				XmlApplicationContext.BATCH_SCHEMA_MAPPINGS_LOCATION));
		}
		ResourceLoader resourceLoader=  new DefaultResourceLoader( new ClassLoader(){
			WeakReference<ClassLoader> delegate= new WeakReference<ClassLoader>( loaderRef.getClassLoader());
			public Class<?> loadClass(String name) throws ClassNotFoundException
			{
				ClassLoader loaderToUse= null;
				if( ( loaderToUse= delegate.get())!= null)
					return loaderToUse.loadClass( name);
				else
					throw new IllegalStateException( "current class loader is already closed");
			}
			public URL getResource( String name)
			{
				ClassLoader loaderToUse= null;
				if( ( loaderToUse= delegate.get())!= null)
					return loaderToUse.getResource( name);
				else
					throw new IllegalStateException( "current class loader is already closed");
			}
			// filtering application local resource for scan
			public Enumeration<URL> getResources( String name) throws IOException
			{
				ClassLoader loaderToUse= null;
				if( ( loaderToUse= delegate.get())!= null)
					return ( (ApplicationClassLoader)loaderToUse).getApplicationResources( name);
				else
					throw new IllegalStateException( "current class loader is already closed");
			}
		});
		reader.setBeanClassLoader( this.loaderRef.getClassLoader());
		LazyInitFilter lazyInitFilter= null;
		DeployedResourceScannerConfigurer scanner=
				new DeployedResourceScannerConfigurer( this.beanCandidates,
						reader.getRegistry(), application.getContainerDataSource(),
						application.getDataAccessContext(), application.getDataSources(), getClassLoaderRef(), false,
						//[[ 20170118 수정.
						//( application.isLazyInit() && ApplicationLoadingMode.HOT== application.getApplicationLoadingMode()
						//	|| application.isSessionfactroyLazyinit()), lazyInitFilter);
						( application.isLazyInit() && application.isSessionfactroyLazyinit()), lazyInitFilter);
						//]]
		scanner.setResourceLoader( resourceLoader);
		scanner.setBeanNameGenerator( new ManagedResourceBeanNameGenerator( getClassLoaderRef().getResourceLoader()));

		int scanned= scanner.scan( "");

		String[] configLocations = getConfigLocations();
		if( configLocations!= null)
		{
			reader.setErrorHandler( new ErrorHandler(){
				public void warning( SAXParseException exception) throws SAXException{}
				public void fatalError( SAXParseException exception) throws SAXException{ throw exception;}
				public void error( SAXParseException exception) throws SAXException{ throw exception;}
			});
			for (String configLocation : configLocations)
			{
				Resource resource= resourceLoader.getResource( configLocation);
				logger.debug( "resource [{}/{}/{}].",
						new Object[]{ application.getApplicationName(), resource.getURL(), resource.exists()});
				if( resource.exists())
				{
					try{ reader.loadBeanDefinitions( resource);}
					catch( Throwable th)
					{
						logger.warn( "loadBeanDefinitions for [{}] using resource [{}] is failed. {}",
								new Object[]{ application.getApplicationName(), resource, th.getMessage()});
					}
				}
			}
		}

		if( batch)
		{
			bxm.instance.loader.resource.ResourceLoader appLoader= application.getClassLoaderRef().getResourceLoader();
			bxm.instance.loader.resource.Resource[] appResources= null;
			File jobsRoot= null;
			if( deployedTaret.isDirectory()
					&& ( jobsRoot= new File( deployedTaret, DeployedApplicationModel.META_PATH_SUFFIX+ FS+ JOBS_PATH)).exists()
					&& jobsRoot.isDirectory() && jobsRoot.canRead())
				appResources= appLoader.getResources( "file:"+ jobsRoot.getAbsolutePath()+ FS+ "**/*"+ JOBS_SUFFIX_NAME);
			else if( deployedTaret.isFile() && deployedTaret.getName().endsWith( DeployedApplicationModel.BXM_ARCHIVE_SUFFIX))
			{
				appResources= appLoader.getResources( ResourceUtils.URL_PROTOCOL_PAR+ ":"+
								"file:"+ deployedTaret.getAbsolutePath()+ ParURLConnection.SEPARATOR+
								DeployedApplicationModel.META_PATH_SUFFIX+ FS+ JOBS_PATH+ FS+ "**/*"+ JOBS_SUFFIX_NAME);
			}

			if( appResources!= null && appResources.length> 0)
			{
				for( bxm.instance.loader.resource.Resource res: appResources)
				{
					Resource targetResource= deployedTaret.isDirectory() ?
							new FileSystemResource( res.getFile()) : new UrlResource( res.getURL());
					logger.debug( "resource [{}/{}].", application.getApplicationName(), res.getURL());
					try{ reader.loadBeanDefinitions( targetResource);}
					catch( Throwable th)
					{
						logger.warn( "loadBeanDefinitions for [{}] using resource[{}] is failed. {}",
						new Object[]{ application.getApplicationName(), res.getURL(), th.getMessage()});
					}
				}
			}
		}
		else
		{
			List<Resource> wsdlResources= new ArrayList<Resource>();
			File wsdlRoot= null;
			if( deployedTaret.isDirectory()
					&& ( wsdlRoot= new File( deployedTaret, DeployedApplicationModel.META_PATH_SUFFIX+ FS+
							WebServiceMessageDispatcher.WSDL_PATH)).exists()
					&& wsdlRoot.isDirectory() && wsdlRoot.canRead())
			{
				try
				{
					File[] wsdls= wsdlRoot.listFiles( new FilenameFilter(){
						public boolean accept( File dir, String name)
						{
							if( name.endsWith( WSDL_SUFFIX_NAME)) return true;
							else return false;
						}
					});

					for( File wsdl: wsdls)
						wsdlResources.add( new FileSystemResource( wsdl));
					registerWsdlDefinitions( reader, wsdlResources);
				}
				catch( Throwable th)
				{
					logger.warn( "loadBeanDefinitions for [{}] wsdl resource is failed.", application, th);
				}
			}
			else if( deployedTaret.isFile() && deployedTaret.getName().endsWith( DeployedApplicationModel.BXM_ARCHIVE_SUFFIX))
			{
				bxm.instance.loader.resource.ResourceLoader appLoader= application.getClassLoaderRef().getResourceLoader();
				bxm.instance.loader.resource.Resource[] appResources=
						appLoader.getResources( ResourceUtils.URL_PROTOCOL_PAR+ ":"+
									"file:"+ deployedTaret.getAbsolutePath()+ ParURLConnection.SEPARATOR+
									DeployedApplicationModel.META_PATH_SUFFIX+ FS+ WebServiceMessageDispatcher.WSDL_PATH+
									FS+ "**/*"+ WSDL_SUFFIX_NAME);
				if( appResources!= null && appResources.length> 0)
				{
					try
					{
						for( bxm.instance.loader.resource.Resource res: appResources)
							wsdlResources.add( new UrlResource( res.getURL()));
						registerWsdlDefinitions( reader, wsdlResources);
					}
					catch( Throwable th)
					{
						logger.warn( "loadBeanDefinitions for [{}] wsdl resource is failed.", application, th);
					}
				}
			}
		}

		String[] beanNames= application.isUseOnlyPredefinedBeanProcessors() ?
				( !batch ? PREDEFINED_ONLINE_PROCESSORS.keySet().toArray( new String[PREDEFINED_ONLINE_PROCESSORS.keySet().size()])
						: PREDEFINED_BATCH_PROCESSORS.keySet().toArray( new String[PREDEFINED_BATCH_PROCESSORS.keySet().size()]))
				: reader.getRegistry().getBeanDefinitionNames();
		for( String beanName: beanNames)
		{
			if( !reader.getRegistry().containsBeanDefinition( beanName))
				continue;

			BeanDefinition bd= reader.getRegistry().getBeanDefinition( beanName);
			String beanClassName= null;
			if( ( bd instanceof AbstractBeanDefinition) && ( (AbstractBeanDefinition)bd).hasBeanClass())
				beanClassName= ( (AbstractBeanDefinition)bd).getBeanClass().getName();
			else
				beanClassName= bd.getBeanClassName();

			if( !StringUtils.hasText( beanClassName)) continue;
//			scanBeanNamesForRegistration( BeanDefinitionRegistryPostProcessor.class.getName(), beanName, beanClassName,
//					beanDefinitionRegistryPostProcessorNames);
			scanBeanNamesForRegistration( BeanFactoryPostProcessor.class.getName(), beanName, beanClassName,
					beanFactoryPostProcessorNames);
			scanBeanNamesForRegistration( BeanPostProcessor.class.getName(), beanName, beanClassName, beanPostProcessorNames);
			scanBeanNamesForRegistration( ApplicationListener.class.getName(), beanName, beanClassName, applicationListeners);
		}

		logger.debug( "scanned deployed resource [{}/{}].", application.getApplicationName(), scanned);
		logger.debug( "loadBeanDefinitions of [{}] is ended. elapsedtime is [{}].",
				application.getApplicationName(), System.currentTimeMillis()- now);
	}

	private void scanBeanNamesForRegistration( String typeName, String beanName, String beanClassName, Set<String> registry)
	{
		if( isAssignable( typeName, beanClassName))
		{
			registry.add( beanName);
			if( isAssignable( FactoryBean.class.getName(), beanClassName))
				factoryBeanNames.add( beanName);
			if( isAssignable( PriorityOrdered.class.getName(), beanClassName))
				priorityOrdereds.add( beanName);
			if( isAssignable( Ordered.class.getName(), beanClassName))
				ordereds.add( beanName);
		}
	}

	private void registerWsdlDefinitions( XmlBeanDefinitionReader reader, List<Resource> resources) throws IOException
	{
		Resource wsdefs= new ClassPathResource( CUSTOM_WS_BEANS_RESOURCE);
		if( wsdefs!= null && wsdefs.exists())
		{
			reader.setNamespaceHandlerResolver(
					new DefaultNamespaceHandlerResolver( loaderRef.getClassLoader(), WS_HANDLER_MAPPINGS_LOCATION));
			reader.setEntityResolver( new PluggableSchemaResolver( loaderRef.getClassLoader(), WS_SCHEMA_MAPPINGS_LOCATION));
			reader.loadBeanDefinitions( wsdefs);
			for( Resource res: resources)
			{
				GenericBeanDefinition wsdlBean= new GenericBeanDefinition();
				wsdlBean.setBeanClassName( WS_BEANCLASS_NAME);
				wsdlBean.getPropertyValues().add( "wsdl", res);
				String beanName= StringUtils.getFilename( res.getURL().getFile());
				reader.getRegistry().registerBeanDefinition( beanName, wsdlBean);
			}
			GenericBeanDefinition dispatcherBean= new GenericBeanDefinition();
			dispatcherBean.setBeanClassName( WebServiceMessageDispatcher.class.getName());
			reader.getRegistry().registerBeanDefinition( WebServiceMessageDispatcher.MESSAGE_DISPATCHER_BEANNAME, dispatcherBean);
		}
		else
		{
			wsdefs= new ClassPathResource( WS_BEANS_RESOURCE);
			GenericBeanDefinition endpDef= new GenericBeanDefinition();
			endpDef.setBeanClassName( ManagedServiceWsdl.WS_ENDPOINT_CLASSNAME);
			endpDef.getPropertyValues().add( "application", application);
			reader.getRegistry().registerBeanDefinition( ManagedServiceWsdl.WS_ENDPOINT_BEANNAME, endpDef);
			reader.setNamespaceHandlerResolver(
					new DefaultNamespaceHandlerResolver( loaderRef.getClassLoader(), WS_HANDLER_MAPPINGS_LOCATION));
			reader.setEntityResolver( new PluggableSchemaResolver( loaderRef.getClassLoader(), WS_SCHEMA_MAPPINGS_LOCATION));
			reader.loadBeanDefinitions( wsdefs);
			for( Resource res: resources)
			{
				GenericBeanDefinition wsdlBean= new GenericBeanDefinition();
				wsdlBean.setBeanClassName( WS_BEANCLASS_NAME);
				wsdlBean.getPropertyValues().add( "wsdl", res);
				String beanName= StringUtils.getFilename( res.getURL().getFile());
				reader.getRegistry().registerBeanDefinition( beanName, wsdlBean);
			}
			GenericBeanDefinition dispatcherBean= new GenericBeanDefinition();
			dispatcherBean.setBeanClassName( WebServiceMessageDispatcher.class.getName());
			reader.getRegistry().registerBeanDefinition( WebServiceMessageDispatcher.MESSAGE_DISPATCHER_BEANNAME, dispatcherBean);
		}



	}

	private void rebuildInfrastructureBeanDefinitions( SingletonThreadSafeListableBeanFactory beanF)
	{
		beanF.removeBeanDefinition( AnnotationConfigUtils.CONFIGURATION_ANNOTATION_PROCESSOR_BEAN_NAME);
		Map<String, String> infrastructureBeans= PREDEFINED_ALL_PROCESSORS;
		ClassLoader cl= Thread.currentThread().getContextClassLoader();
		for( Map.Entry<String, String> entry: infrastructureBeans.entrySet())
		{
			if( !beanF.containsBeanDefinition( entry.getKey()))
				continue;

			Object processor= null;
			try{ processor= cl.loadClass( entry.getValue()).newInstance();}
			catch( Exception ex)
			{
				throw new IllegalStateException( "Cannot create infrastructure bean : " + entry.getValue(), ex);
			}
			injectAwareRequirement( processor);
			beanF.registerSingletonConcurrently( entry.getKey(), processor);
			createdPostProcessors.add( entry.getKey());
		}
	}

	private void injectAwareRequirement( Object processor)
	{
		if( processor instanceof Aware)
		{
			if( processor instanceof BeanFactoryAware)
				( (BeanFactoryAware)processor).setBeanFactory( getBeanFactory());
			if( processor instanceof EnvironmentAware)
				( (EnvironmentAware)processor).setEnvironment( getEnvironment());
			if( processor instanceof ResourceLoaderAware)
				( (ResourceLoaderAware)processor).setResourceLoader( this);
			if( processor instanceof ApplicationContextAware)
				( (ApplicationContextAware)processor).setApplicationContext( this);
		}
	}

	private boolean isAssignable( String lhsType, String rhsType)
	{
		Assert.hasText( lhsType, lhsType);
		Assert.hasText( rhsType, rhsType);
		try
		{
			ClassMetadata classMetadata= loaderRef.getResourceLoader().getMetadataReader( rhsType).getClassMetadata();
			String superClass= classMetadata.getSuperClassName();
			Set<String> interfaces= new HashSet<String>();
			String[] infs= classMetadata.getInterfaceNames();
			if( infs!= null && infs.length> 0)
				interfaces.addAll( Arrays.asList( infs));

			if( lhsType.equals( superClass) || interfaces.contains( lhsType))
				return true;
			else
			{
				if( StringUtils.hasText( superClass)
						&& !superClass.equals( Object.class.getName()) && isAssignable( lhsType, superClass))
					return true;
				for( String interfacen: interfaces)
				{
					if( StringUtils.hasText( interfacen)
							&& !interfacen.equals( Object.class.getName()) && isAssignable( lhsType, interfacen))
						return true;
				}
				return false;
			}
		}
		catch( IOException e){}

		return false;
	}

	protected void prepareBeanFactory( ConfigurableListableBeanFactory beanFactory)
	{
		logger.info( "prepare beanfactory of [{}] for WebApplicationContext refreshment.", application.getApplicationName());

		setClassLoader( this.loaderRef.getClassLoader());
		ClassLoader classLoader= getClassLoader();
		logger.info( "classloader [{}/{}] will be used.", application.getApplicationName(), classLoader);

		SingletonThreadSafeListableBeanFactory beanF=
				(SingletonThreadSafeListableBeanFactory)( (ConfigurableListableBeanFactoryDelegate)beanFactory).getDelegate();

		// Register default environment beans.
		if( !beanFactory.containsBean( ENVIRONMENT_BEAN_NAME))
			beanF.registerSingletonConcurrently( ENVIRONMENT_BEAN_NAME, getEnvironment());

		if( !beanFactory.containsBean( SYSTEM_PROPERTIES_BEAN_NAME))
			beanF.registerSingletonConcurrently( SYSTEM_PROPERTIES_BEAN_NAME, getEnvironment().getSystemProperties());

		if( !beanFactory.containsBean( SYSTEM_ENVIRONMENT_BEAN_NAME))
			beanF.registerSingletonConcurrently( SYSTEM_ENVIRONMENT_BEAN_NAME, getEnvironment().getSystemEnvironment());

		super.prepareBeanFactory( beanFactory);

		logger.info( "beanfactory of [{}] is prepared for current WebApplicationContext.", application.getApplicationName());
	}

	private String[] getBeanNamesForRegister(
			Class<?> type, SingletonThreadSafeListableBeanFactory beanFactory, Set<String> beanDefinitionNames)
	{
		AliasRegistry aliasRegistry= (AliasRegistry)beanFactory;
		List<String> result= new ArrayList<String>();
		// Check all bean definitions.
		for( String beanName : beanDefinitionNames)
		{
			// Only consider bean as eligible if the bean name
			// is not defined as alias for some other bean.
			if( aliasRegistry.isAlias( beanName)) continue;

			try
			{
				RootBeanDefinition mbd= beanFactory.getMergedLocalBeanDefinitionConcurrently( beanName);
				// Only check bean definition if it is complete.
				if( mbd.isAbstract()
						|| SqlSessionFactoryBean.class.getName().equals( mbd.getBeanClassName())
						|| MapperFactoryBean.class.getName().equals( mbd.getBeanClassName()))
					continue;

				if( !factoryBeanNames.contains( beanName))
					result.add( beanName);
				else if( beanFactory.isTypeMatch( FACTORY_BEAN_PREFIX + beanName, type))
					result.add( FACTORY_BEAN_PREFIX + beanName);
			}
			catch( Exception ex){}
		}
		return StringUtils.toStringArray(result);
	}

	@Override
	protected void postProcessBeanFactory( ConfigurableListableBeanFactory beanFactory)
	{
		SingletonThreadSafeListableBeanFactory beanF=
				(SingletonThreadSafeListableBeanFactory)( (ConfigurableListableBeanFactoryDelegate)beanFactory).getDelegate();

		beanFactory.addBeanPostProcessor( new ServletContextAwareProcessor( getServletContext(), getServletConfig()));
		beanFactory.ignoreDependencyInterface( ServletContextAware.class);
		beanFactory.ignoreDependencyInterface( ServletConfigAware.class);

		WebApplicationContextUtils.registerWebApplicationScopes( beanFactory, getServletContext());
		registerEnvironmentBeans( beanF, getServletContext(), getServletConfig());

		rebuildInfrastructureBeanDefinitions( beanF);
	}

	private void registerEnvironmentBeans( SingletonThreadSafeListableBeanFactory bf, ServletContext sc, ServletConfig config)
	{
		if( sc!= null && !bf.containsBean( WebApplicationContext.SERVLET_CONTEXT_BEAN_NAME))
			bf.registerSingletonConcurrently( WebApplicationContext.SERVLET_CONTEXT_BEAN_NAME, sc);

		if( config!= null && !bf.containsBean( ConfigurableWebApplicationContext.SERVLET_CONFIG_BEAN_NAME))
			bf.registerSingletonConcurrently( ConfigurableWebApplicationContext.SERVLET_CONFIG_BEAN_NAME, config);

		if( !bf.containsBean( WebApplicationContext.CONTEXT_PARAMETERS_BEAN_NAME))
		{
			Map<String, String> parameterMap= new HashMap<String, String>();
			if( sc!= null)
			{
				Enumeration<?> paramNameEnum= sc.getInitParameterNames();
				while( paramNameEnum.hasMoreElements())
				{
					String paramName= (String)paramNameEnum.nextElement();
					parameterMap.put( paramName, sc.getInitParameter( paramName));
				}
			}
			if( config!= null)
			{
				Enumeration<?> paramNameEnum= config.getInitParameterNames();
				while( paramNameEnum.hasMoreElements())
				{
					String paramName= (String)paramNameEnum.nextElement();
					parameterMap.put( paramName, config.getInitParameter( paramName));
				}
			}
			bf.registerSingletonConcurrently( WebApplicationContext.CONTEXT_PARAMETERS_BEAN_NAME,
					Collections.unmodifiableMap(parameterMap));
		}

		if( !bf.containsBean( WebApplicationContext.CONTEXT_ATTRIBUTES_BEAN_NAME))
		{
			Map<String, Object> attributeMap= new HashMap<String, Object>();
			if( sc!= null)
			{
				Enumeration<?> attrNameEnum= sc.getAttributeNames();
				while( attrNameEnum.hasMoreElements())
				{
					String attrName= (String)attrNameEnum.nextElement();
					attributeMap.put( attrName, sc.getAttribute( attrName));
				}
			}
			bf.registerSingletonConcurrently( WebApplicationContext.CONTEXT_ATTRIBUTES_BEAN_NAME,
					Collections.unmodifiableMap( attributeMap));
		}
	}

	@Override
	protected void invokeBeanFactoryPostProcessors( ConfigurableListableBeanFactory beanFactory)
	{
		SingletonThreadSafeListableBeanFactory beanF=
				(SingletonThreadSafeListableBeanFactory)( (ConfigurableListableBeanFactoryDelegate)beanFactory).getDelegate();

		// Invoke BeanDefinitionRegistryPostProcessors first, if any.
		// do not BeanDefinitionRegistryPostProcessor processing.
		Set<String> processedBeans= new HashSet<String>();
		if( beanFactory instanceof BeanDefinitionRegistry)
		{
//			BeanDefinitionRegistry registry= (BeanDefinitionRegistry)beanF;
			List<BeanFactoryPostProcessor> regularPostProcessors= new LinkedList<BeanFactoryPostProcessor>();
//			List<BeanDefinitionRegistryPostProcessor> registryPostProcessors= new LinkedList<BeanDefinitionRegistryPostProcessor>();
			for( BeanFactoryPostProcessor postProcessor : getBeanFactoryPostProcessors())
			{
				if( postProcessor instanceof BeanDefinitionRegistryPostProcessor)
				{
//					BeanDefinitionRegistryPostProcessor registryPostProcessor= (BeanDefinitionRegistryPostProcessor)postProcessor;
//					registryPostProcessor.postProcessBeanDefinitionRegistry( registry);
//					registryPostProcessors.add( registryPostProcessor);
				}
				else
					regularPostProcessors.add( postProcessor);
			}

//			String[] beanNames= getBeanNamesForRegister(
//					BeanDefinitionRegistryPostProcessor.class, beanF, beanDefinitionRegistryPostProcessorNames);
//			Map<String, BeanDefinitionRegistryPostProcessor> beanMap= new HashMap<String, BeanDefinitionRegistryPostProcessor>();
//			for( String beanName: beanNames)
//				beanMap.put( beanName, (BeanDefinitionRegistryPostProcessor)beanF.getBean( beanName));
//			List<BeanDefinitionRegistryPostProcessor> registryPostProcessorBeans=
//					new ArrayList<BeanDefinitionRegistryPostProcessor>(beanMap.values());
//			OrderComparator.sort( registryPostProcessorBeans);
//			for( BeanDefinitionRegistryPostProcessor postProcessor : registryPostProcessorBeans)
//				postProcessor.postProcessBeanDefinitionRegistry( registry);
//			invokeBeanFactoryPostProcessors( registryPostProcessors, beanFactory);
//			invokeBeanFactoryPostProcessors( registryPostProcessorBeans, beanFactory);
			invokeBeanFactoryPostProcessors( regularPostProcessors, beanFactory);
//			processedBeans.addAll( beanMap.keySet());
		}
		else
		{
			// Invoke factory processors registered with the context instance.
			invokeBeanFactoryPostProcessors( getBeanFactoryPostProcessors(), beanFactory);
		}

		// Do not initialize FactoryBeans here: We need to leave all regular beans
		// uninitialized to let the bean factory post-processors apply to them!
		String[] postProcessorNames=
				getBeanNamesForRegister( BeanFactoryPostProcessor.class, beanF, beanFactoryPostProcessorNames);

		// Separate between BeanFactoryPostProcessors that implement PriorityOrdered,
		// Ordered, and the rest.
		List<BeanFactoryPostProcessor> priorityOrderedPostProcessors= new ArrayList<BeanFactoryPostProcessor>();
		List<String> orderedPostProcessorNames= new ArrayList<String>();
		List<String> nonOrderedPostProcessorNames= new ArrayList<String>();
		for( String ppName : postProcessorNames)
		{
			if( processedBeans.contains( ppName))
				continue;
			else if( priorityOrdereds.contains( ppName))
				priorityOrderedPostProcessors.add( createdPostProcessors.contains( ppName) ?
						(BeanFactoryPostProcessor)beanF.getSingletonConcurrently( ppName) :
						beanFactory.getBean( ppName, BeanFactoryPostProcessor.class));
			else if( ordereds.contains( ppName))
				orderedPostProcessorNames.add( ppName);
			else
				nonOrderedPostProcessorNames.add( ppName);
		}

		// First, invoke the BeanFactoryPostProcessors that implement PriorityOrdered.
		OrderComparator.sort( priorityOrderedPostProcessors);
		invokeBeanFactoryPostProcessors( priorityOrderedPostProcessors, beanF);

		// Next, invoke the BeanFactoryPostProcessors that implement Ordered.
		List<BeanFactoryPostProcessor> orderedPostProcessors= new ArrayList<BeanFactoryPostProcessor>();
		for( String postProcessorName : orderedPostProcessorNames)
			orderedPostProcessors.add( createdPostProcessors.contains( postProcessorName) ?
					(BeanFactoryPostProcessor)beanF.getSingletonConcurrently( postProcessorName) :
					beanFactory.getBean( postProcessorName, BeanFactoryPostProcessor.class));
		OrderComparator.sort( orderedPostProcessors);
		invokeBeanFactoryPostProcessors( orderedPostProcessors, beanF);

		// Finally, invoke all other BeanFactoryPostProcessors.
		List<BeanFactoryPostProcessor> nonOrderedPostProcessors= new ArrayList<BeanFactoryPostProcessor>();
		for( String postProcessorName : nonOrderedPostProcessorNames)
			nonOrderedPostProcessors.add( createdPostProcessors.contains( postProcessorName) ?
					(BeanFactoryPostProcessor)beanF.getSingletonConcurrently( postProcessorName) :
					beanFactory.getBean( postProcessorName, BeanFactoryPostProcessor.class));
		invokeBeanFactoryPostProcessors( nonOrderedPostProcessors, beanF);
	}

	private void invokeBeanFactoryPostProcessors(
			Collection<? extends BeanFactoryPostProcessor> postProcessors, ConfigurableListableBeanFactory beanFactory)
	{
		for( BeanFactoryPostProcessor postProcessor : postProcessors)
			postProcessor.postProcessBeanFactory(beanFactory);
	}

	@Override
	protected void registerBeanPostProcessors( ConfigurableListableBeanFactory beanFactory)
	{
		SingletonThreadSafeListableBeanFactory beanF=
				(SingletonThreadSafeListableBeanFactory)( (ConfigurableListableBeanFactoryDelegate)beanFactory).getDelegate();
		String[] postProcessorNames= getBeanNamesForRegister( BeanPostProcessor.class, beanF, beanPostProcessorNames);

		// Register BeanPostProcessorChecker that logs an info message when
		// a bean is created during BeanPostProcessor instantiation, i.e. when
		// a bean is not eligible for getting processed by all BeanPostProcessors.
		int beanProcessorTargetCount= beanF.getBeanPostProcessorCount()+ 1+ postProcessorNames.length;
		beanF.addBeanPostProcessor( new BeanPostProcessorChecker( beanF, beanProcessorTargetCount));

		// Separate between BeanPostProcessors that implement PriorityOrdered,
		// Ordered, and the rest.
		List<BeanPostProcessor> priorityOrderedPostProcessors= new ArrayList<BeanPostProcessor>();
		List<BeanPostProcessor> internalPostProcessors= new ArrayList<BeanPostProcessor>();
		List<String> orderedPostProcessorNames= new ArrayList<String>();
		List<String> nonOrderedPostProcessorNames= new ArrayList<String>();
		for( String ppName : postProcessorNames)
		{
			if( priorityOrdereds.contains( ppName))
			{
				BeanPostProcessor pp= createdPostProcessors.contains( ppName) ?
						(BeanPostProcessor)beanF.getSingletonConcurrently( ppName) :
						beanFactory.getBean( ppName, BeanPostProcessor.class);
				priorityOrderedPostProcessors.add( pp);
				if( pp instanceof MergedBeanDefinitionPostProcessor)
					internalPostProcessors.add( pp);
			}
			else if( ordereds.contains( ppName))
				orderedPostProcessorNames.add( ppName);
			else
				nonOrderedPostProcessorNames.add( ppName);
		}

		// First, register the BeanPostProcessors that implement PriorityOrdered.
		OrderComparator.sort( priorityOrderedPostProcessors);
		registerBeanPostProcessors( beanFactory, priorityOrderedPostProcessors);

		// Next, register the BeanPostProcessors that implement Ordered.
		List<BeanPostProcessor> orderedPostProcessors = new ArrayList<BeanPostProcessor>();
		for( String ppName : orderedPostProcessorNames)
		{
			BeanPostProcessor pp= createdPostProcessors.contains( ppName) ?
					(BeanPostProcessor)beanF.getSingletonConcurrently( ppName) :
					beanFactory.getBean( ppName, BeanPostProcessor.class);
			orderedPostProcessors.add( pp);
			if( pp instanceof MergedBeanDefinitionPostProcessor)
				internalPostProcessors.add( pp);
		}
		OrderComparator.sort( orderedPostProcessors);
		registerBeanPostProcessors( beanFactory, orderedPostProcessors);

		// Now, register all regular BeanPostProcessors.
		List<BeanPostProcessor> nonOrderedPostProcessors= new ArrayList<BeanPostProcessor>();
		for( String ppName : nonOrderedPostProcessorNames)
		{
			BeanPostProcessor pp= createdPostProcessors.contains( ppName) ?
					(BeanPostProcessor)beanF.getSingletonConcurrently( ppName) :
					beanFactory.getBean( ppName, BeanPostProcessor.class);
			nonOrderedPostProcessors.add( pp);
			if( pp instanceof MergedBeanDefinitionPostProcessor)
				internalPostProcessors.add( pp);
		}
		registerBeanPostProcessors( beanFactory, nonOrderedPostProcessors);

		// Finally, re-register all internal BeanPostProcessors.
		OrderComparator.sort( internalPostProcessors);
		registerBeanPostProcessors( beanFactory, internalPostProcessors);
		beanF.addBeanPostProcessor( new ApplicationListenerDetector( this));
	}

