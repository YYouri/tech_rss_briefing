	public ApplicationContainer lookupApplicationContainer( ServletContext servletContext, URL configLocation)
	{
		ClassLoader currentLoader= Thread.currentThread().getContextClassLoader();
//		logger.debug( "classLoader is {}", ApplicationContainerLoader.class.getClassLoader());

		ContextClassLoaderWeakReference currentRef= new ContextClassLoaderWeakReference( currentLoader);
		FrameworkInstanceApplicationContainer container;
		BxmInstance conf;
		try{ conf= createConfigurationBindingObject( configLocation);}
		catch( Exception e)
		{
			logger.error( e.getMessage(), e);
			throw new IllegalArgumentException( "Invalid configuration for Framework instance");
		}

		synchronized( monitor)
		{
			container= (FrameworkInstanceApplicationContainer)currentContexts.get( currentRef);
			if( container!= null)
			{
				if( container.getFrameworkInstance().getName().equals( conf.getName()))
					return container;
				else
				{
					logger.warn( "created ApplicationContainer's name in current context is [{}].",
							container.getFrameworkInstance().getName());
					throw new IllegalStateException( "created ApplicationContainer's name in current context is "+
							container.getFrameworkInstance().getName());
				}
			}
			else
			{
				// associate
				for( Map.Entry<ContextClassLoaderWeakReference, ApplicationContainer> entry:
					ApplicationContainerLoader.currentContexts.entrySet())
				{
					FrameworkInstanceApplicationContainer managedContainer= (FrameworkInstanceApplicationContainer)entry.getValue();
					if( managedContainer.getFrameworkInstance().getName().equals( conf.getName()))
					{
						ApplicationContainerLoader.currentContextRefs.put(
								currentRef, new WeakReference<ApplicationContainer>( managedContainer));
						logger.info( "ApplicationContainer request associated with [{}]."+ entry.getKey());
						return managedContainer;
					}
				}

				// or create
				FrameworkInstance instance=
						FrameworkInstanceConfigurationManager.configure( servletContext, conf, deployRoot, true);
				container= new FrameworkInstanceApplicationContainer( instance);

				if( instance.getMessageService()!= null)
				{
					List<JmsMessageListener> jmsListeners= instance.getMessageService().getJmsMessageListeners();
					if( jmsListeners!= null && jmsListeners.size()> 0)
					{
						for( JmsMessageListener jmsListener: jmsListeners)
						{
							if( jmsListener.getServiceEndpoint()!=null)
							{
								jmsListener.getServiceEndpoint().setApplicationContainer( container);
								jmsListener.start();
							}
						}
					}

					List<MessageListenerServiceEndpoint> endpoints= instance.getMessageService().getMessageListenerServiceEndpoints();
					if( endpoints!= null && endpoints.size()> 0)
					{
						for( MessageListenerServiceEndpoint endpoint: endpoints)
							endpoint.setApplicationContainer( container);
					}
				}

				ApplicationContainerLoader.currentContexts.put( currentRef, container);
				logger.info( "ApplicationContainer with resource [{}] is created.", configLocation);
				return container;
			}
		}
	}
