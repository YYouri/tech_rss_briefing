public class DeployedResourceDefinitionScanner
{
	private Logger logger= LoggerFactory.getLogger( DeployedResourceDefinitionScanner.class);

//	private String resourcePattern= DeployedApplicationModel.DEFAULT_RESOURCE_PATTERN;

	private final List<TypeFilter> typeFilters= new LinkedList<TypeFilter>();

	private final List<ClassFileTransformer> managedServiceTransformers= new LinkedList<ClassFileTransformer>();
	private final ClassFileTransformer managedBeanTransformer= new ManagedBeanTransformer();

	private final Set<String> beanCandidateAnnotations= new HashSet<String>();

	private static final Class<? extends Annotation> SERVICEOPERATION_ANNOTATION_CLASS ;

	static
	{
		boolean useMainService = Boolean.parseBoolean(System.getProperty("bxm.use.mainservice", "true"));

		if (useMainService)
		{
			SERVICEOPERATION_ANNOTATION_CLASS = TRANID_ANNOTATION_CLASS;
		}
		else
		{
			SERVICEOPERATION_ANNOTATION_CLASS = AnnotatedConfig.SERVICEOPERATION_ANNOTATION_CLASS;
		}
	}

	@SuppressWarnings( "unchecked")
	public DeployedResourceDefinitionScanner( TransactionalServiceOperationTransfomer transformer)
	{
		beanCandidateAnnotations.add( "org.springframework.stereotype.Component");
		beanCandidateAnnotations.add( DataAccess.class.getName());
		beanCandidateAnnotations.add( BxmDataAccess.class.getName());

		typeFilters.add( new AnnotationTypeFilter( MANAGED_OBJECT_ANNOTATION_CLASS, true));
		typeFilters.add( new AnnotationMemberTypeFilter
				(
						transformer!= null ?
								new Class[]{ TRANSACTIONALOPERATION_ANNOTATION_CLASS, SERVICEOPERATION_ANNOTATION_CLASS} :
								new Class[]{ SERVICEOPERATION_ANNOTATION_CLASS},
				false));
		managedServiceTransformers.add( new ManagedServiceOperationTransfomer());
		if( transformer!= null)
			managedServiceTransformers.add( transformer);
	}

	public static String determineManagedName( Map<String, Object> attributes, String substitueName)
	{
		if( attributes== null || attributes.size()== 0)	return substitueName;
		Object value= null;
		String managedName= null;
		if( attributes.containsKey( ServiceDefinitions.VALUE_ATTRIBUTE_NAME))
			value= attributes.get( ServiceDefinitions.VALUE_ATTRIBUTE_NAME);
		managedName= value!= null && (value instanceof String) && StringUtils.hasText( value.toString()) ?
				value.toString() : null;
		if( attributes.containsKey( ServiceDefinitions.NAME_ATTRIBUTE_NAME))
			value= attributes.get( ServiceDefinitions.NAME_ATTRIBUTE_NAME);
		managedName= value!= null && (value instanceof String) && StringUtils.hasText( value.toString()) ?
				value.toString() : managedName;

		managedName= managedName!= null && StringUtils.hasText( managedName) ? managedName : substitueName;
		return managedName;
	}

	public void applyResourceManagedTransformer( final ServiceRegistry registry, final ClassLoaderRef loaderRef)
	{
		loaderRef.getClassLoader().setManagedResourceFilter( new InstrumentTargetFilter(){

			private final Set<String> knownNotInstrumentables= Collections.synchronizedSet( new HashSet<String>());

			private ResourceLoader resourceLoader= loaderRef.getResourceLoader();

			@Override
			public List<ClassFileTransformer> checkIfInstrumentable( String name)
			{
				try
				{
					if( this.knownNotInstrumentables.contains( name) || managedServiceTransformers.size()<= 0)
						return null;

					List<ClassFileTransformer> transformers= new LinkedList<ClassFileTransformer>();
					DeployedService cdef= null;
					MetadataReader reader= resourceLoader.readMetadataReaderOnce( name);
					if( !isCandidateManagedType( reader, resourceLoader)
							|| !isCandidateManagedType( reader.getAnnotationMetadata()))
					{
						this.knownNotInstrumentables.add( name);
						return null;
					}
					else
					{
						try{ cdef= AnnotatedDefinitionReader.defineAnnotatedResource( reader, registry);}
						catch( IOException e)
						{
							ApplicationResourceInitializer.logger.warn(
									"annotated resource [{}] definition reading is failed.", name, e);
						}

						// not service but managed resource ex) @BxmBean
						if( cdef== null)
						{
//							logger.debug( "not service but managed resource [{}].", name);
							String managedName= null;
							if (reader.getAnnotationMetadata().hasAnnotation(BEAN_OBJECT_ANNOTATION_CLASSNAME))
							{
								managedName = determineManagedName(
												reader.getAnnotationMetadata().getAnnotationAttributes( BEAN_OBJECT_ANNOTATION_CLASSNAME), name);

							}
							else
							{
								managedName = determineManagedName(
										reader.getAnnotationMetadata().getAnnotationAttributes( SUBSERVICE_OBJECT_ANNOTATION_CLASSNAME), name);
							}
							( (ManagedBeanTransformer)managedBeanTransformer).setManagedName( managedName);
							transformers.add( managedBeanTransformer);

//							logger.debug( "resource [{}] is instrumentable using [{}].", name, transformers);
							return transformers;
						}

//						logger.debug( "managed resource [{}], data [{}].", name, cdef);

						// managed resources @BxmService, include @TransactionalOperation
						if( cdef.isInstrumentable() || cdef.isExposed())
						{
							for( ClassFileTransformer transformer: managedServiceTransformers)
							{
								if( transformer instanceof ManagedServiceOperationTransfomer)
								{
									( (ManagedServiceOperationTransfomer)transformer).setServiceOperations( cdef.getOperations());
									( (ManagedServiceOperationTransfomer)transformer).setManagedName( cdef.getServiceName());
								}
								else if( transformer instanceof TransactionalServiceOperationTransfomer)
									( (TransactionalServiceOperationTransfomer)transformer).setTransactionInstrumentableMethods(
											cdef.getTransactionInstrumentableMethods());
								transformers.add( transformer);
							}
//							logger.debug( "resource [{}] is instrumentable using [{}].", name, transformers);
							return transformers;
						}
						return null;
					}
				}
				catch( Exception e)
				{
//					logger.warn( "[{}] is can not check for instrumentable classloader.", name);
					this.knownNotInstrumentables.add( name);
					return null;
				}
			}
		});
	}

	public Set<MetadataReader> scanResources( ServiceRegistry registry, final ClassLoaderRef loaderRef,
			boolean cacheIOProperties, ResourceLoader legacyLoader, Resource[] resources)
	{
		Assert.notNull( registry, "registry can not be null");
		Assert.notNull( loaderRef, "loaderRef can not be null");

		Set<MetadataReader> beanCandidates= new LinkedHashSet<MetadataReader>();
		collectBeanCandidates( registry, loaderRef, resources, beanCandidates, cacheIOProperties, legacyLoader);
//		for( MetadataReader candidate: beanCandidates)
//		logger.debug( "{}/{}", ( (ApplicationClassLoader)loaderRef.getClassLoader()).getApplicationName(), candidate.getResourceURI());

		return beanCandidates;
	}

	public Set<MetadataReader> scanResources( ServiceRegistry registry, final ClassLoaderRef loaderRef,
			boolean cacheIOProperties, ResourceLoader legacyLoader, String... basePackages)
			throws IOException
	{
		Assert.notNull( registry, "registry can not be null");
		Assert.notNull( loaderRef, "loaderRef can not be null");

		Set<MetadataReader> beanCandidates= new LinkedHashSet<MetadataReader>();

		ArrayList<String> postPatterns = getBasePackagePostPatterns();

		for( String basePackage: basePackages)
		{
			if (basePackage == null) continue;
			basePackage = basePackage.trim();
			if ("".equals(basePackage)) continue;

//			String path= ResourceLoader.CLASSPATH_ALL_URL_PREFIX+ resolveBasePackage( basePackage)+ "/"+ this.resourcePattern;

			for ( String postPattern: postPatterns)
			{
				String path= ResourceLoader.CLASSPATH_ALL_URL_PREFIX+ resolveBasePackage( basePackage)+ "/"+ postPattern;

				long now1 = System.currentTimeMillis();
				Resource[] resources= loaderRef.getResourceLoader().getLocalResources( path);
				long now2 = System.currentTimeMillis();
				long findTime = now2 - now1;
				collectBeanCandidates( registry, loaderRef, resources, beanCandidates, cacheIOProperties, legacyLoader);
				logger.debug( "scan-beans : path [{}] count[{}] time1 [{}] time2 [{}]", new Object[]{ path, (resources == null ? 0 : resources.length), findTime, (System.currentTimeMillis()-now2) });

			}
		}

		ArrayList<String> addPackages = getAddPackages();
		for ( String addPackage: addPackages)
		{
			String path= ResourceLoader.CLASSPATH_ALL_URL_PREFIX+ resolveBasePackage( addPackage)+ "/*.class";

			long now1 = System.currentTimeMillis();
			Resource[] resources= loaderRef.getResourceLoader().getLocalResources( path);
			long now2 = System.currentTimeMillis();
			long findTime = now2 - now1;
			collectBeanCandidates( registry, loaderRef, resources, beanCandidates, cacheIOProperties, legacyLoader);
			logger.debug( "scan-beans : path [{}] count[{}] time1 [{}] time2 [{}]", new Object[]{ path, (resources == null ? 0 : resources.length), findTime, (System.currentTimeMillis()-now2) });
		}

//		for( MetadataReader candidate: beanCandidates)
//			logger.debug( ">>{}", candidate.getResourceURL().toString());

		return beanCandidates;
	}

	private ArrayList<String> getBasePackagePostPatterns() {

		ArrayList<String> postPatterns = new ArrayList<String>();
		String postPatternStr = System.getProperty("bxm.system.online.base.packages.post.pattern");
		if (postPatternStr == null) {
			postPatterns.add("**/*.class");
		} else {
			String[] patterns = postPatternStr.split(",");
			if (patterns == null || patterns.length == 0) {
				postPatterns.add("**/*.class");
			} else {
				for (String pattern : patterns) {
					postPatterns.add(pattern);
				}
			}
		}
		return postPatterns;
	}

	private ArrayList<String> getAddPackages() {

		ArrayList<String> addPackages = new ArrayList<String>();

		if(!LApplicationContext.isBatchContext())
		{
			String addPackagesStr = System.getProperty("bxm.system.online.base.packages.added");
			if (addPackagesStr == null) {
			} else {
				String[] patterns = addPackagesStr.split(",");
				if (patterns == null || patterns.length == 0) {
				} else {
					for (String pattern : patterns) {
						addPackages.add(pattern);
					}
				}
			}
		}
		return addPackages;
	}

	private void collectBeanCandidates( ServiceRegistry registry, ClassLoaderRef loaderRef, Resource[] resources,
			Set<MetadataReader> beanCandidates, boolean cacheIOProperties, ResourceLoader legacyLoader)
	{
		List<Pattern> localPathPatterns= null;
		URL[] applocalpaths= null;
		if( legacyLoader!= null && ( applocalpaths= loaderRef.getClassLoader().getLocalApplicationClasspaths())!= null)
		{
			localPathPatterns= new ArrayList<Pattern>();
			for( URL applocalpath: applocalpaths)
			{
				if( applocalpath.toExternalForm().endsWith( DeployedApplicationModel.CLASSES_PATH_SUFFIX)
						|| applocalpath.toExternalForm().endsWith( DeployedApplicationModel.BIN_PATH_SUFFIX))
				{
					Pattern pattern= Pattern.compile( "("+ applocalpath.toExternalForm()+ ")(/)(.*)(.class)");
					localPathPatterns.add( pattern);
				}
			}
		}

		for( Resource resource: resources)
		{
//			logger.debug( "resource [{}/{}] scanned.", resource.getFileName(), resource.getClass().getName());

			if( !resource.isReadable()) continue;
			DeployedService def= null;
			MetadataReader reader= null;
			String className= null;

			URL resourceUrl= null;
			Long lastModified= null;
			try
			{
				resourceUrl= resource.getURL();
				lastModified= resource.lastModified();
			}catch( IOException ioe){}

			if( resourceUrl!= null && localPathPatterns!= null)
			{
				try
				{
					for( Pattern pathPattern: localPathPatterns)
					{
						Matcher matcher= pathPattern.matcher( resourceUrl.toExternalForm());
						if( matcher.matches())
						{
							className= ClassUtils.convertResourcePathToClassName( matcher.replaceFirst( "$3"));
							MetadataReader cached= legacyLoader.removeMetadataReaderCache( className);
							if( cached!= null && cached.lastModified()!= null && lastModified!= null
									&& cached.lastModified().equals( lastModified))
							{
//								logger.debug(  "cached found {}/{}", lastModified, resourceUrl.toExternalForm());
								reader= cached;
								reader.setResourceURL( resource.getURL());
								loaderRef.getResourceLoader().putMetadataReader( className, reader);
								break;
							}
						}
					}
				}
				catch( Throwable th){}
			}

			if( reader== null)
			{
				try{ reader= loaderRef.getResourceLoader().getMetadataReader( resource);}
				catch( Throwable th)
				{
					ApplicationResourceInitializer.logger.warn( "metadata reading for resource [{}] is failed.",
							resourceUrl!= null ? resourceUrl : resource.getFileName(), th);
					continue;
				}
			}

			if( registry instanceof Application && IOmmTypeUtils.isOmmType( loaderRef.getResourceLoader(), reader))
			{
				loaderRef.getResourceLoader().removeMetadataReaderCache( resource);
				continue;
			}

			if( !isCandidateManagedType( reader, loaderRef.getResourceLoader())
					|| !isCandidateManagedType( reader.getAnnotationMetadata()))
			{
				boolean additionalChecked= false;
				for( String candidateAnnotattion: this.beanCandidateAnnotations)
				{
					if( reader.getAnnotationMetadata().hasAnnotation( candidateAnnotattion)
							|| reader.getAnnotationMetadata().hasMetaAnnotation( candidateAnnotattion))
					{
						beanCandidates.add( reader);
						additionalChecked= true;
						break;
					}
				}
				if( !additionalChecked)
					loaderRef.getResourceLoader().removeMetadataReaderCache( resource);
				continue;
			}

			beanCandidates.add( reader);

//			logger.debug( "resource [{}] will be defined.", resource.getURL().toExternalForm());
			try
			{
				def= AnnotatedDefinitionReader.defineAnnotatedResource( reader, registry);
				//[[ 20171109 define동작과 registry에 등록하는 동작을 분리함.
				//   이유는 AnnotatedDefinitionReader.defineAnnotatedResource를
				//   collectBeanCandidates와 applyResourceManagedTransformer 메소드에서 호출하는 데
				//   applyResourceManagedTransformer와 이미 등록된 상태에서 DeployedService객체만 필요하기 때문임..
				registerService(registry, def, reader.getClassMetadata().getClassName());
				//]]
			}
			catch( IOException e)
			{
				ApplicationResourceInitializer.logger.warn( "annotated resource[{}] definition is failed.",
						new Object[]{ resourceUrl!= null ? resourceUrl : resource.getFileName(), e});
			}

			if( def!= null)
			{
				def.setClassName( reader.getClassMetadata().getClassName());
//				logger.debug( "cacheiop {}", cacheIOProperties);
				if( cacheIOProperties)
				{
					for( ServiceOperation operation: def.getOperations().values())
					{
						if( StringUtils.hasText( operation.getInputTypeName())
								&& !( (Application)registry).getIommFieldProperties().hasFieldDescriptors(
										operation.getInputTypeName()))
						{
//							logger.debug( "cache IO Properties for [{}].", operation.getInputTypeName());
							try
							{
								String inputTypeName=
										ResourceUtils.CLASSPATH_URL_PREFIX+
										ClassUtils.convertClassNameToResourcePath( operation.getInputTypeName())+
										ClassUtils.CLASS_FILE_SUFFIX;
								byte[] classbytes= ClassResourceReader.readClassResource(
										loaderRef.getResourceLoader().getResource( inputTypeName).getInputStream());
								if( classbytes.length< 8) throw new IOException( "insufficient class bytes length.");
								ClassReader clsReader= new ClassReader( classbytes);
								clsReader.accept( new IOmmTypeClassVisitor( loaderRef.getResourceLoader(),
												( (Application)registry).getIommFieldProperties(), null),
										ClassReader.SKIP_DEBUG | ClassReader.SKIP_FRAMES);
							}
							catch( Throwable th)
							{
								/*logger.error( th.getMessage(), th);*/
								ApplicationResourceInitializer.logger.warn(
										"invalid input type[{}] resource.", operation.getInputTypeName(), th);
							}
						}

						if( StringUtils.hasText( operation.getOutputTypeName()) &&  Type.VOID_TYPE!= operation.getReturnType()
								&& !( (Application)registry).getIommFieldProperties().hasFieldDescriptors(
										operation.getOutputTypeName()))
						{
//							logger.debug( "cache IO Properties for [{}].", operation.getOutputTypeName());
							try
							{
								String outputTypeName= ResourceUtils.CLASSPATH_URL_PREFIX+
										ClassUtils.convertClassNameToResourcePath( operation.getOutputTypeName())+
										ClassUtils.CLASS_FILE_SUFFIX;
								byte[] classbytes= ClassResourceReader.readClassResource(
										loaderRef.getResourceLoader().getResource( outputTypeName).getInputStream());
								if( classbytes.length< 8) throw new IOException( "insufficient class bytes length.");
								ClassReader clsReader= new ClassReader( classbytes);
								clsReader.accept( new IOmmTypeClassVisitor( loaderRef.getResourceLoader(),
												( (Application)registry).getIommFieldProperties(), null),
										ClassReader.SKIP_DEBUG | ClassReader.SKIP_FRAMES);
							}
							catch( Throwable th)
							{
								/*logger.error( th.getMessage(), th);*/
								ApplicationResourceInitializer.logger.warn(
										"invalid output type[{}] resource.", operation.getOutputTypeName(), th);
							}
						}
					}
				}
			}
		}
	}

	/**
	 * @param registry
	 * @param def
	 * @param reader
	 */
	private void registerService(ServiceRegistry registry, DeployedService def, String classname) {
		if( def!= null && def.isExposed() && registry!= null)
		{
			registry.registerService( def.getServiceName(), def);

			Map<String, ServiceOperation> operationMap = def.getOperations();
			for (Entry<String, ServiceOperation> operationEntry : operationMap.entrySet())
			{
				String operationName = operationEntry.getKey();
				ServiceOperation serviceOperation = operationEntry.getValue();
//				logger.debug("Operation-[{}][{}][{}][{}]", new Object[]{serviceOperation.getApplicationName(), serviceOperation.getServiceName(), serviceOperation.getOperationName(), serviceOperation.getInputTypeName()});
				if (registry.checkIfServiceOperationRegistered(operationName))
				{
					try
					{
						ServiceOperation registered = registry.lookupServiceOperation(operationName);
						String rServiceInfoStr = getServiceInfoStr(registered);
						String sServiceInfoStr = getServiceInfoStr(serviceOperation);
						if (rServiceInfoStr.equalsIgnoreCase(sServiceInfoStr))
						{
							// 중복 scan하는 경우가 있으므로 application, service, operation이 같으면 무시한다.
							continue;
						}
						logger.warn( "OperationName [{}] is already registered, so this operation is ignored. Already registered operation {}",
								operationName, registered);

						if (!registry.checkIfServiceOperationDuplicated(operationName))
							registry.registerDuplicatedServiceOperation(operationName, registered);

						registry.registerDuplicatedServiceOperation(operationName, serviceOperation);

					}
					catch (ServiceOperationNotFoundException e) {}

					continue;
				}

				registry.registerServiceOperation(operationName, serviceOperation);
			}


			Map<String, List<ServiceOperation>> duplicatedOperationMap = def.getDuplicatedOperations();
			if (duplicatedOperationMap != null)
			{

				for (Entry<String, List<ServiceOperation>> dupOpListEntry : duplicatedOperationMap.entrySet())
				{
					String operationName = dupOpListEntry.getKey();
					List<ServiceOperation> dupOpList =  dupOpListEntry.getValue();

					for (ServiceOperation serviceOperation : dupOpList)
					{
						try
						{
							ServiceOperation registered = registry.lookupServiceOperation(operationName);
							String rServiceInfoStr = getServiceInfoStr(registered);
							String sServiceInfoStr = getServiceInfoStr(serviceOperation);
							if (rServiceInfoStr.equalsIgnoreCase(sServiceInfoStr))
							{
								// 중복 scan하는 경우가 있으므로 application, service, operation이 같으면 무시한다.
								continue;
							}
							
							logger.warn( "OperationName [{}] is already registered, so this operation is ignored. Already registered operation {}",
									operationName, registered);

							if (!registry.checkIfServiceOperationDuplicated(operationName))
								registry.registerDuplicatedServiceOperation(operationName, registered);

							registry.registerDuplicatedServiceOperation(operationName, serviceOperation);

						}
						catch (ServiceOperationNotFoundException e) {}

					}

				}
			}
		}

	}

	private String getServiceInfoStr(ServiceOperation operation) {
		StringBuilder buffer = new StringBuilder();
		buffer.append(operation.getApplicationName()).append("_");
		buffer.append(operation.getServiceName()).append("_");
		buffer.append(operation.getOperationName()).append("_");
		buffer.append(operation.getInputTypeName()).append("_");
		return buffer.toString();
	}

	private boolean isCandidateManagedType( MetadataReader reader, ResourceLoader resourceLoader)
	{
		for( TypeFilter filter: this.typeFilters)
		{
			try
			{
				if( filter.match( reader, resourceLoader))
					return true;
			}
			catch( IOException e)
			{
				return false;
			}
		}
		return false;
	}

	private boolean isCandidateManagedType( AnnotationMetadata metadata)
	{
		return metadata.isConcrete() && metadata.isIndependent();
	}

	private String resolveBasePackage( String base)
	{
		return ClassUtils.convertClassNameToResourcePath( SystemPropertyUtils.resolvePlaceholders( base, true));
	}

