	private void prepareApplications( Map<String, DeployedApplication> toDeployApps, final List<String> basePackages)
	{
		ThreadFactory prepareTaskFactory= NamedExecutors.namedPrivilegedThreadFactory( "autoDeployTask");

		int parallels= toDeployApps.size();
		if( !initDeployed)
			parallels= this.applicationLoader.getDeployerInitLimit()> 0
					&& parallels> this.applicationLoader.getDeployerInitLimit() ?
					this.applicationLoader.getDeployerInitLimit() : parallels;
		else
			parallels= this.applicationLoader.getDeployerProcLimit()> 0
					&& parallels> this.applicationLoader.getDeployerProcLimit() ?
					this.applicationLoader.getDeployerProcLimit() : parallels;

		ExecutorService eservice= Executors.newFixedThreadPool( parallels, prepareTaskFactory);

		try
		{
			final CountDownLatch start= new CountDownLatch( 1);
			final CountDownLatch finish= new CountDownLatch( toDeployApps.size());

			final Object initializationLock= new Object();
			for( DeployedApplication application: toDeployApps.values())
			{
				final DeployedApplication target= application;
				final ServletContext targetContext= this.servletContext;
				final Object targetLock= this.singletonLock;
				eservice.execute( new Runnable(){
					public void run()
					{
						try{ start.await(); }
						catch( InterruptedException e){ logger.error( e.getMessage(), e);}

						try
						{
							ResourceLoader legacyLoader= null;
							DeployedApplication das= null;
							if( !batch && HOT== FrameworkInstance.this.applicationLoader.getLoadingMode()
									&& ( das= FrameworkInstance.this.deployedApplications.get( target.getApplicationName()))!= null)
							{
								das.getLightweightApplicationContext().interruptedDeferredInstantiate();
								legacyLoader= das.getClassLoaderRef().getResourceLoader();
							}
							target.prepare( FrameworkInstance.this, targetContext, targetLock, initializationLock,
									legacyLoader, basePackages);
						}
						catch( Throwable th)
						{ logger.error( "application [{}] preparation is failed.", new Object[]{ target.getApplicationName(), th});}
						finally{ finish.countDown();}
					}
				});
			}
			start.countDown();
			try{ finish.await(); }
			catch( InterruptedException e){ logger.error( e.getMessage(), e);}
		}
		finally
		{
			initDeployed= true;
			if( eservice!= null) eservice.shutdown();
		}
	}

	private Map<BxmApplication, File> loadApplicationConfs( File apphome, File excludeApplicationLocation)
	{
		Map<BxmApplication,File> confs= new HashMap<BxmApplication,File>();
		File[] entries= apphome.listFiles();
		for( File entry: entries)
		{
			if( entry.equals( excludeApplicationLocation)) continue;
			if( entry.getName().toLowerCase().endsWith( ".svn"))	continue;
			File parFile= new File( apphome.getAbsolutePath()+ File.separator+ entry.getName()+ BXM_ARCHIVE_SUFFIX);
			File metaFile= null;
			JarFile parEntry= null;
			ZipEntry metaEntry= null;

			if( entry.isDirectory() && entry.getName().equals( EXTRACTED_PATH_SUFFIX))	continue;

			if( entry.isDirectory() && ( metaFile= new File( entry, APPLICATION_DD_FILE)).exists() && !parFile.exists())
			{
				try
				{
					BxmApplication conf= marshallApplicationDescriptor( metaFile);
					if( conf== null)	continue;
					confs.put( conf, entry);
				}
				catch( Exception e)
				{
					logger.warn( e.getMessage(), e);
					continue;
				}
			}
			// else packaged par application
			else if( entry.isFile() && entry.getName().endsWith( BXM_ARCHIVE_SUFFIX))
			{
				InputStream inStream= null;
				try
				{
					metaEntry= ( parEntry= new JarFile( entry)).getEntry( APPLICATION_DD_FILE);
					if( metaEntry== null) continue;
					inStream= parEntry.getInputStream( metaEntry);
					BxmApplication conf= marshallApplicationDescriptor( inStream);
					if( conf== null) continue;
					confs.put( conf, entry);
				}
				catch( Exception e)
				{
					logger.warn( e.getMessage(), e);
					continue;
				}
				finally
				{
					if( inStream!= null) try{ inStream.close();}catch( Exception e){}
				}
			}
		}

		return confs;
	}

	private InputStream findApplicationConfigurationFromArchive( File archive) throws Exception
	{
		JarInputStream inStream= null;
		JarEntry je= null;

		try
		{
			inStream= new JarInputStream( new FileInputStream( archive));
			while( ( je= inStream.getNextJarEntry())!= null)
			{
				if( !je.isDirectory() && je.getName().endsWith( "/"+ APPLICATION_DD_FILENAME))
				{
					ByteArrayOutputStream bout= new ByteArrayOutputStream();
					int bLen= 0;
					byte[] record= new byte[BUFFER_SIZE];
					do
					{
						bLen= inStream.read( record);
						if( bLen> 0)	bout.write( record, 0, bLen);
					}
					while( bLen!= -1);
					bout.flush(); bout.close();

					return new ByteArrayInputStream( bout.toByteArray());
				}
			}

			return null;
		}
		finally
		{
			inStream.close();
		}
	}

	private void checkReferenceApplications(
			BxmApplication toCheck, Map<String,BxmApplication> candidates, Set<BxmApplication> toDeploys)
	{
		if( candidates== null || candidates.size()<= 0)
			return;

		String[] currentRefTos=
				StringUtils.hasText( toCheck.getReferenceApplications()) ?
						StringUtils.tokenizeToStringArray( toCheck.getReferenceApplications(), ",") : new String[]{};

		for( String referenceTo: currentRefTos)
		{
			if( candidates.keySet().contains( referenceTo))
			{
				BxmApplication refConf= candidates.remove( referenceTo);
				if( refConf!= null)
				{
					toDeploys.add( refConf);
					checkReferenceApplications( refConf, candidates, toDeploys);
				}
			}
		}
	}

