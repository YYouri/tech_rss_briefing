	@Override
	public Resource getResource( String path)
	{
		Assert.notNull( path, "requested resource path can not be null.");
		if( path.startsWith( CLASSPATH_URL_PREFIX))
			return new ClassPathResource( path.substring( CLASSPATH_URL_PREFIX.length()), getClassLoader());
		else
		{
			try
			{
				if( path.startsWith( ResourceUtils.URL_PROTOCOL_PAR))
					return new URLResource( new URL( null, path, new ParURLStreamHandler()));
				else
					return new URLResource( new URL( path));
			}
			catch( MalformedURLException e)
			{
				return getResouceByPath( path);
			}
		}
	}

	protected Resource getResouceByPath( String path)
	{
		return new ClassPathContextResource( path, getClassLoader());
	}

	@Override
	public Resource[] getLocalResources( String pathPattern) throws IOException
	{
		Assert.notNull( pathPattern, "pathPattern can not be null.");
		if( pathPattern.startsWith( CLASSPATH_ALL_URL_PREFIX))
		{
			if( getPathMatcher().isPattern( pathPattern.substring( CLASSPATH_ALL_URL_PREFIX.length())))
				return findPathMatchingLocalResources( pathPattern);
			else
				return findLocalResources( pathPattern.substring( CLASSPATH_ALL_URL_PREFIX.length()));
		}
		else
		{
			int prefixEnd= pathPattern.indexOf( ":")+ 1;
			if( getPathMatcher().isPattern( pathPattern.substring( prefixEnd)))
				return findPathMatchingLocalResources( pathPattern);
			else
				return new Resource[]{ getResource( pathPattern) };
		}
	}

	@Override
	public Resource[] getResources( String pathPattern) throws IOException
	{
		Assert.notNull( pathPattern, "pathPattern can not be null.");
		if( pathPattern.startsWith( CLASSPATH_ALL_URL_PREFIX))
		{
			if( getPathMatcher().isPattern( pathPattern.substring( CLASSPATH_ALL_URL_PREFIX.length())))
				return findPathMatchingResources( pathPattern);
			else
				return findAllClassPathResources( pathPattern.substring( CLASSPATH_ALL_URL_PREFIX.length()));
		}
		else
		{
			int prefixEnd= pathPattern.indexOf( ":")+ 1;
			if( getPathMatcher().isPattern( pathPattern.substring( prefixEnd)))
				return findPathMatchingResources( pathPattern);
			else
				return new Resource[]{ getResource( pathPattern) };
		}
	}

	protected Resource[] findPathMatchingLocalResources( String pathPattern) throws IOException
	{
		String rootDirPath= determineRootDir( pathPattern);
		String subPattern= pathPattern.substring( rootDirPath.length());
		Resource[] rootDirResources= getLocalResources( rootDirPath);
		Set<Resource> result= new LinkedHashSet<Resource>( 16);

		for( int i= 0; i< rootDirResources.length; i++)
		{
			if(  isJarResource( rootDirResources[i]) || isParResource( rootDirResources[i]))
				result.addAll( doFindPathMatchingJarResources( rootDirResources[i], subPattern));
			else
				result.addAll( doFindPathMatchingFileResources( rootDirResources[i], subPattern));
		}
//		logger.debug( "Resolved pattern [{}] to resources {}", new Object[]{pathPattern, result.size()});
		return (Resource[])result.toArray( new Resource[result.size()]);
	}

	protected Resource[] findPathMatchingResources( String pathPattern) throws IOException
	{
		String rootDirPath= determineRootDir( pathPattern);
		String subPattern= pathPattern.substring( rootDirPath.length());
		Resource[] rootDirResources= getResources( rootDirPath);
		Set<Resource> result= new LinkedHashSet<Resource>( 16);

		for( int i= 0; i< rootDirResources.length; i++)
		{
			if( isJarResource( rootDirResources[i]) || isParResource( rootDirResources[i]))
				result.addAll( doFindPathMatchingJarResources( rootDirResources[i], subPattern));
			else
				result.addAll( doFindPathMatchingFileResources( rootDirResources[i], subPattern));
		}
//		logger.debug( "Resolved pattern [{}] to resources {}", new Object[]{pathPattern, result.size()});
		return (Resource[])result.toArray( new Resource[result.size()]);
	}

	protected Resource[] findLocalResources( String path) throws IOException
	{
		if( path.startsWith( "/")) path= path.substring( 1);
		Enumeration<URL> urls= null;
		ClassLoader loader= getClassLoader();
		if( loader instanceof AbstractApplicationClassLoader)
			urls= ( (AbstractApplicationClassLoader)loader).getApplicationResources( path);
		else
			urls= loader.getResources( path);

		Set<Resource> results= new LinkedHashSet<Resource>( 16);
		while( urls.hasMoreElements())
		{
			URL url= urls.nextElement();
			results.add( convertClassLoaderURL( url));
		}
		return (Resource[])results.toArray( new Resource[results.size()]);
	}

	protected Resource[] findAllClassPathResources( String path) throws IOException
	{
		if( path.startsWith( "/")) path= path.substring( 1);
		Enumeration<URL> urls= null;
		ClassLoader loader= getClassLoader();

		if( loader instanceof ApplicationClassLoader)
			urls= ( (ApplicationClassLoader)loader).getCurrentLoaderResources( path);
		else
			urls= loader.getResources( path);

		Set<Resource> results= new LinkedHashSet<Resource>( 16);
		while( urls.hasMoreElements())
		{
			URL url= urls.nextElement();
			results.add( convertClassLoaderURL( url));
		}
		return (Resource[])results.toArray( new Resource[results.size()]);
	}

	protected Set<Resource> doFindPathMatchingJarResources( Resource rootDirResource, String subPattern) throws IOException
	{
		URLConnection con= rootDirResource.getURL().openConnection();
		JarFile jarFile= null;
		String jarFileUrl= null;
		String rootEntryPath= null;
		Enumeration<JarEntry> jarEntries= null;
		boolean newJarFile=false;

		if( con instanceof JarURLConnection)
		{
			JarURLConnection jarCon= (JarURLConnection)con;
			jarCon.setUseCaches( false);
			jarFile= jarCon.getJarFile();
			jarEntries= jarFile.entries();
			jarFileUrl= jarCon.getJarFileURL().toExternalForm();
			JarEntry jarEntry= jarCon.getJarEntry();
			rootEntryPath= (jarEntry!= null ? jarEntry.getName() : "");
		}
		else if( con instanceof ParURLConnection)
		{
			ParURLConnection parCon= (ParURLConnection)con;
			parCon.setUseCaches( false);
			jarFile= parCon.getParFile();
			jarEntries= parCon.entries();
			jarFileUrl= parCon.getParFileURL().toExternalForm();

			if( parCon.getParFileURL().getFile().endsWith( ResourceUtils.URL_PROTOCOL_JAR))
			{
				rootEntryPath= rootDirResource.getURL().getFile().substring( parCon.getParFileURL().getFile().length());
				rootEntryPath= rootEntryPath.startsWith( "!") ? rootEntryPath.substring( 1) : rootEntryPath;
				rootEntryPath= rootEntryPath.startsWith( "/") ? rootEntryPath.substring( 1) : rootEntryPath;
			}
			else
				rootEntryPath= ( parCon.getParEntry()!= null ? parCon.getParEntry().getName() : "");
		}
		else
		{
			String urlFile= rootDirResource.getURL().getFile();
			int separatorIdx= urlFile.indexOf( ResourceUtils.JAR_URL_SEPARATOR);
			if( separatorIdx!= -1)
			{
				jarFileUrl= urlFile.substring( 0, separatorIdx);
				rootEntryPath= urlFile.substring( separatorIdx+ ResourceUtils.JAR_URL_SEPARATOR.length());
				jarFile= getJarFile( jarFileUrl);
				jarEntries= jarFile.entries();
			}
			else
			{
				jarFile= new JarFile( urlFile);
				jarEntries= jarFile.entries();
				jarFileUrl= urlFile;
				rootEntryPath= "";
			}
			newJarFile= true;
		}

		try
		{
			if( !"".equals( rootEntryPath) && !rootEntryPath.endsWith( "/"))
				rootEntryPath= rootEntryPath+ "/";
			Set<Resource> results= new LinkedHashSet<Resource>(8);
			for( Enumeration<JarEntry> entries= jarEntries; entries.hasMoreElements();)
			{
				JarEntry entry= entries.nextElement();
				String entryPath= entry.getName();
				if( entryPath.startsWith( rootEntryPath))
				{
					String relativePath= entryPath.substring( rootEntryPath.length());
					if( getPathMatcher().match( subPattern, relativePath))
						results.add( rootDirResource.createRelative( relativePath));
				}
			}
			return results;
		}
		finally
		{
			if( newJarFile)
				jarFile.close();
			if( jarEntries instanceof ParEnumeration)
				( (ParEnumeration<JarEntry>)jarEntries).disconnect();
		}
	}

	protected boolean isJarResource( Resource rsc) throws IOException
	{
		return ResourceUtils.isJarURL( rsc.getURL());
	}

	protected boolean isParResource( Resource rsc) throws IOException
	{
		return rsc.getURL().getProtocol().equals( ResourceUtils.URL_PROTOCOL_PAR);
	}

	protected JarFile getJarFile( String jarFileUrl) throws IOException
	{
		if( jarFileUrl.startsWith( ResourceUtils.FILE_URL_PREFIX))
		{
			try
			{
				return new JarFile( ResourceUtils.toURI( jarFileUrl).getSchemeSpecificPart());
			}
			catch( URISyntaxException e)
			{
				return new JarFile( jarFileUrl.substring( ResourceUtils.FILE_URL_PREFIX.length()));
			}
		}
		else
		{
			return new JarFile( jarFileUrl);
		}
	}

	protected Set<Resource> doFindPathMatchingFileResources( Resource rootDirResource, String subPattern) throws IOException
	{
		File rootDir= null;
		try{ rootDir= rootDirResource.getFile().getAbsoluteFile();}
		catch( IOException e)
		{
			logger.warn(
					"Cannot search for matching files unerneath [{}] " +
					"because it does not correspond to a directory in the file system.", new Object[]{ rootDirResource, e});
		}
		return doFindMatchingFileSystemResources( rootDir, subPattern);
	}

	protected Set<Resource> doFindMatchingFileSystemResources( File rootDir, String subPattern) throws IOException
	{
//		logger.debug( "looking for matching resources in directory tree [{}].", rootDir.getPath());
		Set<File> matchingFiles= retrieveMatchingFiles( rootDir, subPattern);
		Set<Resource> results= new LinkedHashSet<Resource>( matchingFiles.size());
		for( File file: matchingFiles)
			results.add( new FileSystemResource( file));
		return results;
	}

	protected Set<File> retrieveMatchingFiles( File rootDir, String pattern) throws IOException
	{
		if( !rootDir.isDirectory())
			throw new IllegalArgumentException( "Resource path ["+ rootDir+ "] does not denote a directory");

		String fullPattern= StringUtils.replace( rootDir.getAbsolutePath(), File.separator, "/");

		if( !pattern.startsWith( "/"))
			fullPattern+= "/";

		fullPattern= fullPattern + StringUtils.replace( pattern, File.separator, "/");
		Set<File> result= new LinkedHashSet<File>( 8);
		doRetrieveMatchingFiles( fullPattern, rootDir, result);
		return result;
	}

	protected void doRetrieveMatchingFiles( String fullPattern, File dir, Set<File> result) throws IOException
	{
//		logger.debug( "searching directory[{}] for files matching pattern [{}]", new Object[]{dir.getAbsolutePath(), fullPattern});

		File[] dirContents= dir.listFiles();
		if( dirContents== null)
			throw new IOException( "Could not retrieve contents of directory ["+ dir.getAbsolutePath()+ "]");

		for( int i= 0; i< dirContents.length; i++)
		{
			File content= dirContents[i];
			if( content.isDirectory() && content.getName().endsWith( ".svn")) continue;
			String currPath= StringUtils.replace( content.getAbsolutePath(), File.separator, "/");
			if( content.isDirectory() && getPathMatcher().matchStart( fullPattern, currPath+ "/"))
				doRetrieveMatchingFiles( fullPattern, content, result);
			if( getPathMatcher().match( fullPattern, currPath))
				result.add( content);
		}
	}

	protected String determineRootDir( String path)
	{
		int prefixEnd= path.indexOf( ":")+ 1;
		int rootDirEnd= path.length();
		while( rootDirEnd> prefixEnd && getPathMatcher().isPattern( path.substring( prefixEnd, rootDirEnd)))
			rootDirEnd= path.lastIndexOf( '/', rootDirEnd- 2)+ 1;

		if( rootDirEnd== 0) rootDirEnd= prefixEnd;
		return path.substring( 0, rootDirEnd);
	}

	protected Resource convertClassLoaderURL( URL url)
	{
		return new URLResource( url);
	}

	@Override
	public void putMetadataReader( String clsName, MetadataReader reader)
	{
		this.metadataReaderCacheByClassName.put( clsName, reader);
	}

	@Override
	public MetadataReader readMetadataReaderOnce( String clsName) throws IOException
	{
		synchronized( this.metadataReaderLRUCache)
		{
			MetadataReader reader= null;
			if( ( reader= this.metadataReaderLRUCache.get( clsName))!= null)
				return reader;
			else
			{
				String resourcePath=
						ResourceUtils.CLASSPATH_URL_PREFIX+
						ClassUtils.convertClassNameToResourcePath( clsName)+
						ClassUtils.CLASS_FILE_SUFFIX;
				Resource resource= getResource( resourcePath);
				Long lastModified= null;
				try{ lastModified= resource.lastModified();}catch( Throwable th){}
				byte[] classbytes= ClassResourceReader.readClassResource( resource.getInputStream());
				if( classbytes.length< 8) throw new IOException( "insufficient class bytes length.");
				ClassReader clsReader= new ClassReader( classbytes);
				reader= new MetadataReader( resource.getURL(), clsReader, this.classLoader.get(), lastModified);

				if( this.metadataReaderLRUCache.size()>= instrumentableMetadataCachesize)
					this.metadataReaderLRUCache.remove( this.metadataReaderLRUCache.keySet().iterator().next());
				this.metadataReaderLRUCache.put( clsName, reader);
				return reader;
			}
		}
	}

	public ClassReader getCachedClassReader( String path, ClassLoader classLoader) throws IOException
	{
		synchronized( this.classReaderLRUCache)
		{
			ClassReader reader= null;
			if( ( reader= this.classReaderLRUCache.get( path))!= null)
				return reader;
			else
			{
				byte[] classbytes= ClassResourceReader.readClassResource( classLoader.getResourceAsStream(
						path+ ClassUtils.CLASS_FILE_SUFFIX));
				if( classbytes.length< 8) throw new IOException( "insufficient class bytes length.");
				reader= new ClassReader( classbytes);
				if( this.classReaderLRUCache.size()>= classTransformerMetadataCachesize)
					this.classReaderLRUCache.remove( this.classReaderLRUCache.keySet().iterator().next());
				this.classReaderLRUCache.put( path, reader);
				return reader;
			}
		}
	}

