	/**
	 * 파라미터로 받은 prev, current 값을 이용하여 FQCN 값을 반환한다.<br>
	 * prev += FQCN_DELIMITER + current
	 *
	 * @param prev
	 * @param current
	 * 
	 * @return String
	 */
	public static String getFqcn(String prev, String current) {
		if (StringUtils.isNotEmpty(prev)) {
			return prev + FQCN_DELIMITER + current;
		} else {
			return current;
		}
	}

