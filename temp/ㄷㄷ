function onCheck(e, treeId, treeNode) {
	zTree = $.fn.zTree.getZTreeObj("treeDemo");
	nodes = zTree.getSelectedNodes();
	v = "";
	nodeArray = [];
	var type;
	
	if(nodes[0].isFile == false && $('input:radio[name="uploadType"]:checked').val() == 'fileUpload'){
		v = getTreeInfo(nodes, nodeArray, zTree, v);
