	public synchronized void deployApplicationCandicates( File appHome, File applicationLocation, List<String> basePackages)
			throws ApplicationTargetException
	{
		deployApplicationCandicates( appHome, applicationLocation, basePackages, false);
	}

	/**
	 * for stand-alone batch instance
	 * initial deploy application with dependencies in <code>appHome</code>
	 * @param appHome
	 * @param applicationLocation
	 * @param basePackageFilters
	 * @param withDependon
	 * @throws ApplicationTargetException
	 */
	public synchronized void deployApplicationCandicates(
			File appHome, File applicationLocation, Set<BasePackageFilter> basePackageFilters, boolean withDependon)
			throws ApplicationTargetException
	{
		Map<String, DeployedApplication> deployedApps= prepareDeployedApplications( appHome, applicationLocation);

		Set<String> basePackages= new HashSet<String>();
		PathMatcher pathMatcher= new AntPathMatcher();

		if( basePackageFilters== null) basePackageFilters= new HashSet<BasePackageFilter>();
		Map<String, BasePackageFilter> scannerSupportBasePackageFilters= null;
		if( this.scannerSupport!= null
				&& ( scannerSupportBasePackageFilters= this.scannerSupport.getBasePackagefBasePackageFilters())!= null
				&& scannerSupportBasePackageFilters.size()> 0)
		{
			for( BasePackageFilter basePackageFilter: basePackageFilters)
			{
				BasePackageFilter scannerSupportBasePackageFilter= null;
				if( ( scannerSupportBasePackageFilter=
						scannerSupportBasePackageFilters.remove( basePackageFilter.getBasePackagePattern()))!= null)
				{
					for( String includePattern: scannerSupportBasePackageFilter.getIncludeClassNamePatterns())
						basePackageFilter.addIncludeClassNamePattern( includePattern);
					for( String excludePattern: scannerSupportBasePackageFilter.getExcludeClassNamePatterns())
						basePackageFilter.addExcludeClassNamePattern( excludePattern);
				}
			}

			basePackageFilters.addAll( scannerSupportBasePackageFilters.values());
		}

		if( deployedApps.size()> 0 && basePackageFilters!= null)
		{
			for( BasePackageFilter basePackageFilter: basePackageFilters)
			{
				String path= CLASSPATH_ALL_URL_PREFIX+ ClassUtils.convertClassNameToResourcePath(
						SystemPropertyUtils.resolvePlaceholders( basePackageFilter.getBasePackagePattern(), true))+
						"/"+ DEFAULT_RESOURCE_PATTERN;
				basePackages.add( basePackageFilter.getBasePackagePattern());
				try
				{
					Set<String> loadedClasses= new HashSet<String>();

					for( DeployedApplication depApp: deployedApps.values())
					{
						Resource[] resources= depApp.getClassLoaderRef().getResourceLoader().getLocalResources( path);
						if( resources!= null && resources.length> 0)
						{
							for( Resource resource: resources)
							{
								boolean matched= false;
								String checkPath= resource.getURL().toExternalForm();
								Set<String> filterPatterns= basePackageFilter.getIncludeClassNamePatterns();
								if( filterPatterns.size()== 0)
									matched= true;
								for( String include: filterPatterns)
								{
									if( pathMatcher.match( "**/"+include+ CLASS_FILE_SUFFIX , checkPath))
									{
										matched= true;
										break;
									}
								}
								filterPatterns= basePackageFilter.getExcludeClassNamePatterns();
								if( matched && filterPatterns.size()> 0)
								{
									for( String exclude: filterPatterns)
									{
										if( pathMatcher.match( "**/"+ exclude+ CLASS_FILE_SUFFIX, checkPath))
										{
											matched= false;
											break;
										}
									}
								}
								if( matched)
								{
//									logger.debug( "matched resource is {}", resource.getURL());
									loadClassWithDependencies( deployedApps, resource, depApp.getClassLoaderRef(), loadedClasses, withDependon);
								}
							}
						}
					}

				}
				catch( Throwable th)
				{
					logger.error( "creation basepackage set for auto-find dependon packages is failed.", th);
				}
			}
		}

		if( deployedApps.size()<= 0) return;
		List<String> packages= new ArrayList<String>();
		packages.addAll( basePackages);

		publishApplicationDeployStartedEvent( new InstanceEvent( this));

		prepareApplications( deployedApps, packages);
		deployPreparedApplications( deployedApps);

		publishApplicationDeployStartedEvent( new InstanceEvent( this));
	}


	/**
	 * for stand-alone batch instance
	 * initial deploy application with dependencies in <code>appHome</code>
	 * @param appHome
	 * @param applicationLocation
	 * @param basePackages
	 * @param withDependon
	 * @throws ApplicationTargetException
	 */
	public synchronized void deployApplicationCandicates(
			File appHome, File applicationLocation, List<String> basePackages, boolean withDependon)
			throws ApplicationTargetException
	{

		Map<String, DeployedApplication> deployedApps= prepareDeployedApplications( appHome, applicationLocation);

		if( deployedApps.size()> 0 && basePackages!= null)
		{
			for( String basePackage: basePackages)
			{
				String path= CLASSPATH_ALL_URL_PREFIX+ ClassUtils.convertClassNameToResourcePath(
						SystemPropertyUtils.resolvePlaceholders( basePackage, true))+ "/"+ DEFAULT_RESOURCE_PATTERN;
				try
				{
					Set<String> loadedClasses= new HashSet<String>();

					for( DeployedApplication depApp: deployedApps.values())
					{
						Resource[] resources= depApp.getClassLoaderRef().getResourceLoader().getLocalResources( path);
						if( resources!= null && resources.length> 0)
						{
							for( Resource resource: resources)
								loadClassWithDependencies( deployedApps, resource, depApp.getClassLoaderRef(), loadedClasses, withDependon);
						}
					}

				}
				catch( Throwable th)
				{
					logger.error( "creation basepackage set for auto-find dependon packages is failed.", th);
				}
			}
		}

		if( deployedApps.size()<= 0) return;

		publishApplicationDeployStartedEvent( new InstanceEvent(  this));

		prepareApplications( deployedApps, basePackages);
		deployPreparedApplications( deployedApps);

		publishApplicationDeployCompletedEvent( new InstanceEvent( this));
	}

	private Map<String, DeployedApplication> prepareDeployedApplications( File appHome, File applicationLocation)
		throws ApplicationTargetException
	{
		if( appHome== null || !appHome.exists() || applicationLocation== null || !applicationLocation.exists())
		{
			logger.error( "can not deployApplicationCandicates using application [{}] of application home [{}].",
					appHome, applicationLocation);
			throw new ApplicationTargetException( "application preparing for deployment is failed. ");
		}

		Map<String, DeployedApplication> deployedApps= new HashMap<String, DeployedApplication>();
		File metaFile= null;
		InputStream metaStream= null;
		URL applicationSource= null;
		if( applicationLocation.isDirectory() && ( metaFile= new File( applicationLocation, APPLICATION_DD_FILE)).exists())
		{
			try
			{
				applicationSource= applicationLocation.toURI().toURL();
				BxmApplication conf= marshallApplicationDescriptor( metaFile);
				if( conf!= null)
				{
					logger.debug( "autoDeployApplication using [{}].", metaFile.getAbsolutePath());
					Map<String, DeployedApplication> depapps= newApplication( applicationLocation, conf, applicationSource);
					if( depapps!= null && depapps.size()> 0)
					{
						for( DeployedApplication depapp: depapps.values())
							deployedApps.put( depapp.getApplicationName(), depapp);
					}

					Map<BxmApplication,File> candidateConfs= loadApplicationConfs( appHome, applicationLocation);
					Set<BxmApplication> toDeployConfs= new HashSet<BxmApplication>();
					Map<String,BxmApplication> checkTos= new HashMap<String, BxmApplication>();
					for( BxmApplication cconf: candidateConfs.keySet())
						checkTos.put( cconf.getName(), cconf);
					checkReferenceApplications( conf, checkTos, toDeployConfs);

					for( BxmApplication bxmApplication: toDeployConfs)
					{
						File target= null;
						if( deployedApps.containsKey( bxmApplication.getName())) continue;
						if( ( target= candidateConfs.get( bxmApplication))!= null)
						{
							if( target.isDirectory() || ( target.isFile() && target.getName().endsWith( BXM_ARCHIVE_SUFFIX)))
							{
								depapps.clear();
								depapps= newApplication( target, bxmApplication, target.toURI().toURL());
								if( depapps!= null && depapps.size()> 0)
								{
									for( DeployedApplication depapp: depapps.values())
										deployedApps.put( depapp.getApplicationName(), depapp);
								}
							}
						}
					}
				}
			}
			catch( Exception e)
			{
				logger.error( "deployment using application [{}] of application home [{}] is failed.",
						new Object[]{ applicationLocation, appHome, e});
				throw new ApplicationTargetException( "application preparing for deployment is failed. ", e);
			}
		}
		else if( applicationLocation.isFile() && applicationLocation.getName().endsWith( BXM_ARCHIVE_SUFFIX))
		{
			try
			{
				applicationSource= applicationLocation.toURI().toURL();
				metaStream= findApplicationConfigurationFromArchive( applicationLocation);
				if( metaStream== null)
				{
					logger.error( "deployment using application [{}] of application home [{}] is failed. " +
							"application meta-file not found.", new Object[]{ applicationLocation, appHome});
					throw new ApplicationTargetException( "application preparing for deployment is failed. ");
				}

				BxmApplication conf= marshallApplicationDescriptor( metaStream);
				if( conf!= null)
				{
					Map<String, DeployedApplication> depapps= newApplication( applicationLocation, conf, applicationSource);
					if( depapps!= null && depapps.size()> 0)
					{
						for( DeployedApplication depapp: depapps.values())
							deployedApps.put( depapp.getApplicationName(), depapp);
					}

					Map<BxmApplication,File> candidateConfs= loadApplicationConfs( appHome, applicationLocation);
					Set<BxmApplication> toDeployConfs= new HashSet<BxmApplication>();
					Map<String,BxmApplication> checkTos= new HashMap<String, BxmApplication>();
					for( BxmApplication cconf: candidateConfs.keySet())
						checkTos.put( cconf.getName(), cconf);
					checkReferenceApplications( conf, checkTos, toDeployConfs);

					for( BxmApplication bxmApplication: toDeployConfs)
					{
						File target= null;
						if( deployedApps.containsKey( bxmApplication.getName())) continue;
						if( ( target= candidateConfs.get( bxmApplication))!= null)
						{
							if( target.isDirectory() || ( target.isFile() && target.getName().endsWith( BXM_ARCHIVE_SUFFIX)))
							{
								depapps.clear();
								depapps= newApplication( target, bxmApplication, target.toURI().toURL());
								if( depapps!= null && depapps.size()> 0)
								{
									for( DeployedApplication depapp: depapps.values())
										deployedApps.put( depapp.getApplicationName(), depapp);
								}
							}
						}
					}
				}
			}
			catch( Exception e)
			{
				logger.error( "deployment using application [{}] of application home [{}] is failed.",
						new Object[]{ applicationLocation, appHome, e});
				throw new ApplicationTargetException( "application preparing for deployment is failed. ", e);
			}
			finally
			{
				if( metaStream!= null) try{ metaStream.close();}catch( Throwable th){}
			}
		}
		else
		{
			logger.error( "deployment using application [{}] of application home [{}] is failed.",
					new Object[]{ applicationLocation, appHome});
			throw new ApplicationTargetException( "application preparing for deployment is failed. ");
		}
		return deployedApps;
	}

	private void loadClassWithDependencies(
			Map<String, DeployedApplication> deployedApps, Resource resource
			, ClassLoaderRef loaderRef, Set<String> loadedClasses, boolean withDependon)
			throws Exception
	{
		MetadataReader reader= null;
		try
		{
			reader= loaderRef.getResourceLoader().getMetadataReader( resource);
			if( reader== null) return;

			String appname= ( (AbstractApplicationClassLoader)loaderRef.getClassLoader()).getApplicationName();
			Application resholder= deployedApps.get( appname);
			if( resholder!= null)
			{
				resholder.addBeanCandidateResource( resource);
				logger.debug( "appended {} to {}", resource.getFileName(), appname);
			}

			String className= reader.getClassMetadata().getClassName();

			if( loadedClasses.contains( className)) return;
			Class<?> loadedClass= loaderRef.getClassLoader().loadClass( className);
			loadedClasses.add( className);
			Field[] fields= loadedClass.getDeclaredFields();
			for( Field field: fields)
			{
//				Annotation[] annotations= field.getAnnotations();
//				if( annotations!= null && annotations.length> 0)
				if( !ClassUtils.isPrimitiveOrWrapper( field.getDeclaringClass()))
				{
					String fieldTypeName= field.getType().getName();
					if( fieldTypeName.startsWith( "java.") || fieldTypeName.startsWith( "sun.")
							|| fieldTypeName.startsWith( "javax.") || fieldTypeName.startsWith( "org."))
						continue;

					String resName= ClassUtils.convertClassNameToResourcePath( fieldTypeName)+ ClassUtils.CLASS_FILE_SUFFIX;
					for( DeployedApplication depApp: deployedApps.values())
					{
						AbstractApplicationClassLoader appLoader=
								(AbstractApplicationClassLoader)depApp.getClassLoaderRef().getClassLoader();
						URL resUrl= appLoader.getApplicationResource( resName);

						if( resUrl!= null)
						{
							if(withDependon)
							{
								loadClassWithDependencies(
										deployedApps, new URLResource( resUrl), depApp.getClassLoaderRef(), loadedClasses, withDependon);
							}
							break;
						}
					}

					String[] additionalClassNames= this.scannerSupport!= null ?
							this.scannerSupport.additionalCandidateClassNames( fieldTypeName) : new String[]{};
					for( String additionalClassName: additionalClassNames)
					{
						if( !StringUtils.hasText( additionalClassName) || additionalClassName.equals( field.getType().getName()))
							continue;

						logger.debug( "additional class Name is {}/{}", fieldTypeName, additionalClassName);
						resName= ClassUtils.convertClassNameToResourcePath( additionalClassName)+ ClassUtils.CLASS_FILE_SUFFIX;
						for( DeployedApplication depApp: deployedApps.values())
						{
							AbstractApplicationClassLoader appLoader=
									(AbstractApplicationClassLoader)depApp.getClassLoaderRef().getClassLoader();
							URL resUrl= appLoader.getApplicationResource( resName);
							if( resUrl!= null)
							{
								if(withDependon)
								{
									loadClassWithDependencies(
											deployedApps, new URLResource( resUrl), depApp.getClassLoaderRef(), loadedClasses, withDependon);
								}
								break;
							}
						}
					}
				}
			}

		}
		catch( Throwable th)
		{
			logger.warn( th.getMessage(), th);
		}
	}

	private void deployPreparedApplications( Map<String, DeployedApplication> deployedApps)
	{
		for( DeployedApplication application: deployedApps.values())
		{
			List<LightweightApplicationContext> refCtxs= new ArrayList<LightweightApplicationContext>();
			ClassLoaderRef[] shRefs=
					( (ApplicationClassLoader)application.getClassLoaderRef().getClassLoader()).getSharedClassLoaderRefs();
			for( ClassLoaderRef shRef: shRefs)
			{
				String shAppName= shRef.getClassLoader().getApplicationName();
				if( deployedApps.containsKey( shAppName))
				{
					refCtxs.add( deployedApps.get( shAppName).getLightweightApplicationContext());
					application.getIommFieldProperties().addReferenceIOmmFieldProperties(
							deployedApps.get( shAppName).getIommFieldProperties());
				}
				else if( this.deployedApplications.containsKey( shAppName))
				{
					refCtxs.add( this.deployedApplications.get( shAppName).getLightweightApplicationContext());
					application.getIommFieldProperties().addReferenceIOmmFieldProperties(
							this.deployedApplications.get( shAppName).getIommFieldProperties());
				}
			}

			try
			{
				// 배치 기동 실패 시 NullPointerException 발생하여 if( 추가.
				if(application == null || application.getLightweightApplicationContext() == null)
				{
					logger.error( "application [{}] or LightweightApplicationContext is null.", application.getApplicationName());
				}
				else
				{
					application.getLightweightApplicationContext().postInitialization(
							refCtxs.toArray( new LightweightApplicationContext[refCtxs.size()]));
				}
			}
			catch( Throwable th)
			{
				logger.error( "application [{}] postInitialization is failed.", new Object[]{ application.getApplicationName(), th});
			}
		}

		try
		{
			for( DeployedApplication application: deployedApps.values())
			{
				DeployedApplication das= null;
				try
				{
					if(application != null)
					{
						if(application.getLightweightApplicationContext() != null)
						{
							if( !this.batch && this.applicationLoader.isDeferredInit())
								application.getLightweightApplicationContext().deferredInstantiate( deferredTasks, deferredInitLock);
							else
								application.getLightweightApplicationContext().preInstantiate();
						}
						else
						{
							throw new IllegalStateException("Application LightweightApplicationContext is null.");
						}

						application.setStage( ApplicationStage.EMPLOYED);
						das= this.deployedApplications.put( application.getApplicationName(), application);
						application.deployed( this.uuid, this.datasource);
//						if( this.batch && this.applicationLoader.isNouseSnapshot())
						if( this.applicationLoader.isNouseSnapshot())
							application.getClassLoaderRef().getClassLoader().setDeleteOnDestroy( false);
					}
				}
				catch( Throwable th)
				{
					if(application != null && application.getLightweightApplicationContext() != null)
					{
						application.getLightweightApplicationContext().interruptedDeferredInstantiate();
						logger.error( "application [{}] preInstantiate is failed.", new Object[]{ application.getApplicationName(), th});
					}
					else
					{
						logger.error( "application preInstantiate is failed.", new Object[]{th});
					}
				}
				finally
				{
					if(application != null)
					{
						logger.info( "appliaction [{}] is deployed.", application.getApplicationName());
					}
					if( das!= null)
					{
						// to avoid early gc effect
						this.referenceKeeper.add( das);
						das.getLightweightApplicationContext().interruptedDeferredInstantiate();
						das.setStage( ApplicationStage.THROWABLE);
						try{ das.undeployed( this.uuid, this.datasource);}catch( Throwable th){ logger.error( th.getMessage(), th);}
						finally{ das.destroy();}
					}
				}
			}
		}
		finally
		{
			try
			{
				for( DeployedApplication application: deployedApps.values())
				{
					if( !applicationLoader.isLazyInit() || COLD== applicationLoader.getLoadingMode()
							|| ( application.getApplicationSource()!= null
									&& StringUtils.hasText( application.getApplicationSource().getFile())
									&& application.getApplicationSource().getFile().endsWith( BXM_ARCHIVE_SUFFIX)))
					{
						try{ application.getClassLoaderRef().getResourceLoader().clearMetadataReadCache();}catch( Throwable th){}
					}
				}
			}catch( Throwable th){}
			this.referenceKeeper.clear();
		}
	}

	private synchronized void autoDeployApplicationCandidates()
	{
//		logger.debug("Caller Class name :{} ", Reflection.getCallerClass( 2));
//		try {
//			throw new Exception("Here");
//		}
//		catch (Exception e)
//		{
//			StackTraceElement[] ste = e.getStackTrace();
//			try {
//				logger.debug(String.format("Caller Class name(%s.%s:%d)", ste[1].getClassName(), ste[1].getMethodName(), ste[1].getLineNumber()));
//			}
//			catch (Exception ee) {}
//		}

		if( this.appHome== null) return;
		Set<String> targetApplications= this.applicationLoader.getTargetApplications();
		long now= System.currentTimeMillis();
		File[] entries= this.appHome.listFiles();
		Map<String, DeployedApplication> toDeployApps= new HashMap<String, DeployedApplication>();
		for( File entry: entries)
		{
			if( entry.getName().toLowerCase().endsWith( ".svn"))	continue;
			File parFile= new File( this.appHome.getAbsolutePath()+ File.separator+ entry.getName()+ BXM_ARCHIVE_SUFFIX);
			File metaFile= null;
			InputStream metaStream= null;

			if( entry.isDirectory() && entry.getName().equals( EXTRACTED_PATH_SUFFIX))	continue;
			if( entry.isDirectory() && entry.getName().equals( "META-INF"))	
				System.out.println("");
			if( entry.isDirectory() && (( metaFile= new File( entry, APPLICATION_DD_FILE)).exists() || ( metaFile= new File( entry, APPLICATION_DD_FILENAME)).exists())
					&& !parFile.exists())
			{
				URL applicationSource= null;
				File commandFile= new File( entry, DeployedApplicationModel.COMMAND_FILE);
				try
				{
					applicationSource= entry.toURI().toURL();
					boolean canAutoDeploy= false;

					if( commandFile.exists())
					{
						if( !commandModTimes.containsKey( applicationSource))
							canAutoDeploy= true;
						else if( commandModTimes.get( applicationSource).longValue()< commandFile.lastModified())
							canAutoDeploy= true;
					}
					if( !dirModTimes.containsKey( applicationSource))
						canAutoDeploy= true;
					else if( dirModTimes.get( applicationSource).longValue()< metaFile.lastModified())
						canAutoDeploy= true;

					if( canAutoDeploy)
					{
						BxmApplication conf= marshallApplicationDescriptor( metaFile);
						if( conf== null)	continue;
						if( !batch && ApplicationType.BATCH== conf.getType()) continue;
						if( !CollectionUtils.isEmpty( targetApplications) && !targetApplications.contains( conf.getName()))
							continue;

						if( toDeployApps.containsKey( conf.getName()))
						{
							logger.debug( "refreshApplicationSourceForLoader using [{}].", entry);
							refreshApplicationSourceForLoader( entry, conf, applicationSource,
									toDeployApps.get( conf.getName()).getClassLoaderRef().getClassLoader(),
									this.applicationLoader.isUseLastmodifiedCache());
						}
						else
						{
							logger.debug( "autoDeployApplication using [{}].", metaFile.getAbsolutePath());
							Map<String, DeployedApplication> depapps= autoDeployApplication( applicationSource, conf, entry);
							if( depapps!= null && depapps.size()> 0)
							{
								for( DeployedApplication depapp: depapps.values())
									toDeployApps.put( depapp.getApplicationName(), depapp);
							}
						}
					}
				}
				catch( Exception e)
				{
					logger.warn( e.getMessage(), e);
					continue;
				}
				finally
				{
					if( applicationSource!= null)
					{
						dirModTimes.put( applicationSource, metaFile.lastModified());
						if( commandFile.exists())	commandModTimes.put( applicationSource, commandFile.lastModified());
					}
				}
			}
			// else packaged par application
			else if( entry.isFile() && entry.getName().endsWith( BXM_ARCHIVE_SUFFIX))
			{
				URL applicationSource= null;
				try
				{
					applicationSource= entry.toURI().toURL();
					if( jarModTimes.containsKey( applicationSource)
							&& ( jarModTimes.get( applicationSource).longValue()>= entry.lastModified()))
						continue;

					metaStream= findApplicationConfigurationFromArchive( entry);
					if( metaStream== null) continue;

					BxmApplication conf= marshallApplicationDescriptor( metaStream);

					if( conf== null) continue;
					if( !batch && ApplicationType.BATCH== conf.getType()) continue;
					if( !CollectionUtils.isEmpty( targetApplications) && !targetApplications.contains( conf.getName()))
						continue;

					if( toDeployApps.containsKey( conf.getName()))
					{
						logger.debug( "refreshApplicationSourceForLoader using [{}].", entry);
						refreshApplicationSourceForLoader( entry, conf, applicationSource,
								toDeployApps.get( conf.getName()).getClassLoaderRef().getClassLoader(), false);
					}
					else
					{
						logger.debug( "autoDeployApplication using [{}].", entry);
						Map<String, DeployedApplication> depapps= autoDeployApplication( applicationSource, conf, entry);
						if( depapps!= null && depapps.size()> 0)
						{
							for( DeployedApplication depapp: depapps.values())
								toDeployApps.put( depapp.getApplicationName(), depapp);
						}
					}
				}
				catch( Exception e)
				{
					logger.warn( e.getMessage(), e);
					continue;
				}
				finally
				{
					if( applicationSource!= null) jarModTimes.put( applicationSource, entry.lastModified());
					if( metaStream!= null) try{ metaStream.close();}catch( Throwable th){}
				}
			}
		}

		if( toDeployApps.size()<= 0) return;
		
		logger.warn( "autoDeployApplicationCandidates_start [{}].", appHome);

		publishApplicationDeployStartedEvent( new InstanceEvent(  this));

		prepareApplications( toDeployApps);

		for( DeployedApplication application: toDeployApps.values())
		{
			List<LightweightApplicationContext> refCtxs= new ArrayList<LightweightApplicationContext>();
			ClassLoaderRef[] shRefs=
					( (ApplicationClassLoader)application.getClassLoaderRef().getClassLoader()).getSharedClassLoaderRefs();
			for( ClassLoaderRef shRef: shRefs)
			{
				String shAppName= null;
				shAppName= shRef.getClassLoader().getApplicationName();
				if( toDeployApps.containsKey( shAppName))
				{
					refCtxs.add( toDeployApps.get( shAppName).getLightweightApplicationContext());
					application.getIommFieldProperties().addReferenceIOmmFieldProperties(
							toDeployApps.get( shAppName).getIommFieldProperties());
				}
				else if( this.deployedApplications.containsKey( shAppName))
				{
					refCtxs.add( this.deployedApplications.get( shAppName).getLightweightApplicationContext());
					application.getIommFieldProperties().addReferenceIOmmFieldProperties(
							this.deployedApplications.get( shAppName).getIommFieldProperties());
				}
			}

			try
			{
				application.getLightweightApplicationContext().postInitialization(
						refCtxs.toArray( new LightweightApplicationContext[refCtxs.size()]));
			}
			catch( Throwable th)
			{
				logger.error( "application [{}] postInitialization is failed.", new Object[]{ application.getApplicationName(), th});
			}
		}

		try
		{
			for( DeployedApplication application: toDeployApps.values())
			{
				DeployedApplication das= null;
				try
				{
					if( !this.batch && this.applicationLoader.isDeferredInit())
						application.getLightweightApplicationContext().deferredInstantiate( deferredTasks, deferredInitLock);
					else
						application.getLightweightApplicationContext().preInstantiate();
					application.setStage( ApplicationStage.EMPLOYED);
					das= this.deployedApplications.put( application.getApplicationName(), application);
					application.deployed( this.uuid, this.datasource);
				}
				catch( Throwable th)
				{
					application.getLightweightApplicationContext().interruptedDeferredInstantiate();
					logger.error( "application [{}] preInstantiate is failed.", new Object[]{ application.getApplicationName(), th});
				}
				finally
				{
					logger.info( "appliaction [{}/{}] is deployed.", application.getApplicationName(), application.getUUID());
					logger.debug( "old application [{}] is detected.", das!= null ? das.getApplicationName() : "null");
					if( das!= null)
					{
						// to avoid early gc effect
						this.referenceKeeper.add( das);
						das.getLightweightApplicationContext().interruptedDeferredInstantiate();
						logger.info( "application [{}/{}] is undeployed", das.getApplicationName(), das.getUUID());
						das.setStage( ApplicationStage.THROWABLE);
						try{ das.undeployed( this.uuid, this.datasource);}catch( Throwable th){ logger.error( th.getMessage(), th);}
						finally{ das.destroy();}
					}
				}
			}
		}
		finally
		{
			try
			{
				for( DeployedApplication application: toDeployApps.values())
				{
					if( !applicationLoader.isLazyInit() || COLD== applicationLoader.getLoadingMode()
							|| ( application.getApplicationSource()!= null
									&& StringUtils.hasText( application.getApplicationSource().getFile())
									&& application.getApplicationSource().getFile().endsWith( BXM_ARCHIVE_SUFFIX)))
					{
						try{ application.getClassLoaderRef().getResourceLoader().clearMetadataReadCache();}catch( Throwable th){}
					}
				}
			}catch( Throwable th){}
			this.referenceKeeper.clear();
		}

		if( toDeployApps!= null && toDeployApps.size()> 0)
		{
			logger.info( "================================================================");
			logger.warn( "autoDeployApplicationCandidates_ended [{}].", System.currentTimeMillis() - now);
		}

		publishApplicationDeployCompletedEvent(  new InstanceEvent( this));

		// temporary action
		System.gc();
	}

	private Map<String, DeployedApplication> autoDeployApplication( URL applicationSource, BxmApplication conf,
			File applicationLocation) throws Exception
	{
		try
		{
			if( this.deployedApplications.containsKey( conf.getName()))
			{
				if( HOT!= applicationLoader.getLoadingMode())
					return null;

				if( !this.deployedApplications.get( conf.getName()).getApplicationSource().equals( applicationSource))
				{
					logger.warn( "duplicated applications are located in application home");
					return null;
				}
			}

			// case 1. not registered before
			// case 2. auto-deploy and hot loading mode
			DeployedApplication das= null;
			if( ( das= this.deployedApplications.get( conf.getName()))!= null)
			{
				das.getLightweightApplicationContext().interruptedDeferredInstantiate();
				return refreshApplication( applicationLocation, conf, applicationSource, das.getClassLoaderRef().getClassLoader(),
						this.applicationLoader.isUseLastmodifiedCache());
			}
			else
				return newApplication( applicationLocation, conf, applicationSource);
		}
		catch( Exception e)
		{
			logger.warn( "application source [{}] in application home deployment failed.", new Object[]{ applicationLocation, e});
			throw e;
		}
	}

	private Map<String, DeployedApplication> stagingApplication( File applicationLocation, BxmApplication conf, URL applicationSource)
		throws ApplicationConfigurationException, InvalidCommandException, ApplicationNotFoundException, IOException
	{
		Map<String, DeployedApplication> stagingTos= new HashMap<String, DeployedApplication>();

		List<URL> configuredClasspath= new ArrayList<URL>();
		configuredClasspath.addAll( applicationLoader.getApplicableClasspath());
		File loaderTarget= createLoaderTagetForApplication( conf.getName(), applicationLocation, null, false);
		List<URL> localAppClasspath= createLocalAppClasspath( loaderTarget);
		configuredClasspath.addAll( localAppClasspath);

		List<ApplicationClassLoaderListener> listeners= getClassLoaderLifecycleListeners();

		ClassLoaderRef[] changeTos= this.classLoaderManager.getClassLoaderForStaging( conf.getName(),
				configuredClasspath.toArray( new URL[configuredClasspath.size()]),
				localAppClasspath.toArray( new URL[localAppClasspath.size()]), conf.isShared(),
				listeners.toArray( new ApplicationClassLoaderListener[listeners.size()]), loaderTarget,
				StringUtils.hasText( conf.getReferenceApplications()) ?
						StringUtils.tokenizeToStringArray( conf.getReferenceApplications(), ",") : new String[]{},
				applicationLoader.getInstrument());

		for( ClassLoaderRef loaderRef: changeTos)
		{
//			String fullpath= ( (AbstractApplicationClassLoader)loaderRef.getClassLoader()).getFinder().getClassPath();
//			logger.debug( fullpath);

			String appName= loaderRef.getClassLoader().getApplicationName();
			if( appName.equals( conf.getName()))
			{
				DeployedApplication target=
						(DeployedApplication)ApplicationConfigurationManager.configure( this, conf, true, loaderRef);
				target.setApplicationSource( applicationSource);
				target.setDeployedTarget( loaderTarget);
				stagingTos.put( target.getApplicationName(), target);
			}
			else
			{
				DeployedApplication deployedApp= this.deployedApplications.get( appName);
				if( deployedApp!= null)
				{
					DeployedApplication target= (DeployedApplication)ApplicationConfigurationManager.configure(
							this, deployedApp.getConfiguration(), true, loaderRef);
					target.setApplicationSource( deployedApp.getApplicationSource());
					target.setDeployedTarget( deployedApp.getDeployedTarget());
					stagingTos.put( target.getApplicationName(), target);
				}
				else
					logger.warn( "staging target application [{}] is not deployed.", appName);
			}
		}
		return stagingTos;
	}

	private Map<String, DeployedApplication> newApplication( File applicationLocation, BxmApplication conf, URL applicationSource)
		throws ApplicationConfigurationException, InvalidCommandException, ApplicationNotFoundException, IOException
	{
		Map<String, DeployedApplication> apps= new HashMap<String, DeployedApplication>();
		List<URL> configuredClasspath= new ArrayList<URL>();
		configuredClasspath.addAll( applicationLoader.getApplicableClasspath());
		File loaderTarget= createLoaderTagetForApplication( conf.getName(), applicationLocation, null, false);
		List<URL> localAppClasspath= createLocalAppClasspath( loaderTarget);
		configuredClasspath.addAll( localAppClasspath);

		List<ApplicationClassLoaderListener> listeners= getClassLoaderLifecycleListeners();

		String[] chTos= this.classLoaderManager.registerApplication( conf.getName(),
				configuredClasspath.toArray( new URL[configuredClasspath.size()]),
				localAppClasspath.toArray( new URL[localAppClasspath.size()]), conf.isShared(),
				listeners.toArray( new ApplicationClassLoaderListener[listeners.size()]), loaderTarget,
				StringUtils.hasText( conf.getReferenceApplications()) ?
						StringUtils.tokenizeToStringArray( conf.getReferenceApplications(), ",") : new String[]{},
				applicationLoader.getInstrument());

		Set<String> changeTos= new HashSet<String>();
		changeTos.addAll( Arrays.asList( chTos));

		List<String> referenceTos= new ArrayList<String>();
		for( String changeTo: changeTos)
		{
			ClassLoaderRef loaderRef= this.classLoaderManager.getClassLoaderFor( changeTo);
			if( changeTo.equals( conf.getName()))
			{
				DeployedApplication target= (DeployedApplication)ApplicationConfigurationManager.configure(
						this, conf, true, loaderRef);
				target.setApplicationSource( applicationSource);
				target.setDeployedTarget( loaderTarget);
				referenceTos.addAll( Arrays.asList( target.getReferenceApplications()));
				apps.put( target.getApplicationName(), target);
			}
			else
			{
				DeployedApplication deployedApp= this.deployedApplications.get( changeTo);
				if( deployedApp!= null)
				{
					DeployedApplication target= (DeployedApplication)ApplicationConfigurationManager.configure(
							this, deployedApp.getConfiguration(), true, loaderRef);
					target.setApplicationSource( deployedApp.getApplicationSource());
					target.setDeployedTarget( deployedApp.getDeployedTarget());
					apps.put( target.getApplicationName(), target);
				}
				else
					logger.warn( "refrersh target application[{}] is not deployed.", changeTo);
			}
		}

		return apps;
	}

