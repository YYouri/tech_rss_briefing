	public boolean isValidClient( String remoteAddr)
	{
		if( !StringUtils.hasText( remoteAddr)) return true;
		boolean valid= true;
		String[] addrTokens= StringUtils.tokenizeToStringArray( remoteAddr, ".");
		for( Pattern[] patterns: this.validClientPatterns)
		{
			valid= true;
			for( int i= 0; i< patterns.length; i++)
			{
				if( !patterns[i].matcher( addrTokens[i]).matches())
				{
					valid= false;
					break;
				}
			}
			if( valid)
				break;
		}
		return valid;
	}

