	public ServiceOperation lookupServiceOperation( String serviceName,
			String operationName) throws ServiceOperationNotFoundException
	{
		Service svc= this.services.get( serviceName);
		if( svc!= null && svc.isExposed())
		{
			ServiceOperation op= svc.lookupOperation( operationName);
			if( op!= null&& op.isExposed())
				return op;
		}
		throw new ServiceOperationNotFoundException( serviceName, operationName);
	}

