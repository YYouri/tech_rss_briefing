    <script src="/js/jquery.min.3.4.1.js"></script> 
    <script src="/js/popper.min.1.16.1.js"></script>
    <script src="/js/bootstrap.min.js"></script>
    <script type="text/javascript">
        
    
    var LOGIN_PAGE_URL = "/bin/Login.jsp"; // 실제 로그인 페이지 경로로 교체

    function loadUserInfoAndMenu() {
        $.ajax({
            url: '/getUserInfo.json',
            type: 'GET',
            dataType: 'json',
            success: function(data) {
                if (data && data.response_username) {
                    $('#user-name').text(data.response_username);
                    const groupId = data.response_group_id;
                    const userId = data.response_user_Id;
                    if (groupId === 'admin' || groupId === 'user') {
                        $('.user-admin-menu').show();
                    }
                    if (groupId === 'admin') {
                        $('.admin-only-menu').show();
                    }
                    if (userId === 'IB1192' || userId === 'IB1117') {
                        $('.special-user-menu').show();
                    }
                } else {
                    // [추가] 응답은 왔는데 로그인 정보가 비어있음 = 세션 없음
                    window.location.href = LOGIN_PAGE_URL;
                }
            },
            error: function(xhr) {
                // [추가] 401/403이면 명확히 세션 만료/미인증 - 로그인 페이지로
                // 그 외(500, 네트워크 오류 등)는 서버 쪽 문제일 수 있어 리다이렉트하지 않고 메뉴만 비워둠
                if (xhr.status === 401 || xhr.status === 403|| xhr.status === 404) {
                    window.location.href = LOGIN_PAGE_URL;
                } else {
                    $('#user-name').text("Error");
                }
            }
        });
    }

        // [핵심 수정 부분]
    $(document).ready(function() {
        // 1. 권한 로드
        loadUserInfoAndMenu();

        // 2. [이벤트 위임] 메뉴 클릭(Dropdown)이 안 될 때를 대비한 강제 바인딩
        // 메뉴가 나중에 로드되어도 'document'가 클릭을 감지해서 처리합니다.
        $(document).on('click', '.dropdown-toggle', function (e) {
            // Bootstrap의 기본 동작을 실행시킵니다.
            $(this).parent().find('.dropdown-menu').toggleClass('show');
        });
    });

    function myFunc() {
        alert("기존 배포 로그 조회 기능을 실행합니다.");
    }
    </script>
</body>
</html>