<%@ page language="java" contentType="text/html; charset=UTF-8"
    pageEncoding="UTF-8"%>
<%@ page import="java.util.List"%>
<%@ taglib prefix="c" uri="http://java.sun.com/jsp/jstl/core"%>
<%@ taglib prefix="fmt" uri="http://java.sun.com/jsp/jstl/fmt"%>
<%@ taglib prefix="fn" uri="http://java.sun.com/jsp/jstl/functions"%>
<!DOCTYPE html>

<html>
<head>
<meta charset="UTF-8">
<title>이미지 배포</title>
</head>
<script type="text/javascript" src="/js/vue.js"></script>
<script type="text/javascript" src="/js/vue-router.js"></script>
<script type="text/javascript" src="/js/axios.js"></script>
<script type="text/javascript" src="/js/moment.js"></script>

<script type="text/javascript" src="/js/jquery-3.6.0.js"></script>
<script type="text/javascript" src="/js/jquery-ui.js"></script>
<script type="text/javascript" src="/js/bootstrap.min.js"></script>
<script type="text/javascript" src="/js/zTree/jquery.ztree.all-3.5.js"></script>
<script type="text/javascript" src="/js/sweetalert/sweetalert2.all.js"></script>
<script type="text/javascript" src="/js/sweetalert/promise.min.js"></script>

<link rel="stylesheet" href="../../../css/zTreeStyle/zTreeStyle.css" type="text/css">
<style type="text/css">
  .radioBtn {height: 16px;vertical-align: middle;}
  .checkboxBtn {vertical-align: middle;margin-right: 2px;}
    div#rMenu {position:absolute; visibility:hidden; top:0; background-color: #555;text-align: left;padding: 2px;}
    div#rMenu ul li{
        margin: 1px 0;
        padding: 0 15px;
        cursor: pointer;
        list-style: none outside none;
        background-color: #DFDFDF;
    }
    {
        margin:0;
        padding:0;
    }
    .swal2-title {
        font-size: 1.475rem !important;
    }
    .swal2-content {
          z-index: 1;
          justify-content: center;
          margin: 0;
          padding: 0 1.6em;
          color: #545454;
          font-size: 1em;
          font-weight: normal;
          line-height: normal;
          text-align: left;
          word-wrap: break-word;
          max-height: 6em;
          overflow-y: scroll;
          width: 100%;
}
</style>

<script type="text/javascript" src="/js/view/zTree.js"></script>
<script type="text/javascript" src="/js/view/image.js"></script>

<link href="../css/bootstrap.min.css" rel="stylesheet">
<link href="../css/jquery-ui.min.css" rel="stylesheet">
<link href="../css/zTreeStyle/zTreeStyle.css" rel="stylesheet">
<%@ page import="hi.framework.deploymanager.login.entity." %>
<%@ page import="hi.framework.deploymanager.image.entity.*" %>
<body>
    <header id="header"><jsp:include page="/bin/menu.jsp" flush="false"/></header>
      <div id="images" class="container-fluid content_wrap" style="float:left;">
        <div class="container">
            <div class="row" >
                  <div class="float-right" style="width:30%">
                      <h5 class="card-title">
                        <span class='font-weight-bold'>이미지 배포 등록 - ${loginInfo.getResponse_username()} </span>
                    </h5>
                  </div>
                  <div class="float-right" style="width:30%; "></div>
                <div style="width:38%; text-align:right;">
                       <a href="http://developer.cis.co.kr/devkit/temp/ImageDeployManual/%ec%9d%b4%eb%af%b8%ec%a7%80_%eb%b0%b0%ed%8f%ac_%ec%8b%9c%ec%8a%a4%ed%85%9c_%ec%82%ac%ec%9a%a9_%eb%a9%94%eb%89%b4%ec%96%bc.pptx" >
                           <button type="button" class="btn-sm btn btn-primary"  style="width:120px; vertical-align:middle;">사용자 메뉴얼</button>
                       </a>
                </div>
            </div>
            <div class="">
            <form id="imageUploadForm" method="get">
                <input type="hidden" id="pmsno" name="pmsno" value=""/>
                <input type="hidden" id="sdlc" name="sdlc" value=""/>
                <input type="hidden" id="shell" name="shell" value=""/>
                <input type="hidden" id="syscode" name="syscode" value=""/>
                <input type="hidden" id="content" name="content" value=""/>
                <input type="hidden" id="existQA" name="existQA" value=""/>
                <%-- <input type="hidden" id="deptId" name="deptId" value="${loginInfo.getResponse_deptId()}"/> --%>
                <c:if test="${imageDeployUserInfo.size() > 0}">
                    <input type="hidden" id="operatorConfirm" name="operatorConfirm" value="${imageDeployUserInfo.get(0).getOperator_id()}"/>
                </c:if>
                
                  <table class="table table-bordered" style="width:100%; font-size:15pt; font-weight: bold;">
                    <tbody>
                           <tr class="text-center" >
                              <td style="width:50%; vertical-align:middle;" colspan=2>배포 정보</td>
                               <td style="width:50%; vertical-align:middle;" colspan=3>FTP 디렉토리</td>
                        </tr>
                        <tr>
                               <td style="vertical-align:middle; text-align: center">서버 구분</td>
                               <td class="text-center" style="vertical-align:middle; text-align:center; margin-left: 20px; font-size:10pt;">
                                   <input class="form-check-input" type="radio" id="serverType" name="serverType" value="QA" checked>
                                   <label for="serverType1">검증(QA)</label>          
                                   <input class="form-check-input" type="radio" id="serverType" name="serverType" value="PROD" >
                                   <label for="serverType2">운영(PROD)</label>
                               </td>
                               <td id="zTreeTd" style="vertical-align:top; " rowspan=6  colspan=3>
                                   <ul class="ztree" id="treeDemo" class="ztree" style="overflow: auto; height:515px;"></ul>
                               </td>
                        </tr>
                           <tr class="text-center" >
                               <td style="vertical-align:middle;">기능 선택</td>
                               <td class="text-center" style="vertical-align:middle; text-align:center; margin-left: 20px; font-size:10pt;">
                                   <input class="form-check-input" type="radio" id="uploadType" name="uploadType" value="fileUpload" checked>
                                   <label for="uploadType1">파일업로드</label>          
                                   <input class="form-check-input" type="radio" id="uploadType" name="uploadType" value="prodUpload" >
                                   <label for="uploadType2">검증배포</label>
                               </td>
                        </tr>
                           <tr class="text-center" id="projectNo" >
                               <td style="vertical-align:middle; text-align: center;">프로젝트번호</td>
                               <td style="vertical-align:middle;" height="55px">
                                  <select id="projectMno"  name="projectMno" style="width:345px;" class="btn btn-light btn-light-sm" disabled>
                                      <option value="none">※ 당일 등록 프로젝트 번호만 조회 됩니다.</option>
                                  <c:forEach var="item" items="${projectMngNo}">
                                      <option value="${item.getFORM_ID()}">
                                          ${item.getFORM_ID()} / ${item.getFORM_NAME()} 
                                      </option>
                                  </c:forEach>
                                  </select>
                            </td>
                        </tr>
                        <tr class="text-center" >
                               <td style="vertical-align:middle; text-align: center">대상 시스템</td>
                               <td style="vertical-align:middle;">
                                  <select id="targetSystem"  name="targetSystem" style="width:345px;" class="btn btn-light btn-light-sm" >
                                      <option value="none">시스템 이름</option>
                                  <c:forEach var="item" items="${imageDeployUserInfo}">
                                      <option value="${item.getSys_code()}/${item.getSys_name()}/${item.getValue()}">
                                        ${item.getSys_code()} (${item.getSys_name()}) 
                                      </option>
                                  </c:forEach>
                                  </select>
                            </td>
                        </tr>
                           <tr class="text-center" >
                              <td style="vertical-align:middle;" rowspan=2>업로드 목록</td>
                               <td style="vertical-align:middle;" >
                                   <div class="text-left data_file_txt" id="data_file_txt" style="margin:5px; height:280px; overflow: auto;">
                                      <div id="articlefileChange"></div>
                                   </div>
                              </td>
                        </tr>
                           <tr class="text-center" >
                               <td class="text-left" style="vertical-align:middle; margin-left: 20px; font-size:10pt;">
                                   <button id="btn-upload" type="button">파일추가</button>
                                   <input id="input_file" name="input_file" multiple="multiple" type="file" style="display:none;" >
                                   <span style="font-size:10pxl color:gray;"> ※ 첨부파일은 최대 10개, 최대 용량은 50M 입니다.</span>
                               </td>
                        </tr>
                           <tr class="text-center" >
                              <td style="vertical-align:middle; text-align: center; ">업로드 경로</td>
                               <td class="text-left" style="vertical-align:middle;" colspan=4>
                                   <input id="filePath" name="filePath" type="text" readonly  style="font-size:18px; vertical-align:middle; width:85%;" value="" />
                                   <button type="button" class="btn-sm btn btn-warning" id="upload" name="upload" onclick="javascript:registerAction();" style="width:120px; vertical-align:middle; display:;">파일 업로드</button>
                                   <button type="button" class="btn-sm btn btn-primary" id="prodDeploy" name="prodDeploy" onclick="" style="width:120px; vertical-align:middle; display:none;">검증계 배포</button>
                              </td>
                        </tr>
                    </tbody>
                  </table>
              </form>
              </div>
          </div>
      </div>
    <div id="rMenu" style="height:106px;">
        <ul>
            <li id="m_add" onclick="">폴더 생성</li>
            <li id="m_del" onclick="">폴더 삭제</li>
            <li id="m_modi" onclick="">폴더 수정</li>
            <li id="m_reset" onclick="">새로 고침</li>
            <li id="mf_del" onclick="">파일 삭제</li>
        </ul>
    </div>
</body>
</html>

한화면에서 스크롤 최소화 되게  사용자 불편 없이 쓰도록 전환해줘