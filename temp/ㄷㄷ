	/** 작업 상태 + 지금까지의 로그 조회 (진행 중이어도 조회 가능). jobType: "backup" 또는 "cleanup" */
	public AsyncJobStatus getConfigJobStatus(String jobType, String env, String taskId) {
		validateTaskId(taskId);
		String key = jobType + "_" + env + "_" + taskId;
		AsyncJobStatus job = configJobs.get(key);
		if (job == null) {
			throw new IllegalStateException("해당 작업 이력이 없습니다: " + taskId);
		}
		return job;
	}

	/** 건건이 작업 상태 + 누적 로그를 담는 값 객체 (기존 TaskExecution과는 별개) */
	public static class AsyncJobStatus {
		private volatile String status = "RUNNING"; // RUNNING, SUCCESS, FAILED
		private volatile Integer exitCode;
		private final StringBuilder logBuffer = new StringBuilder();

		synchronized void appendLog(String line) {
			logBuffer.append(line);
		}

		/** 전체 로그 (하위 호환용) */
		public synchronized String getLog() {
			return logBuffer.toString();
		}

		/** fromIndex 이후에 새로 쌓인 부분만 반환 (매 폴링마다 전체를 다시 안 보내도록) */
		public synchronized String getLogSince(int fromIndex) {
			int len = logBuffer.length();
			if (fromIndex < 0) fromIndex = 0;
			if (fromIndex >= len) return "";
			return logBuffer.substring(fromIndex);
		}

		public synchronized int getLogLength() {
			return logBuffer.length();
		}

		void complete(int exitCode) {
			this.exitCode = exitCode;
			this.status = (exitCode == 0) ? "SUCCESS" : "FAILED";
		}

		public boolean isRunning() { return "RUNNING".equals(status); }
		public String getStatus() { return status; }
		public Integer getExitCode() { return exitCode; }
	}

}
