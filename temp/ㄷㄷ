	public boolean initialize()
	{
		if( this.context instanceof Initialized)
			return ( (Initialized)this.context).initialized( true);
		return false;
	}

	public void destroyApplicationContext()
	{
		if( this.context== null || !this.context.isActive()) return;
		logger.info( "closing Spring root ApplicationContext [{}].", this.context);
		try{ this.context.close();}
		finally
		{
			if( this.servletContext!= null)
			{
				this.servletContext.removeAttribute( WebApplicationContext.ROOT_WEB_APPLICATION_CONTEXT_ATTRIBUTE);
				//[[ 20170518 NCIS08 BXM외의 Spring 사용을 위해 ServletContext를 cleanup하지 않음.
				//                   이미 ServletContextDelegate를 사용해 원본 ServletContext를 수정하지 않고 있음.
				//cleanupServletContextAttributes();
				//]]
				this.servletContext= null;
			}
		}
	}

