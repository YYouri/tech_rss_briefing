	/**
	 * XML 문자열을 분석하여 Document 객체로 반환한다.
	 *
	 * @param strData XML 문자열
	 * 
	 * @return Document
	 * 
	 * @throws ParserConfigurationException
	 * @throws SAXException
	 * @throws IOException
	 */
	public static Document getDocument(String strData) throws ParserConfigurationException, SAXException, IOException {
		return getDocument(strData, null);
	}
	
	/**
	 * XML 문자열을 주어진 캐릭터셋으로 변환하고 분석하여 Document 객체로 반환한다.
	 *
	 * @param xmlData XML 문자열
	 * @param charSet 캐릭터셋
	 * 
	 * @return Document
	 * 
	 * @throws ParserConfigurationException
	 * @throws SAXException
	 * @throws IOException
	 */
	public static Document getDocument(String xmlData, String charSet) throws ParserConfigurationException, SAXException, IOException {
		
		Document doc = null;
		InputStream is = null;
		
		if( charSet != null ) {
			is = new ByteArrayInputStream(xmlData.getBytes(charSet));
		} else {
			is = new ByteArrayInputStream(xmlData.getBytes());
		}
		
		DocumentBuilder builder = domFactory.newDocumentBuilder();
		doc = builder.parse(is);
		
		return doc;
	}
	
	public static Document getDocumentAddDeclaration(String xmlData, String charSet) throws ParserConfigurationException, SAXException, IOException {
		
		if (xmlData.startsWith("<?xml")) {
			xmlData = removeXmlDeclaration(xmlData);
		}
		xmlData = addXmlDeclaration(xmlData, charSet);
		return getDocument(xmlData, charSet);
	}

