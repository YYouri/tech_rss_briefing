#!/bin/bash

# 사용법 안내
if [ "$#" -lt 1 ]; then
    echo "Usage: $0 <input_file> [TASK_ID]"
    exit 1
fi

INPUT_FILE=$1

# 입력 파일 존재 여부 확인
if [ ! -f "$INPUT_FILE" ]; then
    echo "[에러] 신청서 파일을 찾을 수 없습니다: $INPUT_FILE"
    exit 1
fi

# TASK_ID 미지정 시 신청서 파일명(확장자 제외)을 그대로 사용
if [ "$#" -ge 2 ]; then
    TASK_ID="$2"
else
    TASK_ID=$(basename "$INPUT_FILE")
    TASK_ID="${TASK_ID%.*}"
fi

# 결과 디렉토리 설정
REQUEST_DIR="/NFS/IDES/PMS/CIS_RM/TASK_ID"
RESULT_DIR="${REQUEST_DIR}/$(date +%Y)/$(date +%m)/$(date +%d)/${TASK_ID}"
mkdir -p "$RESULT_DIR"

# 상수 설정
STAGING_JAVA="/NFS/IDES/PMS/CIS/STAGING/JAVA"
STAGING_BATCH="/NFS/IDES/PMS/CIS/STAGING/JAVA/BATCH"
STAGING_BATCH_SRC="/NFS/IDES/PMS/CIS/STAGING/JAVA/BATCH_SOURCE"
STAGING_WEB="/NFS/IDES/PMS/CIS/STAGING/WEB"
TARGET_COWEB="/NFS/QA/QCOWEB"
TARGET_DPWEB="/NFS/QA/QDPWEB"
TARGET_COWAS="/Appl/Online"
TARGET_BATCH="/Appl/Batch"

echo "=================================================="
echo " 신청서       : $INPUT_FILE"
echo " TASK_ID      : $TASK_ID"
echo " 출력 위치    : $RESULT_DIR"
echo "=================================================="

# 타입별 배열 초기화
declare -a ONLINE_PATHS=()
declare -a BATCH_PATHS=()
declare -a COWEB_PATHS=()
declare -a DPWEB_PATHS=()
declare -a LOCAL_PATHS=()
declare -a UNKNOWN_LINES=()

while IFS= read -r line || [ -n "$line" ]; do
    [[ -z "$line" || "$line" == \#* ]] && continue

    # 파일명과 경로 분리
    FILE_NAME=$(echo "$line" | awk '{print $1}')
    DIR_INFO=$(echo "$line" | awk '{print $2}')

    if [ -z "$FILE_NAME" ] || [ -z "$DIR_INFO" ]; then
        continue
    fi

    # 경로 정규화 (\ -> /)
    DIR_PATH=$(echo "$DIR_INFO" | sed 's/\\/\//g')
    FILE_NAME_LOWER=$(echo "$FILE_NAME" | tr '[:upper:]' '[:lower:]')
    BASE_FILE=$(basename "$FILE_NAME")
    MATCHED="false"

    # -----------------------------------------------------------------
    # [CASE 1] WEB 계열 (COWEB / DPWEB)
    # -----------------------------------------------------------------
    if [[ "$DIR_PATH" == *"WEB"* ]]; then
        # WEB/ 이후의 경로 추출
        WEB_REL_PATH=$(echo "$DIR_PATH" | sed -E 's|.*/WEB/||' | sed 's|/*$||')

        if [[ "$DIR_PATH" == *"distribution"* ]]; then
            MATCHED="true"
            TYPE="dpweb"
            DPWEB_PATHS+=("${TARGET_DPWEB}/${WEB_REL_PATH}/${BASE_FILE}")
            LOCAL_PATHS+=("${STAGING_WEB}/DPWEB/${WEB_REL_PATH}/${BASE_FILE}")
        else
            MATCHED="true"
            TYPE="coweb"
            COWEB_PATHS+=("${TARGET_COWEB}/${WEB_REL_PATH}/${BASE_FILE}")
            LOCAL_PATHS+=("${STAGING_WEB}/COWEB/${WEB_REL_PATH}/${BASE_FILE}")
        fi

    # -----------------------------------------------------------------
    # [CASE 2] ONLINE Java (ONLINE + src)
    # -----------------------------------------------------------------------------
    elif [[ "$FILE_NAME_LOWER" == *".java" && "$DIR_PATH" == *"ONLINE"* && "$DIR_PATH" == *"src"* ]]; then
        MATCHED="true"
        TYPE="online"
        CLASS_REPLACE="${BASE_FILE%.*}.class"
        RELATIVE_PATH=$(echo "$DIR_PATH" | sed -E 's|.*/src/||' | sed 's|/*$||')
        
        ONLINE_PATHS+=("${TARGET_COWAS}/EAR/WEB/WEB-INF/classes/${RELATIVE_PATH}/${CLASS_REPLACE}")
        ONLINE_PATHS+=("${TARGET_COWAS}/EAR/WEB2/WEB-INF/classes/${RELATIVE_PATH}/${CLASS_REPLACE}")
        BATCH_PATHS+=("${TARGET_BATCH}/classes/${RELATIVE_PATH}/${CLASS_REPLACE}")
        LOCAL_PATHS+=("${STAGING_JAVA}/ONLINE/WEB/WEB-INF/classes/${RELATIVE_PATH}/${CLASS_REPLACE}")
        LOCAL_PATHS+=("${STAGING_JAVA}/ONLINE_SOURCE/${RELATIVE_PATH}/${BASE_FILE}")

    # -----------------------------------------------------------------
    # [CASE 3] BATCH Java (BATCH + src)
    # -----------------------------------------------------------------
    elif [[ "$FILE_NAME_LOWER" == *".java" && "$DIR_PATH" == *"BATCH"* && "$DIR_PATH" == *"src"* ]]; then
        MATCHED="true"
        TYPE="batch"
        CLASS_REPLACE="${BASE_FILE%.*}.class"
        RELATIVE_PATH=$(echo "$DIR_PATH" | sed -E 's|.*/src/||' | sed 's|/*$||')
        
        BATCH_PATHS+=("${TARGET_BATCH}/classes/${RELATIVE_PATH}/${CLASS_REPLACE}")
        LOCAL_PATHS+=("${STAGING_BATCH}/classes/${RELATIVE_PATH}/${CLASS_REPLACE}")
        LOCAL_PATHS+=("${STAGING_BATCH_SRC}/${RELATIVE_PATH}/${BASE_FILE}")

    # -----------------------------------------------------------------
    # [CASE 4] BATCH XML (Config)
    # -----------------------------------------------------------------
    elif [[ "$FILE_NAME_LOWER" == *".xml" && "$DIR_PATH" == *"BATCH"* && "$DIR_PATH" == *"config"* ]]; then
        MATCHED="true"
        TYPE="batch_config"
        RELATIVE_PATH=$(echo "$DIR_PATH" | sed -E 's|.*/config/||' | sed 's|/*$||')
        
        BATCH_PATHS+=("${TARGET_BATCH}/config/${RELATIVE_PATH}/${BASE_FILE}")
        LOCAL_PATHS+=("${STAGING_BATCH}/config/${RELATIVE_PATH}/${BASE_FILE}")

    # -----------------------------------------------------------------
    # [CASE 5] 기타 BATCH
    # -----------------------------------------------------------------
    elif [[ "$DIR_PATH" == *"BATCH"* ]]; then
        MATCHED="true"
        TYPE="batch"
        # BATCH 기본 경로 처리 (src/config 패턴이 없는 경우)
        RELATIVE_PATH=$(echo "$DIR_PATH" | sed -E 's|.*/BATCH/||' | sed 's|/*$||')
        BATCH_PATHS+=("${TARGET_BATCH}/${RELATIVE_PATH}/${BASE_FILE}")
    fi

    if [ "$MATCHED" = "false" ]; then
        UNKNOWN_LINES+=("$line")
    fi

done < "$INPUT_FILE"

# --------------------------------------------------
# 결과 파일 저장 함수
# --------------------------------------------------
write_if_any() {
    local outfile="$1"; shift
    local arr=("$@")
    if [ "${#arr[@]}" -gt 0 ]; then
        printf '%s\n' "${arr[@]}" > "$outfile"
        echo "[생성] $outfile (${#arr[@]}건)"
    fi
}

# 파일 쓰기 실행
write_if_any "${RESULT_DIR}/${TASK_ID}_online.txt"  "${ONLINE_PATHS[@]}"
write_if_any "${RESULT_DIR}/${TASK_ID}_batch.txt"   "${BATCH_PATHS[@]}"
write_if_any "${RESULT_DIR}/${TASK_ID}_coweb.txt"   "${COWEB_PATHS[@]}"
write_if_any "${RESULT_DIR}/${TASK_ID}_dpweb.txt"   "${DPWEB_PATHS[@]}"
write_if_any "${RESULT_DIR}/${TASK_ID}_local.txt"   "${LOCAL_PATHS[@]}"

if [ "${#UNKNOWN_LINES[@]}" -gt 0 ]; then
    printf '%s\n' "${UNKNOWN_LINES[@]}" > "${RESULT_DIR}/${TASK_ID}_unknown.txt"
    echo "[주의] 미분류 ${#UNKNOWN_LINES[@]}건 -> ${RESULT_DIR}/${TASK_ID}_unknown.txt"
fi

echo "=================================================="
echo " 작업 완료!"
echo " 결과 확인: ls -l $RESULT_DIR"
echo "=================================================="


